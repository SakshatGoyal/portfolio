{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sakshat-goyal-portfolio-preview",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-28",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
