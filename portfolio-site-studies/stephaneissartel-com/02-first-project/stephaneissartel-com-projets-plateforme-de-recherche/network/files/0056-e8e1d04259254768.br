  type ColorValue = {
    r: number,
    g: number,
    b: number,
    a: number,
  }

  export type ImageValue = {
    src: string,
    alt?: string,
    height?: number,
    width?: number,
  }

  export type StringSetterPropKeys<Props> = keyof Props
  export type StringPropertySpec<Props> = {
    type: 'string',
    label?: string,
    defaultValue?: string,
    setter?: StringSetterPropKeys<Props>,
    sortPosition?: number,
    showDividerAbove?: boolean,
  }

  // KEEP_IN_SYNC(web/js/figma_app/views/component_props/property_icon.tsx)
  type PropertyIconSpec = 'corners' | 'delay' | 'infinity' | 'loop' | 'loop_off' | 'loop_once' | 'loop_pingpong' | 'minus' | 'opacity' | 'path_trim_end' | 'path_trim_origin' | 'path_trim_start' | 'rotation' | 'time'

  export type StringPropertySelectSpec<Props> = StringPropertySpec<Props> & {
    control: 'select',
    options: {
      value: string,
      label: string,
      icon?: PropertyIconSpec,
    }[],
  }

  export type BooleanSetterPropKeys<Props> = keyof Props
