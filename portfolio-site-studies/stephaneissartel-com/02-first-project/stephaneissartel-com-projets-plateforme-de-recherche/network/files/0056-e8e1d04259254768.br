    | 'spring'
    | 'gentleSpring'
    | 'customSpring'
    | 'springPresetOne'
    | 'springPresetTwo'
    | 'springPresetThree'
    | 'bezier'

  export enum EasingType {
    IN_CUBIC = 0,
    OUT_CUBIC = 1,
    INOUT_CUBIC = 2,
    LINEAR = 3,
    IN_BACK_CUBIC = 4,
    OUT_BACK_CUBIC = 5,
    INOUT_BACK_CUBIC = 6,
    CUSTOM_CUBIC = 7,
    SPRING = 8,
