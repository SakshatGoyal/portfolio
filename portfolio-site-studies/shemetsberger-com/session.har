\r\n\t\t\t\t\t\r\n\t\t<smp-content id=\"content_5d8e710e2\"  data-module=\"image\" ><div class=\"smp-image\" data-align=\"left\" data-width=\"original\"><div class=\"is-content\"><img class=\"\"  src=\"https://shemetsberger.com/wp-content/uploads/2025/10/shemetsberger_schnitt_01.jpg\" width=\"804\" height=\"1102\" alt=\"shemetsberger_schnitt_01\" title=\"shemetsberger_schnitt_01\" caption=\"\" data-scaling=\"no\"></div></div></smp-content></smp-content-wrapper></smp-column>\r\n\t\t\t<smp-column id=\"column_037aa7840\" data-xl-width=\"6\">\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t<smp-content-wrapper>\r\n\t\t\t\t\t\r\n\t\t\t\t\t\r\n\t\t<smp-content id=\"content_p1ezegqch\"  data-module=\"image\" ><div class=\"smp-image\" data-align=\"left\" data-width=\"original\"><div class=\"is-content\"><img class=\"\"  src=\"https://shemetsberger.com/wp-content/uploads/2025/10/shemetsberger_schnitt_02.jpg\" width=\"1656\" height=\"1102\" alt=\"shemetsberger_schnitt_02\" title=\"shemetsberger_schnitt_02\" caption=\"\" data-scaling=\"no\"></div></div></smp-content></smp-content-wrapper></smp-column>\r\n\t\t\t<smp-column id=\"column_bf8d2a68f\" data-xl-width=\"3\">\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t<smp-content-wrapper>\r\n\t\t\t\t\t\r\n\t\t\t\t\t\r\n\t\t<smp-content id=\"content_sg0wk7aff\"  data-module=\"image\" ><div class=\"smp-image\" data-align=\"left\" data-width=\"original\"><div class=\"is-content\"><img class=\"\"  src=\"https://shemetsberger.com/wp-content/uploads/2025/10/shemetsberger_schnitt_03.jpg\" width=\"804\" height=\"1102\" alt=\"shemetsberger_schnitt_03\" title=\"shemetsberger_schnitt_03\" caption=\"\" data-scaling=\"no\"></div></div></smp-content></smp-content-wrapper></smp-column></smp-row><smp-row id=\"row_45d2bdaa5\">\r\n\t\t\t<smp-column id=\"column_6555a6458\" data-xl-width=\"6\">\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t<smp-content-wrapper>\r\n\t\t\t\t\t\r\n\t\t\t\t\t\r\n\t\t<smp-content id=\"content_c70fca80a\"  data-module=\"text\" ><div class=\"is-content\"><h2>Schnitt is an independent magazine at the intersections of architecture and other fields.</h2></div></smp-content><smp-content id=\"content_9e145c43c\"  data-module=\"accordion\" >\r\n\t\t\t<div class=\"is-content\" data-seperator-visibility=\"visible\" data-seperator-mode=\"bottom\" data-accordion-id=\"content_9e145c43c\" data-mode=\"normal\" data-has-gradient=\"false\">\r\n\t\t\t\t<div class=\"seperator top-seperator\"></div>\r\n\t\t\t\t\t<div class=\"accordion-item\" data-accordion-id=\"accordion_default1\">\r\n\t\t\t\t\t\t<div class=\"title\" data-font=\"font_q7il9b6yr\">\r\n\t\t\t\t\t\t\t<div class=\"title-span\" data-name=\"title\"><span>More</span></div>\r\n\t\t\t\t\t\t\t<div class=\"icon\">\r\n\t\t\t\t\t\t\t\t<span class=\"expand\"><svg version=\"1.1\" id=\"Ebene_1\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" x=\"0px\" y=\"0px\"\r\n\t viewBox=\"0 0 16 16\" style=\"enable-background:new 0 0 16 16;\" xml:space=\"preserve\">\r\n<polygon class=\"st0\" points=\"16,7.5 8.5,7.5 8.5,0 7.5,0 7.5,7.5 0,7.5 0,8.5 7.5,8.5 7.5,16 8.5,16 8.5,8.5 16,8.5 \"/>\r\n</svg>\r\n</span>\r\n\t\t\t\t\t\t\t\t<span class=\"collapse\"><svg version=\"1.1\" id=\"Ebene_1\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" x=\"0px\" y=\"0px\"\r\n\t viewBox=\"0 0 16 16\" style=\"enable-background:new 0 0 16 16;\" xml:space=\"preserve\">\r\n<rect x=\"7.5\" y=\"0\" transform=\"matrix(9.094953e-11 -1 1 9.094953e-11 -6.821210e-10 16)\" class=\"st0\" width=\"1\" height=\"16\"/>\r\n</svg>\r\n</span>\r\n\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t<div class=\"description\" ><div class=\"description-inner\" data-font=\"font_q7il9b6yr\"><div id=\"accordion-content_eulatb3qv\" class=\"accordion-text accordion-content\"><div>We designed and built a site that foregrounds the writing: clear hierarchy, readable type, and calm page layouts. Flexible article templates handle interviews, essays, recommendations, and photo series without visual noise. The result is a content-led experience where clarity and readability do the heavy lifting.</div></div></div></div>\r\n\t\t\t\t\t\t\r\n\t\t\t\t\t</div>\r\n\t\t\t\t<div class=\"seperator bottom-seperator\"></div>\r\n\t\t\t</div>\r\n\t\t</smp-content></smp-content-wrapper></smp-column>\r\n\t\t\t<smp-column id=\"column_261576660\" data-xl-width=\"3\">\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t<smp-content-wrapper>\r\n\t\t\t\t\t\r\n\t\t\t\t\t\r\n\t\t<smp-content id=\"content_3247f8f93\"  data-module=\"text\" ><div class=\"is-content\"><p><span style=\"color: rgb(127, 127, 127);\" data-mce-style=\"color: rgb(127, 127, 127);\">Scope</span><br>Website<br></p></div></smp-content><smp-content id=\"content_ad6216b66\"  data-module=\"text\" ><div class=\"is-content\"><p><span style=\"color: rgb(127, 127, 127);\" data-mce-style=\"color: rgb(127, 127, 127);\">Website</span><br>Denise Hödl<br>Sebastian Hemetsberger<br></p></div></smp-content></smp-content-wrapper></smp-column>\r\n\t\t\t<smp-column id=\"column_ce79e4bc0\" data-xl-width=\"3\">\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t<smp-content-wrapper>\r\n\t\t\t\t\t\r\n\t\t\t\t\t\r\n\t\t<smp-content id=\"content_9c9a507a3\"  data-module=\"text\" ><div class=\"is-content\"><p><span style=\"color: rgb(234, 234, 234);\" data-mce-style=\"color: rgb(234, 234, 234);\">Live Site: <span style=\"text-decoration: underline;\" data-mce-style=\"text-decoration: underline;\"><a href=\"https://schnitt-magazine.com/\" data-mce-href=\"https://schnitt-magazine.com/\" data-mce-selected=\"inline-boundary\" target=\"_blank\" rel=\"noopener\">schnitt-magazine.com</a><br></span></span></p></div></smp-content></smp-content-wrapper></smp-column></smp-row></smp-container></smp-section>\r\n\t\t\t<smp-section id=\"section_a0b7974a9\"  data-column-mode-sm=\"single\" data-column-mode-xs=\"single\" data-layout=\"fluid\" data-column-mode-md=\"single\" data-column-mode-lg=\"single\">\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t<smp-container>\r\n\t\t\t\t\t\r\n\t\t\t\t\t\r\n\t\t<smp-row id=\"row_7b87de407\">\r\n\t\t\t<smp-column id=\"column_1a1fb9db6\" data-xl-width=\"4\">\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t<smp-content-wrapper>\r\n\t\t\t\t\t\r\n\t\t\t\t\t\r\n\t\t<smp-content id=\"content_8319daa80\"  data-module=\"image\" ><div class=\"smp-image\" data-align=\"left\" data-width=\"original\"><div class=\"is-content\"><img class=\"\"  src=\"https://shemetsberger.com/wp-content/uploads/2025/01/Woeckl_1.jpg\" width=\"1635\" height=\"1512\" alt=\"Woeckl_1\" title=\"Woeckl_1\" caption=\"\" data-scaling=\"no\"></div></div></smp-content></smp-content-wrapper></smp-column>\r\n\t\t\t<smp-column id=\"column_47e81057f\" data-xl-width=\"5\">\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t<smp-content-wrapper>\r\n\t\t\t\t\t\r\n\t\t\t\t\t\r\n\t\t<smp-content id=\"content_689d388a6\"  data-module=\"image\" ><div class=\"smp-image\" data-align=\"left\" data-width=\"original\"><div class=\"is-content\"><img class=\"\"  src=\"https://shemetsberger.com/wp-content/uploads/2025/01/Woeckl_2-2.jpg\" width=\"2059\" height=\"1513\" alt=\"Woeckl_2\" title=\"Woeckl_2\" caption=\"\" data-scaling=\"no\"></div></div></smp-content></smp-content-wrapper></smp-column>\r\n\t\t\t<smp-column id=\"column_56690b1aa\" data-xl-width=\"3\">\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t<smp-content-wrapper>\r\n\t\t\t\t\t\r\n\t\t\t\t\t\r\n\t\t<smp-content id=\"content_0fa639d16\"  data-module=\"video\" >\n\t\t\t<div class=\"smp-video is-content hide-controls smp-autoplay\">\n\t\t\t\t<video class=\"video\" preload=\"metadata\"  webkit-playsinline playsinline loop muted autoplay>\n\t\t\t\t\t<source src=\"https://shemetsberger.com/wp-content/uploads/2024/08/STW_Case_Layouts.mp4\" type=\"video/mp4\">\n\t\t\t\t</video>\n\t\t\t</div>\n\t\t</smp-content></smp-content-wrapper></smp-column></smp-row><smp-row id=\"row_19b171735\">\r\n\t\t\t<smp-column id=\"column_84fd1b4af\" data-xl-width=\"6\">\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t<smp-content-wrapper>\r\n\t\t\t\t\t\r\n\t\t\t\t\t\r\n\t\t<smp-content id=\"content_60c2954c9\"  data-module=\"text\" ><div class=\"is-content\"><h2>Studio Wöckl is an interior architecture studio specializing in atmosphere; we built a cohesive brand, photography, and website to express that focus.</h2></div></smp-content><smp-content id=\"content_3e53a994b\"  data-module=\"accordion\" >\r\n\t\t\t<div class=\"is-content\" data-seperator-visibility=\"visible\" data-seperator-mode=\"bottom\" data-accordion-id=\"content_3e53a994b\" data-mode=\"normal\" data-has-gradient=\"false\">\r\n\t\t\t\t<div class=\"seperator top-seperator\"></div>\r\n\t\t\t\t\t<div class=\"accordion-item\" data-accordion-id=\"accordion_default1\">\r\n\t\t\t\t\t\t<div class=\"title\" data-font=\"font_q7il9b6yr\">\r\n\t\t\t\t\t\t\t<div class=\"title-span\" data-name=\"title\"><span>More</span></div>\r\n\t\t\t\t\t\t\t<div class=\"icon\">\r\n\t\t\t\t\t\t\t\t<span class=\"expand\"><svg version=\"1.1\" id=\"Ebene_1\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" x=\"0px\" y=\"0px\"\r\n\t viewBox=\"0 0 16 16\" style=\"enable-background:new 0 0 16 16;\" xml:space=\"preserve\">\r\n<polygon class=\"st0\" points=\"16,7.5 8.5,7.5 8.5,0 7.5,0 7.5,7.5 0,7.5 0,8.5 7.5,8.5 7.5,16 8.5,16 8.5,8.5 16,8.5 \"/>\r\n</svg>\r\n</span>\r\n\t\t\t\t\t\t\t\t<span class=\"collapse\"><svg version=\"1.1\" id=\"Ebene_1\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" x=\"0px\" y=\"0px\"\r\n\t viewBox=\"0 0 16 16\" style=\"enable-background:new 0 0 16 16;\" xml:space=\"preserve\">\r\n<rect x=\"7.5\" y=\"0\" transform=\"matrix(9.094953e-11 -1 1 9.094953e-11 -6.821210e-10 16)\" class=\"st0\" width=\"1\" height=\"16\"/>\r\n</svg>\r\n</span>\r\n\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t<div class=\"description\" ><div class=\"description-inner\" data-font=\"font_q7il9b6yr\"><div id=\"accordion-content_s4nc8zyn2\" class=\"accordion-text accordion-content\"><div>Our strategy was to communicate mood at a glance—without explanations. The identity draws on light and shadow, using a subtle blur and motion to create a sense of space and immersion across the system, setting Studio Wöckl apart in a crowded field.</div></div></div></div>\r\n\t\t\t\t\t\t\r\n\t\t\t\t\t</div>\r\n\t\t\t\t<div class=\"seperator bottom-seperator\"></div>\r\n\t\t\t</div>\r\n\t\t</smp-content></smp-content-wrapper></smp-column>\r\n\t\t\t<smp-column id=\"column_587ecf7d8\" data-xl-width=\"3\">\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t<smp-content-wrapper>\r\n\t\t\t\t\t\r\n\t\t\t\t\t\r\n\t\t<smp-content id=\"content_40f5164a0\"  data-module=\"text\" ><div class=\"is-content\"><p><span style=\"color: rgb(127, 127, 127);\" data-mce-style=\"color: rgb(127, 127, 127);\">Scope</span><br>Brand Identity<br>Website<br></p></div></smp-content><smp-content id=\"content_7d67d4476\"  data-module=\"text\" ><div class=\"is-content\"><p><span style=\"color: rgb(127, 127, 127);\" data-mce-style=\"color: rgb(127, 127, 127);\">Brand</span><br>Denise Hödl<br>Alexander Merlicek<br>Sebastian Hemetsberger<br></p></div></smp-content><smp-content id=\"content_01bbc178b\"  data-module=\"text\" ><div class=\"is-content\"><p><span style=\"color: rgb(127, 127, 127);\" data-mce-style=\"color: rgb(127, 127, 127);\">Photography</span><br>Christoph Platzer</p></div></smp-content></smp-content-wrapper></smp-column>\r\n\t\t\t<smp-column id=\"column_9bcba6a8c\" data-xl-width=\"3\">\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t<smp-content-wrapper>\r\n\t\t\t\t\t\r\n\t\t\t\t\t\r\n\t\t<smp-content id=\"content_5b8257ef9\"  data-module=\"text\" ><div class=\"is-content\"><p><span style=\"color: rgb(234, 234, 234);\" data-mce-style=\"color: rgb(234, 234, 234);\">Live Site: <span style=\"text-decoration: underline;\" data-mce-style=\"text-decoration: underline;\"><a href=\"https://studio-woeckl.com/\" data-mce-href=\"https://studio-woeckl.com/\" style=\"color: rgb(234, 234, 234);\" data-mce-style=\"color: rgb(234, 234, 234);\" target=\"_blank\" rel=\"noopener\" data-mce-selected=\"1\">studio-woeckl.com﻿</a></span></span></p></div></smp-content></smp-content-wrapper></smp-column></smp-row></smp-container></smp-section>\r\n\t\t\t<smp-section id=\"section_f044a8d8b\"  data-column-mode-sm=\"single\" data-column-mode-xs=\"single\" data-layout=\"fluid\" data-column-mode-md=\"single\" data-column-mode-lg=\"single\">\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t<smp-container>\r\n\t\t\t\t\t\r\n\t\t\t\t\t\r\n\t\t<smp-row id=\"row_5b3f259d0\">\r\n\t\t\t<smp-column id=\"column_88c862946\" data-xl-width=\"4\">\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t<smp-content-wrapper>\r\n\t\t\t\t\t\r\n\t\t\t\t\t\r\n\t\t<smp-content id=\"content_924f78669\"  data-module=\"image\" ><div class=\"smp-image\" data-align=\"left\" data-width=\"original\"><div class=\"is-content\"><img class=\"\"  src=\"https://shemetsberger.com/wp-content/uploads/2025/01/TF-1.jpg\" width=\"2249\" height=\"1729\" alt=\"TF-1\" title=\"TF-1\" caption=\"\" data-scaling=\"no\"></div></div></smp-content></smp-content-wrapper></smp-column>\r\n\t\t\t<smp-column id=\"column_7ph4xjqow\" data-xl-width=\"4\">\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t<smp-content-wrapper>\r\n\t\t\t\t\t\r\n\t\t\t\t\t\r\n\t\t<smp-content id=\"content_etpsrbs6b\"  data-module=\"video\" >\n\t\t\t<div class=\"smp-video is-content hide-controls smp-autoplay\">\n\t\t\t\t<video class=\"video\" preload=\"metadata\"  webkit-playsinline playsinline loop muted autoplay>\n\t\t\t\t\t<source src=\"https://shemetsberger.com/wp-content/uploads/2025/01/TF-Start-low2.mp4\" type=\"video/mp4\">\n\t\t\t\t</video>\n\t\t\t</div>\n\t\t</smp-content></smp-content-wrapper></smp-column>\r\n\t\t\t<smp-column id=\"column_7fab9d717\" data-xl-width=\"4\">\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t<smp-content-wrapper>\r\n\t\t\t\t\t\r\n\t\t\t\t\t\r\n\t\t<smp-content id=\"content_2613591af\"  data-module=\"image\" ><div class=\"smp-image\" data-align=\"left\" data-width=\"original\"><div class=\"is-content\"><img class=\"\"  src=\"https://shemetsberger.com/wp-content/uploads/2025/01/TF-5.jpg\" width=\"2249\" height=\"1729\" alt=\"TF-5\" title=\"TF-5\" caption=\"\" data-scaling=\"no\"></div></div></smp-content></smp-content-wrapper></smp-column></smp-row><smp-row id=\"row_23380bd60\">\r\n\t\t\t<smp-column id=\"column_812c7e59a\" data-xl-width=\"6\">\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t<smp-content-wrapper>\r\n\t\t\t\t\t\r\n\t\t\t\t\t\r\n\t\t<smp-content id=\"content_2bfda85e9\"  data-module=\"text\" ><div class=\"is-content\"><h2>Tobias, awarded Europe’s Best Wedding Filmmaker, creates wedding films defined by rhythm, tone, and atmosphere, telling personal love stories.</h2></div></smp-content><smp-content id=\"content_50lnwgu6c\"  data-module=\"accordion\" >\r\n\t\t\t<div class=\"is-content\" data-seperator-visibility=\"visible\" data-seperator-mode=\"bottom\" data-accordion-id=\"content_50lnwgu6c\" data-mode=\"normal\" data-has-gradient=\"false\">\r\n\t\t\t\t<div class=\"seperator top-seperator\"></div>\r\n\t\t\t\t\t<div class=\"accordion-item\" data-accordion-id=\"accordion_default1\">\r\n\t\t\t\t\t\t<div class=\"title\" data-font=\"font_q7il9b6yr\">\r\n\t\t\t\t\t\t\t<div class=\"title-span\" data-name=\"title\"><span>More</span></div>\r\n\t\t\t\t\t\t\t<div class=\"icon\">\r\n\t\t\t\t\t\t\t\t<span class=\"expand\"><svg version=\"1.1\" id=\"Ebene_1\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" x=\"0px\" y=\"0px\"\r\n\t viewBox=\"0 0 16 16\" style=\"enable-background:new 0 0 16 16;\" xml:space=\"preserve\">\r\n<polygon class=\"st0\" points=\"16,7.5 8.5,7.5 8.5,0 7.5,0 7.5,7.5 0,7.5 0,8.5 7.5,8.5 7.5,16 8.5,16 8.5,8.5 16,8.5 \"/>\r\n</svg>\r\n</span>\r\n\t\t\t\t\t\t\t\t<span class=\"collapse\"><svg version=\"1.1\" id=\"Ebene_1\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" x=\"0px\" y=\"0px\"\r\n\t viewBox=\"0 0 16 16\" style=\"enable-background:new 0 0 16 16;\" xml:space=\"preserve\">\r\n<rect x=\"7.5\" y=\"0\" transform=\"matrix(9.094953e-11 -1 1 9.094953e-11 -6.821210e-10 16)\" class=\"st0\" width=\"1\" height=\"16\"/>\r\n</svg>\r\n</span>\r\n\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t<div class=\"description\" ><div class=\"description-inner\" data-font=\"font_q7il9b6yr\"><div id=\"accordion-content_m614s9k48\" class=\"accordion-text accordion-content\"><div>Our goal was to craft a brand and website that reflect his unique style and resonate with an international audience. A standout feature is an audiovisualizer, showcasing his projects and music, capturing the essence of his storytelling through sound and emotion.</div></div></div></div>\r\n\t\t\t\t\t\t\r\n\t\t\t\t\t</div>\r\n\t\t\t\t<div class=\"seperator bottom-seperator\"></div>\r\n\t\t\t</div>\r\n\t\t</smp-content></smp-content-wrapper></smp-column>\r\n\t\t\t<smp-column id=\"column_8f050f01a\" data-xl-width=\"3\">\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t<smp-content-wrapper>\r\n\t\t\t\t\t\r\n\t\t\t\t\t\r\n\t\t<smp-content id=\"content_197443c28\"  data-module=\"text\" ><div class=\"is-content\"><p><span style=\"color: rgb(127, 127, 127);\" data-mce-style=\"color: rgb(127, 127, 127);\">Scope</span><br>Brand Identity<br>Website<br>Code<br></p></div></smp-content><smp-content id=\"content_2b92a55fb\"  data-module=\"text\" ><div class=\"is-content\"><p><span style=\"color: rgb(127, 127, 127);\" data-mce-style=\"color: rgb(127, 127, 127);\">Brand</span><br>Denise Hödl<br>Sebastian Hemetsberger<br></p></div></smp-content><smp-content id=\"content_ae65b1a22\"  data-module=\"text\" ><div class=\"is-content\"><p><span style=\"color: rgb(127, 127, 127);\" data-mce-style=\"color: rgb(127, 127, 127);\">Website</span><br>Denise Hödl<br>Sebastian Hemetsberger<br></p></div></smp-content></smp-content-wrapper></smp-column>\r\n\t\t\t<smp-column id=\"column_2dc63b324\" da