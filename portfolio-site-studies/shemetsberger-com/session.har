\t\r\n\t\t\t\t\r\n\t\t\t\t<smp-container>\r\n\t\t\t\t\t\r\n\t\t\t\t\t\r\n\t\t<smp-row id=\"row_3f1060de4\">\r\n\t\t\t<smp-column id=\"column_628a21bd6\" data-xl-width=\"3\">\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t<smp-content-wrapper>\r\n\t\t\t\t\t\r\n\t\t\t\t\t\r\n\t\t<smp-content id=\"content_d6cfc16f4\"  data-module=\"image\" ><div class=\"smp-image\" data-align=\"left\" data-width=\"original\"><div class=\"is-content\"><img class=\"\"  src=\"https://shemetsberger.com/wp-content/uploads/2025/10/shemetsberger_olento_01.jpg\" width=\"806\" height=\"1104\" alt=\"shemetsberger_olento_01\" title=\"shemetsberger_olento_01\" caption=\"\" data-scaling=\"no\"></div></div></smp-content></smp-content-wrapper></smp-column>\r\n\t\t\t<smp-column id=\"column_qe4outqgk\" data-xl-width=\"6\">\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t<smp-content-wrapper>\r\n\t\t\t\t\t\r\n\t\t\t\t\t\r\n\t\t<smp-content id=\"content_e3hmissni\"  data-module=\"image\" ><div class=\"smp-image\" data-align=\"left\" data-width=\"original\"><div class=\"is-content\"><img class=\"\"  src=\"https://shemetsberger.com/wp-content/uploads/2025/10/shemetsberger_olento_02.jpg\" width=\"1654\" height=\"1102\" alt=\"shemetsberger_olento_02\" title=\"shemetsberger_olento_02\" caption=\"\" data-scaling=\"no\"></div></div></smp-content></smp-content-wrapper></smp-column>\r\n\t\t\t<smp-column id=\"column_3e8aa5900\" data-xl-width=\"3\">\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t<smp-content-wrapper>\r\n\t\t\t\t\t\r\n\t\t\t\t\t\r\n\t\t<smp-content id=\"content_0af111700\"  data-module=\"image\" ><div class=\"smp-image\" data-align=\"left\" data-width=\"original\"><div class=\"is-content\"><img class=\"\"  src=\"https://shemetsberger.com/wp-content/uploads/2025/10/shemetsberger_olento_03.jpg\" width=\"804\" height=\"1102\" alt=\"shemetsberger_olento_03\" title=\"shemetsberger_olento_03\" caption=\"\" data-scaling=\"no\"></div></div></smp-content></smp-content-wrapper></smp-column></smp-row><smp-row id=\"row_7a59903f3\">\r\n\t\t\t<smp-column id=\"column_a100e4ab4\" data-xl-width=\"6\">\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t<smp-content-wrapper>\r\n\t\t\t\t\t\r\n\t\t\t\t\t\r\n\t\t<smp-content id=\"content_70f2d1821\"  data-module=\"text\" ><div class=\"is-content\"><h2>Olento integrates a central grill into a ceramic table, putting the cooking where people gather.</h2></div></smp-content><smp-content id=\"content_455rwmxlt\"  data-module=\"accordion\" >\r\n\t\t\t<div class=\"is-content\" data-seperator-visibility=\"visible\" data-seperator-mode=\"bottom\" data-accordion-id=\"content_455rwmxlt\" data-mode=\"normal\" data-has-gradient=\"false\">\r\n\t\t\t\t<div class=\"seperator top-seperator\"></div>\r\n\t\t\t\t\t<div class=\"accordion-item\" data-accordion-id=\"accordion_default1\">\r\n\t\t\t\t\t\t<div class=\"title\" data-font=\"font_q7il9b6yr\">\r\n\t\t\t\t\t\t\t<div class=\"title-span\" data-name=\"title\"><span>More</span></div>\r\n\t\t\t\t\t\t\t<div class=\"icon\">\r\n\t\t\t\t\t\t\t\t<span class=\"expand\"><svg version=\"1.1\" id=\"Ebene_1\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" x=\"0px\" y=\"0px\"\r\n\t viewBox=\"0 0 16 16\" style=\"enable-background:new 0 0 16 16;\" xml:space=\"preserve\">\r\n<polygon class=\"st0\" points=\"16,7.5 8.5,7.5 8.5,0 7.5,0 7.5,7.5 0,7.5 0,8.5 7.5,8.5 7.5,16 8.5,16 8.5,8.5 16,8.5 \"/>\r\n</svg>\r\n</span>\r\n\t\t\t\t\t\t\t\t<span class=\"collapse\"><svg version=\"1.1\" id=\"Ebene_1\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" x=\"0px\" y=\"0px\"\r\n\t viewBox=\"0 0 16 16\" style=\"enable-background:new 0 0 16 16;\" xml:space=\"preserve\">\r\n<rect x=\"7.5\" y=\"0\" transform=\"matrix(9.094953e-11 -1 1 9.094953e-11 -6.821210e-10 16)\" class=\"st0\" width=\"1\" height=\"16\"/>\r\n</svg>\r\n</span>\r\n\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t<div class=\"description\" ><div class=\"description-inner\" data-font=\"font_q7il9b6yr\"><div id=\"accordion-content_rks1rvyv8\" class=\"accordion-text accordion-content\"><div>That shared center turns cooking into a collective moment—everyone sits together, everyone takes part. We built the brand and website around this idea of togetherness, carrying the table’s center point through the visuals and messaging.</div></div></div></div>\r\n\t\t\t\t\t\t\r\n\t\t\t\t\t</div>\r\n\t\t\t\t<div class=\"seperator bottom-seperator\"></div>\r\n\t\t\t</div>\r\n\t\t</smp-content></smp-content-wrapper></smp-column>\r\n\t\t\t<smp-column id=\"column_609b43358\" data-xl-width=\"3\">\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t<smp-content-wrapper>\r\n\t\t\t\t\t\r\n\t\t\t\t\t\r\n\t\t<smp-content id=\"content_989630b19\"  data-module=\"text\" ><div class=\"is-content\"><p><span style=\"color: rgb(127, 127, 127);\" data-mce-style=\"color: rgb(127, 127, 127);\">Scope</span><br>Brand Identity<br>Website<br>Code<br></p></div></smp-content><smp-content id=\"content_1d1888813\"  data-module=\"text\" ><div class=\"is-content\"><p><span style=\"color: rgb(127, 127, 127);\" data-mce-style=\"color: rgb(127, 127, 127);\">Brand</span><br>Denise Hödl<br>Sebastian Hemetsberger<br></p></div></smp-content><smp-content id=\"content_0406c5fb6\"  data-module=\"text\" ><div class=\"is-content\"><p><span style=\"color: rgb(127, 127, 127);\" data-mce-style=\"color: rgb(127, 127, 127);\">Website</span><br>Denise Hödl<br>Sebastian Hemetsberger<br></p></div></smp-content><smp-content id=\"content_bdt6epyl2\"  data-module=\"text\" ><div class=\"is-content\"><p><span style=\"color: rgb(127, 127, 127);\" data-mce-style=\"color: rgb(127, 127, 127);\">Partner</span><br>Ceraflex<br>Studio Wöckl<br>Alexander Merlicek<br>Christoph Platzer</p></div></smp-content></smp-content-wrapper></smp-column>\r\n\t\t\t<smp-column id=\"column_ef5ed60cc\" data-xl-width=\"3\">\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t<smp-content-wrapper>\r\n\t\t\t\t\t\r\n\t\t\t\t\t\r\n\t\t<smp-content id=\"content_836f2aae6\"  data-module=\"text\" ><div class=\"is-content\"><p><span style=\"color: rgb(234, 234, 234);\" data-mce-style=\"color: rgb(234, 234, 234);\">Live Site: <span style=\"text-decoration: underline;\" data-mce-style=\"text-decoration: underline;\"><a href=\"https://olento-studio.com/\" target=\"_blank\" rel=\"noopener\" data-mce-href=\"https://olento-studio.com/\">olento-studio.com</a><br></span>Configurator: <span style=\"text-decoration: underline;\" data-mce-style=\"text-decoration: underline;\"><a data-mce-href=\"https://konfigurator.olento-studio.com/\" href=\"https://konfigurator.olento-studio.com/\" target=\"_blank\" rel=\"noopener\" data-mce-selected=\"inline-boundary\">konfigurator.olento-studio.com</a><br></span></span><span style=\"color: rgb(234, 234, 234);\" data-mce-style=\"color: rgb(234, 234, 234);\"><span style=\"text-decoration: underline;\" data-mce-style=\"text-decoration: underline;\"></span></span></p></div></smp-content></smp-content-wrapper></smp-column></smp-row></smp-container></smp-section>\r\n\t\t\t<smp-section id=\"section_c45c275d9\"  data-column-mode-sm=\"single\" data-column-mode-xs=\"single\" data-layout=\"fluid\" data-column-mode-md=\"single\" data-column-mode-lg=\"single\" data-lg-visibility=\"visible\" data-md-visibility=\"visible\" data-sm-visibility=\"visible\" data-xs-visibility=\"visible\">\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t<smp-container>\r\n\t\t\t\t\t\r\n\t\t\t\t\t\r\n\t\t<smp-row id=\"row_dc6f9d120\">\r\n\t\t\t<smp-column id=\"column_leq4nwdyc\" data-xl-width=\"6\">\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t<smp-content-wrapper>\r\n\t\t\t\t\t\r\n\t\t\t\t\t\r\n\t\t<smp-content id=\"content_5a0vg52ca\"  data-module=\"video\" >\n\t\t\t<div class=\"smp-video is-content hide-controls smp-autoplay\">\n\t\t\t\t<video class=\"video\" preload=\"metadata\"  webkit-playsinline playsinline loop muted autoplay>\n\t\t\t\t\t<source src=\"https://shemetsberger.com/wp-content/uploads/2025/10/shemetsberger_viiala_01.mp4\" type=\"video/mp4\">\n\t\t\t\t</video>\n\t\t\t</div>\n\t\t</smp-content></smp-content-wrapper></smp-column>\r\n\t\t\t<smp-column id=\"column_aff9e294d\" data-xl-width=\"3\">\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t<smp-content-wrapper>\r\n\t\t\t\t\t\r\n\t\t\t\t\t\r\n\t\t<smp-content id=\"content_197603b2e\"  data-module=\"image\" ><div class=\"smp-image\" data-align=\"left\" data-width=\"original\"><div class=\"is-content\"><img class=\"\"  src=\"https://shemetsberger.com/wp-content/uploads/2025/10/shemetsberger_viiala_02.jpg\" width=\"804\" height=\"1102\" alt=\"shemetsberger_viiala_02\" title=\"shemetsberger_viiala_02\" caption=\"\" data-scaling=\"no\"></div></div></smp-content></smp-content-wrapper></smp-column>\r\n\t\t\t<smp-column id=\"column_ef6d1a66b\" data-xl-width=\"3\">\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t<smp-content-wrapper>\r\n\t\t\t\t\t\r\n\t\t\t\t\t\r\n\t\t<smp-content id=\"content_0f410fff6\"  data-module=\"image\" ><div class=\"smp-image\" data-align=\"left\" data-width=\"original\"><div class=\"is-content\"><img class=\"\"  src=\"https://shemetsberger.com/wp-content/uploads/2025/10/shemetsberger_viiala_03.jpg\" width=\"804\" height=\"1102\" alt=\"shemetsberger_viiala_03\" title=\"shemetsberger_viiala_03\" caption=\"\" data-scaling=\"no\"></div></div></smp-content></smp-content-wrapper></smp-column></smp-row><smp-row id=\"row_7da372249\">\r\n\t\t\t<smp-column id=\"column_a31845d0d\" data-xl-width=\"6\">\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t<smp-content-wrapper>\r\n\t\t\t\t\t\r\n\t\t\t\t\t\r\n\t\t<smp-content id=\"content_1d11b5766\"  data-module=\"text\" ><div class=\"is-content\"><h2>Viiala is a Swiss mobility company making cycling the deliberate choice.</h2></div></smp-content><smp-content id=\"content_ee78a7b62\"  data-module=\"accordion\" >\r\n\t\t\t<div class=\"is-content\" data-seperator-visibility=\"visible\" data-seperator-mode=\"bottom\" data-accordion-id=\"content_ee78a7b62\" data-mode=\"normal\" data-has-gradient=\"false\">\r\n\t\t\t\t<div class=\"seperator top-seperator\"></div>\r\n\t\t\t\t\t<div class=\"accordion-item\" data-accordion-id=\"accordion_default1\">\r\n\t\t\t\t\t\t<div class=\"title\" data-font=\"font_q7il9b6yr\">\r\n\t\t\t\t\t\t\t<div class=\"title-span\" data-name=\"title\"><span>More</span></div>\r\n\t\t\t\t\t\t\t<div class=\"icon\">\r\n\t\t\t\t\t\t\t\t<span class=\"expand\"><svg version=\"1.1\" id=\"Ebene_1\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" x=\"0px\" y=\"0px\"\r\n\t viewBox=\"0 0 16 16\" style=\"enable-background:new 0 0 16 16;\" xml:space=\"preserve\">\r\n<polygon class=\"st0\" points=\"16,7.5 8.5,7.5 8.5,0 7.5,0 7.5,7.5 0,7.5 0,8.5 7.5,8.5 7.5,16 8.5,16 8.5,8.5 16,8.5 \"/>\r\n</svg>\r\n</span>\r\n\t\t\t\t\t\t\t\t<span class=\"collapse\"><svg version=\"1.1\" id=\"Ebene_1\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" x=\"0px\" y=\"0px\"\r\n\t viewBox=\"0 0 16 16\" style=\"enable-background:new 0 0 16 16;\" xml:space=\"preserve\">\r\n<rect x=\"7.5\" y=\"0\" transform=\"matrix(9.094953e-11 -1 1 9.094953e-11 -6.821210e-10 16)\" class=\"st0\" width=\"1\" height=\"16\"/>\r\n</svg>\r\n</span>\r\n\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t<div class=\"description\" ><div class=\"description-inner\" data-font=\"font_q7il9b6yr\"><div id=\"accordion-content_xfor3hefa\" class=\"accordion-text accordion-content\"><div>Our strategy sets a clear threshold—there is a before Viiala and an after: Cross Over. Beyond Return. The identity translates that line into a visual system inspired by ancient technology—clarity, light, and a decisive axis—carried through typography, layout, motion, and the website. We built the brand and launch materials to mark that moment of change.</div></div></div></div>\r\n\t\t\t\t\t\t\r\n\t\t\t\t\t</div>\r\n\t\t\t\t<div class=\"seperator bottom-seperator\"></div>\r\n\t\t\t</div>\r\n\t\t</smp-content></smp-content-wrapper></smp-column>\r\n\t\t\t<smp-column id=\"column_531a41e44\" data-xl-width=\"3\">\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t<smp-content-wrapper>\r\n\t\t\t\t\t\r\n\t\t\t\t\t\r\n\t\t<smp-content id=\"content_a98b92b4e\"  data-module=\"text\" ><div class=\"is-content\"><p><span style=\"color: rgb(127, 127, 127);\" data-mce-style=\"color: rgb(127, 127, 127);\">Scope</span><br>Brand Identity<br>Website<br>Code<br></p></div></smp-content><smp-content id=\"content_70493a46d\"  data-module=\"text\" ><div class=\"is-content\"><p><span style=\"color: rgb(127, 127, 127);\" data-mce-style=\"color: rgb(127, 127, 127);\">Brand<br><span style=\"color: rgb(230, 230, 230);\" data-mce-style=\"color: rgb(230, 230, 230);\">Max Kickinger</span><br></span><span style=\"color: rgb(230, 230, 230);\" data-mce-style=\"color: rgb(230, 230, 230);\">Denise Hödl</span><br>Sebastian Hemetsberger<br></p></div></smp-content><smp-content id=\"content_b0f0a0279\"  data-module=\"text\" ><div class=\"is-content\"><p><span style=\"color: rgb(127, 127, 127);\" data-mce-style=\"color: rgb(127, 127, 127);\">Website</span><br>Denise Hödl<br>Sebastian Hemetsberger<br></p></div></smp-content><smp-content id=\"content_b9a1095c5\"  data-module=\"text\" ><div class=\"is-content\"><p><span style=\"color: rgb(127, 127, 127);\" data-mce-style=\"color: rgb(127, 127, 127);\">Partner</span><br>Raven and Finch<br>Ride<br></p></div></smp-content></smp-content-wrapper></smp-column>\r\n\t\t\t<smp-column id=\"column_a94b60f90\" data-xl-width=\"3\">\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t<smp-content-wrapper>\r\n\t\t\t\t\t\r\n\t\t\t\t\t\r\n\t\t<smp-content id=\"content_0eb43c2bd\"  data-module=\"text\" ><div class=\"is-content\"><p><span style=\"color: rgb(234, 234, 234);\" data-mce-style=\"color: rgb(234, 234, 234);\">Live Site: <span style=\"text-decoration: underline;\" data-mce-style=\"text-decoration: underline;\"><a href=\"https://www.viiala.com/\" target=\"_blank\" rel=\"noopener\" data-mce-href=\"https://www.viiala.com/\" data-mce-selected=\"inline-boundary\">viiala.com</a><br></span></span></p></div></smp-content></smp-content-wrapper></smp-column></smp-row></smp-container></smp-section>\r\n\t\t\t<smp-section id=\"section_90851a800\"  data-column-mode-sm=\"single\" data-column-mode-xs=\"single\" data-layout=\"fluid\" data-column-mode-md=\"single\" data-column-mode-lg=\"single\">\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t<smp-container>\r\n\t\t\t\t\t\r\n\t\t\t\t\t\r\n\t\t<smp-row id=\"row_2a2fb4ac0\">\r\n\t\t\t<smp-column id=\"column_qw5ql0ibr\" data-xl-width=\"3\">\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t<smp-content-wrapper>\r\n\t\t\t\t\t\r\n\t\t\t\t\t\r\n\t\t<smp-content id=\"content_78f29df1c\"  data-module=\"image\" ><div class=\"smp-image\" data-align=\"left\" data-width=\"original\"><div class=\"is-content\"><img class=\"\"  src=\"https://shemetsberger.com/wp-content/uploads/2025/10/shemetsberger_stadt-salzburg_01.jpg\" width=\"804\" height=\"1102\" alt=\"shemetsberger_stadt-salzburg_01\" title=\"shemetsberger_stadt-salzburg_01\" caption=\"\" data-scaling=\"no\"></div></div></smp-content></smp-content-wrapper></smp-column>\r\n\t\t\t<smp-column id=\"column_fcf65608a\" data-xl-width=\"6\">\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t<smp-content-wrapper>\r\n\t\t\t\t\t\r\n\t\t\t\t\t\r\n\t\t<smp-content id=\"content_8c66d01e9\"  data-module=\"video\" >\n\t\t\t<div class=\"smp-video is-content hide-controls smp-autoplay\">\n\t\t\t\t<video class=\"video\" preload=\"metadata\"  webkit-playsinline playsinline loop muted autoplay>\n\t\t\t\t\t<source src=\"https://shemetsberger.com/wp-content/uploads/2025/10/shemetsberger_stadt-salzburg_02.mp4\" type=\"video/mp4\">\n\t\t\t\t</video>\n\t\t\t</div>\n\t\t</smp-content></smp-content-wrapper></smp-column>\r\n\t\t\t<smp-column id=\"column_98ed543c2\" data-xl-width=\"3\">\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t<smp-content-wrapper>\r\n\t\t\t\t\t\r\n\t\t\t\t\t\r\n\t\t<smp-content id=\"content_bbeb2efe5\"  data-module=\"image\" ><div class=\"smp-image\" data-align=\"left\" data-width=\"original\"><div class=\"is-content\"><img class=\"\"  src=\"https://shemetsberger.com/wp-content/uploads/2025/10/shemetsberger_stadt-salzburg_03.jpg\" width=\"804\" height=\"1102\" alt=\"shemetsberger_stadt-salzburg_03\" title=\"shemetsberger_stadt-salzburg_03\" caption=\"\" data-scaling=\"no\"></div></div></smp-content></smp-content-wrapper></smp-column></smp-row><smp-row id=\"row_8b1cb3e6e\">\r\n\t\t\t<smp-column id=\"column_90c1e7590\" data-xl-width=\"6\">\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t<smp-content-wrapper>\r\n\t\t\t\t\t\r\n\t\t\t\t\t\r\n\t\t<smp-content id=\"content_ec2fc3446\"  data-module=\"text\" ><div class=\"is-content\"><h2>The Fortschritts-Kompass is Salzburg’s public hub for city projects—planned, ongoing, and completed—filterable by topic, district, and status.</h2></div></smp-content><smp-content id=\"content_104a09756\"  data-module=\"accordion\" >\r\n\t\t\t<div class=\"is-content\" data-seperator-visibility=\"visible\" data-seperator-mode=\"bottom\" data-accordion-id=\"content_104a09756\" data-mode=\"normal\" data-has-gradient=\"false\">\r\n\t\t\t\t<div class=\"seperator top-seperator\"></div>\r\n\t\t\t\t\t<div class=\"accordion-item\" data-accordion-id=\"accordion_default1\">\r\n\t\t\t\t\t\t<div class=\"title\" data-font=\"font_q7il9b6yr\">\r\n\t\t\t\t\t\t\t<div class=\"title-span\" data-name=\"title\"><span>More</span></div>\r\n\t\t\t\t\t\t\t<div class=\"icon\">\r\n\t\t\t\t\t\t\t\t<span class=\"expand\"><svg version=\"1.1\" id=\"Ebene_1\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" x=\"0px\" y=\"0px\"\r\n\t viewBox=\"0 0 16 16\" style=\"enable-background:new 0 0 16 16;\" xml:space=\"preserve\">\r\n<polygon class=\"st0\" points=\"16,7.5 8.5,7.5 8.5,0 7.5,0 7.5,7.5 0,7.5 0,8.5 7.5,8.5 7.5,16 8.5,16 8.5,8.5 16,8.5 \"/>\r\n</svg>\r\n</span>\r\n\t\t\t\t\t\t\t\t<span class=\"collapse\"><svg version=\"1.1\" id=\"Ebene_1\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" x=\"0px\" y=\"0px\"\r\n\t viewBox=\"0 0 16 16\" style=\"enable-background:new 0 0 16 16;\" xml:space=\"preserve\">\r\n<rect x=\"7.5\" y=\"0\" transform=\"matrix(9.094953e-11 -1 1 9.094953e-11 -6.821210e-10 16)\" class=\"st0\" width=\"1\" height=\"16\"/>\r\n</svg>\r\n</span>\r\n\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t<div class=\"description\" ><div class=\"description-inner\" data-font=\"font_q7il9b6yr\"><div id=\"accordion-content_07rs3jr26\" class=\"accordion-text accordion-content\"><div>Our strategy centers on a modern city working with its citizens—transparency, accessibility, and meaningful participation. The design balances clarity and emotion with an inviting, exploratory interface and data visualizations that turn facts into insight.</div></div></div></div>\r\n\t\t\t\t\t\t\r\n\t\t\t\t\t</div>\r\n\t\t\t\t<div class=\"seperator bottom-seperator\"></div>\r\n\t\t\t</div>\r\n\t\t</smp-content></smp-content-wrapper></smp-column>\r\n\t\t\t<smp-column id=\"column_60ffdadd1\" data-xl-width=\"3\">\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t<smp-content-wrapper>\r\n\t\t\t\t\t\r\n\t\t\t\t\t\r\n\t\t<smp-content id=\"content_571b7dc2a\"  data-module=\"text\" ><div class=\"is-content\"><p><span style=\"color: rgb(127, 127, 127);\" data-mce-style=\"color: rgb(127, 127, 127);\">Scope</span><br>Concept<br>Website<br></p></div></smp-content><smp-content id=\"content_e8b9961f6\"  data-module=\"text\" ><div class=\"is-content\"><p><span style=\"color: rgb(127, 127, 127);\" data-mce-style=\"color: rgb(127, 127, 127);\">Design<br></span>Denise Hödl<br>Sebastian Hemetsberger<br></p></div></smp-content><smp-content id=\"content_ef2e24484\"  data-module=\"text\" ><div class=\"is-content\"><p><span style=\"color: rgb(127, 127, 127);\" data-mce-style=\"color: rgb(127, 127, 127);\">Campaign</span><br>Salic</p></div></smp-content><smp-content id=\"content_453d414b7\"  data-module=\"text\" ><div class=\"is-content\"><p><span style=\"color: rgb(127, 127, 127);\" data-mce-style=\"color: rgb(127, 127, 127);\">Code</span><br>typo wimmer</p></div></smp-content></smp-content-wrapper></smp-column>\r\n\t\t\t<smp-column id=\"column_58423643b\" data-xl-width=\"3\">\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t<smp-content-wrapper>\r\n\t\t\t\t\t\r\n\t\t\t\t\t\r\n\t\t<smp-content id=\"content_b67e72597\"  data-module=\"text\" ><div class=\"is-content\"><p><span style=\"color: rgb(234, 234, 234);\" data-mce-style=\"color: rgb(234, 234, 234);\">Live Site: <span style=\"text-decoration: underline;\" data-mce-style=\"text-decoration: underline;\"><a href=\"https://www.fortschritts-kompass.at/\" target=\"_blank\" rel=\"noopener\" data-mce-href=\"https://www.fortschritts-kompass.at/\" data-mce-selected=\"inline-boundary\">fortschritts-kompass.at</a><br></span></span></p></div></smp-content></smp-content-wrapper></smp-column></smp-row></smp-container></smp-section>\r\n\t\t\t<smp-section id=\"section_39433be41\"  data-column-mode-sm=\"single\" data-column-mode-xs=\"single\" data-layout=\"fluid\" data-column-mode-md=\"single\" data-column-mode-lg=\"single\">\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t<smp-container>\r\n\t\t\t\t\t\r\n\t\t\t\t\t\r\n\t\t<smp-row id=\"row_abe87beec\">\r\n\t\t\t<smp-column id=\"column_73f366acf\" data-xl-width=\"3\">\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t<smp-content-wrapper>\r\n\t\t\t\t\t\r\n\t\t\t\t\t\r\n\t\t<smp-content id=\"content_c7b4d6ffd\"  data-module=\"image\" ><div class=\"smp-image\" data-align=\"left\" data-width=\"original\"><div class=\"is-content\"><img class=\"\"  src=\"https://shemetsberger.com/wp-content/uploads/2025/10/shemetsberger_apotheke-laa_01.jpg\" width=\"804\" height=\"1102\" alt=\"shemetsberger_apotheke-laa_01\" title=\"shemetsberger_apotheke-laa_01\" caption=\"\" data-scaling=\"no\"></div></div></smp-content></smp-content-wrapper></smp-column>\r\n\t\t\t<smp-column id=\"column_e2n6lkt8k\" data-xl-width=\"3\">\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\