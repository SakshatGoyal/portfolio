https://studio-nordost.com/media/pages/start/934be95ea6-1775115084/service_image_4-900x-q80.webp 900w, https://studio-nordost.com/media/pages/start/934be95ea6-1775115084/service_image_4-1200x-q80.webp 1200w, https://studio-nordost.com/media/pages/start/934be95ea6-1775115084/service_image_4-1800x-q80.webp 1800w, https://studio-nordost.com/media/pages/start/934be95ea6-1775115084/service_image_4-2560x-q90.webp 2560w\" sizes=\"(min-width: 992px) 25vw, (min-width: 768px) 50vw, 100vw\" type=\"image/webp\"><img loading=\"lazy\" alt=\"\" src=\"https://studio-nordost.com/media/pages/start/934be95ea6-1775115084/service_image_4-300x.jpg\" srcset=\"https://studio-nordost.com/media/pages/start/934be95ea6-1775115084/service_image_4-300x-q80.jpg 300w, https://studio-nordost.com/media/pages/start/934be95ea6-1775115084/service_image_4-600x-q80.jpg 600w, https://studio-nordost.com/media/pages/start/934be95ea6-1775115084/service_image_4-900x-q80.jpg 900w, https://studio-nordost.com/media/pages/start/934be95ea6-1775115084/service_image_4-1200x-q80.jpg 1200w, https://studio-nordost.com/media/pages/start/934be95ea6-1775115084/service_image_4-2560x-q90.jpg 2560w\" sizes=\"(min-width: 992px) 25vw, (min-width: 768px) 50vw, 100vw\" width=\"1504\" height=\"1398\" >        </picture>\n\n                </div>\n    \n\n                        </div>\n                    \n                    <div class=\"card-content\">\n                        <div class=\"text-wrapper\">\n                            <h3 class=\"h3\">Brand Strategy</h3>\n                            <p class=\"secondary-color small\">The blueprint for a differentiated, relevant & sustainable brand</p>\n                        </div>\n\n                        <span class=\"btn secondary-label more-info\">\n                            <span class=\"plus\">+</span>\n                        </span>\n                    </div>\n\n                </div>\n\n                <div class=\"service-panel\" id=\"service-panel-def96c9d-2cbf-439a-b626-efd5f5d1f21c-0\">\n                    <div class=\"panel-content\">\n                        <div class=\"panel-header\">\n                            <h2>Brand Strategy</h2>\n                            <button class=\"btn secondary secondary-label\" data-service-close>Close</button>\n                        </div>\n\n                        <div class=\"panel-body\" data-lenis-prevent>\n                                                            <span class=\"secondary-label btn tight\">Overview</span>\n                                <div class=\"panel-section small secondary-color\"><p>We distill your complexity into a clear, differentiated position people understand — shaped by customer insight and competitive analysis.</p></div>\n                            \n                            \n                                                                                        <span class=\"secondary-label btn tight\">Benefits</span>\n                                <ul class=\"panel-section\">\n                                                                            <li class=\"small secondary-color\">A relevant, distinct and defensible position</li>\n                                                                            <li class=\"small secondary-color\">A clear offer and aligned decision-making</li>\n                                                                            <li class=\"small secondary-color\">A message that’s easy to understand &amp; remember</li>\n                                                                    </ul>\n                            \n                                                                                        <span class=\"secondary-label btn tight\">Examples</span>\n                                <ul class=\"panel-section\">\n                                                                            <li class=\"small secondary-color\">Customer Research</li>\n                                                                            <li class=\"small secondary-color\">Competitive Analysis</li>\n                                                                            <li class=\"small secondary-color\">Core Brand Message</li>\n                                                                    </ul>\n                                                    </div>\n                    </div>\n\n                </div>\n\n            </div>\n                    <div class=\"col-xs-12 col-lg\">\n                \n                <div class=\"card-wrapper hover\" data-service-card role=\"button\" tabindex=\"0\" aria-haspopup=\"dialog\" aria-expanded=\"false\" aria-controls=\"service-panel-def96c9d-2cbf-439a-b626-efd5f5d1f21c-1\">\n                                                                <div class=\"asset-wrapper\">\n                            \n\n    \n            <div class=\"image-wrapper zoom-in\">\n        \n        <picture>\n            \n            <source srcset=\"https://studio-nordost.com/media/pages/start/cd936cf315-1775114899/service-image-1-300x-q80.webp 300w, https://studio-nordost.com/media/pages/start/cd936cf315-1775114899/service-image-1-600x-q80.webp 600w, https://studio-nordost.com/media/pages/start/cd936cf315-1775114899/service-image-1-900x-q80.webp 900w, https://studio-nordost.com/media/pages/start/cd936cf315-1775114899/service-image-1-1200x-q80.webp 1200w, https://studio-nordost.com/media/pages/start/cd936cf315-1775114899/service-image-1-1800x-q80.webp 1800w, https://studio-nordost.com/media/pages/start/cd936cf315-1775114899/service-image-1-2560x-q90.webp 2560w\" sizes=\"(min-width: 992px) 25vw, (min-width: 768px) 50vw, 100vw\" type=\"image/webp\"><img loading=\"lazy\" alt=\"\" src=\"https://studio-nordost.com/media/pages/start/cd936cf315-1775114899/service-image-1-300x.jpg\" srcset=\"https://studio-nordost.com/media/pages/start/cd936cf315-1775114899/service-image-1-300x-q80.jpg 300w, https://studio-nordost.com/media/pages/start/cd936cf315-1775114899/service-image-1-600x-q80.jpg 600w, https://studio-nordost.com/media/pages/start/cd936cf315-1775114899/service-image-1-900x-q80.jpg 900w, https://studio-nordost.com/media/pages/start/cd936cf315-1775114899/service-image-1-1200x-q80.jpg 1200w, https://studio-nordost.com/media/pages/start/cd936cf315-1775114899/service-image-1-2560x-q90.jpg 2560w\" sizes=\"(min-width: 992px) 25vw, (min-width: 768px) 50vw, 100vw\" width=\"1504\" height=\"1398\" >        </picture>\n\n                </div>\n    \n\n                        </div>\n                    \n                    <div class=\"card-content\">\n                        <div class=\"text-wrapper\">\n                            <h3 class=\"h3\">Visual Identity</h3>\n                            <p class=\"secondary-color small\">The design & motion system people recognize and remember</p>\n                        </div>\n\n                        <span class=\"btn secondary-label more-info\">\n                            <span class=\"plus\">+</span>\n                        </span>\n                    </div>\n\n                </div>\n\n                <div class=\"service-panel\" id=\"service-panel-def96c9d-2cbf-439a-b626-efd5f5d1f21c-1\">\n                    <div class=\"panel-content\">\n                        <div class=\"panel-header\">\n                            <h2>Visual Identity</h2>\n                            <button class=\"btn secondary secondary-label\" data-service-close>Close</button>\n                        </div>\n\n                        <div class=\"panel-body\" data-lenis-prevent>\n                                                            <span class=\"secondary-label btn tight\">Overview</span>\n                                <div class=\"panel-section small secondary-color\"><p>A distinctive design and motion language that builds recognition and trust across every touchpoint.</p></div>\n                            \n                            \n                                                                                        <span class=\"secondary-label btn tight\">Benefits</span>\n                                <ul class=\"panel-section\">\n                                                                            <li class=\"small secondary-color\">Look impressive &amp; consistent across touchpoints</li>\n                                                                            <li class=\"small secondary-color\">Gain trust and recognition over time</li>\n                                                                            <li class=\"small secondary-color\">Clear rules and assets for future work</li>\n                                                                    </ul>\n                            \n                                                                                        <span class=\"secondary-label btn tight\">Examples</span>\n                                <ul class=\"panel-section\">\n                                                                            <li class=\"small secondary-color\">Logo + Visual System (type, color, graphics, layout)</li>\n                                                                            <li class=\"small secondary-color\">Brand Trailer / Launch Video</li>\n                                                                            <li class=\"small secondary-color\">Brand Guidelines &amp; Reusable Assets</li>\n                                                                    </ul>\n                                                    </div>\n                    </div>\n\n                </div>\n\n            </div>\n                    <div class=\"col-xs-12 col-lg\">\n                \n                <div class=\"card-wrapper hover\" data-service-card role=\"button\" tabindex=\"0\" aria-haspopup=\"dialog\" aria-expanded=\"false\" aria-controls=\"service-panel-def96c9d-2cbf-439a-b626-efd5f5d1f21c-2\">\n                                                                <div class=\"asset-wrapper\">\n                            \n\n    \n            <div class=\"image-wrapper zoom-in\">\n        \n        <picture>\n            \n            <source srcset=\"https://studio-nordost.com/media/pages/start/3e395172da-1775114906/service-image-2-300x-q80.webp 300w, https://studio-nordost.com/media/pages/start/3e395172da-1775114906/service-image-2-600x-q80.webp 600w, https://studio-nordost.com/media/pages/start/3e395172da-1775114906/service-image-2-900x-q80.webp 900w, https://studio-nordost.com/media/pages/start/3e395172da-1775114906/service-image-2-1200x-q80.webp 1200w, https://studio-nordost.com/media/pages/start/3e395172da-1775114906/service-image-2-1800x-q80.webp 1800w, https://studio-nordost.com/media/pages/start/3e395172da-1775114906/service-image-2-2560x-q90.webp 2560w\" sizes=\"(min-width: 992px) 25vw, (min-width: 768px) 50vw, 100vw\" type=\"image/webp\"><img loading=\"lazy\" alt=\"\" src=\"https://studio-nordost.com/media/pages/start/3e395172da-1775114906/service-image-2-300x.jpg\" srcset=\"https://studio-nordost.com/media/pages/start/3e395172da-1775114906/service-image-2-300x-q80.jpg 300w, https://studio-nordost.com/media/pages/start/3e395172da-1775114906/service-image-2-600x-q80.jpg 600w, https://studio-nordost.com/media/pages/start/3e395172da-1775114906/service-image-2-900x-q80.jpg 900w, https://studio-nordost.com/media/pages/start/3e395172da-1775114906/service-image-2-1200x-q80.jpg 1200w, https://studio-nordost.com/media/pages/start/3e395172da-1775114906/service-image-2-2560x-q90.jpg 2560w\" sizes=\"(min-width: 992px) 25vw, (min-width: 768px) 50vw, 100vw\" width=\"1504\" height=\"1398\" >        </picture>\n\n                </div>\n    \n\n                        </div>\n                    \n                    <div class=\"card-content\">\n                        <div class=\"text-wrapper\">\n                            <h3 class=\"h3\">Web &amp; UX</h3>\n                            <p class=\"secondary-color small\">They way people experience your brand online</p>\n                        </div>\n\n                        <span class=\"btn secondary-label more-info\">\n                            <span class=\"plus\">+</span>\n                        </span>\n                    </div>\n\n                </div>\n\n                <div class=\"service-panel\" id=\"service-panel-def96c9d-2cbf-439a-b626-efd5f5d1f21c-2\">\n                    <div class=\"panel-content\">\n                        <div class=\"panel-header\">\n                            <h2>Web &amp; UX</h2>\n                            <button class=\"btn secondary secondary-label\" data-service-close>Close</button>\n                        </div>\n\n                        <div class=\"panel-body\" data-lenis-prevent>\n                                                            <span class=\"secondary-label btn tight\">Overview</span>\n                                <div class=\"panel-section small secondary-color\"><p>We plan, design, and build your website end-to-end — from structure and UX to development and launch.</p></div>\n                            \n                            \n                                                                                        <span class=\"secondary-label btn tight\">Benefits</span>\n                                <ul class=\"panel-section\">\n                                                                            <li class=\"small secondary-color\">People find the right information quickly</li>\n                                                                            <li class=\"small secondary-color\">Your offer is easy to understand from the outside</li>\n                                                                            <li class=\"small secondary-color\">Your website feels aligned with the brand</li>\n                                                                    </ul>\n                            \n                                                                                        <span class=\"secondary-label btn tight\">Examples</span>\n                                <ul class=\"panel-section\">\n                                                                            <li class=\"small secondary-color\">User Testing &amp; Analysis</li>\n                                                                            <li class=\"small secondary-color\">Web &amp; UX Design</li>\n                                                                            <li class=\"small secondary-color\">Web Development</li>\n                                                                    </ul>\n                                                    </div>\n                    </div>\n\n                </div>\n\n            </div>\n            </div>\n</div>\n<div  class=\"container sno social-proof color-style-ambient\">\n\n    <div class=\"row headline\">\n        <div class=\"col-xs-12 col-sm-10 col-md-8 col-lg-6\">\n            <h2 class=\"h2\"><p>Clients and Partners</p></h2>\n        </div>\n    </div>\n\n            <div class=\"row entries\">\n            <div class=\"col-xs-12\">\n                <div class=\"testimonial-slider has-multiple\" data-social-proof-slider>\n                                                                    <div class=\"entry active\">\n                            <div class=\"testimonial card-wrapper\">\n                                                                    <div class=\"profile-pic show-sm\">\n                                        \n\n    \n    \n        <picture>\n            \n            <source srcset=\"https://studio-nordost.com/media/pages/start/3e59da0cb8-1775733222/nolita_lobo-300x-q80.webp 300w, https://studio-nordost.com/media/pages/start/3e59da0cb8-1775733222/nolita_lobo-600x-q80.webp 600w, https://studio-nordost.com/media/pages/start/3e59da0cb8-1775733222/nolita_lobo-900x-q80.webp 900w, https://studio-nordost.com/media/pages/start/3e59da0cb8-1775733222/nolita_lobo-1200x-q80.webp 1200w, https://studio-nordost.com/media/pages/start/3e59da0cb8-1775733222/nolita_lobo-1800x-q80.webp 1800w, https://studio-nordost.com/media/pages/start/3e59da0cb8-1775733222/nolita_lobo-2560x-q90.webp 2560w\" sizes=\"(min-width: 992px) 25vw, (min-width: 768px) 50vw, 100vw\" type=\"image/webp\"><img loading=\"lazy\" alt=\"\" src=\"https://studio-nordost.com/media/pages/start/3e59da0cb8-1775733222/nolita_lobo-300x.jpg\" srcset=\"https://studio-nordost.com/media/pages/start/3e59da0cb8-1775733222/nolita_lobo-300x-q80.jpg 300w, https://studio-nordost.com/media/pages/start/3e59da0cb8-1775733222/nolita_lobo-600x-q80.jpg 600w, https://studio-nordost.com/media/pages/start/3e59da0cb8-1775733222/nolita_lobo-900x-q80.jpg 900w, https://studio-nordost.com/media/pages/start/3e59da0cb8-1775733222/nolita_lobo-1200x-q80.jpg 1200w, https://studio-nordost.com/media/pages/start/3e59da0cb8-1775733222/nolita_lobo-2560x-q90.jpg 2560w\" sizes=\"(min-width: 992px) 25vw, (min-width: 768px) 50vw, 100vw\" width=\"360\" height=\"360\" >        </picture>\n\n        \n\n                                    </div>\n                                \n                                <div class=\"testimonial-content\">\n                                                                            <p class=\"inverted btn tight secondary-label\">Partner</p>\n                                    \n                                                                            <h3 class=\"h3\">\"They bring a fresh and unique perspective to design - which is increasingly tough in today’s world with every brand trying to stand out. Aside from their skills, they are extremely personable ‘humans you’d love to work with’.\"</h3>\n                                    \n                                                                            <p class=\"secondary-color show-sm small \">Nolita Lobo, Süd RLC</p>\n\n                                        <div class=\"testimonial-meta hide-sm\">\n                                                                                            <div class=\"profile-pic profile-pic-compact\">\n                                                    \n\n    \n    \n        <picture>\n            \n            <source srcset=\"https://studio-nordost.com/media/pages/start/3e59da0cb8-1775733222/nolita_lobo-300x-q80.webp 300w, https://studio-nordost.com/media/pages/start/3e59da0cb8-1775733222/nolita_lobo-600x-q80.webp 600w, https://studio-nordost.com/media/pages/start/3e59da0cb8-1775733222/nolita_lobo-900x-q80.webp 900w, https://studio-nordost.com/media/pages/start/3e59da0cb8-1775733222/nolita_lobo-1200x-q80.webp 1200w, https://studio-nordost.com/media/pages/start/3e59da0cb8-1775733222/nolita_lobo-1800x-q80.webp 1800w, https://studio-nordost.com/media/pages/start/3e59da0cb8-1775733222/nolita_lobo-2560x-q90.webp 2560w\" sizes=\"(min-width: 992px) 25vw, (min-width: 768px) 50vw, 100vw\" type=\"image/webp\"><img loading=\"lazy\" alt=\"\" src=\"https://studio-nordost.com/media/pages/start/3e59da0cb8-1775733222/nolita_lobo-300x.jpg\" srcset=\"https://studio-nordost.com/media/pages/start/3e59da0cb8-1775733222/nolita_lobo-300x-q80.jpg 300w, https://studio-nordost.com/media/pages/start/3e59da0cb8-1775733222/nolita_lobo-600x-q80.jpg 600w, https://studio-nordost.com/media/pages/start/3e59da0cb8-1775733222/nolita_lobo-900x-q80.jpg 900w, https://studio-nordost.com/media/pages/start/3e59da0cb8-1775733222/nolita_lobo-1200x-q80.jpg 1200w, https://studio-nordost.com/media/pages/start/3e59da0cb8-1775733222/nolita_lobo-2560x-q90.jpg 2560w\" sizes=\"(min-width: 992px) 25vw, (min-width: 768px) 50vw, 100vw\" width=\"360\" height=\"360\" >        </picture>\n\n        \n\n                                                </div>\n                                            \n                                            <p class=\"h2 secondary-color\">Nolita Lobo, Süd RLC</p>\n                                        </div>\n                                                                    </div>\n                            </div>\n                        </div>\n                                                                    <div class=\"entry\">\n                            <div class=\"testimonial card-wrapper\">\n                                                                    <div class=\"profile-pic show-sm\">\n                                        \n\n    \n    \n        <picture>\n            \n            <source srcset=\"https://studio-nordost.com/media/pages/start/2d1125f014-1781593465/maxkickinger-300x-q80.webp 300w, https://studio-nordost.com/media/pages/start/2d1125f014-1781593465/maxkickinger-600x-q80.webp 600w, https://studio-nordost.com/media/pages/start/2d1125f014-1781593465/maxkickinger-900x-q80.webp 900w, https://studio-nordost.com/media/pages/start/2d1125f014-1781593465/maxkickinger-1200x-q80.webp 1200w, https://studio-nordost.com/media/pages/start/2d1125f014-1781593465/maxkickinger-1800x-q80.webp 1800w, https://studio-nordost.com/media/pages/start/2d1125f014-1781593465/maxkickinger-2560x-q90.webp 2560w\" sizes=\"(min-width: 992px) 25vw, (min-width: 768px) 50vw, 100vw\" type=\"image/webp\"><img loading=\"lazy\" alt=\"\" src=\"https://studio-nordost.com/media/pages/start/2d1125f014-1781593465/maxkickinger-300x.jpg\" srcset=\"https://studio-nordost.com/media/pages/start/2d1125f014-1781593465/maxkickinger-300x-q80.jpg 300w, https://studio-nordost.com/media/pages/start/2d1125f014-1781593465/maxkickinger-600x-q80.jpg 600w, https://studio-nordost.com/media/pages/start/2d1125f014-1781593465/maxkickinger-900x-q80.jpg 900w, https://studio-nordost.com/media/pages/start/2d1125f014-1781593465/maxkickinger-1200x-q80.jpg 1200w, https://studio-nordost.com/media/pages/start/2d1125f014-1781593465/maxkickinger-2560x-q90.jpg 2560w\" sizes=\"(min-width: 992px) 25vw, (min-width: 768px) 50vw, 100vw\" width=\"360\" height=\"360\" >        </picture>\n\n        \n\n                                    </div>\n                                \n                                <div class=\"testimonial-content\">\n                                                                            <p class=\"inverted btn tight secondary-label\">Partner</p>\n                                    \n                                                                            <h3 class=\"h3\">\"Usually, wisdom comes with age. But every now and then, youth brings a kind of raw talent to the table that feels every bit as valuable as seniority. Nordost is one of those rare cases. While they're young and fresh in their approach and style, they pair that with maturity you'd normally only expect from decades in the field — all while being some of the nicest people to work with.\"</h3>\n                                    \n                                                                            <p class=\"secondary-color show-sm small \">Max Kickinger, Raven &amp; Finch</p>\n\n                                        <div class=\"testimonial-meta hide-sm\">\n                                                                                            <div class=\"profile-pic profile-pic-compact\">\n                                                    \n\n    \n    \n        <picture>\n            \n            <source srcset=\"https://studio-nordost.com/media/pages/start/2d1125f014-1781593465/maxkickinger-300x-q80.webp 300w, https://studio-nordost.com/media/pages/start/2d1125f014-1781593465/maxkickinger-600x-q80.webp 600w, https://studio-nordost.com/media/pages/start/2d1125f014-1781593465/maxkickinger-900x-q80.webp 900w, https://studio-nordost.com/media/pages/start/2d1125f014-1781593465/maxkickinger-1200x-q80.webp 1200w, https://studio-nordost.com/media/pages/start/2d1125f014-1781593465/maxkickinger-1800x-q80.webp 1800w, https://studio-nordost.com/media/pages/start/2d1125f014-1781593465/maxkickinger-2560x-q90.webp 2560w\" sizes=\"(min-width: 992px) 25vw, (min-width: 768px) 50vw, 100vw\" type=\"image/webp\"><img loading=\"lazy\" alt=\"\" src=\"https://studio-nordost.com/media/pages/start/2d1125f014-1781593465/maxkickinger-300x.jpg\" srcset=\"https://studio-nordost.com/media/pages/start/2d1125f014-1781593465/maxkickinger-300x-q80.jpg 300w, https://studio-nordost.com/media/pages/start/2d1125f014-1781593465/maxkickinger-600x-q80.jpg 600w, https://studio-nordost.com/media/pages/start/2d1125f014-1781593465/maxkickinger-900x-q80.jpg 900w, https://studio-nordost.com/media/pages/start/2d1125f014-1781593465/maxkickinger-1200x-q80.jpg 1200w, https://studio-nordost.com/media/pages/start/2d1125f014-1781593465/maxkickinger-2560x-q90.jpg 2560w\" sizes=\"(min-width: 992px) 25vw, (min-width: 768px) 50vw, 100vw\" width=\"360\" height=\"360\" >        </picture>\n\n        \n\n                                                </div>\n                                            \n                                            <p class=\"h2 secondary-color\">Max Kickinger, Raven &amp; Finch</p>\n                                        </div>\n                                                                    </div>\n                            </div>\n                        </div>\n                                                                    <div class=\"entry\">\n                            <div class=\"testimonial card-wrapper\">\n                                                                    <div class=\"profile-pic show-sm\">\n                                        \n\n    \n    \n        <picture>\n            \n            <source srcset=\"https://studio-nordost.com/media/pages/start/22ae06e544-1775733054/christian_salic-300x-q80.webp 300w, https://studio-nordost.com/media/pages/start/22ae06e544-1775733054/christian_salic-600x-q80.webp 600w, https://studio-nordost.com/media/pages/start/22ae06e544-1775733054/christian_salic-900x-q80.webp 900w, https://studio-nordost.com/media/pages/start/22ae06e544-1775733054/christian_salic-1200x-q80.webp 1200w, https://studio-nordost.com/media/pages/start/22ae06e544-1775733054/christian_salic-1800x-q80.webp 1800w, https://studio-nordost.com/media/pages/start/22ae06e544-1775733054/christian_salic-2560x-q90.webp 2560w\" sizes=\"(min-width: 992px) 25vw, (min-width: 768px) 50vw, 100vw\" type=\"image/webp\"><img loading=\"lazy\" alt=\"\" src=\"https://studio-nordost.com/media/pages/start/22ae06e544-1775733054/christian_salic-300x.jpg\" srcset=\"https://studio-nordost.com/media/pages/start/22ae06e544-1775733054/christian_salic-300x-q80.jpg 300w, https://studio-nordost.com/media/pages/start/22ae06e544-1775733054/christian_salic-600x-q80.jpg 600w, https://studio-nordost.com/media/pages/start/22ae06e544-1775733054/christian_salic-900x-q80.jpg 900w, https://studio-nordost.com/media/pages/start/22ae06e544-1775733054/christian_salic-1200x-q80.jpg 1200w, https://studio-nordost.com/media/pages/start/22ae06e544-1775733054/christian_salic-2560x-q90.jpg 2560w\" sizes=\"(min-width: 992px) 25vw, (min-width: 768px) 50vw, 100vw\" width=\"360\" height=\"360\" >        </picture>\n\n        \n\n                                    </div>\n                                \n                                <div class=\"testimonial-content\">\n                                                                            <p class=\"inverted btn tight secondary-label\">Partner</p>\n                                    \n                                                                            <h3 class=\"h3\">\"Working with SNO means joy and maturity. The joy comes from fresh, user-focused, purposeful design. Their maturity shows in their reliability, strong commitment, and the professional way they handle project constraints.\"</h3>\n                                    \n                                                                            <p class=\"secondary-color show-sm small \">Christian Salić, Salić GmbH</p>\n\n                                        <div class=\"testimonial-meta hide-sm\">\n                                                                                            <div class=\"profile-pic profile-pic-compact\">\n                                                    \n\n    \n    \n        <picture>\n            \n            <source srcset=\"https://studio-nordost.com/media/pages/start/22ae06e544-1775733054/christian_salic-300x-q80.webp 300w, https://studio-nordost.com/media/pages/start/22ae06e544-1775733054/christian_salic-600x-q80.webp 600w, https://studio-nordost.com/media/pages/start/22ae06e544-1775733054/christian_salic-900x-q80.webp 900w, https://studio-nordost.com/media/pages/start/22ae06e544-1775733054/christian_salic-1200x-q80.webp 1200w, https://studio-nordost.com/media/pages/start/22ae06e544-1775733054/christian_salic-1800x-q80.webp 1800w, https://studio-nordost.com/media/pages/start/22ae06e544-1775733054/christian_salic-2560x-q90.webp 2560w\" sizes=\"(min-width: 992px) 25vw, (min-width: 768px) 50vw, 100vw\" type=\"image/webp\"><img loading=\"lazy\" alt=\"\" src=\"https://studio-nordost.com/media/pages/start/22ae06e544-1775733054/christian_salic-300x.jpg\" srcset=\"https://studio-nordost.com/media/pages/start/22ae06e544-1775733054/christian_salic-300x-q80.jpg 300w, https://studio-nordost.com/media/pages/start/22ae06e544-1775733054/christian_salic-600x-q80.jpg 600w, https://studio-nordost.com/media/pages/start/22ae06e544-1775733054/christian_salic-900x-q80.jpg 900w, https://studio-nordost.com/media/pages/start/22ae06e544-1775733054/christian_salic-1200x-q80.jpg 1200w, https://studio-nordost.com/media/pages/start/22ae06e544-1775733054/christian_salic-2560x-q90.jpg 2560w\" sizes=\"(min-width: 992px) 25vw, (min-width: 768px) 50vw, 100vw\" width=\"360\" height=\"360\" >        </picture>\n\n        \n\n                                                </div>\n                                            \n                                            <p class=\"h2 secondary-color\">Christian Salić, Salić GmbH</p>\n                                        </div>\n                                                                    </div>\n                            </div>\n                        </div>\n                                                                    <div class=\"entry\">\n                            <div class=\"testimonial card-wrapper\">\n                                                                    <div class=\"profile-pic show-sm\">\n                                        \n\n    \n    \n        <picture>\n            \n            <source srcset=\"https://studio-nordost.com/media/pages/start/ca639de2ef-1775732608/yu_rong-300x-q80.webp 300w, https://studio-nordost.com/media/pages/start/ca639de2ef-1775732608/yu_rong-600x-q80.webp 600w, https://studio-nordost.com/media/pages/start/ca639de2ef-1775732608/yu_rong-900x-q80.webp 900w, https://studio-nordost.com/media/pages/start/ca639de2ef-1775732608/yu_rong-1200x-q80.webp 1200w, https://studio-nordost.com/media/pages/start/ca639de2ef-1775732608/yu_rong-1800x-q80.webp 1800w, https://studio-nordost.com/media/pages/start/ca639de2ef-1775732608/yu_rong-2560x-q90.webp 2560w\" sizes=\"(min-width: 992px) 25vw, (min-width: 768px) 50vw, 100vw\" type=\"image/webp\"><img loading=\"lazy\" alt=\"\" src=\"https://studio-nordost.com/media/pages/start/ca639de2ef-1775732608/yu_rong-300x.jpg\" srcset=\"https://studio-nordost.com/media/pages/start/ca639de2ef-1775732608/yu_rong-300x-q80.jpg 300w, https://studio-nordost.com/media/pages/start/ca639de2ef-1775732608/yu_rong-600x-q80.jpg 600w, https://studio-nordost.com/media/pages/start/ca639de2ef-1775732608/yu_rong-900x-q80.jpg 900w, https://studio-nordost.com/media/pages/start/ca639de2ef-1775732608/yu_rong-1200x-q80.jpg 1200w, https://studio-nordost.com/media/pages/start/ca639de2ef-1775732608/yu_rong-2560x-q90.jpg 2560w\" sizes=\"(min-width: 992px) 25vw, (min-width: 768px) 50vw, 100vw\" width=\"400\" height=\"400\" >        </picture>\n\n        \n\n                                    </div>\n                                \n                                <div class=\"testimonial-content\">\n                                                                            <p class=\"inverted btn tight secondary-label\">Partner</p>\n                                    \n                                                                            <h3 class=\"h3\">\"Incredibly fast, creative, and thoughtful in the details, which makes the whole process feel smooth, collaborative, and genuinely fun. And a super reliable and easy partner to work with.\"</h3>\n                                    \n                                                                            <p class=\"secondary-color show-sm small \">Yu Rong, CōLab &amp; WestCap</p>\n\n                                        <div class=\"testimonial-meta hide-sm\">\n                                                                                            <div class=\"profile-pic profile-pic-compact\">\n                                                    \n\n    \n    \n        <picture>\n            \n            <source srcset=\"https://studio-nordost.com/media/pages/start/ca639de2ef-1775732608/yu_rong-300x-q80.webp 300w, https://studio-nordost.com/media/pages/start/ca639de2ef-1775732608/yu_rong-600x-q80.webp 600w, https://studio-nordost.com/media/pages/start/ca639de2ef-1775732608/yu_rong-900x-q80.webp 900w, https://studio-nordost.com/media/pages/start/ca639de2ef-1775732608/yu_rong-1200x-q80.webp 1200w, https://studio-nordost.com/media/pages/start/ca639de2ef-1775732608/yu_rong-1800x-q80.webp 1800w, https://studio-nordost.com/media/pages/start/ca639de2ef-1775732608/yu_rong-2560x-q90.webp 2560w\" sizes=\"(min-width: 992px) 25vw, (min-width: 768px) 50vw, 100vw\" type=\"image/webp\"><img loading=\"lazy\" alt=\"\" src=\"https://studio-nordost.com/media/pages/start/ca639de2ef-1775732608/yu_rong-300x.jpg\" srcset=\"https://studio-nordost.com/media/pages/start/ca639de2ef-1775732608/yu_rong-300x-q80.jpg 300w, https://studio-nordost.com/media/pages/start/ca639de2ef-1775732608/yu_rong-600x-q80.jpg 600w, https://studio-nordost.com/media/pages/start/ca639de2ef-1775732608/yu_rong-900x-q80.jpg 900w, https://studio-nordost.com/media/pages/start/ca639de2ef-1775732608/yu_rong-1200x-q80.jpg 1200w, https://studio-nordost.com/media/pages/start/ca639de2ef-1775732608/yu_rong-2560x-q90.jpg 2560w\" sizes=\"(min-width: 992px) 25vw, (min-width: 768px) 50vw, 100vw\" width=\"400\" height=\"400\" >        </picture>\n\n        \n\n                                                </div>\n                                            \n                                            <p class=\"h2 secondary-color\">Yu Rong, CōLab &amp; WestCap</p>\n                                        </div>\n                                                                    </div>\n                            </div>\n                        </div>\n                                                                    <div class=\"entry\">\n                            <div class=\"testimonial card-wrapper\">\n                                                                    <div class=\"profile-pic show-sm\">\n                                        \n\n    \n    \n        <picture>\n            \n            <source srcset=\"https://studio-nordost.com/media/pages/start/c6c349c9bf-1776175442/lukas_radke-300x-q80.webp 300w, https://studio-nordost.com/media/pages/start/c6c349c9bf-1776175442/lukas_radke-600x-q80.webp 600w, https://studio-nordost.com/media/pages/start/c6c349c9bf-1776175442/lukas_radke-900x-q80.webp 900w, https://studio-nordost.com/media/pages/start/c6c349c9bf-1776175442/lukas_radke-1200x-q80.webp 1200w, https://studio-nordost.com/media/pages/start/c6c349c9bf-1776175442/lukas_radke-1800x-q80.webp 1800w, https://studio-nordost.com/media/pages/start/c6c349c9bf-1776175442/lukas_radke-2560x-q90.webp 2560w\" sizes=\"(min-width: 992px) 25vw, (min-width: 768px) 50vw, 100vw\" type=\"image/webp\"><img loading=\"lazy\" alt=\"\" src=\"https://studio-nordost.com/media/pages/start/c6c349c9bf-1776175442/lukas_radke-300x.jpg\" srcset=\"https://studio-nordost.com/media/pages/start/c6c349c9bf-1776175442/lukas_radke-300x-q80.jpg 300w, https://studio-nordost.com/media/pages/start/c6c349c9bf-1776175442/lukas_radke-600x-q80.jpg 600w, https://studio-nordost.com/media/pages/start/c6c349c9bf-1776175442/lukas_radke-900x-q80.jpg 900w, https://studio-nordost.com/media/pages/start/c6c349c9bf-1776175442/lukas_radke-1200x-q80.jpg 1200w, https://studio-nordost.com/media/pages/start/c6c349c9bf-1776175442/lukas_radke-2560x-q90.jpg 2560w\" sizes=\"(min-width: 992px) 25vw, (min-width: 768px) 50vw, 100vw\" width=\"800\" height=\"800\" >        </picture>\n\n        \n\n                                    </div>\n                                \n                                <div class=\"testimonial-content\">\n                                                                            <p class=\"inverted btn tight secondary-label\">Client</p>\n                                    \n                                                                            <h3 class=\"h3\">\"We wanted to stand out in the crowded Swiss startup market. Nordost really impressed us with the depth of their strategic process and the resulting identity will be a real asset as we head into our seed round.\"</h3>\n                                    \n                                                                            <p class=\"secondary-color show-sm small \">Lukas Radtke, Shape.bio</p>\n\n                                        <div class=\"testimonial-meta hide-sm\">\n                                                                                            <div class=\"profile-pic profile-pic-compact\">\n                                                    \n\n    \n    \n        <picture>\n            \n            <source srcset=\"https://studio-nordost.com/media/pages/start/