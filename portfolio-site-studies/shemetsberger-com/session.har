                               <div class=\"profile-pic show-sm\">\n                                        \n\n    \n    \n        <picture>\n            \n            <source srcset=\"https://studio-nordost.com/media/pages/start/2dd51516ad-1775733039/gergor_woeckl-300x-q80.webp 300w, https://studio-nordost.com/media/pages/start/2dd51516ad-1775733039/gergor_woeckl-600x-q80.webp 600w, https://studio-nordost.com/media/pages/start/2dd51516ad-1775733039/gergor_woeckl-900x-q80.webp 900w, https://studio-nordost.com/media/pages/start/2dd51516ad-1775733039/gergor_woeckl-1200x-q80.webp 1200w, https://studio-nordost.com/media/pages/start/2dd51516ad-1775733039/gergor_woeckl-1800x-q80.webp 1800w, https://studio-nordost.com/media/pages/start/2dd51516ad-1775733039/gergor_woeckl-2560x-q90.webp 2560w\" sizes=\"(min-width: 992px) 25vw, (min-width: 768px) 50vw, 100vw\" type=\"image/webp\"><img loading=\"lazy\" alt=\"\" src=\"https://studio-nordost.com/media/pages/start/2dd51516ad-1775733039/gergor_woeckl-300x.jpg\" srcset=\"https://studio-nordost.com/media/pages/start/2dd51516ad-1775733039/gergor_woeckl-300x-q80.jpg 300w, https://studio-nordost.com/media/pages/start/2dd51516ad-1775733039/gergor_woeckl-600x-q80.jpg 600w, https://studio-nordost.com/media/pages/start/2dd51516ad-1775733039/gergor_woeckl-900x-q80.jpg 900w, https://studio-nordost.com/media/pages/start/2dd51516ad-1775733039/gergor_woeckl-1200x-q80.jpg 1200w, https://studio-nordost.com/media/pages/start/2dd51516ad-1775733039/gergor_woeckl-2560x-q90.jpg 2560w\" sizes=\"(min-width: 992px) 25vw, (min-width: 768px) 50vw, 100vw\" width=\"360\" height=\"360\" >        </picture>\n\n        \n\n                                    </div>\n                                \n                                <div class=\"testimonial-content\">\n                                                                            <p class=\"inverted btn tight secondary-label\">Client</p>\n                                    \n                                                                            <h3 class=\"h3\">\"Nordost gave us clear guidance as we refined our brand and came up with an out-of-the-box solution that truly fit our needs. The whole team is super friendly, structured and responsive.\"</h3>\n                                    \n                                                                            <p class=\"secondary-color show-sm small \">Gregor Wöckl, Studio Wöckl</p>\n\n                                        <div class=\"testimonial-meta hide-sm\">\n                                                                                            <div class=\"profile-pic profile-pic-compact\">\n                                                    \n\n    \n    \n        <picture>\n            \n            <source srcset=\"https://studio-nordost.com/media/pages/start/2dd51516ad-1775733039/gergor_woeckl-300x-q80.webp 300w, https://studio-nordost.com/media/pages/start/2dd51516ad-1775733039/gergor_woeckl-600x-q80.webp 600w, https://studio-nordost.com/media/pages/start/2dd51516ad-1775733039/gergor_woeckl-900x-q80.webp 900w, https://studio-nordost.com/media/pages/start/2dd51516ad-1775733039/gergor_woeckl-1200x-q80.webp 1200w, https://studio-nordost.com/media/pages/start/2dd51516ad-1775733039/gergor_woeckl-1800x-q80.webp 1800w, https://studio-nordost.com/media/pages/start/2dd51516ad-1775733039/gergor_woeckl-2560x-q90.webp 2560w\" sizes=\"(min-width: 992px) 25vw, (min-width: 768px) 50vw, 100vw\" type=\"image/webp\"><img loading=\"lazy\" alt=\"\" src=\"https://studio-nordost.com/media/pages/start/2dd51516ad-1775733039/gergor_woeckl-300x.jpg\" srcset=\"https://studio-nordost.com/media/pages/start/2dd51516ad-1775733039/gergor_woeckl-300x-q80.jpg 300w, https://studio-nordost.com/media/pages/start/2dd51516ad-1775733039/gergor_woeckl-600x-q80.jpg 600w, https://studio-nordost.com/media/pages/start/2dd51516ad-1775733039/gergor_woeckl-900x-q80.jpg 900w, https://studio-nordost.com/media/pages/start/2dd51516ad-1775733039/gergor_woeckl-1200x-q80.jpg 1200w, https://studio-nordost.com/media/pages/start/2dd51516ad-1775733039/gergor_woeckl-2560x-q90.jpg 2560w\" sizes=\"(min-width: 992px) 25vw, (min-width: 768px) 50vw, 100vw\" width=\"360\" height=\"360\" >        </picture>\n\n        \n\n                                                </div>\n                                            \n                                            <p class=\"h2 secondary-color\">Gregor Wöckl, Studio Wöckl</p>\n                                        </div>\n                                                                    </div>\n                            </div>\n                        </div>\n                                                                    <div class=\"entry\">\n                            <div class=\"testimonial card-wrapper\">\n                                                                    <div class=\"profile-pic show-sm\">\n                                        \n\n    \n    \n        <picture>\n            \n            <source srcset=\"https://studio-nordost.com/media/pages/start/285b779f12-1776175451/gernot_pompenig-300x-q80.webp 300w, https://studio-nordost.com/media/pages/start/285b779f12-1776175451/gernot_pompenig-600x-q80.webp 600w, https://studio-nordost.com/media/pages/start/285b779f12-1776175451/gernot_pompenig-900x-q80.webp 900w, https://studio-nordost.com/media/pages/start/285b779f12-1776175451/gernot_pompenig-1200x-q80.webp 1200w, https://studio-nordost.com/media/pages/start/285b779f12-1776175451/gernot_pompenig-1800x-q80.webp 1800w, https://studio-nordost.com/media/pages/start/285b779f12-1776175451/gernot_pompenig-2560x-q90.webp 2560w\" sizes=\"(min-width: 992px) 25vw, (min-width: 768px) 50vw, 100vw\" type=\"image/webp\"><img loading=\"lazy\" alt=\"\" src=\"https://studio-nordost.com/media/pages/start/285b779f12-1776175451/gernot_pompenig-300x.jpg\" srcset=\"https://studio-nordost.com/media/pages/start/285b779f12-1776175451/gernot_pompenig-300x-q80.jpg 300w, https://studio-nordost.com/media/pages/start/285b779f12-1776175451/gernot_pompenig-600x-q80.jpg 600w, https://studio-nordost.com/media/pages/start/285b779f12-1776175451/gernot_pompenig-900x-q80.jpg 900w, https://studio-nordost.com/media/pages/start/285b779f12-1776175451/gernot_pompenig-1200x-q80.jpg 1200w, https://studio-nordost.com/media/pages/start/285b779f12-1776175451/gernot_pompenig-2560x-q90.jpg 2560w\" sizes=\"(min-width: 992px) 25vw, (min-width: 768px) 50vw, 100vw\" width=\"800\" height=\"800\" >        </picture>\n\n        \n\n                                    </div>\n                                \n                                <div class=\"testimonial-content\">\n                                                                            <p class=\"inverted btn tight secondary-label\">Partner</p>\n                                    \n                                                                            <h3 class=\"h3\">\"Ease, professionalism, charm, perfection. If I had to put it in one sentence: a highly inspiring collaboration at a very high level — deeply in tune with the times, and meticulous and well-grounded in every detail.\"</h3>\n                                    \n                                                                            <p class=\"secondary-color show-sm small \">Gernot Pompenig, Merlicek &amp; Partner</p>\n\n                                        <div class=\"testimonial-meta hide-sm\">\n                                                                                            <div class=\"profile-pic profile-pic-compact\">\n                                                    \n\n    \n    \n        <picture>\n            \n            <source srcset=\"https://studio-nordost.com/media/pages/start/285b779f12-1776175451/gernot_pompenig-300x-q80.webp 300w, https://studio-nordost.com/media/pages/start/285b779f12-1776175451/gernot_pompenig-600x-q80.webp 600w, https://studio-nordost.com/me