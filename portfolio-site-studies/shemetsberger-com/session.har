                 <a\n                                class=\"menu-item primary small\"\n                                href=\"https://studio-nordost.com/contact-us\"\n                                >\n                                Contact                            </a>\n                                            </div>\n                </div>\n            </div>\n        </nav>\n<div class=\"container sno value-proposition color-style-ambient\">\n    <div class=\"row center-sm\">\n        <div class=\"col-xs-12\">\n            <h1 class=\"hero\"><p><strong>Nordost is a design studio</strong> that helps ambitious brands leave lasting impressions.</p></h1>\n        </div>\n    </div>\n</div>\n\n\n<div  class=\"container sno featured-projects color-style-ambient\">\n\n    \n    <div class=\"row\">\n\n        \n                    <a href=\"https://studio-nordost.com/work/viiala\" class=\"col-xs-12 col-sm\">\n                                    \n\n    \n            <div class=\"image-wrapper zoom-in\">\n    \n    <div class=\"lazy-video-wrapper\" data-width-desktop=\"864\" data-height-desktop=\"1080\" data-width-mobile=\"864\" data-height-mobile=\"1080\" data-scr-mp4-mobile=\"https://studio-nordost.com/media/pages/work/viiala/8f0cbda78a-1780994421/viialla-motion-mockup-1080p.mp4\" data-scr-webm-mobile=\"https://studio-nordost.com/media/pages/work/viiala/c7f3e3e772-1780994427/viialla-motion-mockup-1080p.webm\" data-scr-poster=\"https://studio-nordost.com/dist/video/viialla-motion-mockup-1080p-poster.webp\"        >\n        <video poster=\"https://studio-nordost.com/dist/video/viialla-motion-mockup-1080p-poster.webp\" autoplay loop webkit-playsinline playsinline muted class=\"lazy muted\"></video>\n\n            </div>\n\n            </div>\n    \n                \n                <p class=\"project-title\">Viiala AG                </p>\n\n                                    <p class=\"tagline\">\n                        Swiss Mobility Startup                    </p>\n                \n                \n                                    <div class=\"service-wrapper\">\n                                                    <span class=\"secondary-label btn tight secondary-color\">\n                                Brand Identity                            </span>\n                                                    <span class=\"secondary-label btn tight secondary-color\">\n                                Website                            </span>\n                                                    <span class=\"secondary-label btn tight secondary-color\">\n                                Brand Strategy                            </span>\n                                            </div>\n                            </a>\n                    <a href=\"https://studio-nordost.com/work/fortschritts-kompass\" class=\"col-xs-12 col-sm\">\n                                    \n\n    \n            <div class=\"image-wrapper zoom-in\">\n        \n        <picture>\n            \n            <source srcset=\"https://studio-nordost.com/media/pages/work/fortschritts-kompass/ab3d6119dc-1750848146/fk_thumbnail_hf-300x-q80.webp 300w, https://studio-nordost.com/media/pages/work/fortschritts-kompass/ab3d6119dc-1750848146/fk_thumbnail_hf-600x-q80.webp 600w, https://studio-nordost.com/media/pages/work/fortschritts-kompass/ab3d6119dc-1750848146/fk_thumbnail_hf-900x-q80.webp 900w, https://studio-nordost.com/media/pages/work/fortschritts-kompass/ab3d6119dc-1750848146/fk_thumbnail_hf-1200x-q80.webp 1200w, https://studio-nordost.com/media/pages/work/fortschritts-kompass/ab3d6119dc-1750848146/fk_thumbnail_hf-1800x-q80.webp 1800w, https://studio-nordost.com/media/pages/work/fortschritts-kompass/ab3d6119dc-1750848146/fk_thumbnail_hf-2560x-q90.webp 2560w\" sizes=\"(min-width: 992px) 25vw, (min-width: 768px) 50vw, 100vw\" type=\"image/webp\"><img loading=\"lazy\" alt=\"\" src=\"https://studio-nordost.com/media/pages/work/fortschritts-kompass/ab3d6119dc-1750848146/fk_thumbnail_hf-300x.jpg\" srcset=\"https://studio-nordost.com/media/pages/work/fortschritts-kompass/ab3d6119dc-1750848146/fk_thumbnail_hf-300x-q80.jpg 300w, https://studio-nordost.com/media/pages/work/fortschritts-kompass/ab3d6119dc-1750848146/fk_thumbnail_hf-600x-q80.jpg 600w, https://studio-nordost.com/media/pages/work/fortschritts-kompass/ab3d6119dc-1750848146/fk_thumbnail_hf-900x-q80.jpg 900w, https://studio-nordost.com/media/pages/work/fortschritts-kompass/ab3d6119dc-1750848146/fk_thumbnail_hf-1200x-q80.jpg 1200w, https://studio-nordost.com/media/pages/work/fortschritts-kompass/ab3d6119dc-1750848146/fk_thumbnail_hf-2560x-q90.jpg 2560w\" sizes=\"(min-width: 992px) 25vw, (min-width: 768px) 50vw, 100vw\" width=\"1080\" height=\"1364\" >        </picture>\n\n                </div>\n    \n\n                \n                <p class=\"project-title\">Stadt Salzburg                </p>\n\n                                    <p class=\"tagline\">\n                        Platform for Citizens                    </p>\n                \n                \n                                    <div class=\"service-wrapper\">\n                                                    <span class=\"secondary-label btn tight secondary-color\">\n                                Website                            </span>\n                                            </div>\n                            </a>\n                    <a href=\"https://studio-nordost.com/work/olento\" class=\"col-xs-12 col-sm\">\n                                    \n\n    \n            <div class=\"image-wrapper zoom-in\">\n    \n    <div class=\"lazy-video-wrapper\" data-width-desktop=\"864\" data-height-desktop=\"1080\" data-width-mobile=\"864\" data-height-mobile=\"1080\" data-scr-mp4-mobile=\"https://studio-nordost.com/media/pages/work/olento/9848ceaa80-1780994446/olento-motion-mockup-1080p-sq.mp4\" data-scr-webm-mobile=\"https://studio-nordost.com/media/pages/work/olento/9a6b2554d1-1780994454