            "text": "\n<!DOCTYPE html>\n<html>\n\n<head>\n\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width,initial-scale=1.0\">\n\n    \n<title>Design Studio &ndash; Studio Nordost</title>\n<meta name=\"description\" content=\"Studio Nordost is a design studio that helps ambitious brands leave lasting impressions.\">\n<link rel=\"canonical\" href=\"https://studio-nordost.com\">\n<meta name=\"robots\" content=\"index, follow\">\n\n<!-- Open Graph -->\n<meta property=\"og:title\" content=\"Design Studio &ndash; Studio Nordost\">\n<meta property=\"og:description\" content=\"Studio Nordost is a design studio that helps ambitious brands leave lasting impressions.\">\n<meta property=\"og:url\" content=\"https://studio-nordost.com\">\n<meta property=\"og:type\" content=\"website\">\n    <meta property=\"og:image\" content=\"https://studio-nordost.com/media/site/7df62852e8-1770731360/nordost-og.jpg\">\n\n<!-- Twitter Card -->\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<meta name=\"twitter:title\" content=\"Design Studio &ndash; Studio Nordost\">\n<meta name=\"twitter:description\" content=\"Studio Nordost is a design studio that helps ambitious brands leave lasting impressions.\">\n    <meta name=\"twitter:image\" content=\"https://studio-nordost.com/media/site/7df62852e8-1770731360/nordost-og.jpg\">\n\n\n\n        <link href=\"https://studio-nordost.com/dist/css/frontend.css?v=1781594146\" rel=\"stylesheet\">    <script src=\"https://studio-nordost.com/dist/js/frontend.js?v=1781594146\"></script>\n\n    <link rel=\"shortcut icon\" type=\"image/x-icon\" href=\"https://studio-nordost.com/favicon.ico\">\n\n    <!-- Matomo Tag Manager -->\n    <script matomo-tag-manager>\n        var _mtm = window._mtm = window._mtm || [];\n        _mtm.push({\n            'mtm.startTime': (new Date().getTime()),\n            'event': 'mtm.Start'\n        });\n        (function() {\n            var d = document,\n                g = d.createElement('script'),\n                s = d.getElementsByTagName('script')[0];\n            g.async = true;\n            g.src = 'https://analytics.studio-nordost.com/js/container_5GmB9neS.js';\n            s.parentNode.insertBefore(g, s);\n        })();\n    </script>\n    <!-- End Matomo Tag Manager -->\n\n</head>\n\n<body>\n\n    <noscript>\n        <div class=\"container fluid\">\n            <div class=\"row\">\n                <div class=\"col-xs-12\">\n                    <p style=\"margin-top: 16px; font-size: 4rem;\">You should enable Javascript to be able to browse this site correctly. No shady business, just pretty projects. Big promise! 🤞🏻</p>\n                </div>\n            </div>\n        </div>\n\n        <style>\n            img {\n                opacity: 1 !important;\n            }\n        </style>\n    </noscript>\n\n    <div class=\"cursor\">\n        <span class=\"cursor-activate-sound secondary-label\">Activate Sound</span>\n        <span class=\"cursor-featured-project secondary-label\">View Project</span>\n        <span class=\"cursor-filter-project secondary-label\">Filter</span>\n        <span class=\"cursor-general-email secondary-label\">Nice to meet you!</span>\n        <span class=\"cursor-serivce-details secondary-label\">Learn more</span>\n        <span class=\"cursor-lets-talk secondary-label\">👀</span>\n        <span class=\"cursor-error-404 secondary-label\">Back to Home</span>\n        <span class=\"cursor-testimonial secondary-label\">Next</span>\n    </div>\n\n    <div id=\"swup\" class=\"transition-fade\">\n\n        \n        \n        <nav class=\"container main-nav color-style-ambient\" aria-label=\"Primary\">\n            <div class=\"row\">\n                <div class=\"col-xs-12 col-sm-8\">\n                    <div class=\"main-nav-wrapper\">\n                        <div class=\"brand-visual-wrapper\">\n                            <a class=\"brand-visual\" href=\"https://studio-nordost.com\" aria-label=\"Stu