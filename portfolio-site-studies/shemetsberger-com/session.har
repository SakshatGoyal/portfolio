\"start\":[],\"end\":[]},\"wrapperStyles\":{\"xl\":[],\"md\":[]}},\"content_v3zwetab2\":{\"content\":{\"xl\":{\"items\":{\"accordion_default1\":{\"title\":\"\\u003Cspan\\u003EMore\\u003C/span\\u003E\",\"content\":{\"accordion-content_m8r79j1j8\":{\"html\":\"\\u003Cdiv\\u003E\\u003Cdiv\\u003E\\u003Cspan style=\\\"color: rgb(230, 230, 230);\\\"\\u003EIndependently and at Studio Nordost, I\\u2019ve led and contributed to projects for clients including Viiala\\u003Cspan style=\\\"color: rgb(127, 127, 127);\\\"\\u003E (co-founded by former Audemars Piguet CEO Fran\\u00e7ois-Henri Bennahmias and former Stromer co-CEO Tomi Viiala)\\u003C/span\\u003E, Stadt Salzburg, and Tapestry Energy \\u003Cspan style=\\\"color: rgb(127, 127, 127);\\\"\\u003E(part of X, formerly Google X)\\u003C/span\\u003E.&nbsp;\\u003C/span\\u003E\\u003C/div\\u003E\\u003Cdiv\\u003E&nbsp;\\u003C/div\\u003E\\u003Cdiv\\u003E\\u003Cspan style=\\\"color: rgb(230, 230, 230);\\\"\\u003EAs a team, we frequently collaborate with partners including CoLab, S\\u00fcd RLC, Sali\\u0107, Merlicek &amp; Partner, and Raven &amp; Finch.\\u003C/span\\u003E\\u003C/div\\u003E\\u003Cdiv\\u003E&nbsp;\\u003C/div\\u003E\\u003Cdiv\\u003E\\u003Cspan style=\\\"color: rgb(230, 230, 230);\\\"\\u003EOur work has received recognition from Awwwards, TDC Young Ones, the ADC Talent Award, and CCA Venus.\\u003C/span\\u003E\\u003C/div\\u003E\\u003C/div\\u003E\",\"type\":\"text\"}}}},\"order\":[\"accordion_default1\"]}},\"module\":\"accordion\",\"options\":{\"bg_color\":\"#00000000\",\"padding_ver\":\"0.4444444444444444rem\",\"title_font_size\":\"0.8888888888888888rem\",\"title_line_height\":\"1.3333333333333333rem\",\"title_letter_spacing\":\"-0.022222222222222223rem\",\"title_right_spacing\":\"1.7777777777777777rem\",\"title_color\":\"#E6E6E6\",\"title_font_family\":\"font_q7il9b6yr\",\"description_spacing\":\"0.8888888888888888rem\",\"content_spacing\":\"1.3333333333333333rem\",\"description_color\":\"#7F7F7F\",\"description_font_family