            "text": "<!DOCTYPE html>\n<html lang=\"en\">\n    <head>\n        <meta charset=\"UTF-8\" />\n\n        <link rel=\"apple-touch-icon\" sizes=\"180x180\" href=\"/apple-touch-icon.png\">\n        <link rel=\"icon\" type=\"image/png\" sizes=\"32x32\" href=\"/favicon-32x32.png\">\n        <link rel=\"icon\" type=\"image/png\" sizes=\"16x16\" href=\"/favicon-16x16.png\">\n        <link rel=\"manifest\" href=\"/site.webmanifest\">\n        <meta name=\"msapplication-TileColor\" content=\"#ffffff\">\n        <meta name=\"theme-color\" content=\"#ffffff\">\n\n        <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n\n        <title>Karina Sirqueira</title>\n        <meta name=\"description\" content=\"I&#x27;m Karina Sirqueira, a Brazilian designer at Work&amp;Co in Brooklyn.\" />\n\n        <meta property=\"og:title\" content=\"Karina Sirqueira\" />\n        <meta property=\"og:image\" content=\"https://images.prismic.io/karina-sirqueira/58ff0832-15aa-41d6-b5e7-f0901a3fb253_Open+Graph.png?auto&#x3D;compress,format\" />\n        <meta property=\"og:description\" content=\"I&#x27;m Karina Sirqueira, a Brazilian designer at Work&amp;Co in Brooklyn.\" />\n\n        <meta name=\"twitter:card\" content=\"summary_large_image\" />\n        <meta name=\"twitter:title\" content=\"Karina Sirqueira\" />\n        <meta name=\"twitter:description\" content=\"I&#x27;m Karina Sirqueira, a Brazilian designer at Work&amp;Co in Brooklyn.\" />\n        <meta name=\"twitter:image:src\" content=\"https://images.prismic.io/karina-sirqueira/58ff0832-15aa-41d6-b5e7-f0901a3fb253_Open+Graph.png?auto&#x3D;compress,format\" />\n      <script type=\"module\" crossorigin src=\"/assets/main.c1f6367f.js\"></script>\n      <link rel=\"stylesheet\" href=\"/assets/main.d00e416c.css\">\n    <link rel=\"manifest\" href=\"/manifest.webmanifest\"></head>\n    <body>\n        <div class=\"app\" data-template=\"project\">\n                <section class=\"project\" id=\"wwc\" style=\"background: #cdcccc;\">\n                    <div class=\"project__wrapper\">\n                        <a class=\"project__close\" href=\"/\">\n                            <span class=\"project__close__icon\"></span> Back to Home\n                        </a>\n            \n                        <button class=\"project__button project__button--previous\">\n                            <svg class=\"project__button__arrow\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\">\n                                <use xlink:href=\"#arrow-left\" />\n                            </svg>\n                        </button>\n            \n                        <button class=\"project__button project__button--next\">\n                            <svg class=\"project__button__arrow\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\">\n                                <use xlink:href=\"#arrow-right\" />\n                            </svg>\n                        </button>\n            \n                        <div class=\"project__content\">\n                            <header class=\"project__header\">\n                                <div class=\"project__header__wrapper\">\n                                    <h1 class=\"project__header__title\">\n                                        WWC\n            \n                                        <img\n                                            alt=\"WWC\"\n                                            class=\"project__header__image\"\n                                            data-src=\"https://karina-sirqueira.cdn.prismic.io/karina-sirqueira/d828fa72-c8be-4084-bda0-0caf4bd4ff7f_wwc.svg\"\n                                            src=\"https://karina-sirqueira.cdn.prismic.io/karina-sirqueira/d828fa72-c8be-4084-bda0-0caf4bd4ff7f_wwc.svg\"\n                                        >\n                                    </h1>\n                                </div>\n                            </header>\n            \n                            <div class=\"project__sections\">\n                                <div class=\"project__sections__header\">\n                                    <p class=\"project__sections__header__title\">\n                                        <span class=\"project__sections__header__title__text\">\n                                            WWC\n                                        </span>\n                                    </p>\n                                </div>\n            \n                                    <div class=\"project__sections__section \">\n                                        <div class=\"project__sections__section__wrapper\">\n                                                <article class=\"project__sections__media\">\n                                                        <div class=\"project__sections__media__description\" data-media>\n                                                            <p data-description>Generative World Cup 2019. My friend Zeh invited me to be part of this amazing project and use my design skills to bring attention to the Women&#39;s World Cup. This website automatically generates beautiful game summary posters based on key stats and scores.</p>\n                                                        </div>\n            \n                                                    <div class=\"project__sections__media__wrapper\" data-media>\n                                                        <div class=\"project__sections__media__gallery project__sections__media__gallery--1\">\n                                                                    <figure class=\"project__sections__media__item\">\n                                                                            <img alt=\"\" class=\"project__sections__media__item__image\" data-src=\"https://images.prismic.io/karina-sirqueira/b930d799-21b6-446b-a58c-8f53b1eb46a7_01.jpg?auto&#x3D;compress,format\">\n            \n                                                                    </figure>\n                                                        </div>\n                                                    </div>\n                                                </article>\n            \n            \n                                        </div>\n                                    </div>\n                                    <div class=\"project__sections__section \">\n                                        <div class=\"project__sections__section__wrapper\">\n                                                <article class=\"project__sections__media\">\n            \n                                                    <div class=\"project__sections__media__wrapper\" data-media>\n                                                        <div class=\"project__sections__media__gallery project__sections__media__gallery--1\">\n                                                                    <figure class=\"project__sections__media__item\">\n                                                                            <img alt=\"\" class=\"project__sections__media__item__image\" data-src=\"https://images.prismic.io/karina-sirqueira/d7c8854b-cdfc-4230-80a9-97d97393328a_02.jpg?auto&#x3D;compress,format\">\n            \n                                                                    </figure>\n                                                        </div>\n                                                    </div>\n                                                </article>\n            \n            \n                                        </div>\n                                    </div>\n                                    <div class=\"project__sections__section \">\n                                        <div class=\"project__sections__section__wrapper\">\n                                                <article class=\"project__sections__media\">\n            \n                                                    <div class=\"project__sections__media__wrapper\" data-media>\n                                                        <div class=\"project__sections__media__gallery project__sections__media__gallery--2\">\n                                                                    <figure class=\"project__sections__media__item\">\n                                                                            <img alt=\"\" class=\"project__sections__media__item__image\" data-src=\"https://images.prismic.io/karina-sirqueira/e7bb9330-bd92-41f9-856b-d4aac6cf642d_03.jpg?auto&#x3D;compress,format\">\n            \n                                                                    </figure>\n                                                                    <figure class=\"project__sections__media__item\">\n                                                                            <img alt=\"\" class=\"project__sections__media__item__image\" data-src=\"https://images.prismic.io/karina-sirqueira/8ee6c7fc-47b1-4912-a501-0c110e0b2d08_04.jpg?auto&#x3D;compress,format\">\n            \n                                                                    </figure>\n                                                        </div>\n                                                    </div>\n                                                </article>\n            \n            \n                                        </div>\n                                    </div>\n                                    <div class=\"project__sections__section \">\n                                        <div class=\"project__sections__section__wrapper\">\n                                                <article class=\"project__sections__media\">\n            \n                                                    <div class=\"project__sections__media__wrapper\" data-media>\n                                                        <div class=\"project__sections__media__gallery project__sections__media__gallery--2\">\n                                                                    <figure class=\"project__sections__media__item\">\n                                                                            <img alt=\"\" class=\"project__sections__media__item__image\" data-src=\"https://images.prismic.io/karina-sirqueira/c006ca21-6693-4567-8ae8-7f5a957793b3_05.jpg?auto&#x3D;compress,format\">\n            \n                                                                    </figure>\n                                                                    <figure class=\"project__sections__media__item\">\n                                                                            <img alt=\"\" class=\"project__sections__media__item__image\" data-src=\"https://images.prismic.io/karina-sirqueira/816c41cb-7b47-4bd1-b624-0e7bd6b1808c_06.jpg?auto&#x3D;compress,format\">\n            \n                                                                    </figure>\n                                                        </div>\n                                                    </div>\n                                                </article>\n            \n            \n                                        </div>\n                                    </div>\n                                    <div class=\"project__sections__section \">\n                                        <div class=\"project__sections__section__wrapper\">\n                                                <article class=\"project__sections__media\">\n            \n                                                    <div class=\"project__sections__media__wrapper\" data-media>\n                                                        <div class=\"project__sections__media__gallery project__sections__media__gallery--2\">\n                                                                    <figure class=\"project__sections__media__item\">\n                                 