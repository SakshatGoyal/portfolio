            "text": "<!DOCTYPE html>\n<html lang=\"en\">\n    <head>\n        <meta charset=\"UTF-8\" />\n\n        <link rel=\"apple-touch-icon\" sizes=\"180x180\" href=\"/apple-touch-icon.png\">\n        <link rel=\"icon\" type=\"image/png\" sizes=\"32x32\" href=\"/favicon-32x32.png\">\n        <link rel=\"icon\" type=\"image/png\" sizes=\"16x16\" href=\"/favicon-16x16.png\">\n        <link rel=\"manifest\" href=\"/site.webmanifest\">\n        <meta name=\"msapplication-TileColor\" content=\"#ffffff\">\n        <meta name=\"theme-color\" content=\"#ffffff\">\n\n        <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n\n        <title>Karina Sirqueira</title>\n        <meta name=\"description\" content=\"I&#x27;m Karina Sirqueira, a Brazilian designer at Work&amp;Co in Brooklyn.\" />\n\n        <meta property=\"og:title\" content=\"Karina Sirqueira\" />\n        <meta property=\"og:image\" content=\"https://images.prismic.io/karina-sirqueira/58ff0832-15aa-41d6-b5e7-f0901a3fb253_Open+Graph.png?auto&#x3D;compress,format\" />\n        <meta property=\"og:description\" content=\"I&#x27;m Karina Sirqueira, a Brazilian designer at Work&amp;Co in Brooklyn.\" />\n\n        <meta name=\"twitter:card\" content=\"summary_large_image\" />\n        <meta name=\"twitter:title\" content=\"Karina Sirqueira\" />\n        <meta name=\"twitter:description\" content=\"I&#x27;m Karina Sirqueira, a Brazilian designer at Work&amp;Co in Brooklyn.\" />\n        <meta name=\"twitter:image:src\" content=\"https://images.prismic.io/karina-sirqueira/58ff0832-15aa-41d6-b5e7-f0901a3fb253_Open+Graph.png?auto&#x3D;compress,format\" />\n      <script type=\"module\" crossorigin src=\"/assets/main.c1f6367f.js\"></script>\n      <link rel=\"stylesheet\" href=\"/assets/main.d00e416c.css\">\n    <link rel=\"manifest\" href=\"/manifest.webmanifest\"></head>\n    <body>\n        <div class=\"app\" data-template=\"project\">\n                <section class=\"project\" id=\"airbnb\" style=\"background: #FF385C;\">\n                    <div class=\"project__wrapper\">\n                        <a class=\"project__close\" href=\"/\">\n                            <span class=\"project__close__icon\"></span> Back to Home\n                        </a>\n            \n                        <button class=\"project__button project__button--previous\">\n                            <svg class=\"project__button__arrow\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\">\n                                <use xlink:href=\"#arrow-left\" />\n                            </svg>\n                        </button>\n            \n                        <button class=\"project__button project__button--next\">\n                            <svg class=\"project__button__arrow\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\">\n                                <use xlink:href=\"#arrow-right\" />\n                            </svg>\n                        </button>\n            \n                        <div class=\"project__content\">\n                            <header class=\"project__header\">\n                                <div class=\"project__header__wrapper\">\n                                    <h1 class=\"project__header__title\">\n                                        Airbnb\n            \n                                        <img\n                                            alt=\"Airbnb\"\n                                            class=\"project__header__image\"\n                                            data-src=\"https://karina-sirqueira.cdn.prismic.io/karina-sirqueira/aCUCLSdWJ-7kSILf_Airbnb.svg\"\n                                            src=\"https://karina-sirqueira.cdn.prismic.io/karina-sirqueira/aCUCLSdWJ-7kSILf_Airbnb.svg\"\n                                        >\n                                    </h1>\n                                </div>\n                            </header>\n            \n                            <div class=\"project__sections\">\n                                <div class=\"project__sections__header\">\n                                    <p class=\"project__sections__header__title\">\n                                        <span class=\"project__sections__header__title__text\">\n                                            Airbnb\n                                        </span>\n                                    </p>\n                                </div>\n            \n                                    <div class=\"project__sections__section \">\n                                        <div class=\"project__sections__section__wrapper\">\n            \n                                                <article class=\"project__sections__content\">\n                                                    <div class=\"project__sections__content__wrapper\">\n                                                            <div class=\"project__sections__content__description\">\n                                                                <h1 data-title>At Airbnb, I’ve worked on some meaningful tools for hosts and guests—designing features like smartlock integration, collaborative trip planning, and smarter navigation to make the experience more seamless and intuitive.</h1>\n                                                            </div>\n                                                    </div>\n                                                </article>\n            \n                                        </div>\n                                    </div>\n                                    <div class=\"project__sections__section \">\n                                        <div class=\"project__sections__section__wrapper\">\n                                                <article class=\"project__sections__media\">\n            \n                                                    <div class=\"project__sections__media__wrapper\" data-media>\n                                                        <div class=\"project__sections__media__gallery project__sections__media__gallery--3\">\n                                                                    <figure class=\"project__sections__media__item\">\n                                                                            <img alt=\"\" class=\"project__sections__media__item__image\" data-src=\"https://images.prismic.io/karina-sirqueira/aCT8hSdWJ-7kSIJd_Smartlock2.png?auto&#x3D;format,compress?auto&#x3D;compress,format\">\n            \n                                                                    </figure>\n                                                                    <figure class=\"project__sections__media__item\">\n                                                                            <img alt=\"\" class=\"project__sections__media__item__image\" data-src=\"https://images.prismic.io/karina-sirqueira/aCT9DidWJ-7kSIJv_Project02.png?auto&#x3D;format,compress?auto&#x3D;compress,format\">\n            \n                                                                    </figure>\n                                                                    <figure class=\"project__sections__media__item\">\n                                                                            <img alt=\"\" class=\"project__sections__media__item__image\" data-src=\"https://images.prismic.io/karina-sirqueira/aCT8fydWJ-7kSIJX_NativeMenu-Experienced.png?auto&#x3D;format,compress?auto&#x3D;compress,format\">\n            \n                                                                    </figure>\n                                                        </div>\n                                                    </div>\n                                                </article>\n            \n            \n                                        </div>\n                                    </div>\n                                    <div class=\"project__sections__section \">\n                                        <div class=\"project__sections__section__wrapper\">\n            \n                                                <article class=\"project__sections__content\">\n                                                    <div class=\"project__sections__content__wrapper\">\n                                                            <div class=\"project__sections__content__description\">\n                                                                <h1 data-title>Smartlock integration<br /><br />Made it easier for hosts to manage check-ins by integrating smartlocks directly into Airbnb.</h1>\n                                                            </div>\n                                                    </div>\n                                                </article>\n            \n                                        </div>\n                                    </div>\n                                    <div class=\"project__sections__section \">\n                                        <div class=\"project__sections__section__wrapper\">\n                                                <article class=\"project__sections__media\">\n                                                        <div class=\"project__sections__media__description\" data-media>\n                                                            <p data-description>Setup your lock and don&#39;t worry about sending new door codes anymore</p>\n                                                        </div>\n            \n                                                    <div class=\"project__sections__media__wrapper\" data-media>\n                                                        <div class=\"project__sections__media__gallery project__sections__media__gallery--3\">\n                                                                    <figure class=\"project__sections__media__item\">\n                                                                            <img alt=\"\" class=\"project__sections__media__item__image\" data-src=\"https://images.prismic.io/karina-sirqueira/aCT8gydWJ-7kSIJb_Smartlock1.png?auto&#x3D;format,compress?auto&#x3D;compress,format\">\n            \n                                                                    </figure>\n                                                                    <figure class=\"project__sections__media__item\">\n                                                                            <img alt=\"\" class=\"project__sections__media__item__image\" data-src=\"https://images.prismic.io/karina-sirqueira/aCT8hSdWJ-7kSIJd_Smartlock2.png?auto&#x3D;format,compress?auto&#x3D;compress,format\">\n            \n                                                                    </figure>\n                                                                    <figure class=\"project__sections__media__item\">\n                                                                            <img alt=\"\" class=\"project__sections__media__item__image\" data-src=\"https://images.prismic.io/karina-sirqueira/aCT8hCdWJ-7kSIJc_Smartlock3.png?auto&#x3D;format,compress?auto&#x3D;compress,format\">\n            \n                                                                    </figure>\n                                                        </div>\n                                                    </div>\n                                                </article>\n            \n            \n                                        </div>\n                                    </div>\n                                    <div class=\"project__sections__section \">\n                                        <div class=\"project__sections__section__wrapper\">\n                                                <article class=\"project__sections__media\">\n            \n                                                    <div class=\"project__sections__media__wrapper\" data-media>\n                                                        <div class=\"project__sections__media__gallery project__sections__media__gallery--1\">\n                                                                    <figure class=\"project__sections__media__item\">\n            \n                                                                            <video autoplay class=\"project__sections__media__item__video\" data-src=\"https://karina-sirqueira.cdn.prismic.io/karina-sirqueira/aCT8kCdWJ-7kSIJi_AirKey-NewHost-SetupFull.mp4\" loop muted playsinline></video>\n                                                                    </figure>\n                                                        </div>\n                                                    </div>\n                                                </article>\n            \n            \n                                        </div>\n                                    </div>\n                                    <div class=\"project__sections__section \">\n                                        <div class=\"project__sections__section__wrapper\">\n            \n                                                <article class=\"project__sections__content\">\n                                                    <div class=\"project__sections__content__wrapper\">\n                                                            <div class=\"project__sections__content__description\">\n                                                                <h1 data-title>Collaborative Wishlists <br /><br />Helped redesign Wishlists so friends can plan trips together. now they can invite, explore, and decide as a group.</h1>\n                                                            </div>\n                                                    </div>\n                                                </article>\n            \n                                        </div>\n                                    </div>\n                                    <div class=\"project__sections__section \">\n                                        <div class=\"project__sections__section__wrapper\">\n                                                <article class=\"project__sections__media\">\n            \n                                                    <div class=\"project__sections__media__wrapper\" data-media>\n                                                        <div class=\"project__sections__media__gallery project__sections__media__gallery--3\">\n                                                                    <figure class=\"project__sections__media__item\">\n                                                                            <img alt=\"\" class=\"project__sections__media__item__image\" data-src=\"https://images.prismic.io/karina-sirqueira/aCT8hidWJ-7kSIJe_Wishlist01.png?auto&#x3D;format,compress?auto&#x3D;compress,format\">\n            \n                                                                    </figure>\n                                                                    <figure class=\"project__sections__media__item\">\n                                                                            <img alt=\"\" class=\"project__sections__media__item__image\" data-src=\"https://images.prismic.io/karina-sirqueira/aCT8iCdWJ-7kSIJg_Wishlist02.png?auto&#x3D;format,compress?auto&#x3D;compress,format\">\n            \n                                                                    </figure>\n                                                                    <figure class=\"project__sections__media__item\">\n                                                                            <img alt=\"\" class=\"project__sections__media__item__image\" data-src=\"https://images.prismic.io/karina-sirqueira/aCT8hydWJ-7kSIJf_Wishlist03.png?auto&#x3D;format,compress?auto&#x3D;compress,format\">\n            \n                                                                    </figure>\n                                                        </div>\n                                                    </div>\n                                                </article>\n            \n            \n                                        </div>\n                                    </div>\n                                    <div class=\"project__sections__section \">\n                                        <div class=\"project__sections__section__wrapper\">\n                                                <article class=\"project__sections__media\">\n                                                        <div class=\"project__sections__media__description\" data-media>\n                                                            <p data-description>After sharing a couple of listings, why not create a wishlist?</p>\n                                                        </div>\n            \n                                                    <div class=\"project__sections__media__wrapper\" data-media>\n                                                        <div class=\"project__sections__media__gallery project__sections__media__gallery--1\">\n                                                                    <figure class=\"project__sections__media__item\">\n            \n                                                                            <video autoplay class=\"project__sections__media__item__video\" data-src=\"https://karina-sirqueira.cdn.prismic.io/karina-sirqueira/aCT8qydWJ-7kSIJp_ProactiveWishlist-Flow-Desktop.mp4\" loop muted playsinline></video>\n                                                                    </figure>\n                                                        </div>\n                                                    </div>\n                                                </article>\n            \n            \n                                        </div>\n                                    </div>\n                                    <div class=\"project__sections__section \">\n                                        <div class=\"project__sections__section__wrapper\">\n            \n                                                <article class=\"project__sections__content\">\n                                                    <div class=\"project__sections__content__wrapper\">\n                                                            <div class=\"project__sections__content__description\">\n                                                                <h1 data-title>New Host Menu<br /><br />Redesigned the host menu to make managing listings easier, streamlining navigation and bringing key tools into one smart, organized space.</h1>\n                                                            </div>\n                                                    </div>\n                                                </article>\n            \n                                        </div>\n                                    </div>\n                                    <div class=\"project__sections__section \">\n                                        <div class=\"project__sections__section__wrapper\">\n                                                <article class=\"project__sections__media\">\n            \n                                                    <div class=\"project__sections__media__wrapper\" data-media>\n                                                        <div class=\"project__sections__media__gallery project__sections__media__gallery--1\">\n                                                                    <figure class=\"project__sections__media__item\">\n            \n                                                                            <video autoplay class=\"project__sections__media__item__video\" data-src=\"https://karina-sirqueira.cdn.prismic.io/karina-sirqueira/aCT8qSdWJ-7kSIJn_M13_Desktop_Menu_Open_Close_01.mp4\" loop muted playsinline></video>\n                                                                    </figure>\n                                                        </div>\n                                                    </div>\n                                                </article>\n            \n            \n                                        </div>\n                                    </div>\n                                    <div class=\"project__sections__section \">\n                                        <div class=\"project__sections__section__wrapper\">\n                                                <article class=\"project__sections__media\">\n                                                        <div class=\"project__sections__media__description\" data-media>\n                                                            <p data-description>Now it is easier to find your favorite tools</p>\n                                                        </div>\n            \n                                                    <div class=\"project__sections__media__wrapper\" data-media>\n                                                        <div class=\"project__sections__media__gallery project__sections__media__gallery--2\">\n                                                                    <figure class=\"project__sections__media__item\">\n                                                                            <img alt=\"\" class=\"project__sections__media__item__image\" data-src=\"https://images.prismic.io/karina-sirqueira/aCT8fydWJ-7kSIJX_NativeMenu-Experienced.png?auto&#x3D;format,compress?auto&#x3D;compress,format\">\n            \n                                                                    </figure>\n                                                                    <figure class=\"project__sections__media__item\">\n                                                                            <img alt=\"\" class=\"project__sections__media__item__image\" data-src=\"https://images.prismic.io/karina-sirqueira/aCT8fidWJ-7kSIJW_NativeMenu-New.png?auto&#x3D;format,compress?auto&#x3D;compress,format\">\n            \n                                                                    </figure>\n                                                        </div>\n                                                    </div>\n                                                </article>\n            \n            \n                                        </div>\n                                    </div>\n                                    <div class=\"project__sections__section \">\n                                        <div class=\"project__sections__section__wrapper\">\n            \n                                                <article class=\"project__sections__content\">\n                                                    <div class=\"project__sections__content__wrapper\">\n                                                            <div class=\"project__sections__content__description\">\n                                                                <h1 data-title>Manage your Experience and Services<br /><br />Worked on tools to help new service and experience hosts manage their listings more easily and confidently.</h1>\n                                                            </div>\n                                                    </div>\n                                                </article>\n            \n                                        </div>\n                                    </div>\n                                    <div class=\"project__sections__section \">\n                                        <div class=\"project__sections__section__wrapper\">\n                                                <article class=\"project__sections__media\">\n            \n                                                    <div class=\"project__sections__media__wrapper\" data-medi