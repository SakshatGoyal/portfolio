karina-sirqueira.cdn.prismic.io/karina-sirqueira/d8af4135-17d5-4b01-b550-cf524683ea30_09.mp4\" loop muted playsinline></video>\n                                                                    </figure>\n                                                                    <figure class=\"project__sections__media__item\">\n            \n                                                                            <video autoplay class=\"project__sections__media__item__video\" data-src=\"https://karina-sirqueira.cdn.prismic.io/karina-sirqueira/fe7b0329-055b-431c-8acd-128f6a6f43ac_10.mp4\" loop muted playsinline></video>\n                                                                    </figure>\n                                                                    <figure class=\"project__sections__media__item\">\n            \n                                                                            <video autoplay class=\"project__sections__media__item__video\" data-src=\"https://karina-sirqueira.cdn.prismic.io/karina-sirqueira/808591db-9c66-40e3-a2ff-0307d5f76df8_11.mp4\" loop muted playsinline></video>\n                                                                    </figure>\n                                                        </div>\n                                                    </div>\n                                                </article>\n            \n            \n                                        </div>\n                                    </div>\n                                    <div class=\"project__sections__section \">\n                                        <div class=\"project__sections__section__wrapper\">\n                                                <article class=\"project__sections__media\">\n                                                        <div class=\"project__sections__media__description\" data-media>\n                                                            <p data-description>Work &amp; Co<br /><b