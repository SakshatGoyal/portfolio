            "text": "<!DOCTYPE html>\n<html lang=\"en\">\n    <head>\n        <meta charset=\"UTF-8\" />\n\n        <link rel=\"apple-touch-icon\" sizes=\"180x180\" href=\"/apple-touch-icon.png\">\n        <link rel=\"icon\" type=\"image/png\" sizes=\"32x32\" href=\"/favicon-32x32.png\">\n        <link rel=\"icon\" type=\"image/png\" sizes=\"16x16\" href=\"/favicon-16x16.png\">\n        <link rel=\"manifest\" href=\"/site.webmanifest\">\n        <meta name=\"msapplication-TileColor\" content=\"#ffffff\">\n        <meta name=\"theme-color\" content=\"#ffffff\">\n\n        <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n\n        <title>Karina Sirqueira</title>\n        <meta name=\"description\" content=\"I&#x27;m Karina Sirqueira, a Brazilian designer at Work&amp;Co in Brooklyn.\" />\n\n        <meta property=\"og:title\" content=\"Karina Sirqueira\" />\n        <meta property=\"og:image\" content=\"https://images.prismic.io/karina-sirqueira/58ff0832-15aa-41d6-b5e7-f0901a3fb253_Open+Graph.png?auto&#x3D;compress,format\" />\n        <meta property=\"og:description\" content=\"I&#x27;m Karina Sirqueira, a Brazilian designer at Work&amp;Co in Brooklyn.\" />\n\n        <meta name=\"twitter:card\" content=\"summary_large_image\" />\n        <meta name=\"twitter:title\" content=\"Karina Sirqueira\" />\n        <meta name=\"twitter:description\" content=\"I&#x27;m Karina Sirqueira, a Brazilian designer at Work&amp;Co in Brooklyn.\" />\n        <meta name=\"twitter:image:src\" content=\"https://images.prismic.io/karina-sirqueira/58ff0832-15aa-41d6-b5e7-f0901a3fb253_Open+Graph.png?auto&#x3D;compress,format\" />\n      <script type=\"module\" crossorigin src=\"/assets/main.c1f6367f.js\"></script>\n      <link rel=\"stylesheet\" href=\"/assets/main.d00e416c.css\">\n    <link rel=\"manifest\" href=\"/manifest.webmanifest\"></head>\n    <body>\n        <div class=\"app\" data-template=\"project\">\n                <section class=\"project\" id=\"vista\" style=\"background: #85cef1;\">\n                    <div class=\"project__wrapper\">\n                        <a class=\"project__close\" href=\"/\">\n                            <span class=\"project__close__icon\"></span> Back to Home\n                        </a>\n            \n                        <button class=\"project__button project__button--previous\">\n                            <svg class=\"project__button__arrow\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\">\n                                <use xlink:href=\"#arrow-left\" />\n                            </svg>\n                        </button>\n            \n                        <button class=\"project__button project__button--next\">\n                            <svg class=\"project__button__arrow\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\">\n                                <use xlink:href=\"#arrow-right\" />\n                            </svg>\n                        </button>\n            \n                        <div class=\"project__content\">\n                            <header class=\"project__header\">\n                                <div class=\"project__header__wrapper\">\n                                    <h1 class=\"project__header__title\">\n                                        Vista\n            \n                                        <img\n                                            alt=\"Vista\"\n                                            class=\"project__header__image\"\n                                            data-src=\"https://karina-sirqueira.cdn.prismic.io/karina-sirqueira/64c29c4a-1916-4c50-8a86-0cf236add72d_vista.svg\"\n                                            src=\"https://karina-sirqueira.cdn.prismic.io/karina-sirqueira/64c29c4a-1916-4c50-8a86-0cf236add72d_vista.svg\"\n                                        >\n                                    </h1>\n                                </div>\n                            </header>\n            \n                            <div class=\"project__sections\">\n                                <div class=\"project__sections__header\">\n                                    <p class=\"project__sections__header__title\">\n                                        <span class=\"project__sections__header__title__text\">\n                                            Vista\n                                        </span>\n                                    </p>\n                                </div>\n            \n                                    <div class=\"project__sections__section \">\n                                        <div class=\"project__sections__section__wrapper\">\n                                                <article class=\"project__sections__media\">\n                                                        <div class=\"project__sections__media__description\" data-media>\n                                                            <p data-description>Within weeks, we brought a first-of-its-kind product for Vistaprint to market. We worked in an agile and responsive way to create e-commerce to get masks to customers as quickly as possible.</p>\n                                                        </div>\n            \n                                                    <div class=\"project__sections__media__wrapper\" data-media>\n                                                        <div class=\"project__sections__media__gallery project__sections__media__gallery--1\">\n                                                                    <figure class=\"project__sections__media__item\">\n                                                                            <img alt=\"\" class=\"project__sections__media__item__image\" data-src=\"https://images.prismic.io/karina-sirqueira/71435a35-68f6-4e03-bca6-fa059f8200e7_01.jpg?auto&#x3D;compress,format\">\n            \n                                                                    </figure>\n                                                        </div>\n                                                    </div>\n                                                </article>\n            \n            \n                                        </div>\n                                    </div>\n                                    <div class=\"project__sections__section \">\n                                        <div class=\"project__sections__section__wrapper\">\n                                                <article class=\"project__sections__media\">\n            \n                                                    <div class=\"project__sections__media__wrapper\" data-media>\n                                                        <div class=\"project__sections__media__gallery project__sections__media__gallery--4\">\n                                                                    <figure class=\"project__sections__media__item\">\n                                                                            <img alt=\"\" class=\"project__sections__media__item__image\" data-src=\"https://images.prismic.io/karina-sirqueira/4805dd9a-a156-42e3-ad08-308c697daa19_02.jpg?auto&#x3D;compress,format\">\n            \n                                                                    </figure>\n                                                                    <figure class=\"project__sections__media__item\">\n                                                                            <img alt=\"\" class=\"project__sections__media__item__image\" data-src=\"https://images.prismic.io/karina-sirqueira/add90ff7-bc13-4d73-a701-e95057cab0b6_03.jpg?auto&#x3D;compress,format\">\n            \n                                                                    </figure>\n                                                                    <figure class=\"project__sections__media__item\">\n                                                                            <img alt=\"\" class=\"project__sections__media__item__image\" data-src=\"https://images.prismic.io/karina-sirqueira/24b579ae-f5ba-421d-a1b2-0d684613d5c2_04.jpg?auto&#x3D;compress,format\">\n            \n                                                                    </figure>\n                                                                    <figure class=\"project__sections__media__item\">\n                                                                            <img alt=\"\" class=\"project__sections__media__item__image\" data-src=\"https://images.prismic.io/karina-sirqueira/0e0e4c25-4109-45c3-a9f2-82c67d07fafb_05.jpg?auto&#x3D;compress,format\">\n            \n                                                                    </figure>\n                                                        </div>\n                                                    </div>\n                                                </article>\n            \n            \n                                        </div>\n                                    </div>\n                                    <div class=\"project__sections__section \">\n                                        <div class=\"project__sections__section__wrapper\">\n                                                <article class=\"project__sections__media\">\n            \n                                                    <div class=\"project__sections__media__wrapper\" data-media>\n                                                        <div class=\"project__sections__media__gallery project__sections__media__gallery--1\">\n                                                                    <figure class=\"project__sections__media__item\">\n            \n                                                                            <video autoplay class=\"project__sections__media__item__video\" data-src=\"https://karina-sirqueira.cdn.prismic.io/karina-sirqueira/4da28b9b-2b75-4b84-b832-7d3318b63eee_06.mp4\" loop muted playsinline></video>\n                                                                    </figure>\n                                                        </div>\n                                                    </div>\n                                                </article>\n            \n            \n                                        </div>\n                                    </div>\n                                    <div class=\"project__sections__section \">\n                                        <div class=\"project__sections__section__wrapper\">\n            \n                                                <article class=\"project__sections__content\">\n                                                    <div class=\"project__sections__content__wrapper\">\n                                                            <div class=\"project__sections__content__description\">\n                                                                <h1 data-title>Early on in the pandemic, Work &amp; Co designed and developed a new e-commerce website for masks. From there, the site is continually evolving to meet customers’ needs. We have also designed a new homepage and a whole design system.</h1>\n                                                            </div>\n                                                    </div>\n                                                </article>\n            \n                                        </div>\n                                    </div>\n                                    <div class=\"project__sections__section \">\n                                        <div class=\"project__sections__section__wrapper\">\n                                                <article class=\"project__sections__media\">\n            \n                                                    <div class=\"project__sections__media__wrapper\" data-media>\n                                                        <div class=\"project__sections__media__gallery project__sections__media__gallery--1\">\n                                                                    <figure class=\"project__sections__media__item\">\n            \n                                                                            <video autoplay class=\"project__sections__media__item__video\" data-src=\"https://karina-sirqueira.cdn.prismic.io/karina-sirqueira/c354012b-a330-4aa7-a749-014490caa0d8_08.mp4\" loop muted playsinline></video>\n                                                                    </figure>\n                                                        </div>\n                                                    </div>\n                                                </article>\n            \n            \n                                        </div>\n                                    </div>\n                                    <div class=\"project__sections__section \">\n                                        <div class=\"project__sections__section__wrapper\">\n                                                <article class=\"project__sections__media\">\n            \n                                                    <div class=\"project__sections__media__wrapper\" data-media>\n                                                        <div class=\"project__sections__media__gallery project__sections__media__gallery--3\">\n                                                                    <figure class=\"project__sections__media__item\">\n                                                                            <img alt=\"\" class=\"project__sections__media__item__image\" data-src=\"https://images.prismic.io/karina-sirqueira/5173042e-39bb-479a-8e80-bf90f450572e_09.jpg?auto&#x3D;compress,format\">\n            \n                                                                    </figure>\n                                                                    <figure class=\"project_