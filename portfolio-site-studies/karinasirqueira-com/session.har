          "content": {
            "size": 18567,
            "mimeType": "text/html; charset=utf-8",
            "compression": 15417,
            "text": "<!DOCTYPE html>\n<html lang=\"en\">\n    <head>\n        <meta charset=\"UTF-8\" />\n\n        <link rel=\"apple-touch-icon\" sizes=\"180x180\" href=\"/apple-touch-icon.png\">\n        <link rel=\"icon\" type=\"image/png\" sizes=\"32x32\" href=\"/favicon-32x32.png\">\n        <link rel=\"icon\" type=\"image/png\" sizes=\"16x16\" href=\"/favicon-16x16.png\">\n        <link rel=\"manifest\" href=\"/site.webmanifest\">\n        <meta name=\"msapplication-TileColor\" content=\"#ffffff\">\n        <meta name=\"theme-color\" content=\"#ffffff\">\n\n        <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n\n        <title>Karina Sirqueira</title>\n        <meta name=\"description\" content=\"I&#x27;m Karina Sirqueira, a Brazilian designer at Work&amp;Co in Brooklyn.\" />\n\n        <meta property=\"og:title\" content=\"Karina Sirqueira\" />\n        <meta property=\"og:image\" content=\"https://images.prismic.io/karina-sirqueira/58ff0832-15aa-41d6-b5e7-f0901a3fb253_Open+Graph.png?auto&#x3D;compress,format\" />\n        <meta property=\"og:description\" content=\"I&#x27;m Karina Sirqueira, a Brazilian designer at Work&amp;Co in Brooklyn.\" />\n\n        <meta name=\"twitter:card\" content=\"summary_large_image\" />\n        <meta name=\"twitter:title\" content=\"Karina Sirqueira\" />\n        <meta name=\"twitter:description\" content=\"I&#x27;m Karina Sirqueira, a Brazilian designer at Work&amp;Co in Brooklyn.\" />\n        <meta name=\"twitter:image:src\" content=\"https://images.prismic.io/karina-sirqueira/58ff0832-15aa-41d6-b5e7-f0901a3fb253_Open+Graph.png?auto&#x3D;compress,format\" />\n      <script type=\"module\" crossorigin src=\"/assets/main.c1f6367f.js\"></script>\n      <link rel=\"stylesheet\" href=\"/assets/main.d00e416c.css\">\n    <link rel=\"manifest\" href=\"/manifest.webmanifest\"></head>\n    <body>\n        <div class=\"app\" data-template=\"project\">\n                <section class=\"project\" id=\"mta\" style=\"background: #0a0a0a;\">\n                    <div class=\"project__wrapper\">\n                        <a class=\"project__close\" href=\"/\">\n                            <span class=\"project__close__icon\"></span> Back to Home\n                        </a>\n            \n                        <button class=\"project__button project__button--previous\">\n                            <svg class=\"project__button__arrow\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\">\n                                <use xlink:href=\"#arrow-left\" />\n                            </svg>\n                        </button>\n            \n                        <button class=\"project__button project__button--next\">\n                            <svg class=\"project__button__arrow\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\">\n                                <use xlink:href=\"#arrow-right\" />\n                            </svg>\n                        </button>\n            \n                        <div class=\"project__content\">\n                            <header class=\"project__header\">\n                                <div class=\"project__header__wrapper\">\n                                    <h1 class=\"project__header__title\">\n                                        MTA\n            \n                                        <img\n                                            alt=\"MTA\"\n                                            class=\"project__header__image\"\n                                            data-src=\"https://karina-sirqueira.cdn.prismic.io/karina-sirqueira/b6844187-24a1-4f5d-8de5-baacb48237f9_mta.svg\"\n                                            src=\"https://karina-sirqueira.cdn.prismic.io/karina-sirqueira/b6844187-24a1-4f5d-8de5-baacb48237f9_mta.svg\"\n                                        >\n                                    </h1>\n                                </div>\n                            </header>\n            \n                            <div class=\"project__sections\">\n                                <div class=\"project__sections__header\">\n                                    <p class=\"project__sections__header__title\">\n                                        <span class=\"project__sections__header__title__text\">\n                                            MTA\n                                        </span>\n                                    </p>\n                                </div>\n            \n                                    <div class=\"project__sections__section \">\n                                        <div class=\"project__sections__section__wrapper\">\n                                                <article class=\"project__sections__media\">\n                                                        <div class=\"project__sections__media__description\" data-media>\n                                                            <p data-description>Evolving the iconic map to create updates in real time — and help New Yorkers and tourists better plan their journeys.</p>\n                                                        </div>\n            \n                                                    <div class=\"project__sections__media__wrapper\" data-media>\n                                                        <div class=\"project__sections__media__gallery project__sections__media__gallery--1\">\n                                                                    <figure class=\"project__sections__media__item\">\n                                                                            <img alt=\"\" class=\"project__sections__media__item__image\" data-src=\"https://images.prismic.io/karina-sirqueira/0757ab81-cc3d-419d-a651-0720af54bf42_01.jpg?auto&#x3D;compress,format\">\n            \n                                                                    </figure>\n                                                        </div>\n                                                    </div>\n                                                </article>\n            \n            \n                                        </div>\n                                    </div>\n                                    <div class=\"project__sections__section \">\n                                        <div class=\"project__sections__section__wrapper\">\n                                                <article class=\"project__sections__media\">\n                                                        <div class=\"project__sections__media__description\" data-media>\n                                                            <p data-description></p>\n                                                        </div>\n            \n                                                    <div class=\"project__sections__media__wrapper\" data-media>\n                                                        <div class=\"project__sections__media__gallery project__sections__media__gallery--1\">\n                                                                    <figure class=\"project__sections__media__item\">\n            \n                                                                            <video autoplay class=\"project__sections__media__item__video\" data-src=\"https://karina-sirqueira.cdn.prismic.io/karina-sirqueira/eb35df63-cae5-47c3-a148-180b06328048_02.mp4\" loop muted playsinline></video>\n                                                                    </figure>\n                                                        </div>\n                                                    </div>\n                                                </article>\n            \n            \n                                        </div>\n                                    </div>\n                                    <div class=\"project__sections__section \">\n                                        <div class=\"project__sections__section__wrapper\">\n            \n                                                <article class=\"project__sections__content\">\n                                                    <div class=\"project__sections__content__wrapper\">\n                                                            <div class=\"project__sections__content__description\">\n                                                                <h1 data-title>Key features of the new map, which is currently in beta, include:</h1><p data-description>Automatically updating train lines: Train lines will redraw themselves using real-time data to illustrate current and accurate train service status. Sections of train lines fade out where a train line is not running and are denoted with dashes if trains are running in a single direction.</p><p data-description>Moving trains: The user will see trains moving, which helps to signal to users that the map is live and also reflect real-time locations of trains throughout the subway system.</p>\n                                                            </div>\n                                                    </div>\n                                                </article>\n            \n                                        </div>\n                                    </div>\n                                    <div class=\"project__sections__section \">\n                                        <div class=\"project__sections__section__wrapper\">\n                                                <article class=\"project__sections__media\">\n            \n                                                    <div class=\"project__sections__media__wrapper\" data-media>\n                                                        <div class=\"project__sections__media__gallery project__sections__media__gallery--1\">\n                                                                    <figure class=\"project__sections__media__item\">\n            \n                                                                            <video autoplay class=\"project__sections__media__item__video\" data-src=\"https://karina-sirqueira.cdn.prismic.io/karina-sirqueira/d5af4242-28ec-4cad-b57a-56f0c082a5a5_03.mp4\" loop muted playsinline></video>\n                                                                    </figure>\n                                                        </div>\n                                                    </div>\n                                                </article>\n            \n            \n                                        </div>\n                                    </div>\n                                    <div class=\"project__sections__section \">\n                                        <div class=\"project__sections__section__wrapper\">\n            \n                                                <article class=\"project__sections__content\">\n                                                    <div class=\"project__sections__content__wrapper\">\n                                                            <div class=\"project__sections__content__description\">\n                                                                <h1 data-title>Greater map detail is exposed as the user zooms in, including the ability to see individual train lines, subway entrances, station names, and street locations and names.</h1>\n                                                            </div>\n                                                    </div>\n                                                </article>\n            \n                                        </div>\n                                    </div>\n                                    <div class=\"project__sections__section \">\n                                        <div class=\"project__sections__section__wrapper\">\n                                                <article class=\"project__sections__media\">\n            \n                                                    <div class=\"project__sections__media__wrapper\" data-media>\n                                                        <div class=\"project__sections__media__gallery project__sections__media__gallery--1\">\n                                                                    <figure class=\"project__sections__media__item\">\n            \n                                                                            <video autoplay class=\"project__sections__media__item__video\" data-src=\"https://karina-sirqueira.cdn.prismic.io/karina-sirqueira/b170a59d-a738-4242-bdcc-997b8174313e_04.mp4\" loop muted playsinline></video>\n                                                                    </figure>\n                                                        </div>\n                                                    </div>\n                                                </article>\n            \n            \n                                        </div>\n                                    </div>\n                                    <div class=\"project__sections__section \">\n                                        <div class=\"project__sections__section__wrapper\">\n            \n                                                <article class=\"project__sections__content\">\n                                                    <div class=\"project__sections__content__wrapper\">\n                                                            <div class=\"project__sections__content__description\">\n                                                                <h1 data-title>As seen in <a href=\"https://www.nytimes.com/2020/10/21/nyregion/new-nyc-subway-map.html\" target=\"undefined\" rel=\"noopener noreferrer\">The New York Times</a>, <a href=\"https://www.curbed.com/2020/10/first-look-new-yorks-digital-subway-map-comes-alive-today.html\" target=\"undefined\" rel=\"noopener noreferrer\">Curbed</a>, <a href=\"https://www.fastcompany.com/90566212/nycs-new-subway-tool-settles-the-biggest-debate-in-maps\" target=\"undefined\" rel=\"noopener noreferrer\">Fast Company</a>, <a href=\"https://www.timeout.com/newyork/news/mtas-new-map-lets-you-watch-trains-move-in-real-time-102020\" target=\"undefined\" rel=\"noopener noreferrer\">Time Out New York</a>, and <a href=\"https://gothamist.com/news/mta-unveils-new-digital-live-subway-map-simplify-service-changes\" target=\"undefined\" rel=\"noopener noreferrer\">Gothamist</a>, and the subject of <a href=\"https://vimeo.com/469980256\" target=\"undefined\" rel=\"noopener noreferrer\">a short documentary</a> in collaboration with Gary Hustwit — the acclaimed filmmaker and director of design documentaries including Helvetica, Objectified, and Rams. Check it out next.</h1>\n                                                            </div>\n                                                    </div>\n                                                </article>\n            \n                                        </div>\n                                    </div>\n                                    <div class=\"project__sections__section \">\n                                        <div class=\"project__sections__section__wrapper\">\n            \n            \n                                                <article class=\"project__sections__video\">\n                                                    <div class=\"project__sections__video__wrapper\" data-media>\n                                                        <iframe src=\"https://player.vimeo.com/video/470020599?h=74757d3b17&amp;app_id=122963\" width=\"426\" height=\"240\" frameborder=\"0\" allow=\"autoplay; fullscreen; picture-in-picture\" allowfullscreen title=\"The Map\"></iframe>\n                                                    </div>\n                                                </article>\n                                        </div>\n                                    </div>\n                                    <div class=\"project__sections__section \">\n                                        <div class=\"project__sections__section__wrapper\">\n                                                <article class=\"project__sections__media\">\n            \n                                                    <div class=\"project__sections__media__wrapper\" data-media>\n                                                        <div class=\"project__sections__media__gallery project__sections__media__gallery--1\">\n                                                                    <figure class=\"project__sections__media__item\">\n                                                                            <img alt=\"\" class=\"project__sections__media__item__image\" data-src=\"https://images.prismic.io/karina-sirqueira/27e5867a-50a9-4324-8d19-4a767aa33f6c_05.jpg?auto&#x3D;compress,format\">\n            \n                                                                    </figure>\n                                                        </div>\n                                                    </div>\n                                                </article>\n            \n            \n                                        </div>\n                                    </div>\n                                    <div class=\"project__sections__section \">\n                                        <div class=\"project__sections__section__wrapper\">\n                                                <article class=\"project__sections__media\">\n                                                        <div class=\"project__sections__media__description\" data-media>\n                                                            <p data-description>Work &amp; Co<br /><br />Felipe Memoria, Karina Sirqueira, Francesco Bertelli, Corey Edmondson, Marcela Abbade, Robert Penner, Pedro Putz, Maria Clara Santana, Abbey Mondshein, David Whitely, Nick Bethlem</p>\n                                                        </div>\n            \n                                                    <div class=\"project__sections__media__wrapper\" data-media>\n                                                        <div class=\"project__sections__media__gallery project__sections__media__gallery--1\">\n                                                        </div>\n                                                    </div>\n                                                </article>\n            \n            \n                                        </div>\n                                    </div>\n                            </div>\n                        </div>\n                    </div>\n                </section>\n        </div>\n\n        \n\n        <script async src=\"https://www.googletagmanager.com/gtag/js?id=UA-85019401-1\"></script>\n        <script>\n            function gtag() {\n                dataLayer.push(arguments);\n            }\n\n            (window.dataLayer = window.dataLayer || []), gtag('js', new Date()), gtag('config', 'UA-85019401-1');\n        </script>\n    </body>\n</html>\n"
