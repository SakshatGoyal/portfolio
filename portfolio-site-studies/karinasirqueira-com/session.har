          "content": {
            "size": 15446,
            "mimeType": "text/html; charset=utf-8",
            "compression": 12978,
            "text": "<!DOCTYPE html>\n<html lang=\"en\">\n    <head>\n        <meta charset=\"UTF-8\" />\n\n        <link rel=\"apple-touch-icon\" sizes=\"180x180\" href=\"/apple-touch-icon.png\">\n        <link rel=\"icon\" type=\"image/png\" sizes=\"32x32\" href=\"/favicon-32x32.png\">\n        <link rel=\"icon\" type=\"image/png\" sizes=\"16x16\" href=\"/favicon-16x16.png\">\n        <link rel=\"manifest\" href=\"/site.webmanifest\">\n        <meta name=\"msapplication-TileColor\" content=\"#ffffff\">\n        <meta name=\"theme-color\" content=\"#ffffff\">\n\n        <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n\n        <title>Karina Sirqueira</title>\n        <meta name=\"description\" content=\"I&#x27;m Karina Sirqueira, a Brazilian designer at Work&amp;Co in Brooklyn.\" />\n\n        <meta property=\"og:title\" content=\"Karina Sirqueira\" />\n        <meta property=\"og:image\" content=\"https://images.prismic.io/karina-sirqueira/58ff0832-15aa-41d6-b5e7-f0901a3fb253_Open+Graph.png?auto&#x3D;compress,format\" />\n        <meta property=\"og:description\" content=\"I&#x27;m Karina Sirqueira, a Brazilian designer at Work&amp;Co in Brooklyn.\" />\n\n        <meta name=\"twitter:card\" content=\"summary_large_image\" />\n        <meta name=\"twitter:title\" content=\"Karina Sirqueira\" />\n        <meta name=\"twitter:description\" content=\"I&#x27;m Karina Sirqueira, a Brazilian designer at Work&amp;Co in Brooklyn.\" />\n        <meta name=\"twitter:image:src\" content=\"https://images.prismic.io/karina-sirqueira/58ff0832-15aa-41d6-b5e7-f0901a3fb253_Open+Graph.png?auto&#x3D;compress,format\" />\n      <script type=\"module\" crossorigin src=\"/assets/main.c1f6367f.js\"></script>\n      <link rel=\"stylesheet\" href=\"/assets/main.d00e416c.css\">\n    <link rel=\"manifest\" href=\"/manifest.webmanifest\"></head>\n    <body>\n        <div class=\"app\" data-template=\"project\">\n                <section class=\"project\" id=\"fresh-direct\" style=\"background: #65BC4D;\">\n                    <div class=\"project__wrapper\">\n                        <a class=\"project__close\" href=\"/\">\n                            <span class=\"project__close__icon\"></span> Back to Home\n                        </a>\n            \n                        <button class=\"project__button project__button--previous\">\n                            <svg class=\"project__button__arrow\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\">\n                                <use xlink:href=\"#arrow-left\" />\n                            </svg>\n                        </button>\n            \n                        <button class=\"project__button project__button--next\">\n                            <svg class=\"project__button__arrow\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\">\n                                <use xlink:href=\"#arrow-right\" />\n                            </svg>\n                        </button>\n            \n                        <div class=\"project__content\">\n                            <header class=\"project__header\">\n                                <div class=\"project__header__wrapper\">\n                                    <h1 class=\"project__header__title\">\n                                        Freshdirect\n            \n                                        <img\n                                            alt=\"Freshdirect\"\n                                            class=\"project__header__image\"\n                                            data-src=\"https://karina-sirqueira.cdn.prismic.io/karina-sirqueira/aCUBzCdWJ-7kSILX_Freshdirect.svg\"\n                                            src=\"https://karina-sirqueira.cdn.prismic.io/karina-sirqueira/aCUBzCdWJ-7kSILX_Freshdirect.svg\"\n                                        >\n                                    </h1>\n                                </div>\n                            </header>\n            \n                            <div class=\"project__sections\">\n                                <div class=\"project__sections__header\">\n                                    <p class=\"project__sections__header__title\">\n                                        <span class=\"project__sections__header__title__text\">\n                                            Freshdirect\n                                        </span>\n                                    </p>\n                                </div>\n            \n                                    <div class=\"project__sections__section \">\n                                        <div class=\"project__sections__section__wrapper\">\n                                                <article class=\"project__sections__media\">\n                                                        <div class=\"project__sections__media__description\" data-media>\n                                                            <p data-description>FreshDirect is an online grocery delivery service that provides customers with fresh food and grocery items delivered straight to their doorsteps. It was founded in 1999 and is based in New York City, serving customers in various parts of the United States, primarily in the Northeast.</p>\n                                                        </div>\n            \n                                                    <div class=\"project__sections__media__wrapper\" data-media>\n                                                        <div class=\"project__sections__media__gallery project__sections__media__gallery--1\">\n                                                                    <figure class=\"project__sections__media__item\">\n            \n                                                                            <video autoplay class=\"project__sections__media__item__video\" data-src=\"https://karina-sirqueira.cdn.prismic.io/karina-sirqueira/8e74805b-200a-4167-889b-01eefa7de9a9_FD+flow+short.mp4\" loop muted playsinline></video>\n                                                                    </figure>\n                                                        </div>\n                                                    </div>\n                                                </article>\n            \n            \n                                        </div>\n                                    </div>\n                                    <div class=\"project__sections__section \">\n                                        <div class=\"project__sections__section__wrapper\">\n            \n                                                <article class=\"project__sections__content\">\n                                                    <div class=\"project__sections__content__wrapper\">\n                                                            <div class=\"project__sections__content__description\">\n                                                                <h1 data-title>Our biggest challenge at FreshDirect was reimagining the shopping cart experience. Our primary goal was to ensure that customers could receive their selected products quickly and efficiently, especially those that needed to be delivered hot and fresh.</h1>\n                                                            </div>\n                                                    </div>\n                                                </article>\n            \n                                        </div>\n                                    </div>\n                                    <div class=\"project__sections__section project__sections__section--scrollable\">\n                                        <div class=\"project__sections__section__wrapper\">\n                                                <article class=\"project__sections__media\">\n            \n                                                    <div class=\"project__sections__media__wrapper\" data-media>\n                                                        <div class=\"project__sections__media__gallery project__sections__media__gallery--1\">\n                                                                    <figure class=\"project__sections__media__item\">\n            \n                                                                            <video autoplay class=\"project__sections__media__item__video\" data-src=\"https://karina-sirqueira.cdn.prismic.io/karina-sirqueira/688ce9eb-cb4c-4526-aa71-d1c102bc1425_FD+Express+x+Standard+3.mp4\" loop muted playsinline></video>\n                                                                    </figure>\n                                                        </div>\n                                                    </div>\n                                                </article>\n            \n            \n                                        </div>\n                                    </div>\n                                    <div class=\"project__sections__section \">\n                                        <div class=\"project__sections__section__wrapper\">\n                                                <article class=\"project__sections__media\">\n            \n                                                    <div class=\"project__sections__media__wrapper\" data-media>\n                                                        <div class=\"project__sections__media__gallery project__sections__media__gallery--4\">\n                                                                    <figure class=\"project__sections__media__item\">\n                                                                            <img alt=\"\" class=\"project__sections__media__item__image\" data-src=\"https://images.prismic.io/karina-sirqueira/8e974238-b4eb-4222-aaa8-f862a0eeaf8e_1.png?auto&#x3D;format,compress?auto&#x3D;compress,format\">\n            \n                                                                    </figure>\n                                                                    <figure class=\"project__sections__media__item\">\n                                                                            <img alt=\"\" class=\"project__sections__media__item__image\" data-src=\"https://images.prismic.io/karina-sirqueira/e0d24641-d26e-4c1d-9a07-013e6bcf15ed_2.png?auto&#x3D;format,compress?auto&#x3D;compress,format\">\n            \n                                                                    </figure>\n                                                                    <figure class=\"project__sections__media__item\">\n                                                                            <img alt=\"\" class=\"project__sections__media__item__image\" data-src=\"https://images.prismic.io/karina-sirqueira/ecd410f3-5b22-41c6-be26-5856a4a4fe17_3.png?auto&#x3D;format,compress?auto&#x3D;compress,format\">\n            \n                                                                    </figure>\n                                                                    <figure class=\"project__sections__media__item\">\n                                                                            <img alt=\"\" class=\"project__sections__media__item__image\" data-src=\"https://images.prismic.io/karina-sirqueira/493cd47b-7691-4d1c-b7d3-6e1ae6ab8834_4.png?auto&#x3D;format,compress?auto&#x3D;compress,format\">\n            \n                                                                    </figure>\n                                                        </div>\n                                                    </div>\n                                                </article>\n            \n            \n                                        </div>\n                                    </div>\n                                    <div class=\"project__sections__section \">\n                                        <div class=\"project__sections_