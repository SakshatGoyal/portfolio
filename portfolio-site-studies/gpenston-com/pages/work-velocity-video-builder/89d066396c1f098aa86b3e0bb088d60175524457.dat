arEffectEnabled:!0,__framer__threshold:0,__perspectiveFX:!1,__targetOpacity:1,className:`framer-8b4lfl`,"data-framer-name":`Text`,style:{transformPerspective:1200},children:a(l,{__fromCanvasComponent:!0,children:o(r,{children:[a(`h3`,{className:`framer-styles-preset-1ld6jqb`,"data-styles-preset":`sYhPbbYF1`,children:a(`strong`,{children:`Making vertical video ads effortless`})}),a(`p`,{className:`framer-styles-preset-1b1wlt8`,"data-styles-preset":`yywA2ZNZg`,style:{"--framer-text-alignment":`left`},children:`In 2016, Flite set out to solve a growing challenge for marketers—how to transform existing horizontal videos into full-screen vertical ads optimized for social media. Traditional editing tools were complex, and most marketers lacked the time or expertise for custom video production. The goal was to build a tool that enabled anyone to quickly and easily create polished, high-impact vertical video ads from their existing content.`})]}),className:`framer-rale2y`,"data-framer-name":`Paragraph`,fonts:[`Inter`,`Inter-Bold`],verticalAlignment:`top`,withExternalLayout:!0})}),a(v,{children:a(I,{__framer__animate:{transition:W},__framer__animateOnce:!0,__framer__enter:J,__framer__exit:Y,__framer__styleAppearEffectEnabled:!0,__framer__threshold:0,__perspectiveFX:!1,__targetOpacity:1,className:`framer-m5qrpv-container`,style:{transformPerspective:1200},children:a(O,{alt:`Sample project image`,height:`100%`,id:`F_fl3tgQH`,image:X({src:`https://framerusercontent.com/images/eZuiHSYc66N54id9lPus7ApjTI.jpg`,srcSet:`https://framerusercontent.com/images/eZuiHSYc66N54id9lPus7ApjTI.jpg?scale-down-to=512 512w,https://framerusercontent.com/images/eZuiHSYc66N54id9lPus7ApjTI.jpg?scale-down-to=1024 1024w,https://framerusercontent.com/images/eZuiHSYc66N54id9lPus7ApjTI.jpg?scale-down-to=2048 2048w,https://framerusercontent.com/images/eZuiHSYc66N54id9lPus7ApjTI.jpg 2774w`},``),layoutId:`F_fl3tgQH`,newTab:!0,padding:0,radius:8,style:{width:`100%`},width:`100%`})})}),a(L,{__framer__animate:{transition:W},__framer__animateOnce:!0,__framer__enter:J,__framer__exit:Y,__framer__styleAppearEffectEnabled:!0,__framer__threshold:0,__perspectiveFX:!1,__targetOpacity:1,className:`framer-96dd7u`,"data-framer-name":`Text`,style:{transformPerspective:1200},children:a(l,{__fromCanvasComponent:!0,children:o(r,{children:[a(`h3`,{className:`framer-styles-preset-1ld6jqb`,"data-styles-preset":`sYhPbbYF1`,children:a(`strong`,{children:`Leading the vision and execution of Velocity`})}),o(`p`,{className:`framer-styles-preset-1b1wlt8`,"data-styles-preset":`yywA2ZNZg`,style:{"--framer-text-alignment":`left`,"--framer-text-color":`var(--token-0f0ae4b9-e928-41c5-b457-bbd33ae176d3, rgb(89, 89, 89))`},children:[`As the product design leader, I defined the vision and strategy for Velocity, a fully web-based tool that streamlined video ad creation. Working closely with engineering, I led the design of an intuitive workflow that allowed users to trim videos, overlay animated brand elements, and generate polished, social-ready ads in minutes—without the need for professional editing software. The interface leveraged `,a(_,{href:{webPageId:`eyBp7dcac`},nodeId:`liQHNP7lJ`,openInNewTab:!1,smoothScroll:!1,children:a(`a`,{className:`framer-styles-preset-1wicq5s`,"data-styles-preset":`ro7OPezbn`,children:`Flite’s Design Studio`})}),`, ensuring flexibility while keeping the process simple and accessible.`]}),a(`p`,{className:`framer-styles-preset-1b1wlt8`,"data-styles-preset":`yywA2ZNZg`,style:{"--framer-text-alignment":`left`,"--framer-text-color":`var(--token-0f0ae4b9-e928-41c5-b457-bbd33ae176d3, rgb(89, 89, 89))`},children:a(`br`,{className:`trailing-break`})}),o(`p`,{className:`framer-styles-preset-1b1wlt8`,"data-styles-preset":`yywA2ZNZg`,style:{"--framer-text-alignment":`left`,"--framer-text-color":`var(--token-0f0ae4b9-e928-41c5-b457-bbd33ae176d3, rgb(89, 89, 89))`},children:[`Beyond product design, I developed the\xA0`,a(`strong`,{children:`Velocity`}),`\xA0name and branding, working with marketing to create a strong visual identity that was integrated into sales and promotional materials. This ensured the tool had a compelling story that resonated with customers.`]})]}),className:`framer-ruyge5`,"data-framer-name":`Paragraph`,fonts:[`Inter`,`Inter-Bold`],verticalAlignment:`top`,withExternalLayout:!0})}),a(v,{children:a(I,{__framer__animate:{transition:W},__framer__animateOnce:!0,__framer__enter:J,__framer__exit:Y,__framer__styleAppearEffectEnabled:!0,__framer__threshold:0,__perspectiveFX:!1,__targetOpacity:1,className:`framer-1auh1bx-container`,style:{transformPerspective:1200},children:a(O,{alt:`Sample project image`,height:`100%`,id:`QkE8D03Ud`,image:X({src:`https://framerusercontent.com/images/1Guy0Cjem0cQAy0qlLVLA4qnZM4.jpg`,srcSet:`https://framerusercontent.com/images/1Guy0Cjem0cQAy0qlLVLA4qnZM4.jpg?scale-down-to=512 512w,https://framerusercontent.com/images/1Guy0Cjem0cQAy0qlLVLA4qnZM4.jpg?scale-down-to=1024 1024w,https://framerusercontent.com/images/1Guy0Cjem0cQAy0qlLVLA4qnZM4.jpg?scale-down-to=2048 2048w,https://framerusercontent.com/images/1Guy0Cjem0cQAy0qlLVLA4qnZM4.jpg 2774w`},``),layoutId:`QkE8D03Ud`,newTab:!0,padding:0,radius:8,style:{width:`100%`},width:`100%`})})}),a(L,{__framer__animate:{transition:W},__framer__animateOnce:!0,__framer__enter:J,__framer__exit:Y,__framer__styleAppearEffectEnabled:!0,__framer__threshold:0,__perspectiveFX:!1,__targetOpacity:1,className:`framer-139rb6b`,"data-framer-name":`Text`,style:{transformPerspective:1200},children:a(l,{__fromCanvasComponent:!0,children:o(r,{children:[a(`h3`,{className:`framer-styles-preset-1ld6jqb`,"data-styles-preset":`sYhPbbYF1`,children:a(`strong`,{children:`Driving impact and shaping the future of video ads`})}),a(`p`,{className:`framer-styles-preset-1b1wlt8`,"data-styles-preset":`yywA2ZNZg`,style:{"--framer-text-alignment":`left`,"--framer-text-color":`var(--token-0f0ae4b9-e928-41c5-b457-bbd33ae176d3, rgb(89, 89, 89))`},children:`Velocity gave marketers the power to create compelling vertical ads in hours or days—far faster than the weeks it would take a professional video editor. By removing technical barriers, it made high-quality video ad production accessible to more brands, helping them scale their advertising across platforms like Snapchat, Instagram, and Facebook.`}),a(`p`,{className:`framer-styles-preset-1b1wlt8`,"data-styles-preset":`yywA2ZNZg`,style:{"--framer-text-alignment":`left`,"--framer-text-color":`var(--token-0f0ae4b9-e928-41c5-b457-bbd33ae176d3, rgb(89, 89, 89))`},children:a(`br`,{className:`trailing-break`})}),o(`p`,{className:`framer-styles-preset-1b1wlt8`,"data-styles-preset":`yywA2ZNZg`,style:{"--framer-text-alignment":`left`,"--framer-text-color":`var(--token-0f0ae4b9-e928-41c5-b457-bbd33ae176d3, rgb(89, 89, 89))`},children:[`Velocity’s success paved the way for\xA0`,a(_,{href:`https://snappublisher.snapchat.com/welcome`,nodeId:`gpTEM2d69`,openInNewTab:!0,smoothScroll:!1,children:a(`a`,{className:`framer-styles-preset-1wicq5s`,"data-styles-preset":`ro7OPezbn`,children:a(`strong`,{children:`Snap Publisher`})})}),`, Snapchat’s video ad creation tool, which continues to help brands produce engaging mobile-first video ads today.`]})]}),className:`framer-6pinyi`,"data-framer-name":`Paragraph`,fonts:[`Inter`,`Inter-Bold`],verticalAlignment:`top`,withExternalLayout:!0})}),a(v,{children:a(I,{__framer__animate:{transition:W},__framer__animateOnce:!0,__framer__enter:J,__framer__exit:Y,__framer__styleAppearEffectEnabled:!0,__framer__threshold:0,__perspectiveFX:!1,__targetOpacity:1,className:`framer-ef2ufw-container`,style:{transformPerspective:1200},children:a(O,{alt:`Sample project image`,height:`100%`,id:`aP_uIluJH`,image:X({src:`https://framerusercontent.com/images/DroXQWoKaQNkE3iC04kAXssBBsY.jpg`,srcSet:`https://framerusercontent.com/images/DroXQWoKaQNkE3iC04kAXssBBsY.jpg?scale-down-to=512 512w,https://framerusercontent.com/images/DroXQWoKaQNkE3iC04kAXssBBsY.jpg?scale-down-to=1024 1024w,https://framerusercontent.com