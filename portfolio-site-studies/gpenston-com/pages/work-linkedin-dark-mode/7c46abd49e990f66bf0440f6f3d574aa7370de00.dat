idth:`100%`},width:`100%`})})}),a(L,{__framer__animate:{transition:G},__framer__animateOnce:!0,__framer__enter:Y,__framer__exit:X,__framer__styleAppearEffectEnabled:!0,__framer__threshold:0,__perspectiveFX:!1,__targetOpacity:1,className:`framer-obihmb`,"data-framer-name":`Text`,style:{transformPerspective:1200},children:a(c,{__fromCanvasComponent:!0,children:o(r,{children:[a(`h3`,{className:`framer-styles-preset-1ld6jqb`,"data-styles-preset":`sYhPbbYF1`,children:`A more comfortable LinkedIn experience`}),o(`p`,{className:`framer-styles-preset-1b1wlt8`,"data-styles-preset":`yywA2ZNZg`,children:[`Building on `,a(ce,{href:`https://www.linkedin.com/pulse/how-our-new-look-embodies-linkedins-warm-welcoming-community-joann-wu/`,nodeId:`oAD0zK_R9`,openInNewTab:!0,smoothScroll:!1,children:a(`a`,{className:`framer-styles-preset-1wicq5s`,"data-styles-preset":`ro7OPezbn`,children:`our design refresh`})}),`—crafted to reflect LinkedIn’s diverse, warm, and welcoming community—Dark Mode was the next step in making the platform more adaptable to members' needs. More than just a visual update, it reduced eye strain, improved accessibility, and gave users greater control over their experience. Rolling it out at scale required a thoughtful balance of design consistency, accessibility, and seamless integration across a platform used by millions daily.`]})]}),className:`framer-1nqas29`,"data-framer-name":`Paragraph`,fonts:[`Inter`],verticalAlignment:`top`,withExternalLayout:!0})}),a(_,{children:a(I,{__framer__animate:{transition:G},__framer__animateOnce:!0,__framer__enter:Y,__framer__exit:X,__framer__styleAppearEffectEnabled:!0,__framer__threshold:0,__perspectiveFX:!1,__targetOpacity:1,className:`framer-1yx8lfk-container`,style:{transformPerspective:1200},children:a(D,{alt:`Sample project image`,height:`100%`,id:`TlBIrBF1d`,image:Z({src:`https://framerusercontent.com/images/44nmUajJ2LROhfZEWxHIKw0Qlw.png`,srcSet:`https://framerusercontent.com/images/44nmUajJ2LROhfZEWxHIKw0Qlw.png?scale-down-to=512 512w,https://framerusercontent.com/images/44nmUajJ2LROhfZEWxHIKw0Qlw.png?scale-down-to=1024 1024w,https://framerusercontent.com/images/44nmUajJ2LROhfZEWxHIKw0Qlw.png?scale-down-to=2048 2048w,https://framerusercontent.com/images/44nmUajJ2LROhfZEWxHIKw0Qlw.png?scale-down-to=4096 4096w,https://framerusercontent.com/images/44nmUajJ2LROhfZEWxHIKw0Qlw.png 4320w`},``),layoutId:`TlBIrBF1d`,newTab:!0,padding:0,radius:8,style:{width:`100%`},width:`100%`})})}),a(L,{__framer__animate:{transition:G},__framer__animateOnce:!0,__framer__enter:Y,__framer__exit:X,__framer__styleAppearEffectEnabled:!0,__framer__threshold:0,__perspectiveFX:!1,__targetOpacity:1,className:`framer-ahqs8l`,"data-framer-name":`Text`,style:{transformPerspective:1200},children:a(c,{__fromCanvasComponent:!0,children:o(r,{children:[a(`h3`,{className:`framer-styles-preset-1ld6jqb`,"data-styles-preset":`sYhPbbYF1`,style:{"--framer-text-alignment":`left`},children:`Leading dark mode from vision to launch`}),a(`p`,{className:`framer-styles-preset-1b1wlt8`,"data-styles-preset":`yywA2ZNZg`,style:{"--framer-text-alignment":`left`},children:`I led the vision, strategy, and execution of Dark Mode for LinkedIn’s consumer app, working closely with product, engineering, and accessibility teams to ensure a smooth rollout. With over 10,000 color usages to rethink, we redefined contrast ratios, color semantics, and brand integrity across both light and dark settings. Every decision had to balance aesthetics with functionality, ensuring a cohesive and polished experience across the platform.`})]}),className:`framer-1h7xm0e`,"data-framer-name":`Paragraph`,fonts:[`Inter`],verticalAlignment:`top`,withExternalLayout:!0})}),a(_,{children:a(I,{__framer__animate:{transition:G},__framer__animateOnce:!0,__framer__enter:Y,__framer__exit:X,__framer__styleAppearEffectEnabled:!0,__framer__threshold:0,__perspectiveFX:!1,__targetOpacity:1,className:`framer-9ls6g6-container`,style:{transformPerspective:1200},children:a(D,{alt:`Sample project image`,height:`100%`,id:`Ji6Hi7v8W`,image:Z({src:`https://framerusercontent.com/images/7kU7wsXyEQe1iSD4IzOqbToCXo.png`,srcSet:`https://framerusercontent.com/images/7kU7wsXyEQe1iSD4IzOqbToCXo.png?scale-down-to=512 512w,https://framerusercontent.com/images/7kU7wsXyEQe1iSD4IzOqbToCXo.png?scale-down-to=1024 1024w,https://framerusercontent.com/images/7kU7wsXyEQe1iSD4IzOqbToCXo.png?scale-down-to=2048 2048w,https://framerusercontent.com/images/7kU7wsXyEQe1iSD4IzOqbToCXo.png?scale-down-to=4096 4096w,https://framerusercontent.com/images/7kU7wsXyEQe1iSD4IzOqbToCXo.png 4320w`},``),layoutId:`Ji6Hi7v8W`,newTab:!0,padding:0,radius:8,style:{width:`100%`},width:`100%`})})}),a(L,{__framer__animate:{transition:G},__framer__animateOnce:!0,__framer__enter:Y,__framer__exit:X,__framer__styleAppearEffectEnabled:!0,__framer__threshold:0,__perspectiveFX:!1,__targetOpacity:1,className:`framer-a55urf`,"data-framer-name":`Text`,style:{transformPerspective:1200},children:a(c,{__fromCanvasComponent:!0,children:o(r,{children:[a(`h3`,{className:`framer-styles-preset-1ld6jqb`,"data-styles-preset":`sYhPbbYF1`,style:{"--framer-text-alignment":`left`},children:`Designing for accessibility and usability`}),a(`p`,{className:`framer-styles-preset-1b1wlt8`,"data-styles-preset":`yywA2ZNZg`,style:{"--framer-text-alignment":`left`},children:`Dark Mode had to be more than just a color shift—it needed to enhance usability. We refined color palettes for optimal contrast, reduced glare in low-light settings, and ensured interactive elements remained intuitive. Every design choice reinforced comfort, readability, and accessibility.`}),a(`p`,{className:`framer-styles-preset-1b1wlt8`,"data-styles-preset":`yywA2ZNZg`,style:{"--framer-text-alignment":`left`},children:a(`br`,{className:`trailing-break`})}),a(`p`,{className:`framer-styles-preset-1b1wlt8`,"data-styles-preset":`yywA2ZNZg`,style:{"--framer-text-alignment":`left`},children:`Beyond colors, we fine-tuned motion, depth, and interactive states to create a smooth, fatigue-free experience. This was also an opportunity to expand our illustration system into Dark Mode, designing visuals that complemented the darker aesthetic while maintaining warmth and inclusivity. The result was a Dark Mode experience that felt polished, natural, and seamlessly integrated with LinkedIn’s broader design principles.`})]}),className:`framer-1vfso64`,"data-framer-name":`Paragraph`,fonts:[`Inter`],verticalAlignment:`top`,withExternalLayout:!0})}),a(_,{children:a(I,{__framer__animate:{transition:G},__framer__animateOnce:!0,__framer__enter:Y,__framer__exit:X,__framer__styleAppearEffectEnabled:!0,__framer__threshold:0,__perspectiveFX:!1,__targetOpacity:1,className:`framer-1pdbgk4-container`,style:{transformPerspective:1200},children:a(D,{alt:`Sample project image`,height:`100%`,id:`hYiLvmOxs`,image:Z({src:`https://framerusercontent.com/images/ofOnqtQSMCPnwgTGjPGtzJ5fI.gif`,srcSet:`https://framerusercontent.com/images/ofOnqtQSMCPnwgTGjPGtzJ5fI.gif?scale-down-to=512 512w,https://framerusercontent.com/images/ofOnqtQSMCPnwgTGjPGtzJ5fI.gif 835w`},``),layoutId:`hYiLvmOxs`,newTab:!0,padding:0,radius:8,style:{width:`100%`},width:`100%`})})}),a(L,{__framer__animate:{transition:G},__framer__animateOnce:!0,__framer__enter:Y,__framer__exit:X,__framer__styleAppearEffectEnabled:!0,__framer__threshold:0,__perspectiveFX:!1,__targetOpacity:1,className:`framer-10kqutt`,"data-framer-name":`Text`,style:{transformPerspective:1200},children:a(c,{__fromCanvasComponent:!0,children:o(r,{children:[a(`h3`,{className:`framer-styles-preset-1ld6jqb`,"data-styles-preset":`sYhPbbYF1`,style:{"--framer-text-alignment":`left`},children:`How members reacted to dark mode`}),a(`p`,{className:`framer-styles-preset-1b1wlt8`,"data-styles-preset":`yywA2ZNZg`,style:{"--framer-text-alignment":`left`},children:`Dark Mode was one of LinkedIn’s most requested features, and its launch was met with overwhelming enthusiasm. Many members actively sought early access, with some even following support articles to join the rollout as soon as possible. App Store reviews quickly reflected excitement—Dark Mode became one of the most mentioned and praised features, driving a surge in positive feedback about LinkedIn’s UI. This response underscored the demand for more personalization and accessibility-driven improvements across the platform.`})]}),className:`framer-1nk71q`,"data-framer-name":`Paragraph`,fonts:[`Inter`],verticalAlignment:`top`,withExternalLayout:!0})}),a(_,{children:a(I,{__framer__animate:{transition:G},__framer__animateOnce:!0,__framer__enter:Y,__framer__exit:X,__framer__styleAppearEffectEnabled:!0,__framer__threshold:0,__perspectiveFX:!1,__targetOpacity:1,className:`framer-1c5tsuk-container`,style:{transformPerspective:1200},children:a(D,{alt:`Sample project image`,height:`100%`,id:`J65bouI33`,image:Z({src:`https://framerusercontent.com/images/Cjxty1vmPYwgnp5duPR5rnigN4.png`,srcSet:`https://framerusercontent.com/images/Cjxty1vmPYwgnp5duPR5rnigN4.png?scale-down-to=512 512w,https://framerusercontent.com/images/Cjxty1vmPYwgnp5duPR5rnigN4.png?scale-down-to=1024 1024w,https://framerusercontent.com/images/Cjxty1vmPYwgnp5duPR5rnigN4.png?scale-down-to=2048 2048w,https://framerusercontent.com/images/Cjxty1vmPYwgnp5duPR5rnigN4.png?scale-down-to=4096 4096w,https://framerusercontent.com/images/Cjxty1vmPYwgnp5duPR5rnigN4.png 4320w`},``),layoutId:`J65bouI33`,newTab:!0,padding:0,radius:8,style:{width:`100%`},width:`100%`})})}),o(L,{__framer__animate:{transition:G},__framer__animateOnce:!0,__framer__enter:Y,__framer__exit:X,__framer__styleAppearEffectEnabled:!0,__framer__threshold:0,__perspectiveFX:!1,__targetOpacity:1,className:`framer-thukg9`,"data-framer-name":`Text`,style:{transformPerspective:1200},children:[a(c,{__fromCanvasComponent:!0,children:o(r,{children:[a(`h3`,{className:`framer-styles-preset-1ld6jqb`,"data-styles-preset":`sYhPbbYF1`,style:{"--framer-text-alignment":`left`},children:`Key takeaways & lessons learned`}),a(`p`,{className:`fra