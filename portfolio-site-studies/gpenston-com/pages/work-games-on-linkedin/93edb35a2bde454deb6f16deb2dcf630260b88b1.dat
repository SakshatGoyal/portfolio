t.com/images/iNMQPJfeBpR3gNcR8hYgIVmMb8.png`,srcSet:`https://framerusercontent.com/images/iNMQPJfeBpR3gNcR8hYgIVmMb8.png?scale-down-to=512 512w,https://framerusercontent.com/images/iNMQPJfeBpR3gNcR8hYgIVmMb8.png?scale-down-to=1024 1024w,https://framerusercontent.com/images/iNMQPJfeBpR3gNcR8hYgIVmMb8.png?scale-down-to=2048 2048w,https://framerusercontent.com/images/iNMQPJfeBpR3gNcR8hYgIVmMb8.png 3840w`},``),layoutId:`uCVLnnQOl`,newTab:!0,padding:0,radius:8,style:{width:`100%`},width:`100%`})})}),a(I,{__framer__animate:{transition:G},__framer__animateOnce:!0,__framer__enter:Y,__framer__exit:X,__framer__styleAppearEffectEnabled:!0,__framer__threshold:0,__perspectiveFX:!1,__targetOpacity:1,className:`framer-p5xd7e`,"data-framer-name":`Text`,style:{transformPerspective:1200},children:a(c,{__fromCanvasComponent:!0,children:o(r,{children:[a(`h3`,{className:`framer-styles-preset-1ld6jqb`,"data-styles-preset":`sYhPbbYF1`,style:{"--framer-text-alignment":`left`},children:`Why games on LinkedIn?`}),a(`p`,{className:`framer-styles-preset-1b1wlt8`,"data-styles-preset":`yywA2ZNZg`,style:{"--framer-text-alignment":`left`},children:`Games on LinkedIn? Yep. Every year, we study the world’s best workplaces, and one thing is clear—having fun together strengthens relationships. So we set out to bring games to LinkedIn to help people connect in a more natural, engaging way.`}),a(`p`,{className:`framer-styles-preset-1b1wlt8`,"data-styles-preset":`yywA2ZNZg`,style:{"--framer-text-alignment":`left`,"--framer-text-color":`var(--token-0f0ae4b9-e928-41c5-b457-bbd33ae176d3, rgb(89, 89, 89))`},children:a(`br`,{className:`trailing-break`})}),a(`p`,{className:`framer-styles-preset-1b1wlt8`,"data-styles-preset":`yywA2ZNZg`,style:{"--framer-text-alignment":`left`},children:`Many members struggle to start conversations and maintain professional relationships. Seeing this, I saw an opportunity to turn play into a tool for connection. Our goal was simple: introduce lighthearted experiences that make it easier to spark conversations, build relationships, and make work feel more human.`})]}),className:`framer-1a785j1`,"data-framer-name":`Paragraph`,fonts:[`Inter`],verticalAlignment:`top`,withExternalLayout:!0})}),a(g,{children:a(F,{__framer__animate:{transition:G},__framer__animateOnce:!0,__framer__enter:Y,__framer__exit:X,__framer__styleAppearEffectEnabled:!0,__framer__threshold:0,__perspectiveFX:!1,__targetOpacity:1,className:`framer-18p4b0-container`,isAuthoredByUser:!0,isModuleExternal:!0,nodeId:`Rmm_GXkfA`,rendersWithMotion:!0,scopeId:`DDqlp2boE`,style:{transformPerspective:1200},children:a(E,{alt:`Sample project image`,height:`100%`,id:`Rmm_GXkfA`,image:Z({src:`https://framerusercontent.com/images/ByqfWR28fmHD2HaRs5d71JNdwpU.png`,srcSet:`https://framerusercontent.com/images/ByqfWR28fmHD2HaRs5d71JNdwpU.png?scale-down-to=512 512w,https://framerusercontent.com/images/ByqfWR28fmHD2HaRs5d71JNdwpU.png?scale-down-to=1024 1024w,https://framerusercontent.com/images/ByqfWR28fmHD2HaRs5d71JNdwpU.png?scale-down-to=2048 2048w,https://framerusercontent.com/images/ByqfWR28fmHD2HaRs5d71JNdwpU.png 3840w`},``),layoutId:`Rmm_GXkfA`,newTab:!0,padding:0,radius:8,style:{width:`100%`},width:`100%`})})}),a(g,{children:a(F,{__framer__animate:{transition:G},__framer__animateOnce:!0,__framer__enter:Y,__framer__exit:X,__framer__styleAppearEffectEnabled:!0,__framer__threshold:0,__perspectiveFX:!1,__targetOpacity:1,className:`framer-1de4tgv-container`,isAuthoredByUser:!0,isModuleExternal:!0,nodeId:`jrcPD1AWA`,rendersWithMotion:!0,scopeId:`DDqlp2boE`,style:{transformPerspective:1200},children:a(E,{alt:`Sample project image`,height:`100%`,id:`jrcPD1AWA`,image:Z({src:`https://framerusercontent.com/images/iivU26yUu4XRS1ixDl4d2yoVEA.png`,srcSet:`https://framerusercontent.com/images/iivU26yUu4XRS1ixDl4d2yoVEA.png?scale-down-to=512 512w,https://framerusercontent.com/images/iivU26yUu4XRS1ixDl4d2yoVEA.png?scale-down-to=1024 1024w,https://framerusercontent.com/images/iivU26yUu4XRS1ixDl4d2yoVEA.png?scale-down-to=2048 2048w,https://framerusercontent.com/images/iivU26yUu4XRS1ixDl4d2yoVEA.png 3840w`},``),layoutId:`jrcPD1AWA`,newTab:!0,padding:0,radius:8,style:{width:`100%`},width:`100%`})})}),a(I,{__framer__animate:{transition:G},__framer__animateOnce:!0,__framer__enter:Y,__framer__exit:X,__framer__styleAppearEffectEnabled:!0,__framer__threshold:0,__perspectiveFX:!1,__targetOpacity:1,className:`framer-1he6mwe`,"data-framer-name":`Text`,style:{transformPerspective:1200},children:a(c,{__fromCanvasComponent:!0,children:o(r,{children:[a(`h3`,{className:`framer-styles-preset-1ld6jqb`,"data-styles-preset":`sYhPbbYF1`,style:{"--framer-text-alignment":`left`},children:`Designing purposeful play`}),a(`p`,{className:`framer-styles-preset-1b1wlt8`,"data-styles-preset":`yywA2ZNZg`,style:{"--framer-text-alignment":`left`,"--framer-text-color":`var(--token-0f0ae4b9-e928-41c5-b457-bbd33ae176d3, rgb(89, 89, 89))`},children:`I led the initiative to design games tailored for workday breaks—quick to learn in under a minute, playable in less than five, yet challenging enough to be rewarding. We developed realistic prototypes incorporating sound, motion, and haptics to delight users. Start screens were crafted to grab attention, clearly explain the game, and entice players, with careful consideration given to names, icons, and colors to make each game distinct.`}),a(`p`,{className:`framer-styles-preset-1b1wlt8`,"data-styles-preset":`yywA2ZNZg`,style:{"--framer-text-alignment":`left`,"--framer-text-color":`var(--token-0f0ae4b9-e928-41c5-b457-bbd33ae176d3, rgb(89, 89, 89))`},children:a(`br`,{className:`trailing-break`})}),a(`p`,{className:`framer-styles-preset-1b1wlt8`,"data-styles-preset":`yywA2ZNZg`,style:{"--framer-text-alignment":`left`,"--framer-text-color":`var(--token-0f0ae4b9-e928-41c5-b457-bbd33ae176d3, rgb(89, 89, 89))`},children:`To boost engagement, features were implemented to display which connections had played, along with player rankings by company or school. End screens celebrated success, encouraged score sharing, and introduced streaks and achievements to motivate daily participation.`})]}),className:`framer-hdvhto`,"data-framer-name":`Paragraph`,fonts:[`Inter`],verticalAlignment:`top`,withExternalLayout:!0})}),a(g,{children:a(F,{__framer__animate:{transition:G},__framer__animateOnce:!0,__framer__enter:Y,__framer__exit:X,__framer__styleAppearEffectEnabled:!0,__framer__threshold:0,__perspectiveFX:!1,__targetOpacity:1,className:`framer-25lm6q-container`,isAuthoredByUser:!0,isModuleExternal:!0,nodeId:`CoeYMnXeB`,rendersWithMotion:!0,scopeId:`DDqlp2boE`,style:{transformPerspective:1200},children:a(E,{alt:`Sample project image`,height:`100%`,id:`CoeYMnXeB`,image:Z({src:`https://framerusercontent.com/images/xyBlSK2dlQVWNw8CTu4Y1SMllU.png`,srcSet:`https://framerusercontent.com/images/xyBlSK2dlQVWNw8CTu4Y1SMllU.png?scale-down-to=512 512w,https://framerusercontent.com/images/xyBlSK2dlQVWNw8CTu4Y1SMllU.png?scale-down-to=1024 1024w,https://framerusercontent.com/images/xyBlSK2dlQVWNw8CTu4Y1SMllU.png?scale-down-to=2048 2048w,https://framerusercontent.com/images/xyBlSK2dlQVWNw8CTu4Y1SMllU.png 3840w`},``),layoutId:`CoeYMnXeB`,newTab:!0,padding:0,radius:8,style:{width:`100%`},width:`100%`})})}),a(I,{__framer__animate:{transition:G},__framer__animateOnce:!0,__framer__enter:Y,__framer__exit:X,__framer__styleAppearEffectEnabled:!0,__framer__threshold:0,__perspectiveFX:!1,__targetOpacity:1,className:`framer-1wx2j3j`,"data-framer-name":`Text`,style:{transformPerspective:1200},children:a(c,{__fromCanvasComponent:!0,children:o(r,{children:[a(`h3`,{className:`framer-styles-preset-1ld6jqb`,"data-styles-preset":`sYhPbbYF1`,style:{"--framer-text-alignment":`left`},children:`From concept to connection`}),o(`p`,{className:`framer-styles-preset-1b1wlt8`,"data-styles-preset":`yywA2ZNZg`,style:{"--framer-text-alignment":`left`,"--framer-text-color":`var(--token-0f0ae4b9-e928-41c5-b457-bbd33ae176d3, rgb(89, 89, 89))`},children:[`Despite initial skepticism within LinkedIn about launching games, the initiative has been well-received. Members and the public have found the games enjoyable and effective in fostering connections. The press, `,a(le,{href:`https://www.theverge.com/24152045/linkedin-games-crossclimb-queens-pinpoint`,motionChild:!0,nodeId:`kAQqBoJYK`,openInNewTab:!0,smoothScroll:!1,children:a(s.a,{className:`framer-styles-preset-1wicq5s`,"data-styles-preset":`ro7OPezbn`,children:`albeit begrudgingly at times`})}),`, admits they're fun and foster connections.`]}),a(`p`,{className:`framer-styles-preset-1b1wlt8`,"data-styles-preset":`yywA2ZNZg`,style:{"--framer-text-alignment":`left`,"--framer-text-color":`var(--token-0f0ae4b9-e928-41c5-b457-bbd33ae176d3, rgb(89, 89, 89))`},children:a(`br`,{className:`trailing-break`})}),a(`p`,{className:`framer-styles-preset-1b1wlt8`,"data-styles-preset":`yywA2ZNZg`,style:{"--framer-text-alignment":`left`,"--framer-text-color":`var(--token-0f0ae4b9-e928-41c5-b457-bbd33ae176d3, rgb(89, 89, 89))`},children:`LinkedIn games are helping deepen and reignite professional relationships. Growth is fueled by people connecting and sharing scores, with nearly half of new players joining through a connection that messaged them. Engagement has remained strong, with players returning consistently over time. This bold experiment has proven its value, and I’m proud of what we’ve achieved.`})]}),className:`framer-1h2ipo3`,"data-framer-name":`Paragraph`,fonts:[`Inter`],verticalAlignment:`top`,withExternalLayout:!0})}),a(g,{children:a(F,{__framer__animate:{transition:G},__framer__animateOnce:!0,__framer__enter:Y,__framer__exit:X,__framer__styleAppearEffectEnabled:!0,__framer__threshold:0,__perspectiveFX:!1,__targetOpacity:1,className:`framer-1evqggu-container`,isAuthoredByUser:!0,isModuleExternal:!0,nodeId:`ezsKdZQ5v`,rendersWithMotion:!0,scopeId:`DDqlp2boE`,style:{transformPerspective:1200},children:a(E,{alt:`Sample project image`,height:`100%`,id:`ezsKdZQ5v`,image:Z({src:`https://framerusercontent.com/images/BGKGvYN9fA6Oj7eJ9Ww5Mm9cRU.png`,srcSet:`https://framerusercontent.com/images/BGKGvYN9fA6Oj7eJ9Ww5Mm9cRU.png?scale-down-to=512 512w,https://framerusercontent.com/images/BGKGvYN9fA6Oj7eJ9Ww5Mm9cRU.png?scale-down-to=1024 1024w,https://framerusercontent.com/images/BGKGvYN9fA6Oj7eJ9Ww5Mm9cRU.png?scale-down-to=2048 2048w,https://framerusercontent.com/images/BGKGvYN9fA6Oj7eJ9Ww5Mm9cRU.png 3840w`},``),layoutId:`ezsKdZQ5v`,link:`https://www.theverge.com/24152045/linkedin-games-crossclimb-queens-pinpoint`,newTab:!0,padding:0,radius:8,style:{width:`100%`},width:`100%`})})}),o(I,{__framer__animate:{transition:G},__framer__animateOnce:!0,__framer__enter:Y,__framer__exit:X,__framer__styleAppearEffectEnabled:!0,__framer__threshold:0,__perspectiveFX:!1,__targetOpacity:1,className:`framer-14y2vu2`,"data-framer-name":`Text`,style:{transformPerspective:1200},children:[a(c,{__fromCanvasComponent:!0,children:o(r,{children:[a(`h3`,{className:`framer-styles-preset-1ld6jqb`,"data-styles-preset":`sYhPbbYF1`,children:`Key takeaways & lessons learned`}),a(`p`,{className:`framer-styles-preset-1b1wlt8`,"data-styles-preset":`yywA2ZNZg`,style:{"--framer-text-alignment":`left`},children:`This initiative reinforced a simple truth: people connect better when they’re having fun. Games helped bridge engagement gaps, proving that even professional platforms benefit from play. By designing quick, enjoyable experiences, we made it easier for people to interact naturally without disrupting LinkedIn’s core mission.`}),a(`p`,{className:`framer-styles-preset-1b1wlt8`,"data-styles-preset":`yywA2ZNZg`,style:{"--framer-text-alignment":`left`,"--framer-text-color":`var(--token-0f0ae4b9-e928-41c5-b457-bbd33ae176d3, rgb(89, 89, 89))`},children:a(`br`,{className:`trailing-break`})}),a(`p`,{className:`framer-styles-preset-1b1wlt8`,"data-styles-preset":`yywA2ZNZg`,style:{"--framer-text-alignment":`left`},children:`Social features kept players engaged. Seeing connections’ scores and rankings sparked friendly competition and encouraged participation. These elements made interactions feel dynamic, helping people build and maintain relationships effortlessly.`}),a(`p`,{className:`framer-styles-preset-1b1wlt8`,"data-styles-preset":`yywA2ZNZg`,style:{"--framer-text-alignment":`left`,"--framer-text-color":`var(--token-0f0ae4b9-e928-41c5-b457-bbd33ae176d3, rgb(89, 89, 89))`},children:a(`br`,{className:`trailing-break`})}),a(`p`,{className:`framer-styles-preset-1b1wlt8`,"data-styles-preset":`yywA2ZNZg`,style:{"--framer-text-alignment":`left`},children:`Games on LinkedIn have given members a fresh way to connect and engage. Their success proves that adding play to professional spaces strengthens relationships and fosters meaningful interactions.`})]}),className:`framer-1cyrmlp`,"data-framer-name":`Paragraph`,fonts:[`Inter`],id:`1cyrmlp`,verticalAlignment:`top`,withExternalLayout:!0}),a(v,{breakpoint:h,overrides:{IK5zt7SB0:{y:(C?.y||0)+0+0+32+128+0+2629+0+652},Zj308hfwi:{y:(C?.y||0)+0+0+24+128+0+2629+0+652}},children:a(g,{height:24,y:(C?.y||0)+0+0+40+168+0+2812+0+660,children:a(m,{className:`framer-1vsrl0a-container`,nodeId:`dUjLLj1WD`,scopeId:`DDqlp2boE`,children:a(D,{height:`100%`,id:`dUjLLj1WD`,jyhgb_E8i:!0,layoutId:`dUjLLj1WD`,mTauNxMoD:`Play the games`,oEWk4tLoH:`https://www.linkedin.com/games/`,width:`100%`})})})})]}),a(g,{children:a(F,{__framer__animate:{transition:G},__framer__animateOnce:!0,__framer__enter:Y,__framer__exit:X,__framer__styleAppearEffectEnabled:!0,__framer__threshold:0,__perspectiveFX:!1,__targetOpacity:1,className:`framer-101gcba-container`,isAuthoredByUser:!0,isModuleExternal:!0,nodeId:`dZHkWDcON`,rendersWithMotion:!0,scopeId:`DDqlp2boE`,style:{transformPerspective:1200},children:a(k,{borderRadius:8,bottomLeftRadius:8,bottomRightRadius:8,height:`100%`,id:`dZHkWDcON`,isMixedBorderRadius:!1,isRed:!1,layoutId:`dZHkWDcON`,play:`Off`,shouldMute:!0,style:{height:`100%`,width:`100%`},thumbnail:`Medium Quality`,topLeftRadius:8,topRightRadius:8,url:`https://www.y