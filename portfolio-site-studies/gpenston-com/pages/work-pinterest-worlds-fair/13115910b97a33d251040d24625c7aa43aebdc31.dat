,__framer__animateOnce:!0,__framer__enter:q,__framer__exit:J,__framer__styleAppearEffectEnabled:!0,__framer__threshold:0,__perspectiveFX:!1,__targetOpacity:1,className:`framer-13vyj7n`,"data-framer-name":`Text`,style:{transformPerspective:1200},children:a(l,{__fromCanvasComponent:!0,children:o(r,{children:[a(`h3`,{className:`framer-styles-preset-1ld6jqb`,"data-styles-preset":`sYhPbbYF1`,style:{"--framer-text-alignment":`left`},children:`Making room for bold ideas`}),a(`p`,{className:`framer-styles-preset-1b1wlt8`,"data-styles-preset":`yywA2ZNZg`,style:{"--framer-text-alignment":`left`,"--framer-text-color":`var(--token-0f0ae4b9-e928-41c5-b457-bbd33ae176d3, rgb(89, 89, 89))`},children:`Pinterest’s ad products were effective, but innovation often took a backseat to execution. I saw an opportunity to change that. I wanted to push beyond incremental improvements and create a structured way to explore bold new ad experiences. The challenge was clear: how could I carve out space for future-focused thinking without disrupting ongoing priorities?`})]}),className:`framer-safym0`,"data-framer-name":`Paragraph`,fonts:[`Inter`],verticalAlignment:`top`,withExternalLayout:!0})}),a(_,{children:a(F,{__framer__animate:{transition:U},__framer__animateOnce:!0,__framer__enter:q,__framer__exit:J,__framer__styleAppearEffectEnabled:!0,__framer__threshold:0,__perspectiveFX:!1,__targetOpacity:1,className:`framer-z5lmgd-container`,style:{transformPerspective:1200},children:a(D,{alt:`Sample project image`,height:`100%`,id:`n3dIJcLR4`,image:Y({src:`https://framerusercontent.com/images/QPXmSm3zCJXRFllQDgjh5Pygsc.jpeg`,srcSet:`https://framerusercontent.com/images/QPXmSm3zCJXRFllQDgjh5Pygsc.jpeg?scale-down-to=512 512w,https://framerusercontent.com/images/QPXmSm3zCJXRFllQDgjh5Pygsc.jpeg?scale-down-to=1024 1024w,https://framerusercontent.com/images/QPXmSm3zCJXRFllQDgjh5Pygsc.jpeg 1920w`},``),layoutId:`n3dIJcLR4`,newTab:!0,padding:0,radius:8,style:{width:`100%`},width:`100%`})})}),a(I,{__framer__animate:{transition:U},__framer__animateOnce:!0,__framer__enter:q,__framer__exit:J,__framer__styleAppearEffectEnabled:!0,__framer__threshold:0,__perspectiveFX:!1,__targetOpacity:1,className:`framer-dquye2`,"data-framer-name":`Text`,style:{transformPerspective:1200},children:a(l,{__fromCanvasComponent:!0,children:o(r,{children:[a(`h3`,{className:`framer-styles-preset-1ld6jqb`,"data-styles-preset":`sYhPbbYF1`,style:{"--framer-text-alignment":`left`},children:`A quarterly innovation sprint`}),o(`p`,{className:`framer-styles-preset-1b1wlt8`,"data-styles-preset":`yywA2ZNZg`,style:{"--framer-text-alignment":`left`,"--framer-text-color":`var(--token-0f0ae4b9-e928-41c5-b457-bbd33ae176d3, rgb(89, 89, 89))`},children:[`I led the creation of the\xA0`,a(`strong`,{children:`Pinterest World’s Fair`}),`, a recurring initiative designed to drive innovation at scale. Each quarter, I identified a key theme—such as\xA0`,a(`strong`,{children:`Next-Gen Shopping Ads`}),`\xA0or\xA0`,a(`strong`,{children:`Interactive Campaign Reporting`}),`—based on emerging trends and business needs.`]}),a(`p`,{className:`framer-styles-preset-1b1wlt8`,"data-styles-preset":`yywA2ZNZg`,style:{"--framer-text-alignment":`left`,"--framer-text-color":`var(--token-0f0ae4b9-e928-41c5-b457-bbd33ae176d3, rgb(89, 89, 89))`},children:`To ensure meaningful outcomes, I structured the workshop format to move teams rapidly from concept to prototype. Designers, researchers, engineers, and product managers collaborated in real time, while user research provided critical insights. Rather than letting ideas remain theoretical, I ensured that high-potential concepts were refined, validated, and positioned for production.`})]}),className:`framer-1ve281a`,"data-framer-name":`Paragraph`,fonts:[`Inter`,`Inter-Bold`],verticalAlignment:`top`,withExternalLayout:!0})}),a(_,{children:a(F,{__framer__animate:{transition:U},__framer__animateOnce:!0,__framer__enter:q,__framer__exit:J,__framer__styleAppearEffectEnabled:!0,__framer__threshold:0,__perspectiveFX:!1,__targetOpacity:1,className:`framer-1503nh6-container`,style:{transformPerspective:1200},children:a(D,{alt:`Sample project image`,height:`100%`,id:`eiEgtoZbY`,image:Y({src:`https://framerusercontent.com/images/fgWaEQtoWOG8j1OHemOqWQWbqo.jpeg`,srcSet:`https://framerusercontent.com/images/fgWaEQtoWOG8j1OHemOqWQWbqo.jpeg?scale-down-to=512 512w,https://framerusercontent.com/images/fgWaEQtoWOG8j1OHemOqWQWbqo.jpeg?scale-down-to=1024 1024w,https://framerusercontent.com/images/fgWaEQtoWOG8j1OHemOqWQWbqo.jpeg 1920w`},``),layoutId:`eiEgtoZbY`,newTab:!0,padding:0,radius:8,style:{width:`100%`},width:`100%`})})}),a(_,{children:a(F,{__framer__animate:{transition:U},__framer__animateOnce:!0,__framer__enter:q,__framer__exit:J,__framer__styleAppearEffectEnabled:!0,__framer__threshold:0,__perspectiveFX:!1,__targetOpacity:1,className:`framer-k16bgf-container`,style:{transformPerspective:1200},children:a(D,{alt:`Sample project image`,height:`100%`,id:`LAjIQzkJT`,image:Y({src:`https://framerusercontent.com/images/NT3mWamYgIuWYiCTeyYirL7i9Gg.jpeg`,srcSet:`https://framerusercontent.com/images/NT3mWamYgIuWYiCTeyYirL7i9Gg.jpeg?scale-down-to=512 512w,https://framerusercontent.com/images/NT3mWamYgIuWYiCTeyYirL7i9Gg.jpeg?scale-down-to=1024 1024w,https://framerusercontent.com/images/NT3mWamYgIuWYiCTeyYirL7i9Gg.jpeg 1920w`},``),layoutId:`LAjIQzkJT`,newTab:!0,padding:0,radius:8,style:{width:`100%`},width:`100%`})})}),a(I,{__framer__animate:{transition:U},__framer__animateOnce:!0,__framer__enter:q,__framer__exit:J,__framer__styleAppearEffectEnabled:!0,__framer__threshold:0,__perspectiveFX:!1,__targetOpacity:1,className:`framer-13ayza6`,"data-framer-name":`Text`,style:{transformPerspective:1200},children:a(l,{__fromCanvasComponent:!0,children:o(r,{children:[a(`h3`,{className:`framer-styles-preset-1ld6jqb`,"data-styles-preset":`sYhPbbYF1`,style:{"--framer-text-alignment":`left`},children:`From concept to reality`}),o(`p`,{className:`framer-styles-preset-1b1wlt8`,"data-styles-preset":`yywA2ZNZg`,style:{"--framer-text-alignment":`left`,"--framer-text-color":`var(--token-0f0ae4b9-e928-41c5-b457-bbd33ae176d3, rgb(89, 89, 89))`},children:[`The\xA0`,a(`strong`,{children:`World’s Fair`}),`\xA0directly influenced Pinterest’s ad roadmap. Several concepts moved into production, shaping how advertisers engage with users. One example was\xA0`,a(`strong`,{children:`Objective-Based Campaigns`}),`, which evolved beyond traditional advertising performance metrics to better align with business goals. Another, `,a(`strong`,{children:`Shopping Pins`}),`, introduced a more seamless way for users to discover and interact with branded content, enhancing both engagement and conversion.`]}),a(`p`,{className:`framer-styles-preset-1b1wlt8`,"data-styles-preset":`yywA2ZNZg`,style:{"--framer-text-alignment":`left`,"--framer-text-color":`var(--token-0f0ae4b9-e928-41c5-b457-bbd33ae176d3, rgb(89, 89, 89))`},children:a(`br`,{className:`trailing-break`})}),a(`p`,{className:`framer-styles-preset-1b1wlt8`,"data-styles-preset":`yywA2ZNZg`,style:{"--framer-text-alignment":`left`,"--framer-text-color":`var(--token-0f0ae4b9-e928-41c5-b457-bbd33ae176d3, rgb(89, 89, 89))`},children:`By leading this initiative, I set a new standard for structured innovation at Pinterest, ensuring teams had the space, strategy, and executive alignment needed to turn bold ideas into real-world impact.`})]}),className:`framer-1m3izpr`,"data-framer-name":`Paragraph`,fonts:[`Inter`,`Inter-Bold`],verticalAlignment:`top`,withExternalLayout:!0})}),a(_,{children:a(F,{__framer__animate:{transition:U},__framer__animateOnce:!0,__framer__enter:q,__framer__exit:J,__framer__styleAppearEffectEnabled:!0,__framer__threshold:0,__perspectiveFX:!1,__targetOpacity:1,className:`framer-1w9plmc-container`,style:{transformPerspective:1200},children:a(D,{alt:`Sample project image`,height:`100%`,id:`ZOmvsBUwZ`,image:Y({src:`https://framerusercontent.com/images/mU36ATpYWsr7qWEJ1FbaE2tho.jpeg`,srcSet:`https://framerusercontent.