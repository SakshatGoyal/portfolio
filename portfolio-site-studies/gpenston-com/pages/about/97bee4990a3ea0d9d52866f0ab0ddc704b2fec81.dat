styles-preset-1b1wlt8`,"data-styles-preset":`yywA2ZNZg`,dir:`auto`,style:{"--framer-text-alignment":`left`,"--framer-text-color":`var(--token-0f0ae4b9-e928-41c5-b457-bbd33ae176d3, rgb(89, 89, 89))`},children:`Product design is\xA0changing fast. AI\xA0tools have collapsed the distance between concept and something you can feel and interact with. I\xA0wanted to\xA0be\xA0closer to\xA0that, doing the work rather than directing it.`}),s(`p`,{className:`framer-styles-preset-1b1wlt8`,"data-styles-preset":`yywA2ZNZg`,dir:`auto`,style:{"--framer-text-alignment":`left`,"--framer-text-color":`var(--token-0f0ae4b9-e928-41c5-b457-bbd33ae176d3, rgb(89, 89, 89))`},children:s(`br`,{className:`trailing-break`})}),s(`p`,{className:`framer-styles-preset-1b1wlt8`,"data-styles-preset":`yywA2ZNZg`,dir:`auto`,style:{"--framer-text-alignment":`left`,"--framer-text-color":`var(--token-0f0ae4b9-e928-41c5-b457-bbd33ae176d3, rgb(89, 89, 89))`},children:`I\xA0work at\xA0the intersection of\xA0product thinking and hands-on craft. That means getting to\xA0an\xA0interactive, testable concept as\xA0fast as\xA0possible and figuring out what that changes about how we\xA0design.`})]}),className:`framer-1ngdro7`,"data-framer-name":`Paragraph`,fonts:[`Inter`],verticalAlignment:`top`,withExternalLayout:!0})}),s(W,{animate:Y,className:`framer-10gscex`,"data-framer-appear-id":`10gscex`,"data-framer-name":`Column`,initial:dt,optimized:!0,style:{transformPerspective:1200},children:s(W,{animate:Y,className:`framer-9k0s8u`,"data-framer-appear-id":`9k0s8u`,"data-framer-name":`Image Wrapper`,initial:ft,optimized:!0,style:{transformPerspective:1200},children:s(F,{breakpoint:O,overrides:{BzK7KLzkz:{background:{alt:`Avatar image for about me page`,fit:`fill`,intrinsicHeight:2972,intrinsicWidth:5526,loading:w((b?.y||0)+0+0+32+128+0+80+0+0+0+0+0),pixelHeight:2225,pixelWidth:3011,sizes:`calc(max(min(${b?.width||`100vw`} - 64px, 1024px), 200px) * 1.1003)`,src:`https://framerusercontent.com/images/dPzcc0hfGtEN8azX3uDTkM