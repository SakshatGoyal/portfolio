`,fonts:[`Inter`],verticalAlignment:`top`,withExternalLayout:!0})]}),s(_,{__fromCanvasComponent:!0,children:s(i,{children:s(`p`,{className:`framer-styles-preset-1b1wlt8`,"data-styles-preset":`yywA2ZNZg`,dir:`auto`,style:{"--framer-text-alignment":`left`,"--framer-text-color":`var(--token-0f0ae4b9-e928-41c5-b457-bbd33ae176d3, rgb(77, 77, 77))`},children:`Back in the work itself. Spanning product thinking and hands-on craft, using code-based AI tools like Claude Code to prototype interactive concepts across a range of directions at once, compressing the time from idea to something you can actually feel and react to.`})}),className:`framer-18b06ht`,"data-framer-name":`Paragraph`,fonts:[`Inter`],verticalAlignment:`top`,withExternalLayout:!0})]})]}),l(`div`,{className:`framer-1ac88dn`,"data-border":!0,"data-framer-name":`Card`,children:[s(_,{__fromCanvasComponent:!0,children:s(i,{children:s(`p`,{className:`framer-styles-preset-1b1wlt8`,"data-styles-preset":`yywA2ZNZg`,dir:`auto`,style:{"--framer-text-alignment":`left`,"--framer-text-color":`var(--token-0f0ae4b9-e928-41c5-b457-bbd33ae176d3, rgb(77, 77, 77))`},children:`09.2018 – 05.2026`})}),className:`framer-ekcamf`,"data-framer-name":`Paragraph`,fonts:[`Inter`],verticalAlignment:`top`,withExternalLayout:!0}),l(`div`,{className:`framer-1mybilg`,"data-framer-name":`Content`,children:[s(`div`,{className:`framer-1cniucz`,"data-framer-name":`Text`,children:s(_,{__fromCanvasComponent:!0,children:s(i,{children:s(`p`,{className:`framer-styles-preset-1ypj84h`,"data-styles-preset":`s21e4xGOE`,style:{"--framer-text-alignment":`left`,"--framer-text-color":`var(--token-0f0ae4b9-e928-41c5-b457-bbd33ae176d3, rgb(77, 77, 77))`},children:`Design\xA0Director, Product Design`})}),className:`framer-tculaz`,"data-framer-name":`Body`,fonts:[`Inter`],verticalAlignment:`top`,withExternalLayout:!0})}),s(_,{__fromCanvasComponent:!0,children:s(i,{children:s(`p`,{className:`framer-styles-preset-1b1wlt8`,"data-styles-preset":`yywA2ZNZg`,dir:`auto`,style:{"--framer-text-alignment":`left`,"--framer-text-color":`var(--token-0f0ae4b9-e928-41c5-b457-bbd33ae176d3, rgb(77, 77, 77))`},children:`Led multiple product design teams across the main app, focused on\xA0everything from launching new features and generative AI\xA0to\xA0rolling out a\xA0new design language, accessibility upgrades, and dark mode. Launched LinkedIn Games, a\xA0new product category bringing daily play to\xA0a\xA0professional platform, driven by\xA0word of\xA0mouth, with nearly half of\xA0new players joining through a\xA0connection. Built and managed cross-functional teams spanning core product areas (Home, Messaging, Profile, Groups, Pages) and strategic horizontals (Premium, Trust, Infra UX, Navigation).`})}),className:`framer-1xfbvp3`,"data-framer-name":`Paragraph`,fonts:[`Inter`],verticalAlignment:`top`,withExternalLayout:!0})]})]}),l(`div`,{className:`framer-1kl6c6n`,"data-border":!0,"data-framer-name":`Card`,children:[s(_,{__fromCanvasComponent:!0,children:s(i,{children:s(`p`,{className:`framer-styles-preset-1b1wlt8`,"data-styles-preset":`yywA2ZNZg`,style:{"--framer-text-alignment":`left`,"--framer-text-color":`var(--token-0f0ae4b9-e928-41c5-b457-bbd33ae176d3, rgb(77, 77, 77))`},children:`05.2017 – 08.2018`})}),className:`framer-ifmreu`,"data-framer-name":`Paragraph`,fonts:[`Inter`],verticalAlignment:`top`,withExternalLayout:!0}),l(`div`,{className:`framer-7zul5w`,"data-framer-name":`Content`,children:[l(`div`,{className:`framer-yldses`,"data-framer-name":`Text`,children:[s(_,{__fromCanvasComponent:!0,children:s(i,{children:s(`h4`,{className:`framer-styles-preset-16ip4e8`,"data-styles-preset":`jk3LNN0M9`,dir:`auto`,style:{"--framer-text-alignment":`left`,"--framer-text-color":`var(--token-769b2b36-b762-451a-9ad9-f333c17dfad0, rgb(44, 44, 44))`},children:s(k,{href:`https://www.pinterest.com`,motionChild:!0,nodeId:`naTeiFeOI`,openInNewTab:!0,relValues:[],scopeId:`oa_L0Rq_9`,smoothScroll:!1,children:s(d.a,{className:`framer-styles-preset-1wicq5s`,"data-styles-preset":`ro7OPezbn`,children:`Pinterest`})})})}),className:`framer-piiti1`,"data-framer-name":`H4`,fonts:[`Inter`],verticalAlignment:`top`,withExternalLayout:!0}),s(_,{__fromCanvasComponent:!0,children:s(i,{children:s(`p`,{className:`framer-styles-preset-1ypj84h`,"data-styles-preset":`s21e4xGOE`,style:{"--framer-text-alignment":`left`,"--framer-text-color":`var(--token-0f0ae4b9-e928-41c5-b457-bbd33ae176d3, rgb(77, 77, 77))`},children:`Design\xA0Director, Product Design`})}),className:`framer-1ulchw3`,"data-framer-name":`Body`,fonts:[`Inter`],verticalAlignment:`top`,withExternalLayout:!0})]}),s(_,{__fromCanvasComponent:!0,children:s(i,{children:s(`p`,{className:`framer-styles-preset-1b1wlt8`,"data-styles-preset":`yywA2ZNZg`,dir:`auto`,style:{"--framer-text-alignment":`left`,"--framer-text-color":`var(--token-0f0ae4b9-e928-41c5-b457-bbd33ae176d3, rgb(77, 77, 77))`},children:`Led product design for new ways to\xA0grow the business and improve the ads experience. Launched the Creators initiative, which has become central to\xA0Pinterest’s long-term strategy. Focused on\xA0making content more relevant and building tools advertisers actually wanted to\xA0use. Worked closely with engineers and user research to\xA0solve real problems for people using the platform. Pushed for a\xA0practical, hands-on approach centered on\xA0experiments and learning fast.`})}),className:`framer-lu8zg2`,"data-framer-name":`Paragraph`,fonts:[`Inter`],verticalAlignment:`top`,withExternalLayout:!0})]})]}),l(`div`,{className:`framer-12zppqf`,"data-border":!0,"data-framer-name":`Card`,children:[s(_,{__fromCanvasComponent:!0,children:s(i,{children:s(`p`,{className:`framer-styles-preset-1b1wlt8`,"data-styles-preset":`yywA2ZNZg`,style:{"--framer-text-alignment":`left`,"--framer-text-color":`var(--token-0f0ae4b9-e928-41c5-b457-bbd33ae176d3, rgb(77, 77, 77))`},children:`02.2011 – 01.2017`})}),className:`framer-1o41vav`,"data-framer-name":`Paragraph`,fonts:[`Inter`],verticalAlignment:`top`,withExternalLayout:!0}),l(`div`,{className:`framer-5edo91`,"data-framer-name":`Content`,children:[l(`div`,{className:`framer-kkqdcc`,"data-framer-name":`Text`,children:[s(_,{__fromCanvasComponent:!0,children:s(i,{children:l(`h4`,{className:`framer-styles-preset-16ip4e8`,"data-styles-preset":`jk3LNN0M9`,style:{"--framer-text-alignment":`left`,"--framer-text-color":`var(--token-769b2b36-b762-451a-9ad9-f333c17dfad0, rgb(44, 44, 44))`},children:[`Flite (acquired by `,s(k,{href:`https://www.snapchat.com`,motionChild:!0,nodeId:`BnT4OYXSZ`,openInNewTab:!0,relValues:[],scopeId:`oa_L0Rq_9`,smoothScroll:!1,children:s(d.a,{className:`framer-styles-preset-1wicq5s`,"data-styles-preset":`ro7OPezbn`,children:`Snap`})}),`)`]})}),className:`framer-2q048l`,"data-framer-name":`H4`,fonts:[`Inter`],verticalAlignment:`top`,withExternalLayout:!0}),s(_,{__fromCanvasComponent:!0,children:s(i,{children:s(`p`,{className:`framer-styles-preset-1ypj84h`,"data-styles-preset":`s21e4xGOE`,style:{"--framer-text-alignment":`left`,"--framer-text-color":`var(--token-0f0ae4b9-e928-41c5-b457-bbd33ae176d3, rgb(77, 77, 77))`},children:`Head of Product & Design`})}),className:`framer-lewpf4`,"data-framer-name":`Body`,fonts:[`Inter`],verticalAlignment:`top`,withExternalLayout:!0})]}),s(_,{__fromCanvasComponent:!0,children:s(i,{children:s(`p`,{className:`framer-styles-preset-1b1wlt8`,"data-styles-preset":`yywA2ZNZg`,dir:`auto`,style:{"--framer-text-alignment":`left`,"--framer-text-color":`var(--token-0f0ae4b9-e928-41c5-b457-bbd33ae176d3, rgb(77, 77, 77))`},children:`Responsible for both Product and Design. Grew the team from early startup to\xA0a\xA0full organization, guiding the platform from MVP into the enterprise space. Managed the Snap acquisition and led the team through transition.`})}),className:`framer-183wwzm`,"data-framer-name":`Paragraph`,fonts:[`Inter`],verticalAlignment:`top`,withExternalLayout:!0})]})]})]})]}),l(G,{__framer__animate:{transition:J},__framer__animateOnce:!0,__framer__enter:X,__