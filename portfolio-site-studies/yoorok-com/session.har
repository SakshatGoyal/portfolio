    <nav \n    aria-label=\"Accessibility Controls\"\n    class=\"fixed bottom-[27px] left-[27px] flex items-center justify-start no-wrap bg-[#FEF9ED] py-[4px] pl-[5px] pr-[15px] rounded-[50px] m:hidden contrast-border\"\n    style=\"z-index:100; box-shadow:0 4px 40px 0 rgba(93,82,75,0.30);\">\n    <div\n        id=\"site-settings-accessibility-label\"\n        for=\"site-settings-accessibility\"\n        class=\"text-nano flex items-center cursor-pointer select-none relative\" >\n        <span class=\"\n            relative inline-block h-[26px] w-[47px] text-nano bg-[#F7ECD9] text-[#5D524B]\n            rounded-[50px] text-center pt-[8px] px-[9px] mr-[5px]\n            transition-all\n            peer-checked:bg-[#5D524B]\n            peer-checked:text-[#F7ECD9]\n            \n            [&.is-checked]:bg-[#5D524B]\n            [&.is-checked]:text-[#F7ECD9]\n\n            \">\n        <span aria-hidden=\"true\" site-settings-status id=\"site-settings-accessibility-status\">\n            Off\n        </span>\n        <input\n            id=\"site-settings-accessibility\"\n            type=\"checkbox\"\n            role=\"switch\"\n            aria-checked=\"false\"\n            data-site-settings-type=\"accessibility\"\n            aria-label=\"Accessibility Mode\"\n            data-checked-status=\"On\"\n            data-unchecked-status=\"Off\"\n            class=\"peer absolute inset-0 h-full w-full\n                appearance-none bg-transparent border-none cursor-pointer\n                focus-visible:outline focus-visible:outline-2  \n                rounded-[50px] z-10\"\n        />\n        </span>\n        <span aria-hidden=\"true\">Accessibility Mode</span>\n    </div>\n</nav>    \n    <main id=\"main-content\">\n      <!-- block-home -->\n<div class=\"text-[#FEF9ED] relative\" style=\"background:#fbd3be\">\n\n  <block-home class=\"block\">\n    \n    <div class=\"absolute top-0 left-0 h-[200vh] w-full\">\n      <block-gl\n          class=\"block pointer