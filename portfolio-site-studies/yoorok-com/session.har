          "content": {
            "size": 223151,
            "mimeType": "text/html; charset=utf-8",
            "compression": 192306,
            "text": "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <link rel=\"icon\" type=\"image/png\" sizes=\"32x32\" href=\"/favicon.png\" />\n    <link rel=\"icon\" type=\"image/png\" sizes=\"192x192\" href=\"/favicon-192.png\" />\n    <link rel=\"apple-touch-icon\" href=\"/apple-touch-icon.png\" />\n    <title>Yoorok Jeong — Product Designer</title>\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\n    <link rel=\"preload\" as=\"style\" href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap\" onload=\"this.onload=null;this.rel='stylesheet'\" />\n    <noscript><link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap\" /></noscript>\n    <link rel=\"preload\" as=\"style\" href=\"https://fonts.googleapis.com/icon?family=Material+Icons\" onload=\"this.onload=null;this.rel='stylesheet'\" />\n    <noscript><link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/icon?family=Material+Icons\" /></noscript>\n    <script type=\"module\" crossorigin src=\"/assets/index-B94DqRKC.js\"></script>\n    <link rel=\"stylesheet\" crossorigin href=\"/assets/index-D_cByDmf.css\">\n  </head>\n  <body>\n    <div id=\"app\">\n      <!-- Background layers for parallax -->\n      <div class=\"bg-layer bg-work\"></div>\n      <div class=\"bg-layer bg-play-layer\"></div>\n\n      <!-- Ambient corner glows — mouse reactive -->\n      <div class=\"ambient-glow glow-work glow-a\"></div>\n      <div class=\"ambient-glow glow-work glow-b\"></div>\n      <div class=\"ambient-glow glow-play glow-c\"></div>\n      <div class=\"ambient-glow glow-play glow-d\"></div>\n\n      <!-- Toggle -->\n      <nav class=\"toggle-nav\">\n        <div class=\"segmented-control\">\n          <button class=\"seg-btn selected\" data-page=\"work\">Work</button>\n          <button class=\"seg-btn\" data-page=\"play\">Play</button>\n        </div>\n      </nav>\n      <button class=\"companion-btn\" aria-label=\"Open portfolio companion\">\n        <img src=\"/yoorok-avatar.png\" alt=\"Ask Yoorok\" width=\"40\" height=\"40\" />\n        <span class=\"companion-btn-label\">Ask me</span>\n      </button>\n\n      <!-- ==================== WORK PAGE ==================== -->\n      <main id=\"page-work\" class=\"page page-work active\">\n        <header class=\"masthead\">\n          <div class=\"aurora-glow\"></div>\n          <h1 class=\"hero-title spot-text\">Hi there! I'm Yoorok</h1>\n          <p class=\"hero-subtitle spot-text\">\n            A Product Designer at\n            <a href=\"https://microsoft.ai/\" target=\"_blank\" rel=\"noopener\">Microsoft AI</a>,\n            focused on human-centered content experiences at scale through AI systems.\n          </p>\n        </header>\n\n        <!-- Microsoft AI -->\n        <section class=\"section-header\">\n          <div class=\"section-header-row\">\n            <div class=\"logo-container\">\n              <div class=\"icon-btn\">\n                <img decoding=\"async\" src=\"/microsoft-ai.svg\" alt=\"Microsoft AI\" width=\"32\" height=\"32\" style=\"width:32px;height:32px\">\n              </div>\n              <h2 class=\"section-title spot-text\">Microsoft AI</h2>\n            </div>\n            <div class=\"pill-btn spot-badge\">2024 - 2026</div>\n          </div>\n          <p class=\"section-desc spot-text\">Copilot Discover — AI-powered content discovery and feed experiences</p>\n        </section>\n\n        <div class=\"project-grid two-col\">\n          <div class=\"project-col\">\n            <article class=\"project-card card-tall\" data-project=\"discover\">\n              <div class=\"project-card-header\">\n                <h3 class=\"card-title\">Discover on Copilot App</h3>\n                <span class=\"card-meta\">Copilot · 2026</span>\n              </div>\n              <p class=\"card-desc\">Personalized discovery driving daily usage on Copilot</p>\n              <div class=\"card-image-area\">\n                <div class=\"card-placeholder layer-placeholder discover-placeholder\">\n                  <img decoding=\"async\" fetchpriority=\"high\" class=\"layer-img\" src=\"/discover.webp\" alt=\"Discover on Copilot\"/>\n                  <img decoding=\"async\" class=\"layer-lock\" src=\"/lock-play.svg\" width=\"60\" height=\"60\" alt=\"Locked content\"/>\n                </div>\n              </div>\n            </article>\n\n            <article class=\"project-card card-flex\" data-project=\"consumption\">\n              <div class=\"project-card-header\">\n                <h3 class=\"card-title\">Consumption UX Improvement</h3>\n                <span class=\"card-meta\">MSN · 2025-2026</span>\n              </div>\n              <p class=\"card-desc\">Continuous feed system with improved readability and layout</p>\n              <div class=\"card-content\">\n                <div class=\"mini-segmented\">\n                  <button class=\"mini-seg-btn selected\">\n                    <img loading=\"lazy\" decoding=\"async\" src=\"/article.svg\" alt=\"Article\" width=\"44\" height=\"44\">\n                  </button>\n                  <button class=\"mini-seg-btn\">\n                    <img loading=\"lazy\" decoding=\"async\" src=\"/video.svg\" alt=\"Video\" width=\"40\" height=\"40\">\n                  </button>\n                  <button class=\"mini-seg-btn\">\n                    <img loading=\"lazy\" decoding=\"async\" src=\"/gallery.svg\" alt=\"Gallery\" width=\"40\" height=\"40\">\n                  </button>\n                  <button class=\"mini-seg-btn\">\n                    <img loading=\"lazy\" decoding=\"async\" src=\"/gem.svg\" alt=\"Gem\" width=\"44\" height=\"44\">\n                  </button>\n                </div>\n                <div class=\"consumption-preview\">\n                  <div class=\"cns-scroll\">\n                  <!-- Article Tab -->\n                  <div class=\"cns-tab cns-tab-article active\">\n                      <div class=\"cns-inline\">\n                        <!-- Masthead -->\n                        <div class=\"cns-masthead\">\n                          <div class=\"cns-attribution-row\">\n                            <div class=\"cns-publisher\">\n                              <img loading=\"lazy\" decoding=\"async\" class=\"cns-pub-icon\" src=\"/consumption/pub-nbc-news.jpg\" alt=\"\"/>\n                              <span class=\"cns-pub-name\">NBC News</span>\n                            </div>\n                            <button class=\"cns-follow-btn\"><img loading=\"lazy\" decoding=\"async\" class=\"cns-follow-plus\" src=\"/consumption/icon-plus.svg\" alt=\"\"/> Follow</button>\n                          </div>\n                          <h3 class=\"cns-headline\">Japanese Americans play historic baseball games at prison camp to recall a pastime</h3>\n                          <div class=\"cns-byline\">\n                            <span>Story by Lynda Lin Grigsby and Emilie Ikeda</span>\n                            <span class=\"cns-byline-row\">Oct 29 · 3 min read · Updated 1h ago</span>\n                          </div>\n                          <div class=\"cns-action-bar\">\n                            <div class=\"cns-action-icons\">\n                              <button class=\"cns-action-btn\"><img loading=\"lazy\" decoding=\"async\" src=\"/consumption/icon-like.svg\" alt=\"\"/><span>312</span></button>\n                              <button class=\"cns-action-btn\"><img loading=\"lazy\" decoding=\"async\" src=\"/consumption/icon-dislike.svg\" alt=\"\"/></button>\n                              <button class=\"cns-action-btn\"><img loading=\"lazy\" decoding=\"async\" src=\"/consumption/icon-comment.svg\" alt=\"\"/><span>84</span></button>\n                              <button class=\"cns-action-btn\"><img loading=\"lazy\" decoding=\"async\" src=\"/consumption/icon-share.svg\" alt=\"\"/></button>\n                              <button class=\"cns-action-btn\"><img loading=\"lazy\" decoding=\"async\" src=\"/consumption/icon-more.svg\" alt=\"\"/></button>\n                            </div>\n                          </div>\n                        </div>\n                        <!-- Key Takeaways -->\n                        <div class=\"cns-takeaways\">\n                          <div class=\"cns-takeaways-inner\">\n                            <div class=\"cns-takeaways-header\">\n                              Key takeaways\n                              <span class=\"cns-info-wrap\">\n                                <img loading=\"lazy\" decoding=\"async\" class=\"cns-info-icon\" src=\"/consumption/icon-info.svg\" alt=\"Info\"/>\n                                <span class=\"cns-info-tooltip\">\n                                  <strong>Curated by Copilot</strong>\n                                  Copilot uses AI to shape what you see here. Mistakes happen, so double-check the facts.\n                                </span>\n                              </span>\n                            </div>\n                            <ul class=\"cns-takeaways-list\">\n                              <li>The new PS5 update lets users pair their controller with multiple devices simultaneously, including phones, tablets, and PCs</li>\n                              <li>This functionality starts in a system software beta released on July 24, 2025, and will roll out to all users by end of August</li>\n                              <li>Sony includes clear instructions for pairing through Bluetooth settings, with support for up to four connected devices at once</li>\n                            </ul>\n                            <div class=\"cns-takeaways-fade\"></div>\n                          </div>\n                          <button class=\"cns-see-more-btn\">See more <img loading=\"lazy\" decoding=\"async\" src=\"/consumption/icon-chevron-down.svg\" alt=\"\"/></button>\n                        </div>\n                        <!-- Body -->\n                        <p class=\"cns-body cns-body-first\">MANZANAR, Calif. — Swinging at the first pitch on a hallowed baseball field was 23-year-old Logan Morita. As the crowd fell quiet, he thought of a great-uncle, Jimmy Masatoshi Morita, who 80 years before played for a baseball team at Manzanar, one of 10 Japanese American concentration camps.</p>\n                        <p class=\"cns-body\">Painstakingly rebuilt in the barren landscape of the camp, the field hosted games Saturday for the first time since it closed in the 1940s.</p>\n                        <p class=\"cns-body\">Logan Morita, an electrical engineering student at the University of California, Davis, had never been to a Japanese incarceration camp before.</p>\n                        <!-- Video -->\n                        <div class=\"cns-video-card\">\n                          <img loading=\"lazy\" decoding=\"async\" src=\"/consumption/video-baseball.webp\" alt=\"Video\" class=\"cns-video-thumb\"/>\n                          <video class=\"cns-video-overlay\" src=\"/consumption/article-video.mp4\" muted loop playsinline preload=\"none\"></video>\n                          <div class=\"cns-video-play\"><img loading=\"lazy\" decoding=\"async\" src=\"/consumption/icon-play.svg\" alt=\"Play\"/></div>\n                          <div class=\"cns-video-info\">\n                            <div class=\"cns-video-pub\"><img loading=\"lazy\" decoding=\"async\" class=\"cns-pub-icon-sm\" src=\"/consumption/pub-nbc-news.jpg\" alt=\"\"/>NBC News · 1d</div>\n                            <span class=\"cns-video-title\">Baseball returns to former Japanese American incarceration camp in California</span>\n                          </div>\n                          <div class=\"cns-video-controls\">\n                            <button class=\"cvc-playpause\" aria-label=\"Pause\">\n                              <svg class=\"cvc-icon-pause\" viewBox=\"0 0 24 24\" fill=\"white\"><rect x=\"6\" y=\"4\" width=\"4\" height=\"16\" rx=\"1\"/><rect x=\"14\" y=\"4\" width=\"4\" height=\"16\" rx=\"1\"/></svg>\n                              <svg class=\"cvc-icon-play\" viewBox=\"0 0 24 24\" fill=\"white\" style=\"display:none\"><path d=\"M8 5v14l11-7z\"/></svg>\n                            </button>\n                            <div class=\"cvc-progress-wrap\">\n                              <div class=\"cvc-progress-bar\"><div class=\"cvc-progress-fill\"></div></div>\n                            </div>\n                            <span class=\"cvc-time\">0:00 / 0:00</span>\n                            <button class=\"cvc-mute\" aria-label=\"Mute\">\n                              <svg class=\"cvc-icon-muted\" viewBox=\"0 0 24 24\" fill=\"white\"><path d=\"M16.5 12A4.5 4.5 0 0 0 14 8v2.18l2.45 2.45c.03-.2.05-.42.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51A8.8 8.8 0 0 0 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06a8.99 8.99 0 0 0 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z\"/></svg>\n                              <svg class=\"cvc-icon-unmuted\" viewBox=\"0 0 24 24\" fill=\"white\" style=\"display:none\"><path d=\"M3 9v6h4l5 5V4L7 9H3zm13.5 3A4.5 4.5 0 0 0 14 8v8c1.48-.73 2.5-2.25 2.5-4zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z\"/></svg>\n                            </button>\n                          </div>\n                        </div>\n                        <!-- More body -->\n                        <p class=\"cns-body\">\"It's honestly a surreal experience,\" he said. Morita, a native of Lodi, reflected on the arduous journey his grandparents made to reach California's high desert.</p>\n                        <p class=\"cns-body\">As it was during WWII, baseball at Manzanar isn't just about the score or a winning record. The attendees said it was about a reclamation of space, community and power.</p>\n                        <!-- Image -->\n                        <div class=\"cns-article-image\">\n                          <img loading=\"lazy\" decoding=\"async\" src=\"/consumption/article-image.webp\" alt=\"Article\"/>\n                          <p class=\"cns-caption\">Arne Slot waves goodbye to Feyenoord's fans last Sunday</p>\n                          <p class=\"cns-credit\">© MANDEL NGAN/AFP via Getty Images</p>\n                        </div>\n                        <!-- Subtitle + body -->\n                        <h4 class=\"cns-subtitle\">Rebuilding a desert field at the foot of the Sierra Nevada</h4>\n                        <p class=\"cns-body\">In the morning game, 13-year-old Rylen Yamamoto, playing with the JACL Lodi Templars, struck out three batters in a row against the Li'l Tokio Giants.</p>\n                        <!-- Quote -->\n                        <blockquote class=\"cns-quote\">\n                          <p>\"As a player, I just want to play the game. That's why they played at the camps. Because they wanted to feel normal even just for a few hours.\"</p>\n                          <cite>Mike Furutani, a Templars player and manager of the North All-Stars</cite>\n                        </blockquote>\n                        <p class=\"cns-body\">As it was during WWII, baseball at Manzanar isn't just about the score or a winning record. The attendees said it was about a reclamation of space, community and power.</p>\n                        <!-- Action bar bottom -->\n                        <div class=\"cns-action-bar\">\n                          <div class=\"cns-action-icons\">\n                            <button class=\"cns-action-btn\"><img loading=\"lazy\" decoding=\"async\" src=\"/consumption/icon-like.svg\" alt=\"\"/><span>312</span></button>\n                            <button class=\"cns-action-btn\"><img loading=\"lazy\" decoding=\"async\" src=\"/consumption/icon-dislike.svg\" alt=\"\"/></button>\n                            <button class=\"cns-action-btn\"><img loading=\"lazy\" decoding=\"async\" src=\"/consumption/icon-comment.svg\" alt=\"\"/><span>84</span></button>\n                            <button class=\"cns-action-btn\"><img loading=\"lazy\" decoding=\"async\" src=\"/consumption/icon-share.svg\" alt=\"\"/></button>\n                            <button class=\"cns-action-btn\"><img loading=\"lazy\" decoding=\"async\" src=\"/consumption/icon-more.svg\" alt=\"\"/></button>\n                          </div>\n                        </div>\n                        <!-- Related articles -->\n                        <div class=\"cns-related-link\">\n                          <div class=\"cns-related-link-header\">\n                            <img loading=\"lazy\" decoding=\"async\" class=\"cns-pub-icon-sm\" src=\"/consumption/pub-skypoint.svg\" alt=\"\"/>\n                            <span>More from SkyPoint News</span>\n                            <img loading=\"lazy\" decoding=\"async\" class=\"cns-related-link-chevron\" src=\"/consumption/icon-chevron-down.svg\" alt=\"\"/>\n                          </div>\n                          <div class=\"cns-related-link-items\">\n                            <p>Caldor Fire explodes, leveling parts of a California town</p>\n                            <p>U.S. troops will remain in Afghanistan until all citizens evacuated</p>\n                            <p>Biden administration to offer vaccine booster shots beginning Sept. 20</p>\n                          </div>\n                        </div>\n                        <!-- Related questions -->\n                        <div class=\"cns-related-questions\">\n                          <div class=\"cns-rq-header\"><img loading=\"lazy\" decoding=\"async\" class=\"cns-copilot-icon\" src=\"/consumption/pub-copilot.svg\" alt=\"\"/><span>Related questions</span></div>\n                          <div class=\"cns-rq-tags\">\n                            <span class=\"cns-rq-tag\">What happened at Manzanar?</span>\n                            <span class=\"cns-rq-tag\">Why was baseball important to internees?</span>\n                            <span class=\"cns-rq-tag\">Where is the Manzanar camp today?</span>\n                          </div>\n                        </div>\n                      </div>\n                      <!-- Related stories -->\n                      <div class=\"cns-related-stories\">\n                        <h3 class=\"cns-rs-title\">Related stories</h3>\n                        <div class=\"cns-rs-cards\">\n                          <div class=\"cns-rs-card\"><img loading=\"lazy\" decoding=\"async\" src=\"/consumption/rs-manzanar.jpg\" alt=\"\"/><div class=\"cns-rs-card-info\"><div class=\"cns-rs-pub\"><img loading=\"lazy\" decoding=\"async\" class=\"cns-pub-icon-xs\" src=\"/consumption/pub-quantis.svg\" alt=\"\"/>Quantis · 1d</div><span class=\"cns-rs-headline\">Manzanar Pilgrimage Draws Record Crowds to Honor Japanese American History</span></div></div>\n                          <div class=\"cns-rs-card\"><img loading=\"lazy\" decoding=\"async\" src=\"/consumption/rs-baseball-history.jpg\" alt=\"\"/><div class=\"cns-rs-card-info\"><div class=\"cns-rs-pub\"><img loading=\"lazy\" decoding=\"async\" class=\"cns-pub-icon-xs\" src=\"/consumption/pub-metro.svg\" alt=\"\"/>Metro Post · 3h</div><span class=\"cns-rs-headline\">How Sports Helped Japanese Americans Survive Internment During WWII</span></div></div>\n                        </div>\n                      </div>\n                  </div>\n\n                  <!-- Video Tab -->\n                  <div class=\"cns-tab cns-tab-video\">\n                      <div class=\"cns-inline\">\n                        <div class=\"cns-masthead\">\n                          <div class=\"cns-attribution-row\">\n                            <div class=\"cns-publisher\">\n                              <img loading=\"lazy\" decoding=\"async\" class=\"cns-pub-icon\" src=\"/consumption/pub-vexel.svg\" alt=\"\"/>\n                              <span class=\"cns-pub-name\">Vexel</span>\n                            </div>\n                            <button class=\"cns-follow-btn\"><img loading=\"lazy\" decoding=\"async\" class=\"cns-follow-plus\" src=\"/consumption/icon-plus.svg\" alt=\"\"/> Follow</button>\n                          </div>\n                          <h3 class=\"cns-headline\">Dive Into Cannes Celebrity Glam and Red Carpet Looks with Vogue Editors</h3>\n                          <div class=\"cns-byline\">\n                            <span class=\"cns-byline-row\">Jan 10 · Updated 1h ago</span>\n                          </div>\n                          <div class=\"cns-action-bar\">\n                            <div class=\"cns-action-icons\">\n                              <button class=\"cns-action-btn\"><img loading=\"lazy\" decoding=\"async\" src=\"/consumption/icon-like.svg\" alt=\"\"/><span>128</span></button>\n                              <button class=\"cns-action-btn\"><img loading=\"lazy\" decoding=\"async\" src=\"/consumption/icon-dislike.svg\" alt=\"\"/></button>\n                              <button class=\"cns-action-btn\"><img loading=\"lazy\" decoding=\"async\" src=\"/consumption/icon-comment.svg\" alt=\"\"/><span>43</span></button>\n                              <button class=\"cns-action-btn\"><img loading=\"lazy\" decoding=\"async\" src=\"/consumption/icon-share.svg\" alt=\"\"/></button>\n                              <button class=\"cns-action-btn\"><img loading=\"lazy\" decoding=\"async\" src=\"/consumption/icon-more.svg\" alt=\"\"/></button>\n                            </div>\n                          </div>\n                        </div>\n                        <div class=\"cns-video-card cns-video-card-main\">\n                          <img loading=\"lazy\" decoding=\"async\" src=\"/feed/video-thumbnail.webp\" alt=\"Video\" class=\"cns-video-thumb\"/>\n                          <video class=\"cns-video-overlay\" src=\"/feed/video.mp4\" muted loop playsinline preload=\"none\"></video>\n                          <div class=\"cns-video-play\"><img loading=\"lazy\" decoding=\"async\" src=\"/consumption/icon-play.svg\" alt=\"Play\"/></div>\n                          <div class=\"cns-video-info\">\n                            <div class=\"cns-video-pub\"><img loading=\"lazy\" decoding=\"async\" class=\"cns-pub-icon-sm\" src=\"/consumption/vexel2.svg\" alt=\"\"/>Vexel · 1d</div>\n                            <span class=\"cns-video-title\">Best Dressed from Cannes Film Festival 2025</span>\n                          </div>\n                          <div class=\"cns-video-controls\">\n                            <button class=\"cvc-playpause\" aria-label=\"Pause\">\n                              <svg class=\"cvc-icon-pause\" viewBox=\"0 0 24 24\" fill=\"white\"><rect x=\"6\" y=\"4\" width=\"4\" height=\"16\" rx=\"1\"/><rect x=\"14\" y=\"4\" width=\"4\" height=\"16\" rx=\"1\"/></svg>\n                              <svg class=\"cvc-icon-play\" viewBox=\"0 0 24 24\" fill=\"white\" style=\"display:none\"><path d=\"M8 5v14l11-7z\"/></svg>\n                            </button>\n                            <div class=\"cvc-progress-wrap\">\n                              <div class=\"cvc-progress-bar\"><div class=\"cvc-progress-fill\"></div></div>\n                            </div>\n                            <span class=\"cvc-time\">0:00 / 0:00</span>\n                            <button class=\"cvc-mute\" aria-label=\"Mute\">\n                              <svg class=\"cvc-icon-muted\" viewBox=\"0 0 24 24\" fill=\"white\"><path d=\"M16.5 12A4.5 4.5 0 0 0 14 8v2.18l2.45 2.45c.03-.2.05-.42.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51A8.8 8.8 0 0 0 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06a8.99 8.99 0 0 0 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z\"/></svg>\n                              <svg class=\"cvc-icon-unmuted\" viewBox=\"0 0 24 24\" fill=\"white\" style=\"display:none\"><path d=\"M3 9v6h4l5 5V4L7 9H3zm13.5 3A4.5 4.5 0 0 0 14 8v8c1.48-.73 2.5-2.25 2.5-4zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z\"/></svg>\n                            </button>\n                          </div>\n                        </div>\n                        <p class=\"cns-body cns-body-first\">The Cannes Film Festival has wrapped for another year, dazzling us with the glitz and glamour of the annual celebration of movie-making. This year's festival proved why Cannes remains the most prestigious stage for film.</p>\n                      </div>\n                      <div class=\"cns-related-stories\">\n                        <h3 class=\"cns-rs-title\">Related stories</h3>\n                        <div class=\"cns-rs-cards\">\n                          <div class=\"cns-rs-card\"><img loading=\"lazy\" decoding=\"async\" src=\"/consumption/rs-cannes-carpet-new.jpg\" alt=\"\"/><div class=\"cns-rs-card-info\"><div class=\"cns-rs-pub\"><img loading=\"lazy\" decoding=\"async\" class=\"cns-pub-icon-xs\" src=\"/consumption/pub-summit.svg\" alt=\"\"/>Summit News · 1d</div><span class=\"cns-rs-headline\">Best Red Carpet Moments from the 2025 Cannes Film Festival</span></div></div>\n                          <div class=\"cns-rs-card\"><img loading=\"lazy\" decoding=\"async\" src=\"/consumption/rs-cannes-fashion-new.jpg\" alt=\"\"/><div class=\"cns-rs-card-info\"><div class=\"cns-rs-pub\"><img loading=\"lazy\" decoding=\"async\" class=\"cns-pub-icon-xs\" src=\"/consumption/pub-frontline.svg\" alt=\"\"/>Frontline Observer · 3h</div><span class=\"cns-rs-headline\">Cannes 2025: The Fashion Trends That Dominated the French Riviera</span></div></div>\n                        </div>\n                      </div>\n                  </div>\n\n                  <!-- Gallery Tab -->\n                  <div class=\"cns-tab cns-tab-gallery\">\n                      <div class=\"cns-inline\">\n                        <div class=\"cns-masthead\">\n                          <div class=\"cns-attribution-row\">\n                            <div class=\"cns-publisher\">\n                              <img loading=\"lazy\" decoding=\"async\" class=\"cns-pub-icon\" src=\"/consumption/the-atlantic.jpeg\" alt=\"\"/>\n                              <span class=\"cns-pub-name\">The Atlantic</span>\n                            </div>\n                            <button class=\"cns-follow-btn\"><img loading=\"lazy\" decoding=\"async\" class=\"cns-follow-plus\" src=\"/consumption/icon-plus.svg\" alt=\"\"/> Follow</button>\n                          </div>\n                          <h3 class=\"cns-headline\">2024 in Photos: Wrapping Up the Year</h3>\n                          <div class=\"cns-byline\">\n                            <span class=\"cns-byline-row\">Story by James Pierce · Jan 10</span>\n                          </div>\n                          <div class=\"cns-action-bar\">\n                            <div class=\"cns-action-icons\">\n                              <button class=\"cns-action-btn\"><img loading=\"lazy\" decoding=\"async\" src=\"/consumption/icon-like.svg\" alt=\"\"/><span>89</span></button>\n                              <button class=\"cns-action-btn\"><img loading=\"lazy\" decoding=\"async\" src=\"/consumption/icon-dislike.svg\" alt=\"\"/></button>\n                              <button class=\"cns-action-btn\"><img loading=\"lazy\" decoding=\"async\" src=\"/consumption/icon-comment.svg\" alt=\"\"/><span>31</span></button>\n                              <button class=\"cns-action-btn\"><img loading=\"lazy\" decoding=\"async\" src=\"/consumption/icon-share.svg\" alt=\"\"/></button>\n                              <button class=\"cns-action-btn\"><img loading=\"lazy\" decoding=\"async\" src=\"/consumption/icon-more.svg\" alt=\"\"/></button>\n                            </div>\n                          </div>\n                        </div>\n                        <!-- Gallery slideshow -->\n                        <div class=\"cns-gallery\">\n                          <div class=\"cns-gallery-main\">\n                            <img loading=\"lazy\" decoding=\"async\" src=\"/consumption/gallery-slide01.webp\" alt=\"Gallery\"/>\n                            <div class=\"cns-gallery-count\">1/ 11 slides</div>\n                            <div class=\"cns-gallery-nav\">\n                              <button class=\"cns-gallery-arrow\"><img loading=\"lazy\" decoding=\"async\" src=\"/consumption/icon-chevron-left.svg\" alt=\"Prev\"/></button>\n                              <button class=\"cns-gallery-arrow\"><img loading=\"lazy\" decoding=\"async\" src=\"/consumption/icon-chevron-right.svg\" alt=\"Next\"/></button>\n                            </div>\n                          </div>\n                          <div class=\"cns-gallery-thumbs\">\n                            <div class=\"cns-gallery-thumbs-track\">\n                              <img loading=\"lazy\" decoding=\"async\" src=\"/consumption/gallery-slide01.webp\" alt=\"\" class=\"active\"/>\n                              <img loading=\"lazy\" decoding=\"async\" src=\"/consumption/gallery-slide02.webp\" alt=\"\"/>\n                              <img loading=\"lazy\" decoding=\"async\" src=\"/consumption/gallery-slide03.webp\" alt=\"\"/>\n                              <img loading=\"lazy\" decoding=\"async\" src=\"/consumption/gallery-slide04.webp\" alt=\"\"/>\n                              <img loading=\"lazy\" decoding=\"async\" src=\"/consumption/gallery-slide05.webp\" alt=\"\"/>\n                              <img loading=\"lazy\" decoding=\"async\" src=\"/consumption/gallery-slide06.webp\" alt=\"\"/>\n                              <img loading=\"lazy\" decoding=\"async\" src=\"/consumption/gallery-slide07.webp\" alt=\"\"/>\n                              <img loading=\"lazy\" decoding=\"async\" src=\"/consumption/gallery-slide08.webp\" alt=\"\"/>\n                              <img loading=\"lazy\" decoding=\"async\" src=\"/consumption/gallery-slide09.webp\" alt=\"\"/>\n                              <img loading=\"lazy\" decoding=\"async\" src=\"/consumption/gallery-slide10.webp\" alt=\"\"/>\n                              <img loading=\"lazy\" decoding=\"async\" src=\"/consumption/gallery-slide11.webp\" alt=\"\"/>\n                            </div>\n                          </div>\n                        </div>\n                        <h4 class=\"cns-subtitle\">Israeli Strike Hits Gaza School, Sept. 1, 2024</h4>\n                        <p class=\"cns-credit\">©Omar Al-Qattaa / AFP / Getty</p>\n                        <p class=\"cns-body\">A man takes cover behind a column as an explosion blasts out dust and debris during an Israeli strike that reportedly targeted a school in the Zeitoun district, on the outskirts of Gaza City, on September 1, 2024.</p>\n                      </div>\n                      <div class=\"cns-related-stories\">\n                        <h3 class=\"cns-rs-title\">Related stories</h3>\n                        <div class=\"cns-rs-cards\">\n                          <div class=\"cns-rs-card\"><img loading=\"lazy\" decoding=\"async\" src=\"/consumption/rs-photo-exhibition-new.jpg\" alt=\"\"/><div class=\"cns-rs-card-info\"><div class=\"cns-rs-pub\"><img loading=\"lazy\" decoding=\"async\" class=\"cns-pub-icon-xs\" src=\"/consumption/pub-quantis.svg\" alt=\"\"/>Quantis · 1d</div><span class=\"cns-rs-headline\">The Most Iconic Photographs of 2024: From Protests to Celebrations</span></div></div>\n                          <div class=\"cns-rs-card\"><img loading=\"lazy\" decoding=\"async\" src=\"/consumption/rs-photographer-new.jpg\" alt=\"\"/><div class=\"cns-rs-card-info\"><div class=\"cns-rs-pub\"><img loading=\"lazy\" decoding=\"async\" class=\"cns-pub-icon-xs\" src=\"/consumption/pub-metro.svg\" alt=\"\"/>Metro Post · 3h</div><span class=\"cns-rs-headline\">Behind the Lens: Photographers Who Captured the Year's Defining Moments</span></div></div>\n                        </div>\n                      </div>\n                  </div>\n\n                  <!-- Gem Tab -->\n                  <div class=\"cns-tab cns-tab-gem\">\n                      <div class=\"cns-inline\">\n                        <div class=\"cns-masthead cns-masthead-gem\">\n                          <div class=\"cns-gem-curated\">\n                            <img loading=\"lazy\" decoding=\"async\" class=\"cns-all-icon\" src=\"/consumption/all.svg\" alt=\"\"/>\n                            <span>+5 · Curated by Copilot · 56m ago</span>\n                          </div>\n                          <h3 class=\"cns-headline\">Grammarly unveils a team of AI agents built to change how we write</h3>\n                          <div class=\"cns-gem-sections\">\n                            <p class=\"cns-gem-label\"><strong>Who gets in:</strong> The White House will now decide which media outlets can attend presidential events, shifting control away from traditional press pool norms.</p>\n                            <p class=\"cns-gem-label\"><strong>Legal and journalistic backlash:</strong> A judge rejected AP's emergency bid for access, while Fox News and others warn the new system threatens press independence.</p>\n                            <p class=\"cns-gem-label\"><strong>Escalating pressure:</strong> The FCC is investigating outlets, journalists are being barred, and lawsuits against major networks signal a broader crackdown.</p>\n                          </div>\n                          <div class=\"cns-action-bar\">\n                            <div class=\"cns-action-icons\">\n                              <button class=\"cns-action-btn\"><img loading=\"lazy\" decoding=\"async\" src=\"/consumption/icon-like.svg\" alt=\"\"/><span>156</span></button>\n                              <button class=\"cns-action-btn\"><img loading=\"lazy\" decoding=\"async\" src=\"/consumption/icon-dislike.svg\" alt=\"\"/></button>\n                              <button class=\"cns-action-btn\"><img loading=\"lazy\" decoding=\"async\" src=\"/consumption/icon-comment.svg\" alt=\"\"/><span>42</span></button>\n                              <button class=\"cns-action-btn\"><img loading=\"lazy\" decoding=\"async\" src=\"/consumption/icon-share.svg\" alt=\"\"/></button>\n                              <button class=\"cns-action-btn\"><img loading=\"lazy\" decoding=\"async\" src=\"/consumption/icon-more.svg\" alt=\"\"/></button>\n                            </div>\n                          </div>\n                        </div>\n                        <!-- Gem article block -->\n                        <div class=\"cns-gem-article\">\n                          <h4 class=\"cns-gem-article-title\">What are Grammarly's new AI agents?</h4>\n                          <p class=\"cns-body\">Grammarly Docs represents a shift from Grammarly's traditional browser extension model to a standalone writing hub. Built on a block-first approach, the platform allows users to insert tables, columns, and headers while integrating AI tools like the AI Grader and Citation Finder directly into the interface. This move aims to keep users within Grammarly's ecosystem while expanding its functionality across. <span class=\"cns-ref-badge\">Pulse +1</span></p>\n                        </div>\n                        <!-- Gem video -->\n                        <div class=\"cns-video-card\">\n                          <img loading=\"lazy\" decoding=\"async\" src=\"/consumption/grammarly.webp\" alt=\"Video\" class=\"cns-video-thumb\"/>\n                          <video class=\"cns-video-overlay\" src=\"/consumption/grammarly.mp4\" muted loop playsinline preload=\"none\"></video>\n                          <div class=\"cns-video-play\"><img loading=\"lazy\" decoding=\"async\" src=\"/consumption/icon-play.svg\" alt=\"Play\"/></div>\n                          <div class=\"cns-video-info\">\n                            <div class=\"cns-video-pub\"><img loading=\"lazy\" decoding=\"async\" class=\"cns-pub-icon-sm\" src=\"/consumption/pub-contoso.svg\" alt=\"\"/>Contoso · 3d</div>\n                            <span class=\"cns-video-title\">Suburban Living Today: Comfort, Community, and the Changing Face of Neighborhood Life</span>\n                          </div>\n                          <div class=\"cns-video-controls\">\n                            <button class=\"cvc-playpause\" aria-label=\"Pause\">\n                              <svg class=\"cvc-icon-pause\" viewBox=\"0 0 24 24\" fill=\"white\"><rect x=\"6\" y=\"4\" width=\"4\" height=\"16\" rx=\"1\"/><rect x=\"14\" y=\"4\" width=\"4\" height=\"16\" rx=\"1\"/></svg>\n                              <svg class=\"cvc-icon-play\" viewBox=\"0 0 24 24\" fill=\"white\" style=\"display:none\"><path d=\"M8 5v14l11-7z\"/></svg>\n                            </button>\n                            <div class=\"cvc-progress-wrap\">\n                              <div class=\"cvc-progress-bar\"><div class=\"cvc-progress-fill\"></div></div>\n                            </div>\n                            <span class=\"cvc-time\">0:00 / 0:00</span>\n                            <button class=\"cvc-mute\" aria-label=\"Mute\">\n                              <svg class=\"cvc-icon-muted\" viewBox=\"0 0 24 24\" fill=\"white\"><path d=\"M16.5 12A4.5 4.5 0 0 0 14 8v2.18l2.45 2.45c.03-.2.05-.42.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51A8.8 8.8 0 0 0 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06a8.99 8.99 0 0 0 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z\"/></svg>\n                              <svg class=\"cvc-icon-unmuted\" viewBox=\"0 0 24 24\" fill=\"white\" style=\"display:none\"><path d=\"M3 9v6h4l5 5V4L7 9H3zm13.5 3A4.5 4.5 0 0 0 14 8v8c1.48-.73 2.5-2.25 2.5-4zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z\"/></svg>\n                            </button>\n                          </div>\n                        </div>\n                        <!-- Repeated article -->\n                        <div class=\"cns-gem-article\">\n                          <h4 class=\"cns-gem-article-title\">How does Grammarly Docs enhance user experience?</h4>\n                          <p class=\"cns-body\">Grammarly Docs introduces a distraction-free writing environment with built-in AI assistance that adapts to each user's tone and style. Features like smart formatting suggestions, real-time collaboration tools, and contextual grammar corrections help users stay in flow without switching between apps. <span class=\"cns-ref-badge\">Atlas Daily +4</span></p>\n                        </div>\n                        <!-- Gem image -->\n                        <div class=\"cns-article-image\">\n                          <img loading=\"lazy\" decoding=\"async\" src=\"/consumption/gem-image.webp\" alt=\"Gem\"/>\n                        </div>\n                        <!-- References 2 -->\n                        <div class=\"cns-references\">\n                          <span class=\"cns-ref-label\">8 references</span>\n                          <div class=\"cns-ref-pills\">\n                            <div class=\"cns-ref-card\"><div class=\"cns-ref-card-text\"><span class=\"cns-ref-card-pub\"><img loading=\"lazy\" decoding=\"async\" class=\"cns-pub-icon-xs\" src=\"/consumption/pub-pulse.svg\" alt=\"\"/>Pulse · 1d</span><span class=\"cns-ref-card-title\">Grammarly Introduces Specialized AI Agents to Transform Writing Support</span></div></div>\n                            <div class=\"cns-ref-card\"><div class=\"cns-ref-card-text\"><span class=\"cns-ref-card-pub\"><img loading=\"lazy\" decoding=\"async\" class=\"cns-pub-icon-xs\" src=\"/consumption/pub-atlas-daily.svg\" alt=\"\"/>Atlas Daily · 1d</span><span class=\"cns-ref-card-title\">From Grammar Check to Collaborative AI: Grammarly's Bold Pivot</span></div></div>\n                            <button class=\"cns-ref-showall\"><img loading=\"lazy\" decoding=\"async\" src=\"/consumption/sources.svg\" alt=\"\"/>Show all</button>\n                          </div>\n                        </div>\n                        <div class=\"cns-action-bar\">\n                          <div class=\"cns-action-icons\">\n                            <button class=\"cns-action-btn\"><img loading=\"lazy\" decoding=\"async\" src=\"/consumption/icon-like.svg\" alt=\"\"/><span>156</span></button>\n                            <button class=\"cns-action-btn\"><img loading=\"lazy\" decoding=\"async\" src=\"/consumption/icon-dislike.svg\" alt=\"\"/></button>\n                            <button class=\"cns-action-btn\"><img loading=\"lazy\" decoding=\"async\" src=\"/consumption/icon-comment.svg\" alt=\"\"/><span>42</span></button>\n                            <button class=\"cns-action-btn\"><img loading=\"lazy\" decoding=\"async\" src=\"/consumption/icon-share.svg\" alt=\"\"/></button>\n                            <button class=\"cns-action-btn\"><img loading=\"lazy\" decoding=\"async\" src=\"/consumption/icon-more.svg\" alt=\"\"/></button>\n                          </div>\n                        </div>\n                        <!-- Related questions -->\n                        <div class=\"cns-related-questions\">\n                          <div class=\"cns-rq-header\"><img loading=\"lazy\" decoding=\"async\" class=\"cns-copilot-icon\" src=\"/consumption/pub-copilot.svg\" alt=\"\"/><span>Related questions</span></div>\n                          <div class=\"cns-rq-tags\">\n                            <span class=\"cns-rq-tag\">What can Grammarly's AI agents do?</span>\n                            <span class=\"cns-rq-tag\">How is Grammarly Docs different?</span>\n                            <span class=\"cns-rq-tag\">Will AI replace human editors?</span>\n                          </div>\n                        </div>\n                      </div>\n                      <div class=\"cns-related-stories\">\n                        <h3 class=\"cns-rs-title\">Related stories</h3>\n                        <div class=\"cns-rs-cards\">\n                          <div class=\"cns-rs-card\"><img loading=\"lazy\" decoding=\"async\" src=\"/consumption/related-card1.webp\" alt=\"\"/><div class=\"cns-rs-card-info\"><div class=\"cns-rs-pub\"><img loading=\"lazy\" decoding=\"async\" class=\"cns-pub-icon-xs\" src=\"/consumption/pub-summit.svg\" alt=\"\"/>Summit News · 1d</div><span class=\"cns-rs-headline\">Grammarly's AI Agents Are Rewriting How Teams Collaborate on Documents</span></div></div>\n                          <div class=\"cns-rs-card\"><img loading=\"lazy\" decoding=\"async\" src=\"/consumption/related-card2.webp\" alt=\"\"/><div class=\"cns-rs-card-info\"><div class=\"cns-rs-pub\"><img loading=\"lazy\" decoding=\"async\" class=\"cns-pub-icon-xs\" src=\"/consumption/pub-frontline.svg\" alt=\"\"/>Frontline Observer · 3h</div><span class=\"cns-rs-headline\">The Rise of AI Writing Tools: What It Means for Professional Content</span></div></div>\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </article>\n          </div>\n\n          <div class=\"project-col\">\n            <article class=\"project-card\" data-project=\"linear-feed\">\n              <div class=\"project-card-header\">\n                <h3 class=\"card-title\">Linear Feed</h3>\n                <span class=\"card-meta\">Windows · 2025-2026</span>\n              </div>\n              <p class=\"card-desc\">Value-driven linear feed reducing cognitive load</p>\n              <div class=\"card-image-area\">\n                <div class=\"card-placeholder linear-placeholder\">\n                  <img loading=\"lazy\" decoding=\"async\" class=\"linear-bg-img\" src=\"/linear-bg.webp\" alt=\"Linear Feed\"/>\n                  <div class=\"feed-widget\">\n                    <!-- Nav -->\n                    <div class=\"feed-nav\">\n                      <div class=\"feed-nav-top\">\n                        <div class=\"feed-nav-item active\">\n                          <img loading=\"lazy\" decoding=\"async\" src=\"/feed/discover.svg\" width=\"10\" height=\"10\" alt=\"Discover\"/>\n                          <span>Discover</span>\n                        </div>\n                        <div class=\"feed-nav-item\">\n                          <img loading=\"lazy\" decoding=\"async\" src=\"/feed/widgets.svg\" width=\"14\" height=\"14\" alt=\"Widgets\"/>\n                          <span>Widgets</span>\n                        </div>\n                      </div>\n                      <div class=\"feed-nav-bottom\">\n                        <img loading=\"lazy\" decoding=\"async\" src=\"/feed/setting.svg\" width=\"20\" height=\"20\" alt=\"Settings\"/>\n                      </div>\n                    </div>\n                    <!-- Feed content -->\n                    <div class=\"feed-content\">\n                      <div class=\"feed-header\">\n                        <span class=\"feed-greeting\">Good morning, Olivia</span>\n                        <div class=\"feed-controls\">\n                          <div class=\"feed-ctrl-btn\">\n                            <img loading=\"lazy\" decoding=\"async\" src=\"/feed/reflash.svg\" width=\"18\" height=\"18\" alt=\"Refresh\"/>\n                          </div>\n                          <div class=\"feed-ctrl-btn\">\n               