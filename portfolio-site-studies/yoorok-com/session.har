eather.png\" alt=\"\"/>\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </article>\n            <article class=\"project-card\" data-project=\"vds\">\n              <div class=\"project-card-header\">\n                <h3 class=\"card-title\">Vertical Design System</h3>\n                <span class=\"card-meta\">Start · 2023</span>\n              </div>\n              <p class=\"card-desc\">Scalable UI patterns for Microsoft Content Services</p>\n              <div class=\"card-content\">\n                <div class=\"mini-toggles-row\">\n                  <div class=\"mini-segmented\" data-vds-toggle=\"type\">\n                    <button class=\"mini-seg-btn selected\" data-value=\"structure\">\n                      <img loading=\"lazy\" decoding=\"async\" src=\"/structure.svg\" alt=\"Structure\" width=\"36\" height=\"36\">\n                    </button>\n                    <button class=\"mini-seg-btn\" data-value=\"production\">\n                      <img loading=\"lazy\" decoding=\"async\" src=\"/production.svg\" alt=\"Production\" width=\"36\" height=\"36\">\n                    </button>\n                  </div>\n                  <div class=\"mini-segmented\" data-vds-toggle=\"theme\">\n                    <button class=\"mini-seg-btn selected\" data-value=\"dark\">\n                      <img loading=\"lazy\" decoding=\"async\" src=\"/dark.svg\" alt=\"Dark\" width=\"36\" height=\"36\">\n                    </button>\n                    <button class=\"mini-seg-btn\" data-value=\"light\">\n                      <img loading=\"lazy\" decoding=\"async\" src=\"/light.svg\" alt=\"Light\" width=\"36\" height=\"36\">\n                    </button>\n                  </div>\n                </div>\n                <div class=\"vds-image-area\">\n                  <img loading=\"lazy\" decoding=\"async\" src=\"/vds/structure-dark.webp\" alt=\"VDS Preview\" class=\"vds-preview-img vds-img-active\">