itle\">Earnings</span>\n                          <div class=\"sl2-earnings-message\">\n                            <span class=\"sl2-earnings-msg-bold\">Upcoming earnings announcement</span>\n                            <span class=\"sl2-earnings-msg-text\">MSFT is due to report earnings in 71 days (Jul 30, 2026).</span>\n                          </div>\n                          <div class=\"sl2-earnings-tabs\">\n                            <span class=\"sl2-earnings-tab sl2-earnings-tab-active\">EPS</span>\n                            <span class=\"sl2-earnings-tab\">Revenue</span>\n                          </div>\n                        </div>\n                        <div class=\"sl2-earnings-content\">\n                          <!-- Left: Data -->\n                          <div class=\"sl2-earnings-left\">\n                            <div class=\"sl2-earnings-announce\">\n                              <span class=\"sl2-earnings-announce-label\">Upcoming earnings announcement</span>\n                              <div class=\"sl2-earnings-date-box\">\n                                <span class=\"sl2-earnings-date\">Jul 30, 2026</span>\n                                <svg class=\"sl2-earnings-date-icon\" viewBox=\"0 0 20 20\" fill=\"none\">\n                                  <circle cx=\"10\" cy=\"10\" r=\"3.5\" stroke=\"white\" stroke-width=\"1.2\" fill=\"none\"/>\n                                  <path d=\"M10 3V5M10 15V17M17 10H15M5 10H3M14.95 5.05L13.54 6.46M6.46 13.54L5.05 14.95M14.95 14.95L13.54 13.54M6.46 6.46L5.05 5.05\" stroke=\"white\" stroke-width=\"1.2\" stroke-linecap=\"round\"/>\n                                </svg>\n                              </div>\n                            </div>\n                            <div class=\"sl2-earnings-data\">\n                              <div class=\"sl2-earnings-row\">\n                                <span class=\"sl2-earnings-row-label\">Last earnings announcement</span>\n                   