<span>Industry Avg</span>\n                            </div>\n                          </div>\n                        </div>\n                      </div>\n\n                      <!-- Analyst rating and price target -->\n                      <div class=\"sl2-analyst\">\n                        <div class=\"sl2-analyst-header\">\n                          <div class=\"sl2-analyst-title\">\n                            <span>Analyst rating and price target</span>\n                          </div>\n                          <div class=\"sl2-analyst-message\">\n                            <span class=\"sl2-analyst-msg-bold\">Buy</span>\n                            <span class=\"sl2-analyst-msg-text\">MSFT target price is 34% above its current price based on analyst consensus.</span>\n                          </div>\n                        </div>\n                        <div class=\"sl2-analyst-content\">\n                          <!-- Left: Gauge + Data -->\n                          <div class=\"sl2-analyst-left\">\n                            <div class=\"sl2-gauge-area\">\n                              <div class=\"sl2-gauge\">\n                                <svg class=\"sl2-gauge-svg\" viewBox=\"0 0 100 54\">\n                                  <!-- Gauge arcs: semicircle, r=38, center=(50,50), 5 segments ~34° each, sweep-flag=1 (clockwise=upper arc) -->\n                                  <path d=\"M12,50 A38,38 0 0,1 18.5,28.75\" stroke=\"#C62828\" stroke-width=\"8\" fill=\"none\" opacity=\"0.5\"/>\n                                  <path d=\"M19.45,27.4 A38,38 0 0,1 37.32,14.18\" stroke=\"#E57373\" stroke-width=\"8\" fill=\"none\" opacity=\"0.5\"/>\n                                  <path d=\"M38.9,13.66 A38,38 0 0,1 61.1,13.66\" stroke=\"#FDD835\" stroke-width=\"8\" fill=\"none\" opacity=\"0.5\"/>\n                                  <path d=\"M62.68,14.18 A38,38 0 0,1 80.55,27.4\" stroke=\"#66BB6A\" stroke-width=\"8\" fill=\"none\"/>\n                    