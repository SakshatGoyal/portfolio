>\n                        </div>\n                        <div class=\"game-tile\">\n                          <img loading=\"lazy\" decoding=\"async\" src=\"/entertainment/game2.webp\" alt=\"Tropical Merge\">\n                          <video class=\"ent-hover-video\" src=\"/entertainment/tropical-merge.mp4\" muted loop playsinline preload=\"none\"></video>\n                          <div class=\"game-gradient\"></div>\n                          <span class=\"game-label\">Tropical Merge</span>\n                        </div>\n                        <div class=\"game-tile\">\n                          <img loading=\"lazy\" decoding=\"async\" src=\"/entertainment/game3.png\" alt=\"Classic Solitaire\">\n                          <video class=\"ent-hover-video\" src=\"/entertainment/classic-solitaire.mp4\" muted loop playsinline preload=\"none\"></video>\n                          <div class=\"game-gradient\"></div>\n                          <span class=\"game-label\">Classic Solitaire</span>\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </article>\n          </div>\n        </div>\n\n        <!-- Microsoft -->\n        <section class=\"section-header\">\n          <div class=\"section-header-row\">\n            <div class=\"logo-container\">\n              <div class=\"icon-btn\">\n                <img loading=\"lazy\" decoding=\"async\" src=\"/microsoft.svg\" alt=\"Microsoft\" width=\"36\" height=\"36\">\n              </div>\n              <h2 class=\"section-title spot-text\">Microsoft</h2>\n            </div>\n            <div class=\"pill-btn spot-badge\">2023 - 2024</div>\n          </div>\n          <p class=\"section-desc spot-text\">Content Systems — across Microsoft Bing, Start, and Windows surfaces</p>\n        </section>\n\n        <div class=\"project-grid single-col\">\n          <article class=\"project-card card-wide\" dat