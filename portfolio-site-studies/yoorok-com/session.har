                      <video class=\"feed-game-video\" src=\"/entertainment/tropical-merge.mp4\" muted loop playsinline preload=\"none\"></video>\n                              </div>\n                              <span>Tropical Merge</span>\n                            </div>\n                            <div class=\"feed-game-widget\">\n                              <div class=\"feed-game-img-wrap\">\n                                <img loading=\"lazy\" decoding=\"async\" src=\"/feed/game-kitty.webp\" alt=\"Kitty Scramble\"/>\n                                <video class=\"feed-game-video\" src=\"/entertainment/kitty-scramble.mp4\" muted loop playsinline preload=\"none\"></video>\n                              </div>\n                              <span>Kitty Scramble</span>\n                            </div>\n                            <div class=\"feed-game-widget\">\n                              <div class=\"feed-game-img-wrap\">\n                                <img loading=\"lazy\" decoding=\"async\" src=\"/feed/game-cutrope.webp\" alt=\"Cut the Rope\"/>\n                                <video class=\"feed-game-video\" src=\"/entertainment/cut-tthe-rope.mp4\" muted loop playsinline preload=\"none\"></video>\n                              </div>\n                              <span>Cut the Rope</span>\n                            </div>\n                          </div>\n                        </div>\n                        <!-- Card 5: Tiny Home -->\n                        <div class=\"feed-card\">\n                          <div class=\"feed-card-gallery\">\n                            <div class=\"feed-gallery-main\">\n                              <div class=\"feed-gallery-track\">\n                                <div class=\"feed-gallery-slide\"><img loading=\"lazy\" decoding=\"async\" class=\"feed-card-img\" src=\"/feed/article-tinyhome.webp\" alt=\"Tiny Home\"/></div>\n                                <div class=\"feed-gallery-slide\"><img loading=\"lazy\" decoding=\"async\" class=\"feed-card-img\" src=\"/feed/thumb-tinyhome1.webp\" alt=\"Tiny Home\"/></div>\n                                <div class=\"feed-gallery-slide\"><img loading=\"lazy\" decoding=\"async\" class=\"feed-card-img\" src=\"/feed/thumb-tinyhome2.webp\" alt=\"Tiny Home\"/></div>\n                                <div class=\"feed-gallery-slide\"><img loading=\"lazy\" decoding=\"async\" class=\"feed-card-img\" src=\"/feed/thumb-tinyhome3.webp\" alt=\"Tiny Home\"/></div>\n                                <div class=\"feed-gallery-slide\"><img loading=\"lazy\" decoding=\"async\" class=\"feed-card-img\" src=\"/feed/thumb-tinyhome4.webp\" alt=\"Tiny Home\"/></div>\n                                <div class=\"feed-gallery-slide\"><img loading=\"lazy\" decoding=\"async\" class=\"feed-card-img\" src=\"/feed/thumb-tinyhome5.webp\" alt=\"Tiny Home\"/></div>\n                              </div>\n                              <div class=\"feed-gallery-arrows\">\n                                <button class=\"feed-gallery-arrow feed-gallery-prev disabled\"><img loading=\"lazy\" decoding=\"async\" src=\"/feed/chevron-left.svg\" alt=\"Previous\"/></button>\n                                <button class=\"feed-gallery-arrow feed-gallery-next\"><img loading=\"lazy\" decoding=\"async\" src=\"/feed/chevron-right.svg\" alt=\"Next\"/></button>\n                              </div>\n                            </div>\n                            <div class=\"feed-thumbs-row\">\n                              <img loading=\"lazy\" decoding=\"async\" class=\"active\" src=\"/feed/article-tinyhome.webp\" alt=\"\"/>\n                              <img loading=\"lazy\" decoding=\"async\" src=\"/feed/thumb-tinyhome1.webp\" alt=\"\"/>\n                              <img loading=\"lazy\" decoding=\"async\" src=\"/feed/thumb-tinyhome2.webp\" alt=\"\"/>\n                              <img loading=\"lazy\" decoding=\"async\" src=\"/feed/thumb-tinyhome3.webp\" alt=\"\"/>\n                              <img loading=\"lazy\" decoding=\"async\" src=\"/feed/thumb-tinyhome4.webp\" alt=\"\"/>\n                              <img loading=\"lazy\" decoding=\"async\" src=\"/feed/thumb-tinyhome5.webp\" alt=\"\"/>\n                            </div>\n                          </div>\n                          <div class=\"feed-card-body\">\n                            <div class=\"feed-card-meta\">\n                              <div class=\"feed-card-badges\">\n                                <img loading=\"lazy\" decoding=\"async\" class=\"feed-publisher-icon\" src=\"/feed/frontline.svg\" alt=\"\"/>\n                                <span>Frontline Observer</span>\n                                <span class=\"feed-meta-sep\">·</span>\n                                <span>1d</span>\n                              </div>\n                              <div class=\"feed-like-btn\">\n                                <img loading=\"lazy\" decoding=\"async\" src=\"/feed/like.svg\" alt=\"Like\"/>\n                                <span>147</span>\n                              </div>\n                            </div>\n                            <h4 class=\"feed-card-title\">This Tiny Home Looks Like a Spaceship and Has a Sauna</h4>\n                            <p class=\"feed-card-desc\">The Pebl Grand is a futuristic prefab tiny home by Hello Wood with panoramic glazing and optional sauna, starting at around $86K.</p>\n                          </div>\n                        </div>\n                        <!-- Card 6: Seattle -->\n                        <div class=\"feed-card\">\n                          <div class=\"feed-card-img-wrap\">\n                            <img loading=\"lazy\" decoding=\"async\" class=\"feed-card-img\" src=\"/feed/article-seattle.png\" alt=\"Seattle homes\"/>\n                          </div>\n                          <div class=\"feed-card-body\">\n                            <div class=\"feed-card-meta\">\n                              <div class=\"feed-card-badges\">\n                                <img loading=\"lazy\" decoding=\"async\" class=\"feed-publisher-icon\" src=\"/feed/summit.svg\" alt=\"\"/>\n                                <span>Summit News</span>\n                                <span class=\"feed-meta-sep\">·</span>\n                                <span>1d</span>\n                              </div>\n                              <div class=\"feed-like-btn\">\n                                <img loading=\"lazy\" decoding=\"async\" src=\"/feed/like.svg\" alt=\"Like\"/>\n                                <span>155</span>\n                              </div>\n                            </div>\n                            <h4 class=\"feed-card-title\">How Much to Afford Seattle's 'Out-of-Whack' Rents</h4>\n                            <div class=\"feed-takeaways-header\">Key takeaways <span>· Curated by Copilot</span></div>\n                            <p class=\"feed-card-desc\"><strong>Unaffordable Rents</strong>: Seattle's rental market has become increasingly unaffordable, with the median for a one-bedroom apartment requiring an income of over $90,000.</p>\n                            <div class=\"feed-card-expanded\">\n                              <ul class=\"feed-expanded-bullets\">\n                                <li><strong>Unaffordable Rents</strong>: Seattle's rental market has become increasingly unaffordable, with the median for a one-bedroom apartment requiring an income of over $90,000.</li>\n                                <li><strong>Outpacing Wages</strong>: Rent increases of 8% year-over-year have outpaced wage growth, pushing residents toward suburban commutes.</li>\n                                <li><strong>Zoning Reforms</strong>: City officials are considering zoning reforms and incentives to boost affordable housing construction.</li>\n                              </ul>\n                            </div>\n                            <div class=\"feed-see-more-wrap\"><button class=\"feed-see-more\">See more <img loading=\"lazy\" decoding=\"async\" src=\"/feed/chevron-down.svg\" alt=\"\"/></button></div>\n                          </div>\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </article>\n\n            <article class=\"project-card\" data-project=\"eto\">\n              <div class=\"project-card-header\">\n                <h3 class=\"card-title\">Entertainment Takeover</h3>\n                <span class=\"card-meta\">Edge · 2025</span>\n              </div>\n              <p class=\"card-desc\">Entertainment-first experience for Gen Z engagement</p>\n              <div class=\"card-image-area\">\n                <div class=\"entertainment-showcase\">\n                  <img loading=\"lazy\" decoding=\"async\" class=\"entertainment-bg\" src=\"/entertainment/bg.webp\" alt=\"\">\n                  <!-- Header -->\n                  <div class=\"ent-header\">\n                    <span class=\"ent-header-title\">Need a quick break, Olivia?</span>\n                    <div class=\"ent-tickers\">\n                      <span class=\"ent-ticker\"><img loading=\"lazy\" decoding=\"async\" class=\"ent-ticker-logo\" src=\"/entertainment/f1-logo.svg\" alt=\"F1\"> Belgian Grand Prix <span class=\"ent-ticker-live\">LIVE</span></span>\n                      <span class=\"ent-ticker\"><span class=\"ent-ticker-label\">MSFT</span> <span class=\"ent-ticker-up\">▲ +3.97%</span></span>\n                      <span class=\"ent-ticker\">Seattle, WA <span class=\"ent-ticker-weather\">☀️</span> 71°</span>\n                    </div>\n                  </div>\n                  <!-- Content area -->\n                  <div class=\"entertainment-content\">\n                    <div class=\"entertainment-shorts\">\n                      <div class=\"short-card short-left\">\n             