cial-margin-date\">Jun 30, 2025</span>\n                            </div>\n                          </div>\n                          <!-- Right: Line chart -->\n                          <div class=\"sl2-financial-right\">\n                            <div class=\"sl2-financial-chart\">\n                              <svg class=\"sl2-financial-svg\" viewBox=\"0 0 300 140\" preserveAspectRatio=\"none\"></svg>\n                              <div class=\"sl2-financial-crosshair\"></div>\n                              <div class=\"sl2-financial-tooltip\"></div>\n                              <div class=\"sl2-financial-y-axis\">\n                                <span>340B</span><span>255B</span><span>170B</span><span>85B</span><span>0</span>\n                              </div>\n                            </div>\n                            <div class=\"sl2-financial-x-axis\">\n                              <span>2020</span><span>2021</span><span>2022</span><span>2023</span><span>2024</span><span>2025</span><span>2026</span>\n                            </div>\n                            <div class=\"sl2-financial-legend\">\n                              <span class=\"sl2-financial-legend-item active\" data-line=\"revenue\"><span class=\"sl2-financial-legend-dot\" style=\"background:#4a90d9;\"></span>Revenue</span>\n                              <span class=\"sl2-financial-legend-item active\" data-line=\"earnings\"><span class=\"sl2-financial-legend-dot\" style=\"background:#4caf50;\"></span>Earnings</span>\n                              <span class=\"sl2-financial-legend-item\" data-line=\"fcf\"><span class=\"sl2-financial-legend-dot\" style=\"background:#9c27b0;\"></span>Free cash flow</span>\n                              <span class=\"sl2-financial-legend-item\" data-line=\"cashop\"><span class=\"sl2-financial-legend-dot\" style=\"background:#26a69a;\"></span>Cash from OP</span>\n                              <span class=\"sl2-financial-legend-item\" data-line