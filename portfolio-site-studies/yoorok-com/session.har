            "text": " \n\n<!DOCTYPE html>\n<html lang=\"en-US\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\n  <meta name=\"viewport\" content=\"initial-scale=1, minimum-scale=1, width=device-width\">\n  <meta name=\"mobile-web-app-capable\" content=\"yes\">\n  <meta name=\"apple-mobile-web-app-capable\" content=\"yes\">\n  <meta name=\"apple-mobile-web-app-title\" content=\"Microsoft AI - We make responsible AI to empower people&#039;s lives.\">\n  <script type=\"text/javascript\" src=\"https://microsoft.ai/wp-content/plugins/microsoft-uhf/assets/microsoft-cookie-list.js\"></script>\r\n    <script src=\"https://unpkg.com/yett\"></script>\r\n    <meta name='robots' content='index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1' />\n\n\t<!-- This site is optimized with the Yoast SEO plugin v27.7 - https://yoast.com/product/yoast-seo-wordpress/ -->\n\t<title>Home | Microsoft AI</title>\n\t<link rel=\"canonical\" href=\"https://microsoft.ai/\" />\n\t<meta property=\"og:locale\" content=\"en_US\" />\n\t<meta property=\"og:type\" content=\"website\" />\n\t<meta property=\"og:title\" content=\"Home | Microsoft AI\" />\n\t<meta property=\"og:url\" content=\"https://microsoft.ai/\" />\n\t<meta property=\"og:site_name\" content=\"Microsoft AI\" />\n\t<meta property=\"article:modified_time\" content=\"2026-06-03T20:02:27+00:00\" />\n\t<meta name=\"twitter:card\" content=\"summary_large_image\" />\n\t<script type=\"application/ld+json\" class=\"yoast-schema-graph\">{\"@context\":\"https:\\/\\/schema.org\",\"@graph\":[{\"@type\":\"WebPage\",\"@id\":\"https:\\/\\/microsoft.ai\\/\",\"url\":\"https:\\/\\/microsoft.ai\\/\",\"name\":\"Home | Microsoft AI\",\"isPartOf\":{\"@id\":\"https:\\/\\/microsoft.ai\\/#website\"},\"about\":{\"@id\":\"https:\\/\\/microsoft.ai\\/#organization\"},\"datePublished\":\"2025-11-06T13:30:03+00:00\",\"dateModified\":\"2026-06-03T20:02:27+00:00\",\"breadcrumb\":{\"@id\":\"https: