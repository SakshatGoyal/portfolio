  <footer class=\"footer\">\n          <h2 class=\"footer-title spot-text\">Let's connect</h2>\n          <p class=\"footer-desc spot-text\">Open to conversations about design, ideas, and everything in between, including dessert spots around the world.</p>\n          <div class=\"social-icons\">\n            <a href=\"mailto:yoorok.jeong@gmail.com\" class=\"social-btn\" aria-label=\"Email\" data-tooltip=\"Email\">\n              <img loading=\"lazy\" decoding=\"async\" src=\"/mail.svg\" alt=\"Email\" width=\"36\" height=\"36\">\n            </a>\n            <a href=\"https://www.linkedin.com/in/yoorokjeong/\" target=\"_blank\" rel=\"noopener\" class=\"social-btn\" aria-label=\"LinkedIn\" data-tooltip=\"LinkedIn\">\n              <img loading=\"lazy\" decoding=\"async\" src=\"/linkedin.svg\" alt=\"LinkedIn\" width=\"36\" height=\"36\">\n            </a>\n            <a href=\"https://www.behance.net/yoorokjeong\" target=\"_blank\" rel=\"noopener\" class=\"social-btn\" aria-label=\"Behance\" data-tooltip=\"Behance\">\n              <img loading=\"lazy\" decoding=\"async\" src=\"/behance.svg\" alt=\"Behance\" width=\"36\" height=\"36\">\n            </a>\n            <a href=\"https://drive.google.com/file/d/1Q_XitYU6PC7u1G8cy2Xf5rxLYVKu47H5/view?usp=sharing\" target=\"_blank\" rel=\"noopener\" class=\"social-btn\" aria-label=\"Resume\" data-tooltip=\"Resume\">\n              <img loading=\"lazy\" decoding=\"async\" src=\"/cv.svg\" alt=\"Resume\" width=\"36\" height=\"36\">\n            </a>\n          </div>\n        </footer>\n      </main>\n\n      <!-- ==================== PLAY PAGE ==================== -->\n      <main id=\"page-play\" class=\"page page-play\">\n        <header class=\"masthead\">\n          <div class=\"aurora-glow\"></div>\n          <h1 class=\"hero-title spot-text\">Yoorok, You Rock!</h1>\n          <p class=\"hero-subtitle spot-text\">I hear it often, but never get tired of it,<br class=\"mobile-break\"> so feel free to say it again <span class=\"spot-emoji\" style=\"-webkit-text-fill-color: initial\">🤍</span></p>\n        </header>\n\n        <!-- Perspective Layers -->\n        <section class=\"section-header\">\n          <div class=\"section-header-row\">\n            <div class=\"logo-container\">\n              <div class=\"icon-btn\">\n                <img loading=\"lazy\" decoding=\"async\" src=\"/perspective-layers.svg\" alt=\"Perspective Layers\" width=\"36\" height=\"36\">\n              </div>\n              <h2 class=\"section-title spot-text\">Perspective Layers</h2>\n            </div>\n            <div class=\"pill-btn spot-badge\">Shifting</div>\n          </div>\n          <p class=\"section-desc spot-text\">Product thinking — grounded in real product experiences within Microsoft AI</p>\n        </section>\n\n        <div class=\"project-grid three-col perspective-grid\">\n          <article class=\"project-card\" data-project=\"timeline\">\n            <div class=\"project-card-header\">\n              <h3 class=\"card-title\">A shift toward exploring content through time</h3>\n              <span class=\"card-meta\">Copilot · 2026</span>\n            </div>\n            <div class=\"card-image-area\">\n              <div class=\"card-placeholder layer-placeholder\">\n                <img loading=\"lazy\" decoding=\"async\" class=\"layer-img\" src=\"/layer1.webp\" alt=\"Layer 1\"/>\n                <img loading=\"lazy\" decoding=\"async\" class=\"layer-lock\" src=\"/lock-play.svg\" width=\"60\" height=\"60\" alt=\"Locked content\"/>\n              </div>\n            </div>\n          </article>\n          <article class=\"project-card\" data-project=\"onda\">\n            <div class=\"project-card-header\">\n              <h3 class=\"card-title\">A reflection on community in AI-powered content</h3>\n              <span class=\"card-meta\">Copilot · 2026</span>\n            </div>\n            <div class=\"card-image-area\">\n              <div class=\"card-placeholder layer-placeholder\">\n                <img loading=\"lazy\" decoding=\"async\" class=\"layer-img\" src=\"/layer2.webp\" alt=\"Layer 2\"/>\n                <img loading=\"lazy\" decoding=\"async\" class=\"layer-lock\" src=\"/lock-play.svg\" width=\"60\" height=\"60\" alt=\"Locked content\"/>\n              </div>\n            </div>\n          </article>\n          <article class=\"project-card\" data-project=\"curate\">\n            <div class=\"project-card-header\">\n              <h3 class=\"card-title\">A thought on curating personal interests</h3>\n              <span class=\"card-meta\">Windows · 2025</span>\n            </div>\n            <div class=\"card-image-area\">\n              <div class=\"card-placeholder layer-placeholder\">\n                <img loading=\"lazy\" decoding=\"async\" class=\"layer-img layer-img-left\" src=\"/layer3.webp\" alt=\"Layer 3\"/>\n                <img loading=\"lazy\" decoding=\"async\" class=\"layer-lock\" src=\"/lock-play.svg\" width=\"60\" height=\"60\" alt=\"Locked content\"/>\n              </div>\n            </div>\n          </article>\n        </div>\n\n        <!-- Everyday Questions -->\n        <section class=\"section-header\">\n          <div class=\"section-header-row\">\n            <div class=\"logo-container\">\n              <div class=\"icon-btn\">\n                <img loading=\"lazy\" decoding=\"async\" src=\"/everyday-questions.svg\" alt=\"Everyday Questions\" width=\"36\" height=\"36\">\n              </div>\n              <h2 class=\"section-title spot-text\">Everyday Questions</h2>\n            </div>\n            <div class=\"pill-btn spot-badge\">Noticing</div>\n          </div>\n          <p class=\"section-desc spot-text\">Curiosity-led thinking — turning questions into product ideas</p>\n        </section>\n\n        <div class=\"project-grid three-col everyday-grid\">\n          <a href=\"https://www.behance.net/gallery/249239025/Pet-Booking\" target=\"_blank\" rel=\"noopener\" class=\"project-card card-phone card-link\" data-project=\"petcare\">\n            <div class=\"project-card-header\">\n              <h3 class=\"card-title\">What if all pet care lived in one place</h3>\n              <span class=\"card-meta\">Pet Care · 2023 <img loading=\"lazy\" decoding=\"async\" class=\"arrow-icon\" src=\"/arrow-play.svg\" width=\"16\" height=\"16\" alt=\"\"></span>\n            </div>\n            <div class=\"phone-frame\">\n              <div class=\"phone-screen petcare-screen\">\n                <div class=\"petcare-frame\">\n                  <img loading=\"lazy\" decoding=\"async\" class=\"petcare-home-img\" src=\"/petcare/home-screen.webp\" alt=\"\">\n                  <div class=\"petcare-vet-card\">\n                    <div class=\"petcare-vet-avatar\">\n                      <img loading=\"lazy\" decoding=\"async\" src=\"/petcare/vet-avatar.webp\" alt=\"\">\n                    </div>\n                    <div class=\"petcare-vet-info\">\n                      <p class=\"petcare-vet-name\">Dr. Tiffany Mason</p>\n                      <p class=\"petcare-vet-role\">Veterinarian</p>\n                      <p class=\"petcare-vet-meta\"><img loading=\"lazy\" decoding=\"async\" class=\"petcare-vet-clock\" src=\"/petcare/clock-icon.svg\" alt=\"\"> Mon-Thu · 10AM-6PM <span class=\"petcare-vet-sep\">|</span> <img loading=\"lazy\" decoding=\"async\" class=\"petcare-vet-star\" src=\"/petcare/star-icon.svg\" alt=\"\"> 4.8</p>\n                    </div>\n                    <div class=\"petcare-vet-bookmark\">\n                      <svg width=\"12\" height=\"16\" viewBox=\"0 0 12 16\" fill=\"none\"><path d=\"M12 16V1C12 0.735 11.895 0.481 11.707 0.293C11.519 0.106 11.265 0 11 0H1C0.735 0 0.48 0.106 0.293 0.293C0.105 0.481 0 0.735 0 1V16L6 13L12 16Z\" stroke=\"#919EAB\" stroke-width=\"2\" stroke-linejoin=\"round\"/></svg>\n                    </div>\n                  </div>\n                  <!-- Page 2: Veterinarian Info -->\n                  <div class=\"petcare-page2\">\n                    <img loading=\"lazy\" decoding=\"async\" class=\"petcare-page2-img\" src=\"/petcare/vet-info-screen.webp\" alt=\"\">\n                    <div class=\"petcare-back-btn\">\n                      <svg width=\"10\" height=\"10\" viewBox=\"0 0 14 14\" fill=\"none\"><path d=\"M13 7H1M1 7L7 1M1 7L7 13\" stroke=\"#292F30\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n                    </div>\n                    <div class=\"petcare-p2-bookmark\">\n                      <svg width=\"12\" height=\"16\" viewBox=\"0 0 12 16\" fill=\"none\"><path d=\"M12 16V1C12 0.735 11.895 0.481 11.707 0.293C11.519 0.106 11.265 0 11 0H1C0.735 0 0.48 0.106 0.293 0.293C0.105 0.481 0 0.735 0 1V16L6 13L12 16Z\" stroke=\"#919EAB\" stroke-width=\"2\" stroke-linejoin=\"round\"/></svg>\n                    </div>\n                    <p class=\"petcare-p2-title\">Veterinarian Info</p>\n                    <div class=\"petcare-p2-avatar\">\n                      <img loading=\"lazy\" decoding=\"async\" src=\"/petcare/vet-avatar.webp\" alt=\"\">\n                    </div>\n                    <p class=\"petcare-p2-name\">Dr. Tiffany Mason</p>\n                    <p class=\"petcare-p2-role\">Veterinarian</p>\n                    <p class=\"petcare-p2-meta\"><img loading=\"lazy\" decoding=\"async\" class=\"petcare-vet-clock\" src=\"/petcare/clock-icon.svg\" alt=\"\"> Mon-Thu · 10AM-6PM <span class=\"petcare-vet-sep\">|</span> <img loading=\"lazy\" decoding=\"async\" class=\"petcare-vet-star\" src=\"/petcare/star-icon.svg\" alt=\"\"> 4.8</p>\n                    <div class=\"petcare-p2-cta\">\n                      <span>Book Appointment</span>\n                      <svg width=\"10\" height=\"8\" viewBox=\"0 0 10 8\" fill=\"none\"><path d=\"M1 4H9M6 1L9 4L6 7\" stroke=\"white\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n                    </div>\n                  </div>\n                  <!-- Page 3: