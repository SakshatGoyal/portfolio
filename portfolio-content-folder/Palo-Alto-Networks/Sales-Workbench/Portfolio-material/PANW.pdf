1732 0 obj
  << /ActualText (Speaking with Account teams across Americas\054 EMEA\054 and APJC\054 I found different teams having mixed opinions on the introduction of AI into their workflow\056 \nConsistent themes included\072\nAI is always pitched for insights\054 but information workers need depth\nIt is hard to maintain focus along long chat threads\056\nProduct teams consistently try to automate parts of the work that require  human judgement at every step\056 )
     /K [ 22 ]
     /P 1733 0 R
     /Pg 1688 0 R
     /S /Span
     /Type /StructElem
  >>
endobj

1733 0 obj
  << /K [ 1732 0 R ]
     /P 1774 0 R
     /S /P
     /Pg 1688 0 R
     /Type /StructElem
  >>
endobj

1734 0 obj
  << /ActualText (Working through abstract unknowns became a bigger focus than one\055off insights and reporting tasks\056 \nWhile AI was good at synthesizing information from multiple sources\054 identifying patterns and converging towards a finding required structured\054 tactile UI elements\056 )
     /K [ 23 ]
     /P 1735 0 R
     /Pg 1688 0 R
     /S /Span
     /Type /StructElem
  >>
endobj

