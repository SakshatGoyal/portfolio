---
import BaseLayout from '../layouts/BaseLayout.astro';
import MemoryLaneTrail from '../components/MemoryLaneTrail.astro';
import ResponsiveVideo from '../components/ResponsiveVideo.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import { HBS_AI_INSTITUTE_TITLE } from '../data/project-titles.js';

const projects = [
  {
    href: '/work/panw-ai/',
    name: 'Sales Workbench AI Features',
    description: 'Designing AI features for deep analysis and traceability.',
    company: 'PALO ALTO NETWORKS',
    year: '2025-26',
    order: 1,
    video: '/assets/home-covers/panw-renewal-exception-row-anchor.webm',
    poster: '/assets/home-covers/posters/panw-renewal-exception-row-anchor.png',
    width: 2304,
    height: 2304,
    className: 'home-project-panw',
  },
  {
    href: '/work/hbs-ai-institute/',
    name: 'AI Research Architecture',
    description: HBS_AI_INSTITUTE_TITLE,
    company: 'HARVARD BUSINESS SCHOOL AI INSTITUTE',
    year: '2025',
    order: 2,
    image: '/assets/hbs/hbs-cover.webp',
    width: 3000,
    height: 1688,
    className: 'home-project-hbs',
  },
  {
    href: '/work/global-data-analytics/',
    name: 'GDA Dashboards',
    description: 'Turning exploratory research into tools for thematic analysis and value-driven sales.',
    company: 'DOCUSIGN',
    year: '2023-24',
    order: 3,
    video: '/assets/home-covers/gda.webm',
    poster: '/assets/home-covers/posters/gda.png',
    width: 1498,
    height: 1124,
    className: 'home-project-global',
  },
  {
    href: '/work/one-report/',
    name: 'OneReport',
    description: 'Designing a data product around an executive’s inquisitive moments.',
    company: 'DOCUSIGN',
    year: '2023',
    order: 4,
    video: '/assets/home-covers/onereport-cover.webm',
    poster: '/assets/home-covers/posters/onereport-cover.png',
    width: 1138,
    height: 2026,
    className: 'home-project-one-report',
  },
  {
    href: '/work/hitachi-energy/',
    name: 'PowerShop ABB',
    description: 'Designing B2B experiences for Hitachi’s Sales Partners',
    company: 'HITACHI ENERGY',
    year: '2021-22',
    order: 5,
    video: '/assets/home-covers/hitachi-cover.webm',
    poster: '/assets/home-covers/posters/hitachi-cover.png',
    width: 1080,
    height: 608,
    className: 'home-project-hitachi',
  },
  {
    href: '/work/cisco-customer-insights/',
    name: 'Cisco Ready, Customer Insights.',
    description: 'Designing Customer Insights, scaling it with Upsell Opportunities.',
    company: 'CISCO SYSTEMS',
    year: '2020-21',
    order: 6,
    video: '/assets/home-covers/cisco-customer-dashboard.webm',
    poster: '/assets/home-covers/posters/cisco-customer-dashboard.png',
    width: 1920,
    height: 1080,
    className: 'home-project-cisco',
  },
  {
    href: '/work/memory-lane/',
    name: 'MemoryLane',
    description: 'A collection of work that doesn’t deserve a long case study, but worth mentioning.',
    company: 'MULTIPLE',
    year: '2019-Present',
    order: 7,
    placeholder: true,
    className: 'home-project-memory-lane',
  },
];

---

<BaseLayout
  title="Sākshāt Goyal — Product Designer"
  description="Systems-oriented product designer working on ambiguous, organizationally complicated problems with imperfect data."
>
  <section class="home-work" id="work">
    <h2 class="sr-only">Selected Work</h2>
    <div class="home-project-scroller">
      <div class="home-project-grid" data-home-project-grid data-home-layout="small">
        {projects.map((project, index) => (
          <div class="home-project-slot" data-home-project-slot data-home-order={project.order}>
            <a class:list={['home-project-card', project.className]} href={project.href} aria-label={`View ${project.name} case study`} style={`--home-order: ${project.order}`} data-home-order={project.order} data-home-project-reveal-unit data-project-tile data-reveal>
              <div class="home-project-copy" data-home-project-text-reveal>
                <h3>{project.name}</h3>
              </div>
              <div class="home-project-meta" data-home-project-text-reveal>
                <div class="home-project-meta-primary">
                  <span class="home-project-client">{project.company}</span>
                  <time class="home-project-year">{project.year}</time>
                </div>
                <span class="home-project-view" data-tape-label>View Project</span>
              </div>
              {project.placeholder ? (
                <div class="home-project-media" data-home-project-media-reveal data-media-reveal>
                  <span class="media-reveal-clip" data-media-reveal-clip>
                    <MemoryLaneTrail
                      className="home-project-media-visual media-reveal-rise home-project-placeholder"
                      decorative
                      loading="lazy"
                      data-media-reveal-rise
                      data-asset-surface
                    />
                  </span>
                </div>
              ) : project.video ? (
                <div class="home-project-media" data-home-project-media-reveal data-media-reveal>
                  <span class="media-reveal-clip" data-media-reveal-clip>
                    <span class="home-project-media-visual media-reveal-rise playable-media-surface" data-media-reveal-rise data-asset-surface data-playable-media>
                      <ResponsiveVideo src={project.video} poster={project.poster} width={project.width} height={project.height} label={project.name} home />
                    </span>
                  </span>
                </div>
              ) : (
                <div class="home-project-media" data-home-project-media-reveal data-media-reveal>
                  <span class="media-reveal-clip" data-media-reveal-clip>
                    <span class="home-project-media-visual media-reveal-rise" data-media-reveal-rise data-asset-surface>
                      <ResponsiveImage src={project.image!} alt={project.name} width={project.width} height={project.height} sizes="(max-width: 451px) 388px, (max-width: 1023px) calc(100vw - 64px), 444px" loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />
                    </span>
                  </span>
                </div>
              )}
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <script is:inline>
    const projectGrid = document.querySelector('[data-home-project-grid]');

    if (projectGrid) {
      const minimumProjectCardWidth = 420;
      const projectSlots = Object.fromEntries(
        [...projectGrid.querySelectorAll('[data-home-project-slot]')]
          .map((slot) => [Number(slot.dataset.homeOrder), slot]),
      );
      let projectLayoutFrame = 0;
      let observedGridWidth = 0;
      let sectionHashCorrected = false;
      const cssPixels = (value) => `${Math.round(value * 1000) / 1000}px`;
      const setGeometry = (order, left, top, width) => {
        const slot = projectSlots[order];
        slot.style.left = cssPixels(left);
        slot.style.top = cssPixels(top);
        slot.style.width = cssPixels(width);
      };
      const slotHeight = (order) => projectSlots[order].getBoundingClientRect().height;
      const correctSectionHash = (final = false) => {
        if (sectionHashCorrected || !['#work', '#gallery'].includes(location.hash)) return;
        if (final) sectionHashCorrected = true;
        requestAnimationFrame(() => document.querySelector(location.hash)?.scrollIntoView({
          behavior: 'instant',
          block: 'start',
        }));
      };

      const resetToSingleColumn = () => {
        projectGrid.dataset.homeLayout = 'small';
        projectGrid.style.height = '';
        Object.values(projectSlots).forEach((slot) => {
          slot.style.left = '';
          slot.style.top = '';
          slot.style.width = '';
        });
      };

      const layoutProjects = () => {
        const gridWidth = projectGrid.clientWidth;
        if (!gridWidth) return;

        const gridStyles = getComputedStyle(projectGrid);
        const paddingLeft = Number.parseFloat(gridStyles.paddingLeft) || 0;
        const paddingRight = Number.parseFloat(gridStyles.paddingRight) || 0;
        const paddingTop = Number.parseFloat(gridStyles.paddingTop) || 0;
        const paddingBottom = Number.parseFloat(gridStyles.paddingBottom) || 0;
        const contentWidth = gridWidth - paddingLeft - paddingRight;
        const columnGap = Number.parseFloat(
          gridStyles.getPropertyValue('--home-project-column-gap'),
        ) || 0;

        if (contentWidth < minimumProjectCardWidth * 2 + columnGap) {
          resetToSingleColumn();
          correctSectionHash();
          return;
        }

        const columnWidth = (contentWidth - columnGap) / 2;
        const firstColumnX = paddingLeft;
        const secondColumnX = paddingLeft + columnWidth + columnGap;
        projectGrid.dataset.homeLayout = 'medium';
        [1, 3, 5, 6].forEach((order) => setGeometry(order, firstColumnX, paddingTop, columnWidth));
        [2, 4, 7].forEach((order) => setGeometry(order, secondColumnX, paddingTop, columnWidth));

        const height1 = slotHeight(1);
        const height2 = slotHeight(2);
        const height3 = slotHeight(3);
        const height4 = slotHeight(4);
        const height5 = slotHeight(5);
        const height6 = slotHeight(6);
        const height7 = slotHeight(7);
        const rowGap = Number.parseFloat(gridStyles.getPropertyValue('--home-project-row-gap')) || 0;
        const leftSecondTop = paddingTop + height1 + rowGap;
        const leftThirdTop = leftSecondTop + height3 + rowGap;
        const leftFourthTop = leftThirdTop + height5 + rowGap;
        const rightSecondTop = paddingTop + height2 + rowGap;
        const rightThirdTop = rightSecondTop + height4 + rowGap;

        setGeometry(3, firstColumnX, leftSecondTop, columnWidth);
        setGeometry(5, firstColumnX, leftThirdTop, columnWidth);
        setGeometry(6, firstColumnX, leftFourthTop, columnWidth);
        setGeometry(4, secondColumnX, rightSecondTop, columnWidth);
        setGeometry(7, secondColumnX, rightThirdTop, columnWidth);
        projectGrid.style.height = cssPixels(Math.max(
          leftFourthTop + height6,
          rightThirdTop + height7,
        ) + paddingBottom);

        correctSectionHash();
      };

      const queueProjectLayout = () => {
        cancelAnimationFrame(projectLayoutFrame);
        projectLayoutFrame = requestAnimationFrame(layoutProjects);
      };

      const gridObserver = new ResizeObserver(([entry]) => {
        const nextWidth = entry.contentRect.width;
        if (Math.abs(nextWidth - observedGridWidth) < 0.5) return;
        observedGridWidth = nextWidth;
        queueProjectLayout();
      });
      const cardObserver = new ResizeObserver(queueProjectLayout);
      gridObserver.observe(projectGrid);
      Object.values(projectSlots).forEach((slot) => {
        cardObserver.observe(slot);
        cardObserver.observe(slot.firstElementChild);
        cardObserver.observe(slot.querySelector('.home-project-media'));
      });
      projectGrid.addEventListener('load', queueProjectLayout, true);
      projectGrid.addEventListener('loadedmetadata', queueProjectLayout, true);
      document.fonts?.ready.then(queueProjectLayout);
      window.addEventListener('resize', queueProjectLayout, { passive: true });
      layoutProjects();

      const homeMediaReady = [...projectGrid.querySelectorAll('video')].map((video) => (
        video.readyState >= 1
          ? Promise.resolve()
          : new Promise((resolve) => {
            video.addEventListener('loadedmetadata', resolve, { once: true });
            video.addEventListener('error', resolve, { once: true });
          })
      ));
      Promise.all([document.fonts?.ready || Promise.resolve(), ...homeMediaReady]).then(() => {
        queueProjectLayout();
        requestAnimationFrame(() => requestAnimationFrame(() => correctSectionHash(true)));
      });
    }

  </script>
</BaseLayout>
