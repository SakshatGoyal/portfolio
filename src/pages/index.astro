---
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = [
  {
    href: '/work/panw-ai/',
    title: 'Designing AI experiences for deep analysis and traceability.',
    company: 'PALO ALTO NETWORKS',
    year: '2025–26',
    order: 1,
    video: '/assets/panw-ai/video/02-renewal-exception-row-anchor.webm',
    poster: '/assets/home-covers/posters/panw-ai.png',
    className: 'home-project-panw',
  },
  {
    href: '/work/hbs-ai-institute/',
    title: 'Designing an AI architecture for large scale, qualitative research and product strategy.',
    company: 'HARVARD BUSINESS SCHOOL',
    year: '2025',
    order: 2,
    image: '/assets/hbs/hbs-cover.png',
    width: 5586,
    height: 3142,
    className: 'home-project-hbs',
  },
  {
    href: '/work/one-report/',
    title: 'Designing a data product around an executive’s inquisitive moments.',
    company: 'DOCUSIGN',
    year: '2023',
    order: 3,
    video: '/assets/home-covers/one-report.webm',
    poster: '/assets/home-covers/posters/one-report.png',
    className: 'home-project-one-report',
  },
  {
    href: '/work/global-data-analytics/',
    title: 'Deriving novice use-cases from existing basic data [title to be changed later]',
    company: 'DOCUSIGN',
    year: '2023–24',
    order: 4,
    video: '/assets/home-covers/gda.webm',
    poster: '/assets/home-covers/posters/gda.png',
    className: 'home-project-global',
  },
  {
    href: '/work/hitachi-energy/',
    title: "Designing a B2B buying experience for Hitachi's Sales Partners",
    company: 'HITACHI ENERGY',
    year: '2022',
    order: 5,
    image: '/assets/home-covers/hitachi-cover.gif',
    className: 'home-project-hitachi',
  },
  {
    href: '/work/cisco-customer-insights/',
    title: 'Designing Customer Insights and extending it with Upsell Opportunities.',
    company: 'CISCO',
    year: '2020–21',
    order: 6,
    image: '/assets/home-covers/cisco-customer-dashboard.gif',
    className: 'home-project-cisco',
  },
];

const leftProjects = projects.filter(({ order }) => order === 1 || order === 3);
const rightProjects = projects.filter(({ order }) => order !== 1 && order !== 3);

---

<BaseLayout title="Portfolio" description="Portfolio">
  <section class="home-hero" id="about">
    <div class="home-bio">
      <p>I lead design at Intelligaia.</p>
      <p>I’m a systems-oriented product designer whose greatest value emerges when the problem is ambiguous, organizationally complicated, and full of imperfect data.</p>
      <p>Over the last 8 years, I’ve worked with teams at Palo Alto Networks, Harvard Business School, DocuSign, Hitachi Energy, and Cisco.</p>
    </div>
  </section>

  <section class="home-work" id="work">
    <div class="home-project-columns">
      <div class="home-project-column">
        {leftProjects.map((project, index) => (
          <a class:list={['home-project-card', project.className]} href={project.href} style={`--home-order: ${project.order}`} data-home-order={project.order} data-reveal>
            <div class="home-project-meta">
              <span>{project.company}</span>
              <time>{project.year}</time>
            </div>
            <div class="home-project-media">
              {project.video ? (
                <video src={project.video} poster={project.poster} style={`--video-poster-image: url('${project.poster}')`} aria-label={project.title} muted loop playsinline preload="metadata" data-autoplay-on-view></video>
              ) : (
                <img src={project.image} alt={project.title} width={project.width} height={project.height} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />
              )}
            </div>
            <div class="home-project-copy">
              <h3>{project.title}</h3>
            </div>
          </a>
        ))}
      </div>
      <div class="home-project-column">
        {rightProjects.map((project) => (
          <a class:list={['home-project-card', project.className]} href={project.href} style={`--home-order: ${project.order}`} data-home-order={project.order} data-reveal>
            <div class="home-project-meta">
              <span>{project.company}</span>
              <time>{project.year}</time>
            </div>
            <div class="home-project-media">
              {project.video ? (
                <video src={project.video} poster={project.poster} style={`--video-poster-image: url('${project.poster}')`} aria-label={project.title} muted loop playsinline preload="metadata" data-autoplay-on-view></video>
              ) : (
                <img src={project.image} alt={project.title} width={project.width} height={project.height} loading="lazy" decoding="async" />
              )}
            </div>
            <div class="home-project-copy">
              <h3>{project.title}</h3>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
