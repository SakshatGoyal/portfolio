---
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = [
  {
    href: '/work/panw-ai/',
    title: 'Designing AI experiences for deep analysis and traceability.',
    company: 'Palo Alto Networks',
    video: '/assets/panw-ai/video/02-renewal-exception-row-anchor.webm',
    className: 'home-project-panw',
  },
  {
    href: '/work/hbs-ai-institute/',
    title: 'Designing an AI architecture for large scale, qualitative research and product strategy.',
    company: 'HBS AI Institute',
    image: '/assets/hbs/imgPanwImage011.png',
    className: 'home-project-hbs',
  },
  {
    href: '/work/one-report/',
    title: 'Designing a data product around an executive’s inquisitive moments.',
    company: 'DocuSign',
    image: '/assets/one-report/imgPanwImage011.png',
    className: 'home-project-one-report',
  },
  {
    href: '/work/global-data-analytics/',
    title: 'Deriving novice use-cases from existing basic data [title to be changed later]',
    company: 'DocuSign',
    image: '/assets/global-data/imgPanwImage011.png',
    className: 'home-project-global',
  },
  {
    href: '/work/hitachi-energy/',
    title: "Designing a B2B buying experience for Hitachi's Sales Partners",
    company: 'Hitachi Energy',
    image: '/assets/hitachi/partner-account-team.png',
    className: 'home-project-hitachi',
  },
  {
    href: '/work/cisco-customer-insights/',
    title: 'Designing Customer Insights and extending it with Upsell Opportunities.',
    company: 'Cisco',
    image: '/assets/cisco/posters/opportunity-extension-flow.jpg',
    className: 'home-project-cisco',
  },
];
---

<BaseLayout title="Portfolio" description="Portfolio">
  <section class="home-hero" id="about">
    <p class="home-role">Sākshāt Goyal</p>
    <h1>Product Designer</h1>
    <p class="home-statement">I’m a 0 to 1 Product Designer living in the San Francisco Bay Area.</p>
    <p class="home-summary">Over the past 8 years, I’ve worked with teams at Palo Alto Networks, Harvard Business School, DocuSign, Hitachi Energy, Cisco, and a number of startups.</p>
  </section>

  <section class="home-work" id="work">
    <div class="home-section-heading" data-reveal>
      <h2>Selected work</h2>
    </div>
    <div class="home-project-columns">
      <div class="home-project-column">
        {projects.filter((_, index) => index % 2 === 0).map((project, index) => (
          <a class:list={['home-project-card', project.className]} href={project.href} data-reveal>
            <div class="home-project-media">
              {project.video ? (
                <video src={project.video} aria-label={project.title} autoplay muted loop playsinline preload="auto" data-autoplay-on-view></video>
              ) : (
                <img src={project.image} alt={project.title} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />
              )}
              <span class="home-project-arrow" aria-hidden="true">↗</span>
            </div>
            <div class="home-project-copy">
              <h3>{project.title}</h3>
              <p>{project.company}</p>
            </div>
          </a>
        ))}
      </div>
      <div class="home-project-column">
        {projects.filter((_, index) => index % 2 === 1).map((project) => (
          <a class:list={['home-project-card', project.className]} href={project.href} data-reveal>
          <div class="home-project-media">
            {project.video ? (
              <video src={project.video} aria-label={project.title} autoplay muted loop playsinline preload="auto" data-autoplay-on-view></video>
            ) : (
              <img src={project.image} alt={project.title} loading="lazy" decoding="async" />
            )}
            <span class="home-project-arrow" aria-hidden="true">↗</span>
          </div>
          <div class="home-project-copy">
            <h3>{project.title}</h3>
            <p>{project.company}</p>
          </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
