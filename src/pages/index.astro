---
import BaseLayout from '../layouts/BaseLayout.astro';
import GalleryArtifact from '../components/GalleryArtifact.astro';
import { GLOBAL_DATA_ANALYTICS_TITLE } from '../data/project-titles.js';
import { parseGalleryNotes } from '../data/gallery.js';
import galleryNotes from '../content/gallery-notes.md?raw';

const galleryProjects = parseGalleryNotes(galleryNotes);

const projects = [
  {
    href: '/work/panw-ai/',
    title: 'Designing AI experiences for deep analysis and traceability.',
    company: 'PALO ALTO NETWORKS',
    year: '2025–26',
    order: 1,
    video: '/assets/home-covers/panw-renewal-exception-row-anchor.webm',
    poster: '/assets/home-covers/posters/panw-renewal-exception-row-anchor.png',
    className: 'home-project-panw',
  },
  {
    href: '/work/hbs-ai-institute/',
    title: 'Creating an AI driven research architecture for reliability and novel exploration.',
    company: 'HARVARD BUSINESS SCHOOL',
    year: '2025',
    order: 2,
    image: '/assets/hbs/hbs-cover.webp',
    width: 3000,
    height: 1688,
    className: 'home-project-hbs',
  },
  {
    href: '/work/global-data-analytics/',
    title: GLOBAL_DATA_ANALYTICS_TITLE,
    company: 'DOCUSIGN',
    year: '2023–24',
    order: 3,
    video: '/assets/home-covers/gda.webm',
    poster: '/assets/home-covers/posters/gda.png',
    className: 'home-project-global',
  },
  {
    href: '/work/one-report/',
    title: 'Designing a data product around an executive’s inquisitive moments.',
    company: 'DOCUSIGN',
    year: '2023',
    order: 4,
    video: '/assets/home-covers/onereport-cover.webm',
    poster: '/assets/home-covers/posters/onereport-cover.png',
    className: 'home-project-one-report',
  },
  {
    href: '/work/hitachi-energy/',
    title: "Designing a B2B buying experience for Hitachi's Sales Partners",
    company: 'HITACHI ENERGY',
    year: '2022',
    order: 5,
    video: '/assets/home-covers/hitachi-cover.webm',
    poster: '/assets/home-covers/posters/hitachi-cover.png',
    width: 1080,
    height: 608,
    className: 'home-project-hitachi',
  },
  {
    href: '/work/cisco-customer-insights/',
    title: 'Designing Customer Insights and extending it with Upsell Opportunities.',
    company: 'CISCO',
    year: '2020–21',
    order: 6,
    video: '/assets/home-covers/cisco-customer-dashboard.webm',
    poster: '/assets/home-covers/posters/cisco-customer-dashboard.png',
    width: 1920,
    height: 1080,
    className: 'home-project-cisco',
  },
];

---

<BaseLayout
  title="Sākshāt Goyal — Product Designer"
  description="Systems-oriented product designer working on ambiguous, organizationally complicated problems with imperfect data."
>
  <section class="home-hero" id="about">
    <div class="home-bio">
      <p>I’m a systems-oriented product designer whose greatest value emerges when the problem is ambiguous, organizationally complicated, and full of imperfect data.</p>
      <p>Over the last 8 years, I’ve worked with teams at Palo Alto Networks, Harvard Business School, DocuSign, Hitachi Energy, and Cisco.</p>
    </div>
  </section>

  <section class="home-work" id="work">
    <div class="home-project-grid" data-home-project-grid data-home-layout="small">
      {projects.map((project, index) => (
        <div class="home-project-slot" data-home-project-slot data-home-order={project.order}>
          <a class:list={['home-project-card', project.className]} href={project.href} aria-label={`View ${project.title}`} style={`--home-order: ${project.order}`} data-home-order={project.order} data-project-tile data-reveal>
            <div class="home-project-copy">
              <h3 class="home-tape-label" data-tape-label data-tape-delay="0">{project.title}</h3>
            </div>
            <div class="home-project-meta">
              <span class="home-project-client home-tape-label" data-tape-label data-tape-delay="75">{project.company}</span>
              <span class="home-project-meta-separator" aria-hidden="true">・</span>
              <time class="home-project-year home-tape-label" data-tape-label data-tape-delay="150">{project.year}</time>
            </div>
            {project.video ? (
              <div class="home-project-media" data-media-reveal>
                <span class="media-reveal-clip" data-media-reveal-clip>
                  <span class="home-project-media-visual media-reveal-rise" data-media-reveal-rise>
                    <video src={project.video} poster={project.poster} style={`--video-poster-image: url('${project.poster}')`} aria-label={project.title} muted loop playsinline preload="metadata" data-home-autoplay-on-view></video>
                  </span>
                </span>
              </div>
            ) : (
              <div class="home-project-media" data-media-reveal>
                <span class="media-reveal-clip" data-media-reveal-clip>
                  <span class="home-project-media-visual media-reveal-rise" data-media-reveal-rise>
                    <img src={project.image} alt={project.title} width={project.width} height={project.height} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />
                  </span>
                </span>
              </div>
            )}
          </a>
        </div>
      ))}
    </div>
  </section>

  <section class="home-gallery" id="gallery" data-home-gallery aria-label="Gallery">
    {galleryProjects.map((project) => (
      <article class="gallery-project" data-gallery-project>
        <div class="gallery-project-info-track">
          <div class="gallery-project-info" data-gallery-info>
            <div class="gallery-project-heading">
              <h2>{project.title}</h2>
              <span aria-hidden="true">・</span>
              <time>{project.year}</time>
            </div>
            {project.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </div>
        <div class="gallery-artifacts">
          {project.media.map((artifact) => <GalleryArtifact {...artifact} label={project.title} />)}
        </div>
        <span class="gallery-project-end" data-gallery-project-end aria-hidden="true"></span>
      </article>
    ))}
  </section>

  <script is:inline>
    const projectGrid = document.querySelector('[data-home-project-grid]');

    if (projectGrid) {
      const projectSlots = Object.fromEntries(
        [...projectGrid.querySelectorAll('[data-home-project-slot]')]
          .map((slot) => [Number(slot.dataset.homeOrder), slot]),
      );
      let projectLayoutFrame = 0;
      let observedGridWidth = 0;
      let galleryHashCorrected = false;
      const cssPixels = (value) => `${Math.round(value * 1000) / 1000}px`;
      const setGeometry = (order, left, top, width) => {
        const slot = projectSlots[order];
        slot.style.left = cssPixels(left);
        slot.style.top = cssPixels(top);
        slot.style.width = cssPixels(width);
      };
      const slotHeight = (order) => projectSlots[order].getBoundingClientRect().height;
      const correctGalleryHash = () => {
        if (galleryHashCorrected || location.hash !== '#gallery') return;
        galleryHashCorrected = true;
        requestAnimationFrame(() => document.querySelector('#gallery')?.scrollIntoView({
          behavior: 'instant',
          block: 'start',
        }));
      };

      const resetToSingleColumn = () => {
        projectGrid.dataset.homeLayout = 'small';
        projectGrid.style.height = '';
        Object.values(projectSlots).forEach((slot) => {
          slot.style.left = '';
          slot.style.top = '';
          slot.style.width = '';
        });
      };

      const layoutProjects = () => {
        const viewportWidth = window.innerWidth;
        const gridWidth = projectGrid.clientWidth;
        if (!gridWidth) return;

        if (viewportWidth < 672) {
          resetToSingleColumn();
          correctGalleryHash();
          return;
        }

        const columnWidth = gridWidth / 2;
        projectGrid.dataset.homeLayout = 'medium';
        [1, 4].forEach((order) => setGeometry(order, 0, 0, columnWidth));
        [2, 3, 5, 6].forEach((order) => setGeometry(order, columnWidth, 0, columnWidth));

        const height1 = slotHeight(1);
        const height2 = slotHeight(2);
        const height3 = slotHeight(3);
        const height4 = slotHeight(4);
        const height5 = slotHeight(5);
        const height6 = slotHeight(6);
        setGeometry(4, 0, height1, columnWidth);
        setGeometry(3, columnWidth, height2, columnWidth);
        setGeometry(5, columnWidth, height2 + height3, columnWidth);
        setGeometry(6, columnWidth, height2 + height3 + height5, columnWidth);
        projectGrid.style.height = cssPixels(Math.max(
          height1 + height4,
          height2 + height3 + height5 + height6,
        ));

        correctGalleryHash();
      };

      const queueProjectLayout = () => {
        cancelAnimationFrame(projectLayoutFrame);
        projectLayoutFrame = requestAnimationFrame(layoutProjects);
      };

      const gridObserver = new ResizeObserver(([entry]) => {
        const nextWidth = entry.contentRect.width;
        if (Math.abs(nextWidth - observedGridWidth) < 0.5) return;
        observedGridWidth = nextWidth;
        queueProjectLayout();
      });
      const cardObserver = new ResizeObserver(queueProjectLayout);
      gridObserver.observe(projectGrid);
      Object.values(projectSlots).forEach((slot) => {
        cardObserver.observe(slot);
        cardObserver.observe(slot.firstElementChild);
        cardObserver.observe(slot.querySelector('.home-project-media'));
      });
      projectGrid.addEventListener('load', queueProjectLayout, true);
      projectGrid.addEventListener('loadedmetadata', queueProjectLayout, true);
      document.fonts?.ready.then(queueProjectLayout);
      projectGrid.addEventListener('tapelayout', queueProjectLayout);
      window.addEventListener('resize', queueProjectLayout, { passive: true });
      layoutProjects();
    }

    const homeSections = ['about', 'work', 'gallery']
      .map((id) => document.getElementById(id))
      .filter(Boolean);
    const homeSectionLinks = [...document.querySelectorAll('[data-home-section-link]')];
    let sectionStateFrame = 0;
    const syncHomeSectionState = () => {
      sectionStateFrame = 0;
      const readingLine = window.scrollY + (window.innerHeight * 0.25);
      const activeSection = homeSections.reduce((active, section) => (
        section.offsetTop <= readingLine ? section : active
      ), homeSections[0]);
      homeSectionLinks.forEach((link) => {
        const active = link.dataset.homeSectionLink === activeSection?.id;
        link.classList.toggle('active', active);
        if (active) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
    };
    const queueHomeSectionState = () => {
      if (sectionStateFrame) return;
      sectionStateFrame = requestAnimationFrame(syncHomeSectionState);
    };
    window.addEventListener('scroll', queueHomeSectionState, { passive: true });
    window.addEventListener('resize', queueHomeSectionState, { passive: true });
    window.addEventListener('hashchange', queueHomeSectionState);
    document.fonts?.ready.then(queueHomeSectionState);
    syncHomeSectionState();

    const galleryEndObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        entry.target.closest('[data-gallery-project]')
          ?.classList.toggle('gallery-project-ending', entry.isIntersecting);
      });
    }, { threshold: 0 });
    document.querySelectorAll('[data-gallery-project-end]').forEach((sentinel) => {
      galleryEndObserver.observe(sentinel);
    });
  </script>
</BaseLayout>
