---
interface Props {
  slides: string[];
  startIndex?: number;
  aspectRatio: string;
  class?: string;
}

const {
  slides,
  startIndex = 0,
  aspectRatio,
  class: className = '',
} = Astro.props;
---

<div
  class:list={['figma-carousel', className]}
  data-carousel
  data-media-unit
  data-media-reveal
  data-index={startIndex}
>
  <div class="media-reveal-clip" data-media-reveal-clip>
    <div class="media-reveal-rise" data-media-reveal-rise>
      <div
        class="carousel-viewport"
        style={`aspect-ratio: ${aspectRatio};`}
        data-asset-surface
        data-viewport-media-frame
        data-preserve-media-aspect
        data-media-aspect={aspectRatio}
        role="button"
        tabindex="0"
        aria-label="Show next slide"
      >
        <div class="carousel-stage">
          {slides.map((slide, index) => (
            <img
              src={slide}
              alt=""
              loading="lazy"
              data-carousel-slide
              data-media-visual
              aria-hidden={index === startIndex ? 'false' : 'true'}
              style={`opacity: ${index === startIndex ? 1 : 0};`}
            />
          ))}
        </div>
      </div>
    </div>
  </div>
  <div class="carousel-pagination" aria-label="Carousel pagination">
    {slides.map((_, index) => (
      <button type="button" data-carousel-dot aria-label={`View slide ${index + 1}`} aria-current={index === startIndex ? 'step' : undefined}></button>
    ))}
  </div>
  <div class="carousel-caption" data-media-caption><slot /></div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((carousel) => {
    const slides = Array.from(carousel.querySelectorAll<HTMLElement>('[data-carousel-slide]'));
    const dots = Array.from(carousel.querySelectorAll<HTMLButtonElement>('[data-carousel-dot]'));
    const viewport = carousel.querySelector<HTMLElement>('.carousel-viewport');
    let index = Number(carousel.dataset.index ?? '0');
    let fadeIndex = index;
    let position = 1;
    let velocity = 0;
    let restingFrames = 0;
    let animationFrame: number | undefined;

    const prefersReducedMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const dispatchMediaChange = () => carousel.dispatchEvent(new CustomEvent('mediachange', {
      bubbles: true,
      detail: { geometryChanged: false },
    }));

    const renderState = () => {
      slides.forEach((slide, slideIndex) => {
        const selected = slideIndex === index;
        slide.setAttribute('aria-hidden', String(!selected));
      });
      dots.forEach((dot, dotIndex) => {
        if (dotIndex === index) dot.setAttribute('aria-current', 'step');
        else dot.removeAttribute('aria-current');
      });
      carousel.dataset.index = String(index);
      dispatchMediaChange();
    };

    const renderFade = () => {
      slides.forEach((slide, slideIndex) => {
        if (slideIndex === fadeIndex) slide.style.opacity = String(Math.max(0, 1 - position));
        else if (slideIndex === index) slide.style.opacity = String(Math.min(1, position));
        else slide.style.opacity = '0';
      });
    };

    const settleFade = () => {
      position = 1;
      velocity = 0;
      restingFrames = 0;
      renderFade();
      animationFrame = undefined;
      dispatchMediaChange();
    };

    const animateFade = () => {
      const previousPosition = position;
      velocity += (1 - position) * 0.025;
      position += velocity;
      velocity *= 1 - 0.28;
      renderFade();

      if (Math.round(position * 100) === Math.round(previousPosition * 100)) restingFrames += 1;
      else restingFrames = 0;

      if (restingFrames > 2) settleFade();
      else animationFrame = window.requestAnimationFrame(animateFade);
    };

    const select = (nextIndex: number) => {
      const normalizedIndex = (nextIndex + slides.length) % slides.length;
      if (normalizedIndex === index || slides.length < 2) return;
      if (animationFrame !== undefined) window.cancelAnimationFrame(animationFrame);
      fadeIndex = index;
      index = normalizedIndex;
      position = 0;
      velocity = 0;
      restingFrames = 0;
      renderState();

      if (prefersReducedMotion()) settleFade();
      else animateFade();
    };

    dots.forEach((dot, dotIndex) => dot.addEventListener('click', () => {
      select(dotIndex);
    }));
    carousel.addEventListener('keydown', (event) => {
      if (!['ArrowLeft', 'ArrowRight'].includes(event.key)) return;
      event.preventDefault();
      const nextIndex = event.key === 'ArrowLeft' ? index - 1 : index + 1;
      select(nextIndex);
      dots[(nextIndex + slides.length) % slides.length]?.focus();
    });
    viewport?.addEventListener('click', () => select(index + 1));
    viewport?.addEventListener('keydown', (event) => {
      if (!['Enter', ' '].includes(event.key)) return;
      event.preventDefault();
      select(index + 1);
    });
    renderState();
  });
</script>

<style>
  .figma-carousel { display: flex; flex-direction: column; gap: 0; width: 100%; margin-inline: auto; }
  .media-reveal-rise, .media-reveal-clip { width: 100%; }
  .carousel-viewport { position: relative; width: 100%; overflow: hidden; outline: 0; cursor: pointer; }
  .carousel-stage { position: absolute; inset: 0; width: 100%; }
  .carousel-stage > img { position: absolute; inset: 0 auto auto 0; display: block; width: 100%; max-width: 100%; height: auto; }
  .carousel-stage > img[aria-hidden='true'] { pointer-events: none; }
  .carousel-pagination { position: relative; z-index: 2; display: flex; align-self: flex-start; width: auto; height: 2px; padding: 0; margin: 8px 0 12px; list-style: none; text-align: left; line-height: 1; font-size: 0; }
  .carousel-pagination button { position: relative; display: inline-block; flex: 0 0 50px; width: 50px; height: 2px; padding: 0; margin: 0 2px; border: 0; border-radius: 0; outline: 0; background: var(--ink); opacity: .25; cursor: pointer; box-shadow: none; transition: opacity .2s ease-out; }
  .carousel-pagination button[aria-current='step'] { opacity: 1; }
  .carousel-pagination button::after { position: absolute; top: -13px; left: 0; width: 100%; height: 30px; content: ''; }
  .carousel-caption { align-self: stretch; padding: var(--caption-pad-top, 8px) 0 var(--caption-pad-bottom, 0px); color: var(--ink); font: 400 var(--caption-size, 14px)/var(--caption-leading, 1.35) 'Basically A Mono', 'Fragment Mono', monospace; }
  .carousel-caption :global(p + p) { margin-top: 24px; }

  @media (max-width: 767px) {
    .figma-carousel { width: 100%; padding-inline: 0; }
    .carousel-caption { padding-inline: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .carousel-pagination button { transition: none; }
  }
</style>
