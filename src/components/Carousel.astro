---
interface Props {
  slides: string[];
  startIndex?: number;
  aspectRatio: string;
  slideFadeDuration?: number;
  class?: string;
}

const {
  slides,
  startIndex = 0,
  aspectRatio,
  slideFadeDuration = 438,
  class: className = '',
} = Astro.props;
---

<div
  class:list={['figma-carousel', className]}
  data-carousel
  data-media-unit
  data-media-reveal
  data-index={startIndex}
>
  <div class="media-reveal-clip" data-media-reveal-clip>
    <div class="media-reveal-rise" data-media-reveal-rise>
      <div class="carousel-viewport" style={`aspect-ratio: ${aspectRatio};`} data-viewport-media-frame data-preserve-media-aspect data-media-aspect={aspectRatio}>
        <div class="carousel-stage">
          {slides.map((slide, index) => (
            <img
              src={slide}
              alt=""
              loading="lazy"
              data-carousel-slide
              data-media-visual
              data-behance-image
              role="button"
              tabindex={index === startIndex ? 0 : -1}
              aria-label={`View slide ${index + 1}`}
              aria-hidden={index === startIndex ? 'false' : 'true'}
              style={`opacity: ${index === startIndex ? 1 : 0}; --carousel-slide-fade-duration: ${slideFadeDuration}ms;`}
            />
          ))}
        </div>
      </div>
    </div>
  </div>
  <div class="carousel-pagination" aria-label="Carousel pagination">
    {slides.map((_, index) => (
      <button type="button" data-carousel-dot aria-label={`View slide ${index + 1}`} aria-current={index === startIndex ? 'step' : undefined}>
        <svg viewBox="0 0 50 3" aria-hidden="true" preserveAspectRatio="none">
          <path
            class="line-system-path carousel-line-path"
            d="M0 1.5H50"
            pathLength="1"
            data-line-id={`carousel-pagination.${index + 1}`}
            data-line-token="outline"
            data-line-direction="left-to-right"
          />
        </svg>
      </button>
    ))}
  </div>
  <div class="carousel-caption" data-media-caption><slot /></div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((carousel) => {
    const slides = Array.from(carousel.querySelectorAll<HTMLElement>('[data-carousel-slide]'));
    const dots = Array.from(carousel.querySelectorAll<HTMLButtonElement>('[data-carousel-dot]'));
    let index = Number(carousel.dataset.index ?? '0');
    let autoAdvance: number | undefined;
    let isVisible = false;
    let isInteracting = false;

    const render = () => {
      slides.forEach((slide, slideIndex) => {
        const selected = slideIndex === index;
        slide.style.opacity = selected ? '1' : '0';
        slide.setAttribute('aria-hidden', String(!selected));
        slide.tabIndex = selected ? 0 : -1;
      });
      dots.forEach((dot, dotIndex) => {
        if (dotIndex === index) dot.setAttribute('aria-current', 'step');
        else dot.removeAttribute('aria-current');
      });
      carousel.dataset.index = String(index);
      carousel.dispatchEvent(new CustomEvent('mediachange', {
        bubbles: true,
        detail: { geometryChanged: false },
      }));
    };

    const stopAutoAdvance = () => {
      if (autoAdvance) window.clearTimeout(autoAdvance);
      autoAdvance = undefined;
    };

    const startAutoAdvance = () => {
      stopAutoAdvance();
      if (
        slides.length < 2
        || !isVisible
        || isInteracting
        || document.hidden
        || document.body.classList.contains('behance-viewer-open')
        || window.matchMedia('(prefers-reduced-motion: reduce)').matches
      ) return;
      autoAdvance = window.setTimeout(() => {
        index = (index + 1) % slides.length;
        render();
        startAutoAdvance();
      }, 3000);
    };

    dots.forEach((dot, dotIndex) => dot.addEventListener('click', () => {
      index = dotIndex;
      render();
      startAutoAdvance();
    }));
    carousel.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
      event.preventDefault();
      index = event.key === 'ArrowLeft'
        ? (index - 1 + slides.length) % slides.length
        : (index + 1) % slides.length;
      render();
      dots[index]?.focus();
      startAutoAdvance();
    });
    carousel.addEventListener('pointerenter', () => {
      isInteracting = true;
      stopAutoAdvance();
    });
    carousel.addEventListener('pointerleave', () => {
      isInteracting = false;
      startAutoAdvance();
    });
    carousel.addEventListener('focusin', () => {
      isInteracting = true;
      stopAutoAdvance();
    });
    carousel.addEventListener('focusout', (event) => {
      if (event.relatedTarget instanceof Node && carousel.contains(event.relatedTarget)) return;
      isInteracting = false;
      startAutoAdvance();
    });
    const visibilityObserver = new IntersectionObserver(([entry]) => {
      isVisible = entry.intersectionRatio >= 0.15;
      startAutoAdvance();
    }, { threshold: 0.15 });
    visibilityObserver.observe(carousel);
    document.addEventListener('visibilitychange', startAutoAdvance);
    document.addEventListener('viewerchange', startAutoAdvance);
    render();
  });
</script>

<style>
  .figma-carousel { display: flex; flex-direction: column; gap: 0; width: 100%; margin-inline: auto; }
  .media-reveal-rise, .media-reveal-clip { width: 100%; }
  .carousel-viewport { position: relative; width: 100%; overflow: hidden; }
  .carousel-stage { position: absolute; inset: 0; width: 100%; }
  .carousel-stage > img { position: absolute; inset: 0 auto auto 0; display: block; width: 100%; max-width: 100%; height: auto; cursor: zoom-in; transition: opacity var(--carousel-slide-fade-duration) cubic-bezier(0, 0, 0.3, 1); }
  .carousel-stage > img[aria-hidden='true'] { pointer-events: none; }
  .carousel-pagination { position: relative; z-index: 2; display: flex; align-self: flex-start; gap: 5px; width: auto; height: 24px; margin: 8px 0 12px; align-items: center; }
  .carousel-pagination button { position: relative; flex: 0 0 50px; width: 50px; height: 24px; padding: 0; border: 0; background: transparent; cursor: pointer; }
  .carousel-pagination button svg { position: absolute; top: 50%; left: 0; width: 100%; height: 3px; overflow: visible; transform: translateY(-50%); }
  .carousel-pagination button .carousel-line-path { fill: none; stroke: var(--site-line); stroke-width: 3; transition: stroke 150ms cubic-bezier(0.4, 0.14, 0.3, 1), stroke-width 150ms cubic-bezier(0.4, 0.14, 0.3, 1); vector-effect: non-scaling-stroke; }
  .carousel-pagination button[aria-current='step'] .carousel-line-path { stroke: var(--ink); stroke-width: 5; }
  .carousel-caption { align-self: stretch; padding: var(--caption-pad-top, 8px) 0 var(--caption-pad-bottom, 0px); color: var(--ink); font: 400 var(--caption-size, 14px)/var(--caption-leading, 1.35) 'Basically A Mono', 'Fragment Mono', monospace; }
  .carousel-caption :global(p + p) { margin-top: 24px; }

  @media (max-width: 767px) {
    .figma-carousel { width: 100%; padding-inline: 0; }
    .carousel-pagination button { flex-basis: 30px; width: 30px; }
    .carousel-caption { padding-inline: 0; }
  }
</style>
