---
interface Props {
  slides: string[];
  startIndex?: number;
  aspectRatio: string;
  class?: string;
}

const {
  slides,
  startIndex = 0,
  aspectRatio,
  class: className = '',
} = Astro.props;
---

<div
  class:list={['figma-carousel', className]}
  data-carousel
  data-index={startIndex}
>
  <div class="carousel-viewport" style={`aspect-ratio: ${aspectRatio};`}>
    <div class="carousel-stage">
      {slides.map((slide, index) => (
        <img
          src={slide}
          alt=""
          loading="lazy"
          data-carousel-slide
          data-behance-image
          aria-hidden={index === startIndex ? 'false' : 'true'}
          style={`opacity: ${index === startIndex ? 1 : 0};`}
        />
      ))}
    </div>
  </div>
  <div class="carousel-pagination" aria-label="Carousel pagination">
    {slides.map((_, index) => <button type="button" data-carousel-dot aria-label={`View slide ${index + 1}`} aria-current={index === startIndex ? 'step' : undefined}></button>)}
  </div>
  <div class="carousel-caption"><slot /></div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((carousel) => {
    const slides = Array.from(carousel.querySelectorAll<HTMLElement>('[data-carousel-slide]'));
    const dots = Array.from(carousel.querySelectorAll<HTMLButtonElement>('[data-carousel-dot]'));
    let index = Number(carousel.dataset.index ?? '0');
    let autoAdvance: number | undefined;

    const render = () => {
      slides.forEach((slide, slideIndex) => {
        const selected = slideIndex === index;
        slide.style.opacity = selected ? '1' : '0';
        slide.setAttribute('aria-hidden', String(!selected));
      });
      dots.forEach((dot, dotIndex) => {
        if (dotIndex === index) dot.setAttribute('aria-current', 'step');
        else dot.removeAttribute('aria-current');
      });
    };

    const startAutoAdvance = () => {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      if (autoAdvance) window.clearInterval(autoAdvance);
      autoAdvance = window.setInterval(() => {
        index = (index + 1) % slides.length;
        render();
      }, 300);
    };

    dots.forEach((dot, dotIndex) => dot.addEventListener('click', () => {
      index = dotIndex;
      render();
      startAutoAdvance();
    }));
    carousel.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
      event.preventDefault();
      index = event.key === 'ArrowLeft'
        ? (index - 1 + slides.length) % slides.length
        : (index + 1) % slides.length;
      render();
      dots[index]?.focus();
    });
    render();
    startAutoAdvance();
  });
</script>

<style>
  .figma-carousel { display: flex; flex-direction: column; gap: 0; width: 100%; margin-inline: auto; }
  .carousel-viewport { position: relative; width: 100%; overflow: hidden; }
  .carousel-stage { position: absolute; inset: 0; width: 100%; }
  .carousel-stage > img { position: absolute; inset: 0 auto auto 0; display: block; width: 100%; max-width: 100%; height: auto; cursor: zoom-in; transition: opacity 50ms ease-in-out; }
  .carousel-stage > img[aria-hidden='true'] { pointer-events: none; }
  .carousel-pagination { position: relative; z-index: 2; display: flex; align-self: flex-start; gap: 5px; width: auto; height: 24px; margin: 8px 0 12px; align-items: center; }
  .carousel-pagination button { position: relative; flex: 0 0 50px; width: 50px; height: 24px; padding: 0; border: 0; background: transparent; cursor: pointer; }
  .carousel-pagination button::after { content: ''; position: absolute; top: 50%; left: 0; width: 100%; height: 3px; background: #c9cdd0; transform: translateY(-50%); transition: background .2s ease; }
  .carousel-pagination button[aria-current='step']::after { background: #1f2933; }
  .carousel-pagination button:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .carousel-caption { align-self: stretch; padding: var(--caption-pad-top, 8px) 0 var(--caption-pad-bottom, 24px); color: var(--ink); font: 400 var(--caption-size, 14px)/var(--caption-leading, 1.35) 'Basically A Mono', 'Fragment Mono', monospace; }
  .carousel-caption :global(p + p) { margin-top: 24px; }

  @media (max-width: 767px) {
    .figma-carousel { width: 100%; padding-inline: 0; }
    .carousel-pagination button { flex-basis: 30px; width: 30px; }
    .carousel-caption { padding-inline: 0; }
  }
</style>
