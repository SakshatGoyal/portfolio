---
import GalleryArtifact from './GalleryArtifact.astro';

interface Placement {
  column: number;
  span: number;
  row: number;
  rowSpan?: number;
}

interface Artifact {
  id: string;
  type: 'image' | 'video';
  src: string;
  poster?: string;
  width: number;
  height: number;
  role: 'lead' | 'support';
  caption: string;
  viewportFit?: boolean;
}

interface Project {
  title: string;
  year: string;
  paragraphs: string[];
  media: Artifact[];
  layout: {
    info: Placement;
    artifacts: Record<string, Placement>;
  };
}

interface Props {
  project: Project;
  infoFirst?: boolean;
  projectNumber?: number;
}

const { project, infoFirst = false, projectNumber } = Astro.props;
const [summary, ...notes] = project.paragraphs;
const [lead, ...supports] = project.media;
const infoPlacement = infoFirst ? { ...project.layout.info, row: 1 } : project.layout.info;
const leadPlacement = infoFirst
  ? { ...project.layout.artifacts[lead.id], row: 2 }
  : project.layout.artifacts[lead.id];
const formattedProjectNumber = projectNumber == null ? '' : String(projectNumber).padStart(2, '0');
const placementStyle = ({ column, span, row, rowSpan = 1 }: Placement) => [
  `--gallery-column: ${column}`,
  `--gallery-span: ${span}`,
  `--gallery-row: ${row}`,
  `--gallery-row-span: ${rowSpan}`,
  `--gallery-inset-start: ${column === 1 ? '0px' : 'var(--gallery-composition-inset)'}`,
  `--gallery-inset-end: ${column + span > 20 ? '0px' : 'var(--gallery-composition-inset)'}`,
].join('; ');
---

<article class:list={['gallery-project', { 'gallery-project--info-first': infoFirst }]} data-gallery-project>
  <div
    class="gallery-project-info"
    data-gallery-info
    data-gallery-column={infoPlacement.column}
    data-gallery-span={infoPlacement.span}
    data-gallery-row={infoPlacement.row}
    data-gallery-row-span={infoPlacement.rowSpan ?? 1}
    style={placementStyle(infoPlacement)}
  >
    <div class="gallery-project-heading">
      <h2>
        {project.title}
        {formattedProjectNumber && <span class="gallery-project-number"> — {formattedProjectNumber}</span>}
      </h2>
      <time>{project.year}</time>
    </div>
    <div class="gallery-project-copy">
      <p class="gallery-project-summary">{summary}</p>
      {notes.length > 0 && (
        <div class="gallery-project-notes" data-gallery-notes>
          {notes.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      )}
    </div>
  </div>

  <GalleryArtifact
    {...lead}
    label={project.title}
    placement={leadPlacement}
  />

  {supports.map((artifact) => (
    <GalleryArtifact
      {...artifact}
      label={project.title}
      placement={project.layout.artifacts[artifact.id]}
    />
  ))}
</article>
