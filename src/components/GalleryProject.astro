---
import GalleryArtifact from './GalleryArtifact.astro';

interface Placement {
  column: number;
  span: number;
  row: number;
  rowSpan?: number;
}

interface Seam {
  axis: 'horizontal' | 'vertical';
  at: number;
  from: number;
  to: number;
}

interface Artifact {
  id: string;
  type: 'image' | 'video';
  src: string;
  poster?: string;
  width: number;
  height: number;
}

interface Project {
  title: string;
  year: string;
  paragraphs: string[];
  media: Artifact[];
  layout: {
    info: Placement;
    artifacts: Record<string, Placement>;
    seams: Seam[];
  };
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const placementStyle = ({ column, span, row, rowSpan = 1 }: Placement) => [
  `--gallery-column: ${column}`,
  `--gallery-span: ${span}`,
  `--gallery-row: ${row}`,
  `--gallery-row-span: ${rowSpan}`,
  `--gallery-inset-start: ${column === 1 ? '0px' : '24px'}`,
  `--gallery-inset-end: ${column + span > 20 ? '0px' : '24px'}`,
].join('; ');
---

<article
  class="gallery-project"
  data-gallery-project
  data-gallery-seams={JSON.stringify(project.layout.seams)}
>
  <div
    class="gallery-project-info"
    data-gallery-info
    data-gallery-column={project.layout.info.column}
    data-gallery-span={project.layout.info.span}
    data-gallery-row={project.layout.info.row}
    data-gallery-row-span={project.layout.info.rowSpan ?? 1}
    style={placementStyle(project.layout.info)}
  >
    <div class="gallery-project-heading">
      <h2>{project.title}</h2>
      <span aria-hidden="true">・</span>
      <time>{project.year}</time>
    </div>
    {project.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
  </div>

  {project.media.map((artifact) => (
    <GalleryArtifact
      {...artifact}
      label={project.title}
      placement={project.layout.artifacts[artifact.id]}
    />
  ))}
</article>
