---
const path = Astro.url.pathname;
const isHome = path === '/';
---

<header class:list={['site-header', { 'home-site-header': isHome }]}>
  {isHome ? (
    <>
      <a class="home-mark" href="/" aria-label="Sākshāt Goyal home">
        <svg viewBox="0 0 48 48" aria-hidden="true">
          <path d="M22.5 10.5c-7.2 0-12 4.3-12 10.4 0 5.7 4.5 8 11.1 9.4 5.7 1.2 8 2.5 8 5.5 0 2.6-2.5 4.5-6.3 4.5-4.2 0-7.4-1.7-10.3-4.5" />
          <path d="M38.2 17.2c-2.8-4.2-7.1-6.7-12.4-6.7-8.2 0-14 6.2-14 14.6 0 8.3 5.8 14.4 14.1 14.4 4.1 0 7.7-1.4 10.2-3.8v-8.6H25.7" />
        </svg>
      </a>
      <nav class="home-nav" aria-label="Primary navigation">
        <a class="active" href="/">Home</a>
        <a href="/#about">About</a>
        <a href="/#work">Work</a>
      </nav>
      <details class="home-menu">
        <summary aria-label="Open navigation"><span></span><span></span></summary>
        <nav aria-label="Mobile navigation">
          <a href="/">Home</a>
          <a href="/#about">About</a>
          <a href="/#work">Work</a>
        </nav>
      </details>
    </>
  ) : (
    <>
      <a class="monogram" href="/" aria-label="Home"><span aria-hidden="true"></span></a>
      <nav aria-label="Primary navigation">
        <a href="/">Home</a>
        <a class:list={[{ active: path.startsWith('/work') }]} href="/#work">Work</a>
      </nav>
    </>
  )}
</header>
