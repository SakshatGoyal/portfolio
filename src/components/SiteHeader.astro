---
const path = Astro.url.pathname;
const isHome = path === '/';
const isWork = path.startsWith('/work/');

const links = [
  { label: 'Selected Work', href: '/#work', section: 'work', active: isWork },
  { label: 'Gallery', href: '/#gallery', section: 'gallery', active: false },
  { label: 'About', href: '/#about', section: 'about', active: isHome },
];
---

<header class="site-header" data-site-header>
  <div class="site-header-capsule" data-site-header-capsule>
    <div class="site-header-area">
      <div class="site-header-row">
        <div class="site-header-brand">
          <a class="site-header-name" href="/" aria-label="Sākshāt Goyal, Product Designer — Home">
            <span class="site-header-person">Sākshāt Goyal</span>
            <span class="site-header-role">Product Designer</span>
          </a>
        </div>
        <nav aria-label="Primary navigation">
          <ul class="site-header-nav-list">
            {links.map((link, index) => (
              <li>
                <a
                  class:list={['site-header-link', { active: link.active }]}
                  href={link.href}
                  data-home-section-link={isHome ? link.section : undefined}
                  aria-current={link.active ? (isWork ? 'page' : 'location') : undefined}
                >{link.label}</a>
                {index < links.length - 1 && <span class="site-header-separator" aria-hidden="true">・</span>}
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  (() => {
    window.__siteHeaderCleanup?.();

    const header = document.querySelector('[data-site-header]');
    if (!(header instanceof HTMLElement)) return;

    const controller = new AbortController();
    let frame = 0;
    let disposed = false;

    const syncHeader = () => {
      frame = 0;
      if (disposed) return;
      header.classList.toggle('site-header-minimized', window.scrollY > window.innerHeight * 0.5);
    };
    const queueHeaderSync = () => {
      if (frame || disposed) return;
      frame = requestAnimationFrame(syncHeader);
    };
    const dispose = () => {
      if (disposed) return;
      disposed = true;
      controller.abort();
      if (frame) cancelAnimationFrame(frame);
      if (window.__siteHeaderCleanup === dispose) delete window.__siteHeaderCleanup;
    };

    window.__siteHeaderCleanup = dispose;
    window.addEventListener('scroll', queueHeaderSync, { passive: true, signal: controller.signal });
    window.addEventListener('resize', queueHeaderSync, { passive: true, signal: controller.signal });
    syncHeader();
  })();
</script>
