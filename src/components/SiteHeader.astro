---
const path = Astro.url.pathname;
const isHome = path === '/';

const links = [
  { label: 'Selected Work', href: '/#work', section: 'work', active: false },
  { label: 'Gallery', href: '/#gallery', section: 'gallery', active: false },
  { label: 'About', href: '/#about', section: 'about', active: isHome },
];
---

<header class="site-header" data-site-header>
  <nav aria-label="Primary navigation">
    <ul class="site-header-nav-list">
      {links.map((link) => (
        <li>
          <a
            class:list={['site-header-link', 'header-tape-label', { active: link.active }]}
            href={link.href}
            data-tape-label
            data-home-section-link={isHome ? link.section : undefined}
            aria-current={link.active ? 'location' : undefined}
          >{link.label}</a>
        </li>
      ))}
    </ul>
  </nav>
</header>
