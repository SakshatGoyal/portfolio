---
interface Props {
  theme?: string;
}

const { theme = 'neutral' } = Astro.props;
const path = Astro.url.pathname;
const isHome = path === '/';
const isCaseSystem = !isHome && theme !== 'neutral';
---

<header class:list={['site-header', { 'home-site-header': isHome, 'system-case-header': isCaseSystem }]}>
  {isHome ? (
    <>
      <a class="home-name" href="/">Sākshāt Goyal</a>
      <nav class="home-nav" aria-label="Primary navigation">
        <a class="active" href="/#work">Selected Work</a>
        <a href="/#work">Gallery</a>
        <a href="/#about">About</a>
      </nav>
    </>
  ) : isCaseSystem ? (
    <>
      <a class="system-case-name" href="/">Sākshāt Goyal</a>
      <nav class="system-case-nav" aria-label="Primary navigation">
        <a class="active" href="/#work">Selected Work</a>
        <a href="/#work">Gallery</a>
        <a href="/#about">About</a>
      </nav>
    </>
  ) : (
    <>
      <a class="monogram" href="/" aria-label="Home"><span aria-hidden="true"></span></a>
      <nav aria-label="Primary navigation">
        <a href="/">Home</a>
        <a class:list={[{ active: path.startsWith('/work') }]} href="/#work">Work</a>
      </nav>
    </>
  )}
</header>
