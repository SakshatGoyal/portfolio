---
import { videoVariantsFor } from '../data/video-variants.js';
import MediaPlaybackControl from './MediaPlaybackControl.astro';

interface Props {
  src: string;
  poster?: string;
  width?: number;
  height?: number;
  label: string;
  loop?: boolean;
  autoplayOnView?: boolean;
  home?: boolean;
  gallery?: boolean;
  standalone?: boolean;
  showPlaybackControl?: boolean;
}

const {
  src, poster, width, height, label, loop = true, autoplayOnView = true,
  home = false, gallery = false, standalone = false, showPlaybackControl = true,
} = Astro.props;
const variants = videoVariantsFor(src);
const mobileQuery = '(max-width: 1023px), (hover: none), (pointer: coarse)';
const desktopQuery = '(min-width: 1024px) and (hover: hover) and (pointer: fine)';
---

<video
  data-src={!variants ? src : undefined}
  poster={poster}
  width={width}
  height={height}
  muted
  loop={loop}
  playsinline
  preload="none"
  style={poster ? `--video-poster-image: url('${poster}')` : undefined}
  data-autoplay-on-view={autoplayOnView && !home ? '' : undefined}
  data-home-autoplay-on-view={autoplayOnView && home ? '' : undefined}
  data-gallery-video={gallery ? '' : undefined}
  data-standalone-media={standalone ? '' : undefined}
  data-media-visual
  aria-label={label}
>
  {variants && (
    <>
      <source data-src={variants.mobile.mp4} type="video/mp4" media={mobileQuery} />
      <source data-src={variants.mobile.webm} type="video/webm" media={mobileQuery} />
      <source data-src={variants.desktop.mp4} type="video/mp4" media={desktopQuery} />
      <source data-src={variants.desktop.webm} type="video/webm" media={desktopQuery} />
      <source data-src={variants.desktop.mp4} type="video/mp4" />
      <source data-src={variants.desktop.webm} type="video/webm" />
    </>
  )}
</video>
{showPlaybackControl && (
  <MediaPlaybackControl label={label} />
)}
