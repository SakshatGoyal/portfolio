---
interface Props {
  title: string;
  level?: 'h1' | 'h2';
  caseStudy?: boolean;
}

const { title, level = 'h1', caseStudy = false } = Astro.props;
const Heading = level;
---

<header class:list={['page-heading', { 'case-hero': caseStudy }]}>
  <Heading data-line-mask aria-label={title} style="visibility: hidden;">{title}</Heading>
</header>
