---
interface Props {
  src: string;
  alt?: string;
  caption?: string;
  captionLines?: string[];
  class?: string;
  contain?: boolean;
  eager?: boolean;
  video?: boolean;
  controls?: boolean;
  autoplayOnView?: boolean;
  loop?: boolean;
  poster?: string;
  width?: number;
  height?: number;
}

const {
  src, alt, caption, captionLines, class: className, contain = false, eager = false,
  video = false, controls = false, autoplayOnView = video, loop = video, poster, width, height,
} = Astro.props;
const sourceAlt = alt ?? caption ?? captionLines?.join(' ') ?? '';
---

<figure class:list={['case-figure', className, { contain }]}>
  {video ? (
    <div class="media-frame video-frame">
      <video
        src={src}
        poster={poster}
        width={width}
        height={height}
        controls={controls}
        muted
        loop={loop}
        playsinline
        preload="metadata"
        style={poster ? `--video-poster-image: url('${poster}')` : undefined}
        data-autoplay-on-view={autoplayOnView ? '' : undefined}
        aria-label={sourceAlt || 'Case study video'}
      />
    </div>
  ) : (
    <button class="media-frame" type="button" data-behance-image>
      <img src={src} alt={sourceAlt} width={width} height={height} loading={eager ? 'eager' : 'lazy'} decoding="async" />
    </button>
  )}
  {(caption || captionLines) && <figcaption>{captionLines ? captionLines.map((line, index) => <Fragment>{line}{index < captionLines.length - 1 && <br />}</Fragment>) : caption}</figcaption>}
</figure>
