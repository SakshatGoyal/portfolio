---
interface Props {
  src: string;
  alt?: string;
  caption?: string;
  captionLines?: string[];
  class?: string;
  contain?: boolean;
  eager?: boolean;
  video?: boolean;
  controls?: boolean;
}

const { src, alt, caption, captionLines, class: className, contain = false, eager = false, video = false, controls = false } = Astro.props;
const sourceAlt = alt ?? caption ?? captionLines?.join(' ') ?? '';
---

<figure class:list={['case-figure', className, { contain }]}> 
  {video ? (
    <div class="media-frame">
      <video src={src} controls={controls} autoplay muted loop playsinline preload="metadata" aria-label={sourceAlt || 'Case study video'} />
    </div>
  ) : (
    <button class="media-frame" type="button" data-lightbox-image>
      <img src={src} alt={sourceAlt} loading={eager ? 'eager' : 'lazy'} decoding="async" />
    </button>
  )}
  {(caption || captionLines) && <figcaption>{captionLines ? captionLines.map((line, index) => <Fragment>{line}{index < captionLines.length - 1 && <br />}</Fragment>) : caption}</figcaption>}
</figure>
