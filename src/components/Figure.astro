---
interface Props {
  src: string;
  alt?: string;
  caption?: string;
  captionLines?: string[];
  class?: string;
  contain?: boolean;
  eager?: boolean;
  video?: boolean;
  controls?: boolean;
  poster?: string;
  width?: number;
  height?: number;
}

const {
  src, alt, caption, captionLines, class: className, contain = false, eager = false,
  video = false, controls = false, poster, width, height,
} = Astro.props;
const sourceAlt = alt ?? caption ?? captionLines?.join(' ') ?? '';
const hasDesignedPlayback = video && Boolean(poster);
---

<figure class:list={['case-figure', className, { contain }]}> 
  {video ? (
    <div class="media-frame video-frame">
      <video src={src} poster={poster} width={width} height={height} controls={controls} autoplay={!hasDesignedPlayback} muted loop={!hasDesignedPlayback} playsinline preload={hasDesignedPlayback ? 'none' : 'metadata'} aria-label={sourceAlt || 'Case study video'} />
    </div>
  ) : (
    <button class="media-frame" type="button" data-lightbox-image>
      <img src={src} alt={sourceAlt} width={width} height={height} loading={eager ? 'eager' : 'lazy'} decoding="async" />
    </button>
  )}
  {(caption || captionLines) && <figcaption>{captionLines ? captionLines.map((line, index) => <Fragment>{line}{index < captionLines.length - 1 && <br />}</Fragment>) : caption}</figcaption>}
</figure>
