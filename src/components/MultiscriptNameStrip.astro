---
const names = [
  { language: 'hi', className: 'devanagari', value: 'साक्षात् गोयल' },
  { language: 'gu', className: 'gujarati', value: 'સાક્ષાત્ ગોયલ' },
  { language: 'ta', className: 'tamil', value: 'ஸாக்ஷாத் கோயல்' },
  { language: 'en', className: 'latin', value: 'Sākshāt Goyal' },
];

const rowOffsets = [0, 69, 138, 275];
const repetitions = Array.from({ length: 15 });
---

<div class="multiscript-name-strip" aria-hidden="true">
  <div class="multiscript-name-strip__rows">
    {rowOffsets.map((offset) => (
      <div class="multiscript-name-strip__row" style={`--multiscript-row-offset: ${offset}px`}>
        {repetitions.map(() => (
          <span class="multiscript-name-strip__group">
            {names.map((name) => (
              <span
                class:list={['multiscript-name-strip__name', `multiscript-name-strip__name--${name.className}`]}
                lang={name.language}
              >
                {name.value}
              </span>
            ))}
          </span>
        ))}
      </div>
    ))}
  </div>
</div>
