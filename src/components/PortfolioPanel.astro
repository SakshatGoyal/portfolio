---
import { PANEL_LEAD_LINES, PANEL_PROJECTS, PANEL_SUPPORT } from '../data/panel-navigation.js';
import { CONTACT_EMAIL, LINKEDIN_URL, RESUME_URL } from '../data/contact-links.js';

const pathname = Astro.url.pathname;
const isHome = pathname === '/';
const isProject = (href: string) => pathname === href || pathname === href.slice(0, -1);
---

<aside class="portfolio-panel" aria-label="Portfolio introduction and navigation">
  <a class="portfolio-panel-home" href="/" aria-label="Go to homepage">
    {isHome ? (
      <h1 class="portfolio-panel-identity">
        <span>Sākshāt Goyal</span>
        <span>Product Designer</span>
      </h1>
    ) : (
      <span class="portfolio-panel-identity">
        <span>Sākshāt Goyal</span>
        <span>Product Designer</span>
      </span>
    )}
  </a>

  <div class="portfolio-panel-socials" aria-label="Contact links" data-contact-links>
    <button
      class="portfolio-panel-contact"
      type="button"
      aria-label={`Copy ${CONTACT_EMAIL} to clipboard`}
      data-copy-email={CONTACT_EMAIL}
      data-tape-label
      data-tape-frame="true"
      data-tape-color="var(--panel-tape-color)"
      data-tape-duration="126"
    >Email</button>
    <a
      class="portfolio-panel-contact"
      href={LINKEDIN_URL}
      target="_blank"
      rel="noreferrer"
      data-tape-label
      data-tape-frame="true"
      data-tape-color="var(--panel-tape-color)"
      data-tape-duration="126"
    >LinkedIn</a>
    <a
      class="portfolio-panel-contact"
      href={RESUME_URL}
      target="_blank"
      rel="noreferrer"
      data-tape-label
      data-tape-frame="true"
      data-tape-color="var(--panel-tape-color)"
      data-tape-duration="126"
    >Resume</a>
    <span class="contact-copy-tooltip" role="status" data-copy-tooltip hidden>copied to clipboard</span>
  </div>

  <div class="portfolio-panel-intro">
    <p class="portfolio-panel-lead">
      <span class="sr-only">{PANEL_LEAD_LINES.join(' ')}</span>
      <span class="portfolio-panel-highlight" aria-hidden="true" data-panel-highlight>
        {PANEL_LEAD_LINES.map((line, index) => (
          <span class="portfolio-panel-highlight-line" style={`--panel-highlight-index: ${index}`}>{line}{index < PANEL_LEAD_LINES.length - 1 ? ' ' : ''}</span>
        ))}
      </span>
    </p>
    <p class="portfolio-panel-support">{PANEL_SUPPORT}</p>
  </div>

  <nav class="portfolio-panel-navigation" aria-label="Portfolio">
    <ul class="portfolio-navigation-levels">
      <li><a class:list={['portfolio-panel-link', { 'is-selected': pathname.startsWith('/about') }]} href="/about/" aria-current={pathname.startsWith('/about') ? 'page' : undefined} data-tape-label data-tape-frame="true" data-tape-color="var(--panel-tape-color)" data-tape-duration="126">About</a></li>
      <li>
        <a class:list={['portfolio-panel-link', { 'is-selected': isHome }]} href="/" aria-current={isHome ? 'page' : undefined} data-tape-label data-tape-frame="true" data-tape-color="var(--panel-tape-color)" data-tape-duration="126">Work</a>
        <ul class="portfolio-panel-projects">
      {PANEL_PROJECTS.map((project) => (
        <li><a
          class:list={['portfolio-panel-link', { 'is-selected': isProject(project.href) }]}
          href={project.href}
          aria-current={isProject(project.href) ? 'page' : undefined}
          data-tape-label
          data-tape-frame="true"
          data-tape-color="var(--panel-tape-color)"
          data-tape-duration="126"
        >{project.panelLabel}</a></li>
      ))}
        </ul>
      </li>
    </ul>
  </nav>
</aside>

<script is:inline>
  if (document.documentElement.dataset.homeSystem === 'true') {
    const revealPanelHighlights = () => {
      document.querySelector('[data-panel-highlight]')?.setAttribute('data-highlight-ready', 'true');
    };
    (document.fonts?.ready || Promise.resolve()).then(() => requestAnimationFrame(revealPanelHighlights));
  }
</script>
