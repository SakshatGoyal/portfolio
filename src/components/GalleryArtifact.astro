---
import ResponsiveVideo from './ResponsiveVideo.astro';

interface Props {
  id: string;
  type: 'image' | 'video';
  src: string;
  poster?: string;
  width: number;
  height: number;
  label: string;
  placement: {
    column: number;
    span: number;
    row: number;
    rowSpan?: number;
  };
}

const { id, type, src, poster, width, height, label, placement } = Astro.props;
const { column, span, row, rowSpan = 1 } = placement;
const insetStart = column === 1 ? '0px' : 'var(--gallery-composition-inset)';
const insetEnd = column + span > 20 ? '0px' : 'var(--gallery-composition-inset)';
---

<div
  class="gallery-artifact"
  data-gallery-artifact={id}
  data-gallery-column={column}
  data-gallery-span={span}
  data-gallery-row={row}
  data-gallery-row-span={rowSpan}
  data-media-unit
  data-media-reveal
  style={`--gallery-column: ${column}; --gallery-span: ${span}; --gallery-row: ${row}; --gallery-row-span: ${rowSpan}; --gallery-inset-start: ${insetStart}; --gallery-inset-end: ${insetEnd};`}
>
  <div class="media-reveal-clip" data-media-reveal-clip>
    <div class="media-reveal-rise" data-media-reveal-rise>
      {type === 'video' ? (
        <div
          class="gallery-artifact-surface playable-media-surface"
          data-playable-media
          data-asset-surface
        >
          <ResponsiveVideo
            src={src}
            poster={poster}
            width={width}
            height={height}
            label={label}
            gallery
          />
          <button class="media-viewer-trigger" type="button" data-behance-video data-behance-title={label} aria-label={`View ${label} video`}></button>
        </div>
      ) : (
        <button
          class="gallery-artifact-surface"
          type="button"
          data-asset-surface
          data-behance-image
          data-behance-title={label}
          aria-label={`View ${label}`}
        >
          <img
            src={src}
            alt={label}
            width={width}
            height={height}
            loading="lazy"
            decoding="async"
            data-media-visual
          />
        </button>
      )}
    </div>
  </div>
</div>
