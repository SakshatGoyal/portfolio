---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  theme?: string;
}

const { title, description, theme = 'neutral' } = Astro.props;
const isCaseSystem = theme !== 'neutral';
const isHomeSystem = Astro.url.pathname === '/';
---

<!doctype html>
<html lang="en" data-theme={theme} data-case-system={isCaseSystem ? 'true' : undefined} data-home-system={isHomeSystem ? 'true' : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fcfcfa" />
    <title>{title}</title>
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <noscript><style>[data-line-mask], [data-media-caption] { visibility: visible !important; }</style></noscript>
  </head>
  <body id="top">
    <div class="page-shell">
      <SiteHeader theme={theme} />
      <main>
        <slot />
      </main>
      <SiteFooter />
    </div>
    <div class="custom-site-cursor" data-custom-cursor aria-hidden="true">
      <svg class="cursor-pause" viewBox="0 0 100 100"><rect x="20" width="20" height="100" rx="6"></rect><rect x="60" width="20" height="100" rx="6"></rect></svg>
      <svg class="cursor-play" viewBox="0 0 100 100"><path d="M17 90.4251V9.57428C17 2.11666 25.1593-2.46895 31.5295 1.4088L95.6527 40.44C101.66 44.0969 101.795 52.7704 95.9041 56.6123L31.7809 98.4319C25.4226 102.579 17 98.0161 17 90.4251Z"></path></svg>
    </div>
    <div class="behance-viewer" data-behance-viewer hidden role="dialog" aria-modal="true" aria-labelledby="behance-viewer-title">
      <div class="behance-viewer__topbar">
        <h2 id="behance-viewer-title" data-behance-viewer-title></h2>
        <button class="behance-viewer__close" type="button" data-behance-viewer-close aria-label="Close image viewer">
          <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M1 1L11 11M11 1L1 11" /></svg>
        </button>
      </div>
      <button class="behance-viewer__previous" type="button" data-behance-viewer-previous aria-label="Previous image">
        <svg viewBox="0 0 12 20" aria-hidden="true"><path d="M10 2L2 10L10 18" /></svg>
      </button>
      <div class="behance-viewer__stage" data-behance-viewer-stage>
        <img data-behance-viewer-image alt="" tabindex="0" />
      </div>
      <button class="behance-viewer__next" type="button" data-behance-viewer-next aria-label="Next image">
        <svg viewBox="0 0 12 20" aria-hidden="true"><path d="M2 2L10 10L2 18" /></svg>
      </button>
    </div>
    <script is:inline>
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const lineMaskHeadings = [...document.querySelectorAll('[data-line-mask]')];
      lineMaskHeadings.forEach((heading) => {
        heading.dataset.lineMaskText = heading.textContent?.trim() || '';
      });

      const renderLineMaskHeading = (heading, animate = true) => {
        const text = heading.dataset.lineMaskText || '';
        const words = text.split(/\s+/).filter(Boolean);
        if (!words.length) {
          heading.classList.add('line-mask-ready');
          heading.style.removeProperty('visibility');
          return;
        }

        heading.classList.remove('line-mask-ready', 'line-mask-active', 'line-mask-played');
        const probe = document.createElement('span');
        probe.className = 'line-mask-probe';
        words.forEach((word, index) => {
          if (index) probe.append(document.createTextNode(' '));
          const wordElement = document.createElement('span');
          wordElement.className = 'line-mask-word';
          wordElement.textContent = word;
          probe.append(wordElement);
        });
        heading.replaceChildren(probe);

        const lines = [];
        probe.querySelectorAll('.line-mask-word').forEach((wordElement) => {
          const top = Math.round(wordElement.getBoundingClientRect().top * 10) / 10;
          const currentLine = lines.at(-1);
          if (!currentLine || Math.abs(currentLine.top - top) > 1) {
            lines.push({ top, words: [wordElement.textContent] });
          } else {
            currentLine.words.push(wordElement.textContent);
          }
        });

        const fragment = document.createDocumentFragment();
        lines.forEach((line, index) => {
          const lineMask = document.createElement('span');
          lineMask.className = 'line-mask-line';
          lineMask.setAttribute('aria-hidden', 'true');
          const lineInner = document.createElement('span');
          lineInner.className = 'line-mask-line-inner';
          lineInner.style.setProperty('--line-mask-delay', `${index * 80}ms`);
          lineInner.textContent = line.words.join(' ');
          lineMask.append(lineInner);
          fragment.append(lineMask);
        });
        heading.replaceChildren(fragment);
        heading.classList.add('line-mask-ready');
        heading.style.removeProperty('visibility');

        if (!animate) {
          heading.classList.add('line-mask-active', 'line-mask-played');
          return;
        }

        const playHeading = () => {
          window.setTimeout(() => {
            requestAnimationFrame(() => {
              requestAnimationFrame(() => {
                heading.classList.add('line-mask-active');
                window.setTimeout(
                  () => heading.classList.add('line-mask-played'),
                  600 + (lines.length - 1) * 80,
                );
              });
            });
          }, 120);
        };

        const headingObserver = new IntersectionObserver((entries) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          headingObserver.disconnect();
          playHeading();
        }, { threshold: 0.2 });
        headingObserver.observe(heading);
      };

      if (reduceMotion) {
        lineMaskHeadings.forEach((heading) => {
          heading.classList.add('line-mask-ready');
          heading.style.removeProperty('visibility');
        });
      } else {
        document.fonts.ready.then(() => {
          lineMaskHeadings.forEach((heading) => renderLineMaskHeading(heading));
        });

        let lineMaskResizeTimer;
        window.addEventListener('resize', () => {
          window.clearTimeout(lineMaskResizeTimer);
          lineMaskResizeTimer = window.setTimeout(() => {
            if (!lineMaskHeadings.every((heading) => heading.classList.contains('line-mask-played'))) return;
            lineMaskHeadings.forEach((heading) => renderLineMaskHeading(heading, false));
          }, 120);
        }, { passive: true });
      }

      if (!reduceMotion) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        }, { rootMargin: '0px 0px -7% 0px', threshold: 0.08 });
        document.querySelectorAll('[data-reveal]').forEach((element) => observer.observe(element));
      } else {
        document.querySelectorAll('[data-reveal]').forEach((element) => element.classList.add('is-visible'));
      }

      const playableSurfaces = [...document.querySelectorAll('[data-playable-media]')];
      const inViewVideos = playableSurfaces
        .map((surface) => surface.querySelector('video[data-autoplay-on-view]'))
        .filter((video) => video instanceof HTMLVideoElement);
      const videoVisibility = new Map(inViewVideos.map((video) => [video, 0]));
      const independentHomepagePlayback = document.documentElement.dataset.homeSystem === 'true';
      let manuallyActiveVideo = null;

      const surfaceForVideo = (video) => video.closest('[data-playable-media]');
      const isIndependentVideo = (video) => independentHomepagePlayback
        || surfaceForVideo(video)?.dataset.playbackMode === 'independent';
      const mediaLabel = (video) => video.getAttribute('aria-label') || 'animation';
      const syncPlayableState = (video) => {
        const surface = surfaceForVideo(video);
        if (!surface) return;
        const paused = video.paused;
        surface.dataset.playbackState = paused ? 'paused' : 'playing';
        surface.setAttribute('aria-label', `${paused ? 'Play' : 'Pause'} ${mediaLabel(video)}`);
      };

      const updateVideoPlayback = (video, shouldPlay) => {
        if (!(video instanceof HTMLVideoElement)) return;
        const manuallyPaused = video.dataset.manualPlayback === 'paused';
        if (!shouldPlay || manuallyPaused || document.hidden) {
          video.pause();
          return;
        }

        video.play().catch(() => {
          // The poster remains visible if playback is blocked or decoding is delayed.
        });
      };

      const selectActiveVideo = () => {
        const independentVideos = inViewVideos.filter(isIndependentVideo);
        const exclusiveVideos = inViewVideos.filter((video) => !isIndependentVideo(video));

        independentVideos.forEach((video) => {
            const inRange = (videoVisibility.get(video) ?? 0) >= 0.35;
            video.toggleAttribute('data-in-playback-range', inRange);
            video.toggleAttribute('data-active-playback', inRange);
            updateVideoPlayback(video, inRange);
        });

        const viewportCenter = window.innerHeight / 2;
        const eligibleVideos = exclusiveVideos.filter((video) => (
          (videoVisibility.get(video) ?? 0) >= 0.35
          && video.dataset.manualPlayback !== 'paused'
        ));
        const manualIsEligible = manuallyActiveVideo
          && eligibleVideos.includes(manuallyActiveVideo);
        const activeVideo = manualIsEligible ? manuallyActiveVideo : eligibleVideos.reduce((closest, video) => {
          if (!closest) return video;
          const videoRect = video.getBoundingClientRect();
          const closestRect = closest.getBoundingClientRect();
          const videoDistance = Math.abs(videoRect.top + videoRect.height / 2 - viewportCenter);
          const closestDistance = Math.abs(closestRect.top + closestRect.height / 2 - viewportCenter);
          return videoDistance < closestDistance ? video : closest;
        }, null);

        exclusiveVideos.forEach((video) => {
          const inRange = (videoVisibility.get(video) ?? 0) >= 0.35;
          const isActive = video === activeVideo;
          video.toggleAttribute('data-in-playback-range', inRange);
          video.toggleAttribute('data-active-playback', isActive);
          updateVideoPlayback(video, isActive);
        });
      };

      const playbackObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          const video = entry.target;
          if (!(video instanceof HTMLVideoElement)) return;
          videoVisibility.set(video, entry.intersectionRatio);
        });
        selectActiveVideo();
      }, { threshold: [0, 0.15, 0.35, 0.5, 0.75, 1] });
      inViewVideos.forEach((video) => {
        playbackObserver.observe(video);
        video.addEventListener('loadedmetadata', selectActiveVideo);
        video.addEventListener('canplay', selectActiveVideo);
        video.addEventListener('play', () => syncPlayableState(video));
        video.addEventListener('pause', () => syncPlayableState(video));
        video.addEventListener('ended', () => syncPlayableState(video));
        syncPlayableState(video);
      });

      playableSurfaces.forEach((surface) => {
        const video = surface.querySelector('video');
        if (!(video instanceof HTMLVideoElement)) return;
        surface.addEventListener('click', () => {
          if (video.paused) {
            video.dataset.manualPlayback = 'playing';
            if (!isIndependentVideo(video)) {
              manuallyActiveVideo = video;
              inViewVideos.filter((candidate) => candidate !== video && !isIndependentVideo(candidate))
                .forEach((candidate) => candidate.pause());
            }
            video.play().catch(() => {});
          } else {
            video.dataset.manualPlayback = 'paused';
            if (manuallyActiveVideo === video) manuallyActiveVideo = null;
            video.pause();
          }
          syncPlayableState(video);
          selectActiveVideo();
        });
      });

      document.addEventListener('visibilitychange', () => {
        selectActiveVideo();
      });

      const customCursor = document.querySelector('[data-custom-cursor]');
      const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
      let cursorSurface = null;
      const syncCursorMediaState = () => {
        const video = cursorSurface?.querySelector('video');
        customCursor?.classList.toggle('is-media', Boolean(video));
        customCursor?.classList.toggle('is-paused', Boolean(video?.paused));
      };
      if (customCursor && finePointer.matches) {
        document.documentElement.classList.add('custom-cursor-active');
        document.addEventListener('pointermove', (event) => {
          if (event.pointerType && event.pointerType !== 'mouse') return;
          customCursor.style.left = `${event.clientX}px`;
          customCursor.style.top = `${event.clientY}px`;
          customCursor.classList.add('is-visible');
          cursorSurface = event.target.closest?.('[data-playable-media]') || null;
          syncCursorMediaState();
        }, { passive: true });
        document.documentElement.addEventListener('pointerleave', () => customCursor.classList.remove('is-visible'));
        window.addEventListener('blur', () => customCursor.classList.remove('is-visible'));
        inViewVideos.forEach((video) => {
          video.addEventListener('play', syncCursorMediaState);
          video.addEventListener('pause', syncCursorMediaState);
        });
      }

      const alignBranchedConnectors = () => {
        document.querySelectorAll('.problem-layout, .branched-layout').forEach((layout) => {
          const lead = layout.querySelector(':scope > [data-branch-lead]');
          const svg = layout.querySelector(':scope > .problem-connector');
          const path = svg?.querySelector('path');
          const markers = [...layout.querySelectorAll(':scope > .problem-list .problem-marker')];

          if (!lead || !svg || !path || markers.length === 0) return;

          const svgRect = svg.getBoundingClientRect();
          const leadRect = lead.getBoundingClientRect();
          const markerRects = markers.map((marker) => marker.getBoundingClientRect());
          const spineX = Math.round(leadRect.left - svgRect.left + 10) + 0.5;
          const startY = leadRect.bottom - svgRect.top + 6;
          const markerCenters = markerRects.map((rect) => rect.top - svgRect.top + rect.height / 2);
          const markerEdges = markerRects.map((rect) => rect.left - svgRect.left);
          const endY = markerCenters.at(-1);
          const branches = markerCenters.map((centerY, index) => `M ${spineX} ${centerY} H ${markerEdges[index]}`).join(' ');

          svg.setAttribute('viewBox', `0 0 ${svgRect.width} ${svgRect.height}`);
          path.setAttribute('d', `M ${spineX} ${startY} V ${endY} ${branches}`);
        });
      };

      const branchedConnectorObserver = new ResizeObserver(alignBranchedConnectors);
      document.querySelectorAll('.problem-layout, .branched-layout').forEach((layout) => branchedConnectorObserver.observe(layout));
      document.fonts.ready.then(alignBranchedConnectors);
      window.addEventListener('resize', alignBranchedConnectors, { passive: true });
    </script>
    <script is:inline>
      const viewportMediaInset = 64;
      const mediaFrames = [...document.querySelectorAll('[data-viewport-media-frame]')];
      const standaloneMedia = [...document.querySelectorAll('[data-standalone-media]')];
      const synchronizedMediaGroups = [...document.querySelectorAll('[data-synchronized-media-group]')];

      const elementContentWidth = (element) => {
        const styles = getComputedStyle(element);
        return Math.max(0, element.clientWidth
          - parseFloat(styles.paddingLeft || '0')
          - parseFloat(styles.paddingRight || '0'));
      };

      const parseAspectRatio = (value) => {
        if (!value) return 0;
        const [width, height] = value.split('/').map((part) => Number(part.trim()));
        return width > 0 && height > 0 ? width / height : 0;
      };

      const intrinsicRatio = (media, frame) => {
        const declaredRatio = parseAspectRatio(frame?.dataset.mediaAspect);
        if (declaredRatio) return declaredRatio;
        if (media instanceof HTMLImageElement) {
          const width = media.naturalWidth || Number(media.getAttribute('width'));
          const height = media.naturalHeight || Number(media.getAttribute('height'));
          return width > 0 && height > 0 ? width / height : 0;
        }
        if (media instanceof HTMLVideoElement) {
          const width = media.videoWidth || Number(media.getAttribute('width'));
          const height = media.videoHeight || Number(media.getAttribute('height'));
          return width > 0 && height > 0 ? width / height : 0;
        }
        return 0;
      };

      const selectedVisual = (frame) => [...frame.querySelectorAll('[data-media-visual]')]
        .find((media) => media.getAttribute('aria-hidden') !== 'true')
        || frame.querySelector('[data-media-visual]');

      const alignCaption = (media) => {
        const unit = media.closest('[data-media-unit]');
        const caption = unit?.querySelector('[data-media-caption]');
        if (!unit || !caption) return;

        const unitStyles = getComputedStyle(unit);
        const unitRect = unit.getBoundingClientRect();
        const frame = media.closest('[data-viewport-media-frame]');
        const captionAnchor = unit.dataset.captionAlignment === 'frame' && frame ? frame : media;
        const mediaRect = captionAnchor.getBoundingClientRect();
        const contentLeft = unitRect.left
          + parseFloat(unitStyles.borderLeftWidth || '0')
          + parseFloat(unitStyles.paddingLeft || '0');

        caption.style.width = `${mediaRect.width}px`;
        caption.style.maxWidth = 'none';
        caption.style.marginLeft = `${Math.max(0, mediaRect.left - contentLeft)}px`;
        unit.toggleAttribute('data-media-ready', mediaRect.width > 0);
        if (mediaRect.width > 0) {
          caption.dispatchEvent(new CustomEvent('captionlayout', { bubbles: true }));
        }
      };

      const settleFrame = (frame, media, ratio, availableWidth, attempt = 0) => {
        requestAnimationFrame(() => {
          const frameStyles = getComputedStyle(frame);
          const paddingX = parseFloat(frameStyles.paddingLeft || '0') + parseFloat(frameStyles.paddingRight || '0');
          const paddingY = parseFloat(frameStyles.paddingTop || '0') + parseFloat(frameStyles.paddingBottom || '0');
          const maxOuterHeight = Math.max(1, window.innerHeight - viewportMediaInset);
          const maxInnerHeight = Math.max(1, maxOuterHeight - paddingY);
          const targetWidth = frame.hasAttribute('data-fluid-media-frame')
            ? availableWidth
            : Math.min(availableWidth, (maxInnerHeight * ratio) + paddingX);
          const currentWidth = frame.getBoundingClientRect().width;
          const isSquareMedia = frame.hasAttribute('data-square-media-frame');
          const squareMediaSize = Math.min(Math.max(1, targetWidth - paddingX), maxInnerHeight);

          frame.style.width = `${targetWidth}px`;
          frame.style.maxHeight = `${maxOuterHeight}px`;
          media.style.width = isSquareMedia ? `${squareMediaSize}px` : '100%';
          media.style.height = isSquareMedia ? `${squareMediaSize}px` : 'auto';
          media.style.maxHeight = `${maxInnerHeight}px`;
          if (isSquareMedia) media.style.aspectRatio = '1 / 1';

          if (attempt < 3 && Math.abs(currentWidth - targetWidth) > 0.5) {
            settleFrame(frame, media, ratio, availableWidth, attempt + 1);
            return;
          }
          alignCaption(media);
        });
      };

      const syncFrame = (frame) => {
        const media = selectedVisual(frame);
        const parent = frame.parentElement;
        if (!media || !parent) return;
        const ratio = intrinsicRatio(media, frame);
        if (!ratio) return;

        const availableWidth = elementContentWidth(parent);
        if (!availableWidth) return;
        settleFrame(frame, media, ratio, availableWidth);
      };

      const syncStandaloneMedia = (media) => {
        const parent = media.parentElement;
        if (!parent) return;
        const ratio = intrinsicRatio(media);
        if (!ratio) return;

        const availableWidth = elementContentWidth(parent);
        const maxHeight = Math.max(1, window.innerHeight - viewportMediaInset);
        media.style.width = `${Math.min(availableWidth, maxHeight * ratio)}px`;
        media.style.height = 'auto';
        media.style.maxHeight = `${maxHeight}px`;
        if (media.hasAttribute('data-caption-anchor')) alignCaption(media);
      };

      const syncSynchronizedMediaGroup = (group) => {
        const mediaItems = [...group.querySelectorAll('[data-synchronized-media]')];
        const anchor = group.querySelector('[data-media-width-anchor]');
        if (!mediaItems.length || !anchor) return;

        const ratio = intrinsicRatio(anchor);
        const availableWidth = elementContentWidth(group);
        if (!ratio || !availableWidth) return;

        const maxHeight = Math.max(1, window.innerHeight - viewportMediaInset);
        const synchronizedWidth = Math.min(availableWidth, maxHeight * ratio);
        mediaItems.forEach((media) => {
          media.style.width = `${synchronizedWidth}px`;
          media.style.height = 'auto';
          media.style.maxHeight = `${maxHeight}px`;
        });
      };

      const whenMediaReady = (media, callback) => {
        if (media instanceof HTMLImageElement) {
          if (media.complete && media.naturalWidth) callback();
          else media.addEventListener('load', callback, { once: true });
        } else if (media instanceof HTMLVideoElement) {
          if (media.readyState >= 1 && media.videoWidth) callback();
          else media.addEventListener('loadedmetadata', callback, { once: true });
        }
      };

      mediaFrames.forEach((frame) => {
        frame.querySelectorAll('[data-media-visual]').forEach((media) => {
          whenMediaReady(media, () => syncFrame(frame));
        });
        if (frame.dataset.mediaAspect) syncFrame(frame);
      });
      standaloneMedia.forEach((media) => whenMediaReady(media, () => syncStandaloneMedia(media)));
      synchronizedMediaGroups.forEach((group) => {
        syncSynchronizedMediaGroup(group);
        group.querySelectorAll('[data-synchronized-media]').forEach((media) => {
          whenMediaReady(media, () => syncSynchronizedMediaGroup(group));
        });
      });

      const syncViewportMedia = () => {
        mediaFrames.forEach(syncFrame);
        standaloneMedia.forEach(syncStandaloneMedia);
        synchronizedMediaGroups.forEach(syncSynchronizedMediaGroup);
      };
      const viewportMediaObserver = new ResizeObserver(syncViewportMedia);
      [...new Set([
        ...mediaFrames.map((frame) => frame.parentElement),
        ...standaloneMedia.map((media) => media.parentElement),
        ...synchronizedMediaGroups,
      ].filter(Boolean))].forEach((element) => viewportMediaObserver.observe(element));

      document.addEventListener('mediachange', (event) => {
        const frame = event.target.querySelector?.('[data-viewport-media-frame]');
        if (frame) syncFrame(frame);
      });
      window.addEventListener('resize', syncViewportMedia, { passive: true });

      const mediaCaptions = [...document.querySelectorAll('[data-case-system="true"] [data-media-caption]')];
      const captionSources = new WeakMap();
      const captionRenderTimers = new WeakMap();
      const captionResizeDelay = 140;

      mediaCaptions.forEach((caption, index) => {
        const directParagraphs = [...caption.children].filter((child) => child.matches('p'));
        const sourceSegments = directParagraphs.length
          ? directParagraphs.map((paragraph) => paragraph.textContent?.trim() || '').filter(Boolean)
          : (caption.innerText || caption.textContent || '').split(/\n+/).map((line) => line.trim()).filter(Boolean);
        const number = String(index + 1).padStart(2, '0');
        const numberedSegments = sourceSegments.map((segment, segmentIndex) => (
          segmentIndex === 0 ? `[${number}] - ${segment}` : segment
        ));
        const label = numberedSegments.join(' ');

        captionSources.set(caption, {
          numberedSegments,
          separatedParagraphs: directParagraphs.length > 1,
          label,
        });
        caption.dataset.captionLabel = label;
      });

      const captionLayoutReady = (caption) => {
        const unit = caption.closest('[data-media-unit]');
        return !unit || unit.hasAttribute('data-media-ready');
      };

      const playCaption = (caption) => {
        if (
          reduceMotion
          || !caption.classList.contains('caption-motion-ready')
          || caption.classList.contains('caption-motion-active')
          || !captionLayoutReady(caption)
        ) return;

        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            caption.classList.add('caption-motion-active');
            const duration = Number(caption.dataset.captionMotionDuration || 600);
            window.setTimeout(() => caption.classList.add('caption-motion-played'), duration);
          });
        });
      };

      const captionObserver = reduceMotion ? null : new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.dataset.captionInView = 'true';
          if (!captionLayoutReady(entry.target)) return;
          captionObserver.unobserve(entry.target);
          playCaption(entry.target);
        });
      }, { rootMargin: '0px 0px -12% 0px', threshold: 0.1 });

      const renderCaptionMotion = (caption, animate = true) => {
        const source = captionSources.get(caption);
        if (!source?.numberedSegments.length) {
          caption.classList.add('caption-motion-ready', 'caption-motion-active', 'caption-motion-played');
          return;
        }

        const wasSettled = reduceMotion
          || !animate
          || caption.classList.contains('caption-motion-active')
          || caption.classList.contains('caption-motion-played');
        caption.classList.remove('caption-motion-ready', 'caption-motion-active', 'caption-motion-played');

        const accessibleText = document.createElement('span');
        accessibleText.className = 'caption-motion-accessible';
        accessibleText.textContent = source.label;

        const probe = document.createElement('span');
        probe.className = 'caption-motion-probe';
        probe.setAttribute('aria-hidden', 'true');
        source.numberedSegments.forEach((segment, segmentIndex) => {
          const paragraph = document.createElement('span');
          paragraph.className = 'caption-motion-probe-paragraph';
          if (source.separatedParagraphs && segmentIndex > 0) paragraph.classList.add('is-separated');
          segment.split(/\s+/).filter(Boolean).forEach((word, wordIndex) => {
            if (wordIndex) paragraph.append(document.createTextNode(' '));
            const wordElement = document.createElement('span');
            wordElement.className = 'caption-motion-word';
            wordElement.textContent = word;
            paragraph.append(wordElement);
          });
          probe.append(paragraph);
        });
        caption.replaceChildren(accessibleText, probe);

        const paragraphLines = [...probe.querySelectorAll('.caption-motion-probe-paragraph')].map((paragraph) => {
          const lines = [];
          paragraph.querySelectorAll('.caption-motion-word').forEach((wordElement) => {
            const top = Math.round(wordElement.getBoundingClientRect().top * 10) / 10;
            const currentLine = lines.at(-1);
            if (!currentLine || Math.abs(currentLine.top - top) > 1) {
              lines.push({ top, words: [wordElement.textContent] });
            } else {
              currentLine.words.push(wordElement.textContent);
            }
          });
          return lines;
        });
        const totalLines = paragraphLines.reduce((total, lines) => total + lines.length, 0);
        let lineIndex = 0;

        const visual = document.createElement('span');
        visual.className = 'caption-motion-visual';
        visual.setAttribute('aria-hidden', 'true');
        paragraphLines.forEach((lines, paragraphIndex) => {
          const paragraph = document.createElement('span');
          paragraph.className = 'caption-motion-paragraph';
          if (source.separatedParagraphs && paragraphIndex > 0) paragraph.classList.add('is-separated');
          lines.forEach((line) => {
            const lineMask = document.createElement('span');
            lineMask.className = 'caption-motion-line';
            const lineInner = document.createElement('span');
            lineInner.className = 'caption-motion-line-inner';
            lineInner.style.setProperty('--caption-motion-delay', `${(totalLines - lineIndex - 1) * 50}ms`);
            lineInner.textContent = line.words.join(' ');
            lineMask.append(lineInner);
            paragraph.append(lineMask);
            lineIndex += 1;
          });
          visual.append(paragraph);
        });
        caption.replaceChildren(accessibleText, visual);
        caption.dataset.captionMotionDuration = String(600 + Math.max(0, totalLines - 1) * 50);
        caption.classList.add('caption-motion-ready');

        if (wasSettled) {
          caption.classList.add('caption-motion-active', 'caption-motion-played');
        } else if (caption.dataset.captionInView === 'true' && captionLayoutReady(caption)) {
          captionObserver?.unobserve(caption);
          playCaption(caption);
        }
      };

      const scheduleCaptionRender = (caption) => {
        window.clearTimeout(captionRenderTimers.get(caption));
        const timer = window.setTimeout(() => renderCaptionMotion(caption), captionResizeDelay);
        captionRenderTimers.set(caption, timer);
      };

      document.addEventListener('captionlayout', (event) => {
        if (event.target?.matches?.('[data-media-caption]')) scheduleCaptionRender(event.target);
      });

      document.fonts.ready.then(() => {
        mediaCaptions.forEach((caption) => {
          renderCaptionMotion(caption);
          if (reduceMotion) {
            caption.classList.add('caption-motion-active', 'caption-motion-played');
          } else {
            captionObserver.observe(caption);
          }
        });
      });

      let captionWindowResizeTimer;
      window.addEventListener('resize', () => {
        window.clearTimeout(captionWindowResizeTimer);
        captionWindowResizeTimer = window.setTimeout(
          () => mediaCaptions.forEach((caption) => renderCaptionMotion(caption)),
          captionResizeDelay,
        );
      }, { passive: true });
    </script>
    <script is:inline>
      const viewer = document.querySelector('[data-behance-viewer]');
      const viewerImage = viewer?.querySelector('[data-behance-viewer-image]');
      const viewerStage = viewer?.querySelector('[data-behance-viewer-stage]');
      const viewerTitle = viewer?.querySelector('[data-behance-viewer-title]');
      const viewerClose = viewer?.querySelector('[data-behance-viewer-close]');
      const viewerPrevious = viewer?.querySelector('[data-behance-viewer-previous]');
      const viewerNext = viewer?.querySelector('[data-behance-viewer-next]');
      let activeViewerItem = null;
      let viewerReturnFocus = null;
      let viewerExpanded = false;

      const viewerItems = () => Array.from(document.querySelectorAll('[data-behance-image]'))
        .filter((item) => item.getAttribute('aria-hidden') !== 'true');
      const imageFor = (item) => item instanceof HTMLImageElement ? item : item.querySelector('img');
      const titleFor = (item) => {
        const explicit = item.dataset.behanceTitle?.trim();
        const captionElement = item.closest('figure')?.querySelector('figcaption');
        const caption = captionElement?.dataset.captionLabel || captionElement?.textContent?.trim();
        const image = imageFor(item);
        const caseTitle = item.closest('.case-study')?.querySelector('.case-headline')?.textContent?.trim();
        return explicit || caption || image?.alt?.trim() || caseTitle || 'Portfolio image';
      };
      const setViewerExpanded = (expanded) => {
        if (!viewer || !viewerImage || !viewerStage) return;
        viewerExpanded = expanded;
        viewer.classList.toggle('is-expanded', expanded);
        viewerImage.style.width = expanded ? `${window.innerWidth}px` : '';
        viewerStage.scrollTo({ top: 0, left: 0, behavior: 'instant' });
      };
      const renderViewer = () => {
        if (!activeViewerItem || !viewerImage || !viewerTitle) return;
        const sourceImage = imageFor(activeViewerItem);
        if (!sourceImage) return;
        const title = titleFor(activeViewerItem);
        viewerImage.src = sourceImage.currentSrc || sourceImage.src;
        viewerImage.alt = title;
        viewerTitle.textContent = title;
        setViewerExpanded(false);
      };
      const openViewer = (item) => {
        if (!viewer) return;
        activeViewerItem = item;
        viewerReturnFocus = item;
        renderViewer();
        viewer.hidden = false;
        document.body.classList.add('behance-viewer-open');
        viewerClose?.focus();
      };
      const closeViewer = () => {
        if (!viewer || viewer.hidden) return;
        viewer.hidden = true;
        document.body.classList.remove('behance-viewer-open');
        setViewerExpanded(false);
        viewerReturnFocus?.focus();
      };
      const moveViewer = (offset) => {
        const items = viewerItems();
        const current = items.indexOf(activeViewerItem);
        if (current < 0 || items.length < 2) return;
        activeViewerItem = items[(current + offset + items.length) % items.length];
        renderViewer();
      };

      document.addEventListener('click', (event) => {
        const item = event.target.closest?.('[data-behance-image]');
        if (!item) return;
        event.preventDefault();
        event.stopPropagation();
        openViewer(item);
      });
      document.addEventListener('keydown', (event) => {
        const item = event.target.closest?.('[data-behance-image]');
        if (item && (event.key === 'Enter' || event.key === ' ')) {
          event.preventDefault();
          openViewer(item);
          return;
        }
        if (!viewer || viewer.hidden) return;
        if (event.key === 'Escape') closeViewer();
        if (event.key === 'ArrowLeft' && !viewerExpanded) moveViewer(-1);
        if (event.key === 'ArrowRight' && !viewerExpanded) moveViewer(1);
        if (event.key === 'Enter' && event.target === viewerImage) setViewerExpanded(!viewerExpanded);
      });
      viewerImage?.addEventListener('click', () => setViewerExpanded(!viewerExpanded));
      viewerImage?.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          setViewerExpanded(!viewerExpanded);
        }
      });
      viewerClose?.addEventListener('click', closeViewer);
      viewerPrevious?.addEventListener('click', () => moveViewer(-1));
      viewerNext?.addEventListener('click', () => moveViewer(1));
      viewer?.addEventListener('click', (event) => { if (event.target === viewer) closeViewer(); });
    </script>
    <script is:inline>
      document.querySelectorAll('[data-team-panel]').forEach((panel) => {
        if (!(panel instanceof HTMLDialogElement)) return;

        const trigger = document.querySelector(`[data-team-panel-trigger][aria-controls="${panel.id}"]`);
        const closeButton = panel.querySelector('[data-team-panel-close]');
        let returnFocus = null;

        const openPanel = () => {
          returnFocus = document.activeElement instanceof HTMLElement ? document.activeElement : trigger;
          panel.showModal();
          document.body.classList.add('team-panel-open');
          trigger?.setAttribute('aria-expanded', 'true');
          closeButton?.focus();
        };

        const closePanel = () => {
          if (panel.open) panel.close();
        };

        trigger?.addEventListener('click', openPanel);
        closeButton?.addEventListener('click', closePanel);
        panel.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') {
            event.preventDefault();
            closePanel();
          }
        });
        panel.addEventListener('click', (event) => {
          if (event.target === panel) closePanel();
        });
        panel.addEventListener('close', () => {
          document.body.classList.remove('team-panel-open');
          trigger?.setAttribute('aria-expanded', 'false');
          if (returnFocus instanceof HTMLElement && returnFocus.isConnected) returnFocus.focus();
        });
      });
    </script>
    <script>
      import { initLineSystem } from '../scripts/line-system.js';
      initLineSystem();
    </script>
  </body>
</html>
