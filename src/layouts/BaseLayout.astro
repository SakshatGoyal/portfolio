---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  theme?: string;
}

const { title, description, theme = 'neutral' } = Astro.props;
const isCaseSystem = theme !== 'neutral';
const isHomeSystem = Astro.url.pathname === '/';
---

<!doctype html>
<html lang="en" data-theme={theme} data-case-system={isCaseSystem ? 'true' : undefined} data-home-system={isHomeSystem ? 'true' : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fafafa" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <title>{title}</title>
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <noscript><style>[data-line-mask], [data-media-caption] { visibility: visible !important; }</style></noscript>
  </head>
  <body id="top">
    <div class="page-shell">
      <a class="skip-link" href="#main-content">Skip to content</a>
      <SiteHeader theme={theme} />
      <main id="main-content" tabindex="-1">
        <slot />
      </main>
      <SiteFooter />
    </div>
    <div class="custom-site-cursor" data-custom-cursor aria-hidden="true">
      <svg class="cursor-project-arrow" viewBox="0 0 24 24"><path d="M5 12h14M14 7l5 5-5 5"></path></svg>
    </div>
    <div class="behance-viewer" data-behance-viewer hidden role="dialog" aria-modal="true" aria-labelledby="behance-viewer-title">
      <div class="behance-viewer__topbar">
        <h2 id="behance-viewer-title" data-behance-viewer-title></h2>
        <button class="behance-viewer__close" type="button" data-behance-viewer-close aria-label="Close media viewer">
          <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M1 1L11 11M11 1L1 11" /></svg>
        </button>
      </div>
      <button class="behance-viewer__previous" type="button" data-behance-viewer-previous aria-label="Previous media">
        <svg viewBox="0 0 12 20" aria-hidden="true"><path d="M10 2L2 10L10 18" /></svg>
      </button>
      <div class="behance-viewer__stage" data-behance-viewer-stage>
        <img data-behance-viewer-image alt="" tabindex="0" />
        <video data-behance-viewer-video controls muted loop playsinline tabindex="0" hidden></video>
      </div>
      <button class="behance-viewer__next" type="button" data-behance-viewer-next aria-label="Next media">
        <svg viewBox="0 0 12 20" aria-hidden="true"><path d="M2 2L10 10L2 18" /></svg>
      </button>
    </div>
    <script>
      import { createMediaPlaybackController } from '../scripts/media-playback-controller.js';

      const mediaWindow = window as typeof window & {
        __mediaPlaybackController?: ReturnType<typeof createMediaPlaybackController>;
        __mediaPlaybackDispose?: () => void;
      };
      mediaWindow.__mediaPlaybackDispose?.();
      const mediaPlaybackController = createMediaPlaybackController();
      mediaWindow.__mediaPlaybackController = mediaPlaybackController;
      mediaWindow.__mediaPlaybackDispose = () => mediaPlaybackController.dispose();
    </script>
    <script is:inline>
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (!reduceMotion) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        }, { rootMargin: '0px 0px -7% 0px', threshold: 0.08 });
        document.querySelectorAll('[data-reveal]').forEach((element) => observer.observe(element));
      } else {
        document.querySelectorAll('[data-reveal]').forEach((element) => element.classList.add('is-visible'));
      }

      const customCursor = document.querySelector('[data-custom-cursor]');
      const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
      if (customCursor && finePointer.matches) {
        document.documentElement.classList.add('custom-cursor-active');
        document.addEventListener('pointermove', (event) => {
          if (event.pointerType && event.pointerType !== 'mouse') return;
          customCursor.style.left = `${event.clientX}px`;
          customCursor.style.top = `${event.clientY}px`;
          customCursor.classList.add('is-visible');
          const nextProject = event.target.closest?.('[data-media-playback-control]')
            ? null
            : event.target.closest?.('[data-project-tile]') || null;
          customCursor.classList.toggle('is-project', Boolean(nextProject));
        }, { passive: true });
        document.documentElement.addEventListener('pointerleave', () => customCursor.classList.remove('is-visible'));
        window.addEventListener('blur', () => customCursor.classList.remove('is-visible'));
      }

      const alignBranchedConnectors = () => {
        document.querySelectorAll('.problem-layout, .branched-layout').forEach((layout) => {
          const lead = layout.querySelector(':scope > [data-branch-lead]');
          const svg = layout.querySelector(':scope > .problem-connector');
          const path = svg?.querySelector('path');
          const markers = [...layout.querySelectorAll(':scope > .problem-list .problem-marker')];

          if (!lead || !svg || !path || markers.length === 0) return;

          const svgRect = svg.getBoundingClientRect();
          const leadRect = lead.getBoundingClientRect();
          const markerRects = markers.map((marker) => marker.getBoundingClientRect());
          const spineX = Math.round(leadRect.left - svgRect.left + 10) + 0.5;
          const startY = leadRect.bottom - svgRect.top + 6;
          const markerCenters = markerRects.map((rect) => rect.top - svgRect.top + rect.height / 2);
          const markerEdges = markerRects.map((rect) => rect.left - svgRect.left);
          const endY = markerCenters.at(-1);
          const branches = markerCenters.map((centerY, index) => `M ${spineX} ${centerY} H ${markerEdges[index]}`).join(' ');

          svg.setAttribute('viewBox', `0 0 ${svgRect.width} ${svgRect.height}`);
          path.setAttribute('d', `M ${spineX} ${startY} V ${endY} ${branches}`);
        });
      };

      const branchedConnectorObserver = new ResizeObserver(alignBranchedConnectors);
      document.querySelectorAll('.problem-layout, .branched-layout').forEach((layout) => branchedConnectorObserver.observe(layout));
      document.fonts.ready.then(alignBranchedConnectors);
      window.addEventListener('resize', alignBranchedConnectors, { passive: true });
    </script>
    <script is:inline>
      const viewportMediaInset = 64;
      const viewportInsetFor = (frame) => {
        const requestedInset = Number(frame?.dataset.viewportMediaInset);
        return Number.isFinite(requestedInset) && requestedInset >= 0
          ? requestedInset
          : viewportMediaInset;
      };
      const mediaFrames = [...document.querySelectorAll('[data-viewport-media-frame]')];
      const standaloneMedia = [...document.querySelectorAll('[data-standalone-media]')];
      const synchronizedMediaGroups = [...document.querySelectorAll('[data-synchronized-media-group]')];

      const elementContentWidth = (element) => {
        const styles = getComputedStyle(element);
        return Math.max(0, element.clientWidth
          - parseFloat(styles.paddingLeft || '0')
          - parseFloat(styles.paddingRight || '0'));
      };

      const parseAspectRatio = (value) => {
        if (!value) return 0;
        const [width, height] = value.split('/').map((part) => Number(part.trim()));
        return width > 0 && height > 0 ? width / height : 0;
      };

      const intrinsicRatio = (media, frame) => {
        const declaredRatio = parseAspectRatio(frame?.dataset.mediaAspect);
        if (declaredRatio) return declaredRatio;
        if (media instanceof HTMLImageElement) {
          const width = media.naturalWidth || Number(media.getAttribute('width'));
          const height = media.naturalHeight || Number(media.getAttribute('height'));
          return width > 0 && height > 0 ? width / height : 0;
        }
        if (media instanceof HTMLVideoElement) {
          const width = media.videoWidth || Number(media.getAttribute('width'));
          const height = media.videoHeight || Number(media.getAttribute('height'));
          return width > 0 && height > 0 ? width / height : 0;
        }
        return 0;
      };

      const selectedVisual = (frame) => [...frame.querySelectorAll('[data-media-visual]')]
        .find((media) => media.getAttribute('aria-hidden') !== 'true')
        || frame.querySelector('[data-media-visual]');

      const alignCaption = (media) => {
        const unit = media.closest('[data-media-unit]');
        const caption = unit?.querySelector('[data-media-caption]');
        if (!unit || !caption) return;

        const unitStyles = getComputedStyle(unit);
        const unitRect = unit.getBoundingClientRect();
        const frame = media.closest('[data-viewport-media-frame]');
        const captionAnchor = unit.dataset.captionAlignment === 'frame' && frame ? frame : media;
        const mediaRect = captionAnchor.getBoundingClientRect();
        const contentLeft = unitRect.left
          + parseFloat(unitStyles.borderLeftWidth || '0')
          + parseFloat(unitStyles.paddingLeft || '0');

        caption.style.width = `${mediaRect.width}px`;
        caption.style.maxWidth = 'none';
        caption.style.marginLeft = `${Math.max(0, mediaRect.left - contentLeft)}px`;
        unit.toggleAttribute('data-media-ready', mediaRect.width > 0);
        if (mediaRect.width > 0) {
          caption.dispatchEvent(new CustomEvent('captionlayout', { bubbles: true }));
        }
      };

      const settleFrame = (frame, media, ratio, availableWidth, attempt = 0) => {
        requestAnimationFrame(() => {
          const frameStyles = getComputedStyle(frame);
          const paddingX = parseFloat(frameStyles.paddingLeft || '0') + parseFloat(frameStyles.paddingRight || '0');
          const paddingY = parseFloat(frameStyles.paddingTop || '0') + parseFloat(frameStyles.paddingBottom || '0');
          const maxOuterHeight = Math.max(1, window.innerHeight - viewportInsetFor(frame));
          const maxInnerHeight = Math.max(1, maxOuterHeight - paddingY);
          const targetWidth = frame.hasAttribute('data-fluid-media-frame')
            ? availableWidth
            : Math.min(availableWidth, (maxInnerHeight * ratio) + paddingX);
          const currentWidth = frame.getBoundingClientRect().width;
          const isSquareMedia = frame.hasAttribute('data-square-media-frame');
          const squareMediaSize = Math.min(Math.max(1, targetWidth - paddingX), maxInnerHeight);

          frame.style.width = `${targetWidth}px`;
          frame.style.maxHeight = `${maxOuterHeight}px`;
          media.style.width = isSquareMedia ? `${squareMediaSize}px` : '100%';
          media.style.height = isSquareMedia ? `${squareMediaSize}px` : 'auto';
          media.style.maxHeight = `${maxInnerHeight}px`;
          if (isSquareMedia) media.style.aspectRatio = '1 / 1';

          if (attempt < 3 && Math.abs(currentWidth - targetWidth) > 0.5) {
            settleFrame(frame, media, ratio, availableWidth, attempt + 1);
            return;
          }
          alignCaption(media);
        });
      };

      const syncFrame = (frame) => {
        const media = selectedVisual(frame);
        const sizingContainer = frame.closest('[data-media-unit]') || frame.parentElement;
        if (!media || !sizingContainer) return;
        const ratio = intrinsicRatio(media, frame);
        if (!ratio) return;

        const availableWidth = elementContentWidth(sizingContainer);
        if (!availableWidth) return;
        settleFrame(frame, media, ratio, availableWidth);
      };

      const syncStandaloneMedia = (media) => {
        const parent = media.parentElement;
        if (!parent) return;
        const ratio = intrinsicRatio(media);
        if (!ratio) return;

        const availableWidth = elementContentWidth(parent);
        const maxHeight = Math.max(1, window.innerHeight - viewportMediaInset);
        media.style.width = `${Math.min(availableWidth, maxHeight * ratio)}px`;
        media.style.height = 'auto';
        media.style.maxHeight = `${maxHeight}px`;
        if (media.hasAttribute('data-caption-anchor')) alignCaption(media);
      };

      const syncSynchronizedMediaGroup = (group) => {
        const mediaItems = [...group.querySelectorAll('[data-synchronized-media]')];
        const anchor = group.querySelector('[data-media-width-anchor]');
        if (!mediaItems.length || !anchor) return;

        const ratio = intrinsicRatio(anchor);
        const availableWidth = elementContentWidth(group);
        if (!ratio || !availableWidth) return;

        const maxHeight = Math.max(1, window.innerHeight - viewportMediaInset);
        const synchronizedWidth = Math.min(availableWidth, maxHeight * ratio);
        mediaItems.forEach((media) => {
          media.style.width = `${synchronizedWidth}px`;
          media.style.height = 'auto';
          media.style.maxHeight = `${maxHeight}px`;
        });
      };

      const whenMediaReady = (media, callback) => {
        if (media instanceof HTMLImageElement) {
          if (media.complete && media.naturalWidth) callback();
          else media.addEventListener('load', callback, { once: true });
        } else if (media instanceof HTMLVideoElement) {
          if (media.readyState >= 1 && media.videoWidth) callback();
          else media.addEventListener('loadedmetadata', callback, { once: true });
        }
      };

      mediaFrames.forEach((frame) => {
        frame.querySelectorAll('[data-media-visual]').forEach((media) => {
          whenMediaReady(media, () => syncFrame(frame));
        });
        if (frame.dataset.mediaAspect) syncFrame(frame);
      });
      standaloneMedia.forEach((media) => whenMediaReady(media, () => syncStandaloneMedia(media)));
      synchronizedMediaGroups.forEach((group) => {
        syncSynchronizedMediaGroup(group);
        group.querySelectorAll('[data-synchronized-media]').forEach((media) => {
          whenMediaReady(media, () => syncSynchronizedMediaGroup(group));
        });
      });

      const syncViewportMedia = () => {
        mediaFrames.forEach(syncFrame);
        standaloneMedia.forEach(syncStandaloneMedia);
        synchronizedMediaGroups.forEach(syncSynchronizedMediaGroup);
      };
      const viewportMediaObserver = new ResizeObserver(syncViewportMedia);
      [...new Set([
        ...mediaFrames.map((frame) => frame.parentElement),
        ...standaloneMedia.map((media) => media.parentElement),
        ...synchronizedMediaGroups,
      ].filter(Boolean))].forEach((element) => viewportMediaObserver.observe(element));

      document.addEventListener('mediachange', (event) => {
        const frame = event.target.querySelector?.('[data-viewport-media-frame]');
        if (frame) syncFrame(frame);
      });
      window.addEventListener('resize', syncViewportMedia, { passive: true });

    </script>
    <script is:inline>
      const viewer = document.querySelector('[data-behance-viewer]');
      const viewerImage = viewer?.querySelector('[data-behance-viewer-image]');
      const viewerVideo = viewer?.querySelector('[data-behance-viewer-video]');
      const viewerStage = viewer?.querySelector('[data-behance-viewer-stage]');
      const viewerTitle = viewer?.querySelector('[data-behance-viewer-title]');
      const viewerClose = viewer?.querySelector('[data-behance-viewer-close]');
      const viewerPrevious = viewer?.querySelector('[data-behance-viewer-previous]');
      const viewerNext = viewer?.querySelector('[data-behance-viewer-next]');
      const pageShell = document.querySelector('.page-shell');
      let activeViewerItem = null;
      let viewerReturnFocus = null;
      let viewerExpanded = false;
      let viewerSourceVideo = null;
      let viewerRenderToken = 0;

      const viewerItems = () => Array.from(document.querySelectorAll('[data-behance-image], [data-behance-video]'))
        .filter((item) => item.getAttribute('aria-hidden') !== 'true');
      const imageFor = (item) => item instanceof HTMLImageElement ? item : item.querySelector('img');
      const videoFor = (item) => item instanceof HTMLVideoElement
        ? item
        : item.querySelector('video') || item.closest('.gallery-artifact-surface')?.querySelector('video');
      const titleFor = (item) => {
        const explicit = item.dataset.behanceTitle?.trim();
        const captionElement = item.closest('figure')?.querySelector('figcaption');
        const caption = captionElement?.dataset.captionLabel || captionElement?.textContent?.trim();
        const image = imageFor(item);
        const video = videoFor(item);
        const caseTitle = item.closest('.case-study')?.querySelector('.case-headline')?.textContent?.trim();
        return explicit || caption || image?.alt?.trim() || video?.getAttribute('aria-label')?.trim()
          || caseTitle || 'Portfolio media';
      };
      const setViewerExpanded = (expanded) => {
        if (!viewer || !viewerImage || !viewerStage) return;
        viewerExpanded = expanded && !viewerImage.hidden;
        viewer.classList.toggle('is-expanded', viewerExpanded);
        viewerImage.style.width = viewerExpanded ? `${window.innerWidth}px` : '';
        viewerStage.scrollTo({ top: 0, left: 0, behavior: 'instant' });
      };
      const releaseViewerVideo = () => {
        if (!(viewerVideo instanceof HTMLVideoElement)) return;
        viewerVideo.pause();
        if (viewerSourceVideo instanceof HTMLVideoElement && Number.isFinite(viewerVideo.currentTime)) {
          viewerSourceVideo.currentTime = viewerVideo.currentTime;
        }
        viewerSourceVideo = null;
      };
      const renderViewer = () => {
        if (!activeViewerItem || !viewerImage || !viewerVideo || !viewerTitle) return;
        const renderToken = ++viewerRenderToken;
        releaseViewerVideo();
        const sourceImage = imageFor(activeViewerItem);
        const sourceVideo = videoFor(activeViewerItem);
        const title = titleFor(activeViewerItem);
        viewerTitle.textContent = title;
        setViewerExpanded(false);
        if (sourceVideo instanceof HTMLVideoElement) {
          const continuePlayback = sourceVideo.dataset.playbackState === 'playing';
          const sourceTime = sourceVideo.currentTime;
          sourceVideo.pause();
          viewerSourceVideo = sourceVideo;
          viewerImage.hidden = true;
          viewerVideo.hidden = false;
          viewerVideo.src = sourceVideo.currentSrc || sourceVideo.src;
          viewerVideo.poster = sourceVideo.poster;
          viewerVideo.setAttribute('aria-label', title);
          const continueAtSourceTime = () => {
            if (renderToken !== viewerRenderToken) return;
            viewerVideo.currentTime = Math.min(sourceTime, Number.isFinite(viewerVideo.duration) ? viewerVideo.duration : sourceTime);
            if (continuePlayback) viewerVideo.play().catch((error) => {
              viewerVideo.dataset.playbackState = 'failed';
              viewerVideo.dispatchEvent(new CustomEvent('media-playback-statechange', {
                bubbles: true,
                detail: { state: 'failed', previousState: 'starting', reason: 'viewer-play-rejected', error: error?.name },
              }));
            });
          };
          if (viewerVideo.readyState >= 1) continueAtSourceTime();
          else viewerVideo.addEventListener('loadedmetadata', continueAtSourceTime, { once: true });
          return;
        }
        if (!(sourceImage instanceof HTMLImageElement)) return;
        viewerVideo.hidden = true;
        viewerVideo.removeAttribute('src');
        viewerVideo.load();
        viewerImage.hidden = false;
        viewerImage.src = sourceImage.currentSrc || sourceImage.src;
        viewerImage.alt = title;
      };
      const openViewer = (item) => {
        if (!viewer) return;
        activeViewerItem = item;
        viewerReturnFocus = item;
        viewer.hidden = false;
        renderViewer();
        pageShell?.setAttribute('inert', '');
        document.body.classList.add('behance-viewer-open');
        document.dispatchEvent(new CustomEvent('viewerchange'));
        viewerClose?.focus();
      };
      const closeViewer = () => {
        if (!viewer || viewer.hidden) return;
        viewer.hidden = true;
        pageShell?.removeAttribute('inert');
        document.body.classList.remove('behance-viewer-open');
        document.dispatchEvent(new CustomEvent('viewerchange'));
        setViewerExpanded(false);
        releaseViewerVideo();
        viewerReturnFocus?.focus();
      };
      const moveViewer = (offset) => {
        const items = viewerItems();
        const current = items.indexOf(activeViewerItem);
        if (current < 0 || items.length < 2) return;
        activeViewerItem = items[(current + offset + items.length) % items.length];
        renderViewer();
      };

      document.addEventListener('click', (event) => {
        const item = event.target.closest?.('[data-behance-image], [data-behance-video]');
        if (!item) return;
        event.preventDefault();
        event.stopPropagation();
        openViewer(item);
      });
      document.addEventListener('keydown', (event) => {
        const item = event.target.closest?.('[data-behance-image], [data-behance-video]');
        if (item && (event.key === 'Enter' || event.key === ' ')) {
          event.preventDefault();
          openViewer(item);
          return;
        }
        if (!viewer || viewer.hidden) return;
        if (event.key === 'Escape') closeViewer();
        if (event.key === 'ArrowLeft' && !viewerExpanded) moveViewer(-1);
        if (event.key === 'ArrowRight' && !viewerExpanded) moveViewer(1);
        if (event.key === 'Enter' && event.target === viewerImage) setViewerExpanded(!viewerExpanded);
        if (event.key === 'Tab') {
          const focusable = [...viewer.querySelectorAll('button:not([disabled]), [tabindex="0"]')]
            .filter((element) => element instanceof HTMLElement && !element.hidden);
          const first = focusable[0];
          const last = focusable.at(-1);
          if (event.shiftKey && document.activeElement === first) {
            event.preventDefault();
            last?.focus();
          } else if (!event.shiftKey && document.activeElement === last) {
            event.preventDefault();
            first?.focus();
          }
        }
      });
      viewerImage?.addEventListener('click', () => setViewerExpanded(!viewerExpanded));
      viewerImage?.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          setViewerExpanded(!viewerExpanded);
        }
      });
      viewerClose?.addEventListener('click', closeViewer);
      viewerPrevious?.addEventListener('click', () => moveViewer(-1));
      viewerNext?.addEventListener('click', () => moveViewer(1));
      viewer?.addEventListener('click', (event) => { if (event.target === viewer) closeViewer(); });
    </script>
    <script is:inline>
      document.querySelectorAll('[data-team-panel]').forEach((panel) => {
        if (!(panel instanceof HTMLDialogElement)) return;

        const trigger = document.querySelector(`[data-team-panel-trigger][aria-controls="${panel.id}"]`);
        const closeButton = panel.querySelector('[data-team-panel-close]');
        const siteCursor = document.querySelector('[data-custom-cursor]');
        const cursorHome = siteCursor?.parentNode;
        const cursorNextSibling = siteCursor?.nextSibling;
        let returnFocus = null;

        const openPanel = () => {
          returnFocus = document.activeElement instanceof HTMLElement ? document.activeElement : trigger;
          panel.showModal();
          if (siteCursor) panel.append(siteCursor);
          document.body.classList.add('team-panel-open');
          trigger?.setAttribute('aria-expanded', 'true');
          closeButton?.focus();
        };

        const closePanel = () => {
          if (panel.open) panel.close();
        };

        trigger?.addEventListener('click', openPanel);
        closeButton?.addEventListener('click', closePanel);
        panel.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') {
            event.preventDefault();
            closePanel();
          }
        });
        panel.addEventListener('click', (event) => {
          if (event.target === panel) closePanel();
        });
        panel.addEventListener('close', () => {
          if (siteCursor && cursorHome) {
            const reference = cursorNextSibling?.parentNode === cursorHome ? cursorNextSibling : null;
            cursorHome.insertBefore(siteCursor, reference);
          }
          document.body.classList.remove('team-panel-open');
          trigger?.setAttribute('aria-expanded', 'false');
          if (returnFocus instanceof HTMLElement && returnFocus.isConnected) returnFocus.focus();
        });
      });
    </script>
    <script>
      import { initLineSystem } from '../scripts/line-system.js';
      import { initMotionSystem } from '../scripts/motion-system.js';
      import { initTypographySystem } from '../scripts/typography-system.js';
      initTypographySystem();
      initMotionSystem();
      initLineSystem();
    </script>
  </body>
</html>
