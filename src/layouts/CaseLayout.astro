---
import BaseLayout from './BaseLayout.astro';
import Figure from '../components/Figure.astro';
import TeamPanel from '../components/TeamPanel.astro';
import PageHeading from '../components/PageHeading.astro';
import { caseStudyNavigationFor } from '../data/project-sequence.js';
import { projectForRoute } from '../data/projects.js';

interface TeamMember {
  name: string;
  role: string;
}

interface Props {
  headline: string;
  intro: string[];
  stakeholder?: string;
  skills?: string[];
  year?: string;
  role?: string;
  teamLabel?: string;
  teamMembers?: TeamMember[];
  teamNote?: string;
  hero?: string;
  heroVideo?: boolean;
  heroWidth?: number;
  heroHeight?: number;
  heroCaption?: string;
  heroPoster?: string;
  heroAutoplayOnView?: boolean;
  heroLoop?: boolean;
  heroViewportFit?: boolean;
  theme?: string;
  introSpacing?: 'standard' | 'tight';
  showMeta?: boolean;
}

const {
  headline, intro, stakeholder = '', skills = [], year = '', role = '', teamLabel = '', hero = '', heroVideo = false,
  heroWidth = 1920, heroHeight = 1080, heroCaption, heroPoster,
  heroAutoplayOnView = heroVideo, heroLoop = heroVideo, heroViewportFit = true,
  theme = 'neutral', introSpacing = 'standard',
  teamMembers = [], teamNote, showMeta = true,
} = Astro.props;
const { previousHref, nextHref } = caseStudyNavigationFor(Astro.url.pathname);
const project = projectForRoute(Astro.url.pathname);
if (!project) throw new Error(`Missing project registry entry for ${Astro.url.pathname}`);
const hasTeamPanel = Boolean(teamLabel);
const teamPanelId = `team-panel-${theme}`;
const hasCustomHero = Astro.slots.has('hero');
---

<BaseLayout title={project.metadata.title} description={project.metadata.description} theme={theme}>
  <article class="case-study case-study-system">
    <PageHeading title={headline} caseStudy />

    {hasCustomHero ? (
      <slot name="hero" />
    ) : (
      <Figure src={hero} alt={headline} caption={heroCaption} class="hero-figure" eager contain={theme === 'panw'} fluidFrame={theme === 'panw'} squareMedia={theme === 'panw'} viewportFit={heroViewportFit} video={heroVideo} autoplayOnView={heroAutoplayOnView} loop={heroLoop} poster={heroPoster} width={heroWidth} height={heroHeight} />
    )}

    <section class:list={['case-intro', 'reading-column', { tight: introSpacing === 'tight' }]} data-reveal>
      {intro.map((paragraph) => <p>{paragraph}</p>)}
      <slot name="intro-extra" />
    </section>

    {showMeta && <dl class="case-meta reading-column" data-reveal>
      <div><dt>Stakeholder</dt><dd>{stakeholder}</dd></div>
      <div><dt>Skills</dt><dd>{skills.map((skill) => <span>{skill}</span>)}</dd></div>
      <div><dt>Year</dt><dd>{year}</dd></div>
      <div>
        <dt>Role</dt>
        <dd class="role-meta">
          <span>{role}</span>
          <span aria-hidden="true">・</span>
          {hasTeamPanel ? (
            <button
              class="team-label"
              type="button"
              data-tape-label
              data-team-panel-trigger
              aria-haspopup="dialog"
              aria-controls={teamPanelId}
              aria-expanded="false"
            >
              {teamLabel}
            </button>
          ) : (
            <span class="team-label">{teamLabel}</span>
          )}
        </dd>
      </div>
    </dl>}

    {showMeta && hasTeamPanel && (
      <TeamPanel id={teamPanelId} members={teamMembers} note={teamNote} />
    )}

    <div class="case-body">
      <slot />
    </div>

    <nav class="case-navigation" aria-label="Case study navigation" data-reveal>
      <a class="previous-case" href={previousHref} aria-label="Previous case study">
        <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M19 12H5M10 17L5 12L10 7" /></svg>
      </a>
      <a class="next-case" href={nextHref}>
        <span>Next</span>
        <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M5 12H19M14 17L19 12L14 7" /></svg>
      </a>
    </nav>
  </article>
</BaseLayout>
